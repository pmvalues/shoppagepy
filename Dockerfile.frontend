FROM node:20 AS builder
WORKDIR /app

COPY . .

RUN npm install
RUN npm run build

FROM node:20-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

COPY --from=builder /app ./

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=@shoppage/web", "--", "-p", "3000"]
