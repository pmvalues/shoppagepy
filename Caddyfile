# ==============================================================================
# Shoppage edge: automatic HTTPS (Let's Encrypt / ZeroSSL) in front of the
# single Shoppage binary. Caddy sets X-Forwarded-For/-Proto itself and ignores
# client-supplied values; the app trusts them only from this private network.
# ==============================================================================

www.{$DOMAIN:shoppage.co.za} {
	redir https://{$DOMAIN:shoppage.co.za}{uri} permanent
}

{$DOMAIN:shoppage.co.za} {
	encode zstd gzip

	# WebSockets (/ws/chat) and all HTTP traffic go to the same binary.
	reverse_proxy shoppage:3000

	@static path /static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# HSTS lives at the edge. Framing, CSP and the other browser headers are
	# set by the app, because /embed/* must stay frameable by merchant sites.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	header -Server
}
