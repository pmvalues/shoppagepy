# ==============================================================================
# Shoppage v7.0 Environment Configuration Template (Coolify / Dokploy)
# ==============================================================================

# --- Django SEO layer ---------------------------------------------------------
# Explicit public origin used for canonical URLs, sitemaps and JSON-LD.
# Leave SHOPPAGE_SITE_URL empty on preview/staging hosts so they derive from
# the request host instead of pointing at production.
SHOPPAGE_SITE_URL=https://shoppage.co.za
# Origin allowed by CORS (first-party).
SHOPPAGE_PUBLIC_ORIGIN=https://shoppage.co.za
# Search-engine ownership verification tokens (base template emits these when set).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Application Domain & Base URL
DOMAIN=shoppage.co.za
NEXT_PUBLIC_SERVER_URL=https://shoppage.co.za

# Payload CMS 3 Secret Key (generate a 32+ character random string)
PAYLOAD_SECRET=replace_with_a_super_secure_random_32_byte_string

# PostgreSQL 16 Credentials
POSTGRES_USER=shoppage
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=shoppage_db
DATABASE_URI=postgres://shoppage:replace_with_secure_postgres_password@postgres:5432/shoppage_db

# Redis 7 Credentials
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_URL=redis://:replace_with_secure_redis_password@redis:6379

# Typesense Search Engine
TYPESENSE_URL=http://typesense:8108
TYPESENSE_API_KEY=replace_with_secure_typesense_api_key
# Which engine serves ranked_search: auto | sql | typesense.
# 'auto' uses Typesense only when TYPESENSE_URL + API_KEY are set; any backend
# failure falls back to the SQL hybrid engine. Unset = 'auto'.
SHOPPAGE_SEARCH_BACKEND=auto
TYPESENSE_COLLECTION=products
# Seconds before a Typesense query is abandoned in favour of the SQL engine.
TYPESENSE_TIMEOUT=1.5

# Governed AI (xAI / Grok & OpenAI)
XAI_API_KEY=xai-your-api-key-here
OPENAI_API_KEY=sk-your-openai-key-here
# Shoppage assistant LLM (Google Gemini; server-side only — never use NEXT_PUBLIC_ here)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Read-only GitHub token so production containers can download private release
# data assets (sqlite zips). Fine-grained PAT, Contents: read-only, this repo only.
SHOPPAGE_GITHUB_TOKEN=

# Comms & Action Rail
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
AFRICAS_TALKING_API_KEY=your-africas-talking-key
AFRICAS_TALKING_USERNAME=sandbox

# Admin CMS bulk import gate (server-side only — never use NEXT_PUBLIC_ here)
# The admin dashboard Bulk Import tab sends this as the x-admin-token header.
# Leave empty to keep CSV imports disabled.
SHOPPAGE_ADMIN_TOKEN=
