# ==============================================================================
# Shoppage Pure-Go Runtime Environment Template
# ==============================================================================
# The live runtime is 5 Go services (consumer-web, merchant-os, search-core,
# chat-gateway, sweeper-engine). Keys below are the ones the Go binaries read
# via os.Getenv. Legacy Payload/Postgres/Redis/Typesense/Next keys from the
# retired TypeScript stack have been removed — see docs/ for historical notes.

# --- Public origin / CORS ----------------------------------------------------
# Public consumer origin used by merchant-os for storefront/badge/iframe URLs
# (config.PublicBaseURL). Never localhost in production.
SHOPPAGE_PUBLIC_URL=https://shoppage.co.za
# Comma-separated browser origins allowed by CORS on every Go service.
# Empty → localhost:3000,localhost:3001 (dev). Never use "*".
ALLOWED_ORIGINS=https://shoppage.co.za,https://www.shoppage.co.za

# --- Ports (each service; consumer-web is the public gateway) ----------------
PORT=3000
MERCHANT_PORT=8083
CHAT_PORT=8080
SEARCH_PORT=8082

# --- Service discovery (consumer-web reverse proxies) ------------------------
MERCHANT_OS_URL=http://localhost:8083
CHAT_GATEWAY_URL=http://localhost:8080
SEARCH_CORE_URL=http://localhost:8082

# --- AI (server-side only) ---------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Merchant OS identity ----------------------------------------------------
SHOPPAGE_STORE_ID=
SHOPPAGE_STORE_NAME=
MERCHANT_DATA_DIR=data

# --- Authentication (required before public exposure) -----------------------
# HMAC secret for session cookies (32+ chars, never commit).
# Generate with: openssl rand -base64 48
SHOPPAGE_AUTH_SECRET=
# Platform admin credentials used by the merchant login form.
SHOPPAGE_ADMIN_EMAIL=admin@shoppage.co.za
SHOPPAGE_ADMIN_PASSWORD=
