# ==============================================================================
# Shoppage environment template — copy to .env (Compose) or
# /etc/shoppage/shoppage.env (systemd) and fill in every REQUIRED value.
# Never commit the filled-in copy.
# ==============================================================================

# --- Mode ---------------------------------------------------------------------
# Anything other than development|dev|local|test (including unset) is
# production: demo credentials are never bootstrapped and the process refuses
# to start without the REQUIRED values below.
SHOPPAGE_ENV=production

# --- Public origin ------------------------------------------------------------
DOMAIN=shoppage.co.za
SHOPPAGE_PUBLIC_URL=https://shoppage.co.za
# Browser origins allowed for CORS / cross-origin POSTs. Never "*".
ALLOWED_ORIGINS=https://shoppage.co.za,https://www.shoppage.co.za

# --- Database (REQUIRED in production) ---------------------------------------
# Compose builds DATABASE_URL from POSTGRES_PASSWORD. For systemd or a managed
# database, set DATABASE_URL directly and use sslmode=require off-host.
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://shoppage:PASSWORD@db.example:5432/shoppage?sslmode=require

# --- Merchant OS sign-in (REQUIRED in production) -----------------------------
# 32+ characters. Generate with: openssl rand -base64 48
SHOPPAGE_AUTH_SECRET=
SHOPPAGE_ADMIN_EMAIL=
# 12+ characters; known development defaults are refused.
SHOPPAGE_ADMIN_PASSWORD=
SHOPPAGE_STORE_ID=
SHOPPAGE_STORE_NAME=

# --- Network trust ------------------------------------------------------------
# CIDRs allowed to set X-Forwarded-For (your reverse proxy). Default: loopback
# and private ranges. Use "none" if clients connect to the app directly.
# TRUSTED_PROXIES=127.0.0.1/32

# --- AI assistant (optional, server-side only) --------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Live model calls per UTC day before falling back to offline rules (0 = off).
GEMINI_DAILY_LIMIT=2000

# --- Observability (optional) -------------------------------------------------
# Error reporting; leave empty to disable.
SENTRY_DSN=
# Bearer token for /metrics (Prometheus). Empty = /metrics hidden in production.
METRICS_TOKEN=
LOG_LEVEL=info
SHOPPAGE_RELEASE=

# --- Split deployment (optional) ----------------------------------------------
# By default one binary runs everything. Set these only to route a component
# to a separately deployed service.
# MERCHANT_OS_URL=http://merchant-os:8083
# CHAT_GATEWAY_URL=http://chat-gateway:8080
# SEARCH_CORE_URL=http://search-core:8082
# SEARCH_INDEX_TOKEN=
