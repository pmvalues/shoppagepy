package templates

import (
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

func publicBase(data models.DashboardViewData) string {
	return strings.TrimRight(data.Nav.PublicBaseURL, "/")
}

func storeLink(data models.DashboardViewData) string {
	return publicBase(data) + "/m/" + data.Store.ID
}

func embedSnippet(data models.DashboardViewData) string {
	return fmt.Sprintf(`<iframe src="%s/embed/m/%s" width="100%%" height="650" style="border:1px solid #e2e8f0;border-radius:16px" title="%s on Shoppage" loading="lazy"></iframe>`,
		publicBase(data), data.Store.ID, data.Store.Name)
}

func badgeSnippet(data models.DashboardViewData, badge, alt string) string {
	return fmt.Sprintf(`<a href="%s" target="_blank" rel="noopener"><img src="%s/badges/%s.svg" alt="%s" height="48"></a>`, storeLink(data), publicBase(data), badge, alt)
}

func signatureSnippet(data models.DashboardViewData) string {
	s := data.Store
	return fmt.Sprintf(`<table style="font-family:sans-serif;font-size:13px;color:#1e293b"><tr><td><strong>%s</strong></td></tr><tr><td style="font-size:12px;color:#64748b">%s · %s</td></tr><tr><td style="padding-top:6px"><a href="%s"><img src="%s/badges/order-on-shoppage.svg" height="28" alt="Order on Shoppage"></a></td></tr></table>`,
		s.Name, s.Phone, s.Email, storeLink(data), publicBase(data))
}

templ ChannelsTab(data models.DashboardViewData) {
	<div class="page-head">
		<div class="head-copy">
			<p>Where buyers reach you: your Shoppage store, WhatsApp, your own website and email.</p>
		</div>
		<div class="actions">
			<a class="btn ghost" href={ templ.SafeURL(storeLink(data)) } target="_blank" rel="noopener">View your store</a>
		</div>
	</div>
	<div class="row-2">
		<article class="card panel">
			<div class="panel-head">
				<div>
					<h3>WhatsApp</h3>
					<div class="sub">Buyers message you directly from your store and listings.</div>
				</div>
				if data.Store.WhatsApp != "" {
					<span class="right chip ok">Number added</span>
				} else {
					<span class="right chip warn">Not set</span>
				}
			</div>
			if data.Store.WhatsApp != "" {
				<div class="kv-list" style="margin-bottom:14px;">
					<div class="kv-row"><span>Business number</span><b class="mono">+{ data.Store.WhatsApp }</b></div>
					<div class="kv-row"><span>Chat link</span><a class="link mono" href={ templ.SafeURL("https://wa.me/" + data.Store.WhatsApp) } target="_blank" rel="noopener">{ "wa.me/" + data.Store.WhatsApp }</a></div>
				</div>
			} else {
				<p class="muted small-text" style="margin-bottom:12px;">Add your WhatsApp number in Settings so buyers can reach you.</p>
			}
			<h4 style="margin-bottom:4px;">Message preferences</h4>
			<p class="help" style="margin-bottom:8px;">
				if data.Nav.DemoData {
					Saved as preferences. Automatic sending needs the WhatsApp Business API connected, which isn't set up in this demo.
				} else {
					Automatic sending needs the WhatsApp Business API connected.
				}
			</p>
			<form hx-post="/channels/settings" hx-target="#tab-content">
				<label class="switch-row">
					<div><b>Send price list on request</b><span>Reply to "price" messages with your trade prices.</span></div>
					<input type="checkbox" name="autoQuote" value="on"/>
				</label>
				<label class="switch-row">
					<div><b>Attach invoice PDF to orders</b><span>With your bank details and payment reference.</span></div>
					<input type="checkbox" name="pdfInvoice" value="on" checked/>
				</label>
				<label class="switch-row">
					<div><b>Send a dispatch message</b><span>With the courier waybill when an order leaves.</span></div>
					<input type="checkbox" name="dispatchAlert" value="on" checked/>
				</label>
				<div style="text-align:right; margin-top:10px;"><button type="submit" class="btn solid small">Save preferences</button></div>
			</form>
		</article>
		<article class="card panel">
			<div class="panel-head">
				<div>
					<h3>Your Shoppage store</h3>
					<div class="sub">Works as your website if you don't have one.</div>
				</div>
			</div>
			<div class="kv-list">
				<div class="kv-row"><span>Store address</span><a class="link mono" href={ templ.SafeURL(storeLink(data)) } target="_blank" rel="noopener">{ storeLink(data) }</a></div>
				<div class="kv-row"><span>Products listed</span><b>{ fmt.Sprintf("%d of %d", channelListed(data, models.ChannelShoppage), len(data.Catalog)) }</b></div>
			</div>
			<button type="button" class="btn ghost small" style="margin-top:12px;" data-copy={ storeLink(data) }>Copy store link</button>
			if strings.Contains(data.Nav.PublicBaseURL, "localhost") {
				<div class="notice warn" style="margin-top:12px;">Links point at localhost. Set SHOPPAGE_PUBLIC_URL before sharing them.</div>
			}
		</article>
	</div>
	<section class="card panel section">
		<div class="panel-head">
			<div>
				<h3>Add Shoppage to your website and email</h3>
				<div class="sub">Copy a snippet and paste it into your site builder or email signature settings.</div>
			</div>
		</div>
		<div class="three-col">
			<div class="stack" style="gap:8px;">
				<b>Badge for your website</b>
				<div class="card" style="padding:12px; display:grid; place-items:center; background:var(--surface-2);">
					<img src={ publicBase(data) + "/badges/find-us-on-shoppage.svg" } alt="Find us on Shoppage" height="40"/>
				</div>
				<button type="button" class="btn ghost small" data-copy={ badgeSnippet(data, "find-us-on-shoppage", "Find us on Shoppage") }>Copy badge HTML</button>
				if data.Store.VerificationStatus == "fully_verified" {
					<button type="button" class="btn quiet small" data-copy={ badgeSnippet(data, "verified-merchant", "Verified merchant on Shoppage") }>Copy "verified merchant" badge</button>
				}
			</div>
			<div class="stack" style="gap:8px;">
				<b>Live catalogue on your site</b>
				<label class="sr-only" for="embed-code">Embed code</label>
				<textarea id="embed-code" class="textarea mono" readonly rows="4" style="font-size:var(--fs-12);">{ embedSnippet(data) }</textarea>
				<button type="button" class="btn ghost small" data-copy={ embedSnippet(data) }>Copy embed code</button>
			</div>
			<div class="stack" style="gap:8px;">
				<b>Email signature</b>
				<div class="card" style="padding:12px; font-size:var(--fs-13); background:var(--surface-2);">
					<b>{ data.Store.Name }</b>
					<div class="small-text muted">{ data.Store.Phone } · { data.Store.Email }</div>
				</div>
				<button type="button" class="btn ghost small" data-copy={ signatureSnippet(data) }>Copy signature HTML</button>
			</div>
		</div>
	</section>
}
