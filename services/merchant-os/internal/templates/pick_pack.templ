package templates

import (
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

func ordersToPack(orders []models.ProformaOrder) []models.ProformaOrder {
	var out []models.ProformaOrder
	for _, o := range orders {
		switch strings.ToLower(o.Status) {
		case "confirmed", "paid", "packed":
			out = append(out, o)
		}
	}
	return out
}

func unitsToPick(orders []models.ProformaOrder) int {
	n := 0
	for _, o := range orders {
		for _, ln := range o.LineItems {
			n += ln.Quantity
		}
	}
	return n
}

func catalogFor(catalog []models.CatalogSKU, sku string) models.CatalogSKU {
	for _, p := range catalog {
		if strings.EqualFold(p.SKU, sku) {
			return p
		}
	}
	return models.CatalogSKU{}
}

// PickPackTab lists paid orders to pick. Scanning a line's barcode ticks it;
// when every line is ticked the order can be marked dispatched, which takes
// the units out of stock.
templ PickPackTab(data models.DashboardViewData) {
	{{ orders := ordersToPack(data.Orders) }}
	<div class="page-head">
		<div class="head-copy">
			<p>{ fmt.Sprintf("%d %s to pack · %s units to pick · %d awaiting payment", len(orders), Plural(len(orders), "order", "orders"), Int(unitsToPick(orders)), data.Metrics.AwaitingPayment) }</p>
		</div>
		<div class="actions">
			<button type="button" class="btn ghost" onclick="window.print()" disabled?={ len(orders) == 0 }>Print pick lists</button>
		</div>
	</div>
	if len(orders) == 0 {
		<div class="card empty">
			<div class="empty-icon">
				@IconSized("check", 22)
			</div>
			<h3>Nothing to pack</h3>
			<p>Paid orders appear here, ready to pick.</p>
			<a class="btn ghost" href="/tab/orders?view=awaiting_payment" hx-get="/tab/orders?view=awaiting_payment" hx-target="#tab-content" hx-push-url="true">See orders awaiting payment</a>
		</div>
	}
	for _, o := range orders {
		<section class="card section" data-pick-order={ o.ID }>
			<div class="panel" style="border-bottom:1px solid var(--line);">
				<div class="panel-head" style="margin:0;">
					<div>
						<h3>{ o.OrderNumber } · { o.Company }</h3>
						<div class="sub">
							{ orDash(o.Customer) }
							if o.Phone != "" {
								· { o.Phone }
							}
							if o.Address != "" {
								· { o.Address }
							}
						</div>
					</div>
					<div class="right">
						<span class={ OrderStatusClass(o.Status) }>{ OrderStatusLabel(o.Status) }</span>
					</div>
				</div>
				<div class="cluster" style="margin-top:12px;">
					<label class="sr-only" for={ "pick-scan-" + o.ID }>Scan to tick a line</label>
					<input class="input mono" id={ "pick-scan-" + o.ID } data-pick-scan type="search" placeholder="Scan a barcode to tick it off" style="flex:1 1 240px;" autocomplete="off"/>
					<span class="small-text muted" data-pick-progress>{ fmt.Sprintf("0 of %d lines picked", len(o.LineItems)) }</span>
				</div>
			</div>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Picked</th>
							<th>Product</th>
							<th>Barcode</th>
							<th class="r">Pick</th>
							<th class="r">On hand</th>
						</tr>
					</thead>
					<tbody>
						for _, ln := range o.LineItems {
							{{ p := catalogFor(data.Catalog, ln.SKU) }}
							<tr data-pick-line data-sku={ strings.ToLower(ln.SKU) } data-barcode={ p.Spec.Barcode }>
								<td><input type="checkbox" data-pick-check aria-label={ "Picked " + ln.SKU }/></td>
								<td><span class="mono">{ ln.SKU }</span><div class="small-text muted">{ ln.Title }</div></td>
								<td class="mono small-text">{ orDash(p.Spec.Barcode) }</td>
								<td class="r num"><b>{ Int(ln.Quantity) }</b></td>
								<td class="r num">
									{ Int(p.StockQuantity) }
									if p.StockQuantity < ln.Quantity {
										<div><span class="chip bad">Short</span></div>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="panel cluster" style="justify-content:flex-end; border-top:1px solid var(--line);">
				<button type="button" class="btn ghost small" hx-get={ "/orders/" + o.ID + "/invoice" } hx-target="#modal-container">Invoice</button>
				<button type="button" class="btn solid small" data-pick-done disabled hx-post={ "/orders/" + o.ID + "/advance-status" } hx-target="#tab-content">Packed · mark dispatched</button>
			</div>
		</section>
	}
	<script>
		document.querySelectorAll('[data-pick-order]').forEach(function (card) {
			var lines = Array.prototype.slice.call(card.querySelectorAll('[data-pick-line]'));
			var done = card.querySelector('[data-pick-done]');
			var progress = card.querySelector('[data-pick-progress]');
			function update() {
				var n = lines.filter(function (l) { return l.querySelector('[data-pick-check]').checked; }).length;
				progress.textContent = n + ' of ' + lines.length + ' lines picked';
				done.disabled = n < lines.length;
			}
			lines.forEach(function (l) { l.querySelector('[data-pick-check]').addEventListener('change', update); });
			card.querySelector('[data-pick-scan]').addEventListener('keydown', function (e) {
				if (e.key !== 'Enter') return;
				e.preventDefault();
				var v = this.value.trim().toLowerCase();
				var hit = lines.find(function (l) { return l.dataset.barcode === v || l.dataset.sku === v; });
				if (hit) { hit.querySelector('[data-pick-check]').checked = true; update(); }
				else if (window.showToast) showToast('"' + this.value + '" is not on this order.');
				this.value = '';
			});
			update();
		});
	</script>
}
