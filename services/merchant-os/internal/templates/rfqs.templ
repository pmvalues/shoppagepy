package templates

import (
	"encoding/json"
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

func leadProduct(catalog []models.CatalogSKU, l models.RFQLead) models.CatalogSKU {
	if l.SKU != "" {
		return catalogFor(catalog, l.SKU)
	}
	want := strings.ToLower(l.ItemRequested)
	for _, p := range catalog {
		if strings.Contains(strings.ToLower(p.Title), want) || strings.Contains(want, strings.ToLower(p.Title)) {
			return p
		}
	}
	return models.CatalogSKU{}
}

func leadStatus(s string) (string, string) {
	switch s {
	case "new":
		return "New enquiry", "status warn"
	case "quoted":
		return "Quote sent", "status info"
	case "accepted", "completed", "converted":
		return "Won · order created", "status ok"
	case "lost":
		return "Lost", "status bad"
	}
	return s, "status"
}

func quoteMessage(l models.RFQLead, store models.StoreProfile) string {
	if l.Status != "quoted" {
		return fmt.Sprintf("Hi %s, thanks for your enquiry about %d × %s. ", l.BuyerName, l.Quantity, l.ItemRequested)
	}
	return fmt.Sprintf("Hi %s, here's our quote: %d × %s at %s each%s. Total %s incl. VAT, valid until %s. Reply YES to confirm and we'll send the invoice. %s",
		l.BuyerName, l.Quantity, l.ItemRequested, models.FormatZAR(l.QuotedUnitZar), deliveryText(l.DeliveryZar),
		models.FormatZAR(l.EstimatedTotal), LocalDate(l.ValidUntil), store.Name)
}

func deliveryText(d float64) string {
	if d <= 0 {
		return ", collection or free delivery"
	}
	return " plus " + models.FormatZAR(d) + " delivery"
}

// RFQsTab is the quote desk: enquiries in, priced quotes out (from the
// catalogue and the merchant's own volume tiers), then one click to an order.
templ RFQsTab(data models.DashboardViewData) {
	{{ m := data.Metrics }}
	<div class="page-head">
		<div class="head-copy">
			<p>{ fmt.Sprintf("%d open, worth about %s. %d of %d won.", m.OpenQuotes, ZARWhole(m.QuotePipelineZar), m.QuotesWon, m.QuotesTotal) }</p>
		</div>
		<div class="actions">
			<a class="btn ghost" href="/tab/discounts" hx-get="/tab/discounts" hx-target="#tab-content" hx-push-url="true">Volume price tiers</a>
		</div>
	</div>
	if len(data.Leads) == 0 {
		<div class="card empty">
			<h3>No enquiries yet</h3>
			<p>When buyers ask for a price on Shoppage or WhatsApp, the enquiry lands here.</p>
		</div>
	}
	<div class="stack">
		for _, l := range data.Leads {
			{{ label, cls := leadStatus(l.Status) }}
			{{ p := leadProduct(data.Catalog, l) }}
			<article class="card panel">
				<div class="panel-head" style="margin-bottom:8px;">
					<div class="who">
						<span class="av" aria-hidden="true">{ Initials(l.BuyerName) }</span>
						<div>
							<b>{ l.BuyerName }</b>
							<span>{ l.BuyerCompany } · { l.BuyerCity } · { Ago(l.ReceivedAt, m.Now) }</span>
						</div>
					</div>
					<div class="right"><span class={ cls }>{ label }</span></div>
				</div>
				<p style="margin-bottom:10px;">
					<b>{ fmt.Sprintf("%s × ", Int(l.Quantity)) }{ l.ItemRequested }</b>
					if l.Status == "quoted" && !l.ValidUntil.IsZero() {
						<span class="muted"> · quoted { ZAR(l.EstimatedTotal) } incl. VAT, valid until { LocalDate(l.ValidUntil) }</span>
					} else {
						<span class="muted"> · about { ZAR(l.EstimatedTotal) }</span>
					}
				</p>
				<div class="cluster">
					if l.Status == "new" || l.Status == "quoted" {
						<button type="button" class="btn solid small" onclick={ openDialog("quote-" + l.ID) }>
							if l.Status == "new" {
								Build quote
							} else {
								Revise quote
							}
						</button>
					}
					if l.BuyerPhone != "" {
						<a class="btn ghost small" target="_blank" rel="noopener" href={ templ.SafeURL(waLink(l.BuyerPhone, quoteMessage(l, data.Store))) }>
							if l.Status == "quoted" {
								Send quote on WhatsApp
							} else {
								WhatsApp
							}
						</a>
					}
					if l.Status == "quoted" {
						<button type="button" class="btn ghost small" hx-post={ "/rfqs/" + l.ID + "/convert" } hx-target="#tab-content" hx-confirm={ "Create an order for " + l.BuyerCompany + " at the quoted price?" }>Buyer accepted · create order</button>
					}
				</div>
			</article>
			if l.Status == "new" || l.Status == "quoted" {
				@QuoteBuilder(data, l, p)
			}
		}
	</div>
}

// QuoteBuilder prices a quote from the catalogue price and the merchant's
// volume tiers; the merchant can override the unit price.
templ QuoteBuilder(data models.DashboardViewData, l models.RFQLead, p models.CatalogSKU) {
	<dialog id={ "quote-" + l.ID } class="modal-dialog" aria-label={ "Quote for " + l.BuyerCompany }>
		<div class="modal-card">
			<div class="modal-head">
				<h3>Quote for { l.BuyerCompany }</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post={ "/rfqs/" + l.ID + "/quote" } hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()" data-quote data-tiers={ tiersJSON(data.WholesaleTiers) }>
				<div class="modal-body">
					<div class="two-col">
						<div class="form-group">
							<label for={ "q-sku-" + l.ID }>Product</label>
							<select id={ "q-sku-" + l.ID } name="skuId" class="select-full" data-q-sku>
								for _, c := range data.Catalog {
									<option value={ c.ID } data-price={ fmt.Sprintf("%.2f", c.WholesaleZar) } data-stock={ fmt.Sprint(c.StockQuantity) } selected?={ c.ID == p.ID }>{ c.Title } · { ZAR(c.WholesaleZar) }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for={ "q-qty-" + l.ID }>Quantity</label>
							<input id={ "q-qty-" + l.ID } type="number" name="quantity" class="input" min="1" value={ fmt.Sprint(l.Quantity) } data-q-qty required/>
							<p class="help" data-q-stock></p>
						</div>
					</div>
					<div class="three-col">
						<div class="form-group">
							<label for={ "q-unit-" + l.ID }>Unit price (excl. VAT)</label>
							<input id={ "q-unit-" + l.ID } type="number" name="unitPrice" class="input money" min="0.01" step="0.01" data-q-unit required/>
							<p class="help" data-q-tier></p>
						</div>
						<div class="form-group">
							<label for={ "q-del-" + l.ID }>Delivery (excl. VAT)</label>
							<input id={ "q-del-" + l.ID } type="number" name="delivery" class="input money" min="0" step="0.01" value={ fmt.Sprintf("%.2f", l.DeliveryZar) } data-q-del/>
						</div>
						<div class="form-group">
							<label for={ "q-days-" + l.ID }>Valid for</label>
							<select id={ "q-days-" + l.ID } name="validDays" class="select-full">
								<option value="3">3 days</option>
								<option value="7" selected>7 days</option>
								<option value="14">14 days</option>
								<option value="30">30 days</option>
							</select>
						</div>
					</div>
					<div class="kv-list card" style="padding:12px; background:var(--surface-2);">
						<div class="kv-row"><span>Goods</span><b class="num" data-q-goods></b></div>
						<div class="kv-row"><span>Delivery</span><b class="num" data-q-delv></b></div>
						<div class="kv-row"><span>VAT (15%)</span><b class="num" data-q-vat></b></div>
						<div class="kv-row" style="font-size:var(--fs-18);"><span style="color:var(--ink); font-weight:700;">Total</span><b class="num" data-q-total></b></div>
					</div>
					<p class="help">The price is held until the quote expires and used as-is when the buyer accepts.</p>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Save quote</button>
				</div>
			</form>
		</div>
	</dialog>
	<script>
		(function () {
			var form = document.currentScript.previousElementSibling.querySelector('[data-quote]');
			if (!form) return;
			var tiers = JSON.parse(form.dataset.tiers || '[]');
			var q = function (sel) { return form.querySelector(sel); };
			var fmtR = function (v) { return 'R ' + v.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ' '); };
			var touched = false;
			function tierFor(n) { var best = null; tiers.forEach(function (t) { if (n >= t.min && (t.max === 0 || n <= t.max) && (!best || t.pct > best.pct)) best = t; }); return best; }
			function recalc(fromUnit) {
				var opt = q('[data-q-sku]').selectedOptions[0];
				var list = parseFloat(opt.dataset.price), stock = parseInt(opt.dataset.stock, 10), n = parseInt(q('[data-q-qty]').value, 10) || 0;
				var t = tierFor(n);
				if (!fromUnit && !touched) q('[data-q-unit]').value = (list * (1 - (t ? t.pct : 0) / 100)).toFixed(2);
				q('[data-q-tier]').textContent = t ? t.name + ': ' + t.pct + '% off ' + fmtR(list) : 'Your list price ' + fmtR(list);
				q('[data-q-stock]').textContent = n > stock ? 'Only ' + stock + ' in stock' : stock + ' in stock';
				var unit = parseFloat(q('[data-q-unit]').value) || 0, del = parseFloat(q('[data-q-del]').value) || 0;
				var goods = unit * n, vat = (goods + del) * 0.15;
				q('[data-q-goods]').textContent = fmtR(goods);
				q('[data-q-delv]').textContent = fmtR(del);
				q('[data-q-vat]').textContent = fmtR(vat);
				q('[data-q-total]').textContent = fmtR(goods + del + vat);
			}
			q('[data-q-sku]').onchange = function () { touched = false; recalc(); };
			q('[data-q-qty]').oninput = function () { recalc(); };
			q('[data-q-unit]').oninput = function () { touched = true; recalc(true); };
			q('[data-q-del]').oninput = function () { recalc(true); };
			recalc();
		})();
	</script>
}

func tiersJSON(ts []models.WholesaleTier) string {
	type t struct {
		Min  int     `json:"min"`
		Max  int     `json:"max"`
		Pct  float64 `json:"pct"`
		Name string  `json:"name"`
	}
	out := make([]t, 0, len(ts))
	for _, x := range ts {
		out = append(out, t{x.MinUnits, x.MaxUnits, x.DiscountPct, x.TierName})
	}
	b, _ := json.Marshal(out)
	return string(b)
}
