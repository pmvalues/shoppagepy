package templates

import (
	"fmt"
	"github.com/shoppage/merchant-os/internal/models"
)

templ Layout(store models.StoreProfile, activeTab string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Shoppage Merchant OS — Enterprise SME B2B catalog, orders, WMS, POS, GMV threshold, and Pemofy AI copilot."/>
			<title>{ store.Name } — Shoppage Merchant OS</title>
			<!-- Google Fonts: Bricolage Grotesque & Instrument Sans & JetBrains Mono -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet"/>
			<!-- HTMX 2.0.2 -->
			<script src="https://unpkg.com/htmx.org@2.0.2"></script>
			<style>
				:root {
					--bg: #edf1ec;
					--surface: #ffffff;
					--surface-2: #f5f7f4;
					--sidebar: #0a2f24;
					--sidebar-2: #0d3a2c;
					--ink: #0d1c15;
					--ink-2: #37473e;
					--muted: #6b7a71;
					--primary: #0e7c56;
					--primary-2: #0a5c40;
					--primary-soft: #dcefe4;
					--amber: #c47c14;
					--amber-soft: #faecd3;
					--rose: #b5483a;
					--rose-soft: #f7e2de;
					--line: rgba(13,28,21,.10);
					--line-strong: rgba(13,28,21,.20);
					--display: "Bricolage Grotesque", -apple-system, BlinkMacSystemFont, sans-serif;
					--body: "Instrument Sans", -apple-system, BlinkMacSystemFont, sans-serif;
					--mono: "JetBrains Mono", ui-monospace, monospace;
					--r-sm: 8px; --r: 12px; --r-lg: 18px;
					--sh-sm: 0 1px 2px rgba(13,28,21,.05);
					--sh: 0 1px 2px rgba(13,28,21,.05), 0 12px 28px -18px rgba(13,28,21,.30);
					--shadow-side: 8px 0 30px -22px rgba(13,28,21,.55);
					--nav-w: 260px;
				}
				* { box-sizing: border-box; }
				html, body { margin: 0; padding: 0; min-height: 100%; }
				body {
					background: var(--bg);
					color: var(--ink);
					font-family: var(--body);
					font-size: 14px;
					line-height: 1.5;
					-webkit-font-smoothing: antialiased;
				}
				h1, h2, h3, h4 {
					font-family: var(--display);
					margin: 0;
					letter-spacing: -.025em;
					line-height: 1.15;
					font-weight: 700;
				}
				a { color: inherit; text-decoration: none; }
				button, input, select, textarea { font: inherit; }
				button { cursor: pointer; }
				.app {
					display: grid;
					grid-template-columns: var(--nav-w) 1fr;
					min-height: 100vh;
					transition: grid-template-columns .2s;
				}
				.app.collapsed {
					grid-template-columns: 68px 1fr;
				}

				/* SIDEBAR */
				.side {
					background: var(--sidebar);
					color: #dbe8e0;
					padding: 16px 10px;
					display: flex;
					flex-direction: column;
					gap: 3px;
					box-shadow: var(--shadow-side);
					position: sticky;
					top: 0;
					height: 100vh;
					overflow-y: auto;
				}
				.brand {
					display: flex;
					align-items: center;
					gap: 10px;
					padding: 4px 8px 12px;
					color: #fff;
					font-family: var(--display);
					font-weight: 800;
					font-size: 18px;
					letter-spacing: -.04em;
				}
				.brand .mark {
					width: 32px;
					height: 32px;
					border-radius: 9px;
					background: var(--primary);
					display: grid;
					place-items: center;
					flex: none;
				}
				.store-switch {
					display: flex;
					align-items: center;
					gap: 10px;
					background: var(--sidebar-2);
					border: 1px solid rgba(255,255,255,.10);
					border-radius: var(--r);
					padding: 8px 10px;
					margin-bottom: 8px;
				}
				.store-switch .av {
					width: 30px;
					height: 30px;
					border-radius: 8px;
					background: linear-gradient(135deg, #0e7c56, #3fb886);
					display: grid;
					place-items: center;
					color: #fff;
					font-family: var(--display);
					font-weight: 700;
					font-size: 13px;
					flex: none;
				}
				.store-switch .meta { min-width: 0; }
				.store-switch .meta b {
					display: block;
					color: #fff;
					font-size: 12px;
					font-weight: 600;
					white-space: nowrap;
					overflow: hidden;
					text-overflow: ellipsis;
				}
				.store-switch .meta span {
					font-size: 10.5px;
					color: #8fb3a3;
					display: flex;
					align-items: center;
					gap: 4px;
				}
				.live-dot {
					width: 6px;
					height: 6px;
					border-radius: 50%;
					background: #4fe0a4;
					box-shadow: 0 0 0 3px rgba(79,224,164,.25);
				}
				.nav-label {
					font-size: 9.5px;
					text-transform: uppercase;
					letter-spacing: .14em;
					color: #6f9384;
					padding: 10px 8px 3px;
					font-weight: 700;
				}
				.nav-item {
					display: flex;
					align-items: center;
					gap: 10px;
					padding: 6px 10px;
					border-radius: 8px;
					font-size: 12.5px;
					color: #c4d7cd;
					font-weight: 500;
					border: 0;
					background: transparent;
					width: 100%;
					text-align: left;
					transition: all .15s;
					cursor: pointer;
					white-space: nowrap;
				}
				.nav-item:hover {
					background: rgba(255,255,255,.07);
					color: #fff;
				}
				.nav-item.active {
					background: var(--primary);
					color: #fff;
					font-weight: 600;
				}
				.nav-item .badge {
					margin-left: auto;
					background: rgba(255,255,255,.14);
					color: #fff;
					font-size: 10px;
					font-weight: 600;
					padding: 1px 6px;
					border-radius: 999px;
				}
				.nav-item .badge.warn {
					background: var(--amber);
					color: #3a2600;
				}
				.side-collapse-btn {
					margin-left: auto;
					background: transparent;
					border: 0;
					color: #8fb3a3;
					cursor: pointer;
					display: inline-flex;
					align-items: center;
					justify-content: center;
					width: 26px;
					height: 26px;
					border-radius: 6px;
					transition: all .15s;
					padding: 0;
					flex: none;
				}
				.side-collapse-btn:hover {
					background: rgba(255,255,255,.12);
					color: #fff;
				}
				.side-collapse-btn svg {
					transition: transform .2s ease;
				}
				.app.collapsed .side-collapse-btn {
					margin-left: 0;
				}
				.app.collapsed .side-collapse-btn svg {
					transform: rotate(180deg);
				}
				.app.collapsed {
					grid-template-columns: 68px 1fr;
				}
				.app.collapsed .nav-item span:not(.icon-span), 
				.app.collapsed .nav-label, 
				.app.collapsed .store-switch .meta, 
				.app.collapsed .brand-text, 
				.app.collapsed .side-foot {
					display: none !important;
				}
				.app.collapsed .brand {
					flex-direction: column;
					gap: 6px;
					align-items: center;
					padding: 4px 0 12px;
				}
				.app.collapsed .nav-item {
					justify-content: center;
					padding: 10px 0;
				}
				.app.collapsed .store-switch {
					justify-content: center;
					padding: 6px;
				}
				.side-foot {
					margin-top: auto;
					padding-top: 14px;
				}
				.side-note {
					display: flex;
					gap: 8px;
					align-items: flex-start;
					font-size: 10.5px;
					color: #8fb3a3;
					background: var(--sidebar-2);
					border-radius: 9px;
					padding: 9px;
					line-height: 1.4;
				}

				/* THREAD & ROW SELECTION HIGHLIGHTS */
				.thread-item {
					transition: background .15s, border-left .15s;
				}
				.thread-item:hover {
					background: var(--surface-2);
				}
				.thread-item.active-thread, .thread-item.selected {
					background: var(--primary-soft) !important;
					border-left: 4px solid var(--primary) !important;
				}
				.view-switch button {
					border: 0;
					background: transparent;
					color: var(--muted);
					height: 29px;
					padding: 0 10px;
					border-radius: 7px;
					display: inline-flex;
					align-items: center;
					gap: 5px;
					font-weight: 500;
					font-size: 12.5px;
					cursor: pointer;
					transition: all .15s;
				}
				.view-switch button.active {
					background: var(--surface) !important;
					color: var(--primary-2) !important;
					font-weight: 700 !important;
					box-shadow: 0 1px 2px rgba(13,28,21,.08);
				}
				.filter-btn-group .btn.active {
					background: var(--primary) !important;
					color: #fff !important;
					border-color: var(--primary) !important;
					font-weight: 700;
				}

				/* PEMOFY PRODUCT DETAIL & EDIT STYLES */
				.breadcrumb { display: flex; gap: 7px; align-items: center; color: var(--muted); font-size: 12.5px; margin-bottom: 12px; }
				.breadcrumb a { color: var(--primary-2); font-weight: 600; text-decoration: none; }
				.breadcrumb a:hover { text-decoration: underline; }
				.breadcrumb svg { width: 14px; height: 14px; }
				.detail-head { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 18px; flex-wrap: wrap; }
				.detail-head .head-copy { min-width: 0; }
				.detail-head h1, .detail-head h2 { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; font-size: clamp(1.25rem, 1.8vw, 1.55rem); }
				.detail-head p { color: var(--muted); margin: 4px 0 0; font-size: 12.5px; }
				.detail-actions { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }
				.detail-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 14px; margin-bottom: 14px; }
				.gallery-card { padding: 14px; }
				.gallery-main { height: 310px; border-radius: 13px; position: relative; display: grid; place-items: center; overflow: hidden; background: linear-gradient(135deg, #dcefe4, #8fbea5); }
				.gallery-main .g-stamp { position: absolute; bottom: 14px; left: 16px; color: rgba(13,28,21,.45); font-family: var(--display); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
				.gallery-thumbs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 7px; margin-top: 8px; }
				.thumb { height: 56px; border-radius: 8px; border: 2px solid transparent; position: relative; overflow: hidden; cursor: pointer; display: grid; place-items: center; font-size: 18px; background: var(--surface-2); transition: border-color .15s; }
				.thumb.active { border-color: var(--primary); }
				.info-card { padding: 18px; }
				.price-line { display: flex; align-items: baseline; gap: 10px; margin-top: 5px; flex-wrap: wrap; }
				.price-line .large-price { font-family: var(--display); font-size: 2.1rem; font-weight: 800; letter-spacing: -.05em; color: var(--primary-2); }
				.price-line .compare { text-decoration: line-through; color: var(--muted); font-size: 13px; }
				.description { color: var(--ink-2); font-size: 13.5px; line-height: 1.6; margin: 14px 0 16px; }
				.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
				.info-cell { border: 1px solid var(--line); background: var(--surface-2); border-radius: 9px; padding: 10px; }
				.info-cell label { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 700; }
				.info-cell b { display: block; margin-top: 3px; font-family: var(--display); font-size: 15px; }
				.progress { height: 7px; border-radius: 99px; background: rgba(13,28,21,.08); overflow: hidden; margin-top: 7px; }
				.progress span { height: 100%; display: block; background: var(--primary); border-radius: 99px; }
				.info-note { display: flex; gap: 8px; align-items: flex-start; border-top: 1px solid var(--line); padding-top: 12px; color: var(--muted); font-size: 12px; }
				.info-note svg { width: 16px; height: 16px; color: var(--primary); flex: none; margin-top: 2px; }
				.detail-lower { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
				.panel-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
				.panel-title h3 { font-size: 14.5px; margin: 0; }
				.kv-list { display: grid; gap: 8px; }
				.kv-row { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 7px; font-size: 12px; }
				.kv-row:last-child { border-bottom: 0; }
				.kv-row span { color: var(--muted); }
				.kv-row b { font-weight: 600; text-align: right; }
				.tag-list { display: flex; gap: 6px; flex-wrap: wrap; }
				.tag-list span { font-size: 11px; padding: 4px 8px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 6px; color: var(--ink-2); }
				.seo-score { display: flex; align-items: center; gap: 12px; }
				.score-ring { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; position: relative; flex: none; }
				.score-ring::after { content: ""; position: absolute; inset: 6px; background: var(--surface); border-radius: 50%; }
				.score-ring b { position: relative; z-index: 1; font-family: var(--display); font-size: 14px; }
				.activity { display: grid; gap: 9px; }
				.activity-row { display: flex; gap: 8px; font-size: 11.5px; }
				.activity-row .time { margin-left: auto; color: var(--muted); white-space: nowrap; }
				.activity-row .bullet { width: 7px; height: 7px; border-radius: 50%; background: var(--primary); margin-top: 5px; flex: none; }
				.activity-row .bullet.amber { background: var(--amber); }

				/* EDITOR STYLES */
				.editor-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
				.editor-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin-bottom: 14px; overflow-x: auto; }
				.editor-tabs button { border: 0; background: transparent; padding: 9px 14px; color: var(--muted); font-weight: 600; font-size: 13px; border-bottom: 2px solid transparent; cursor: pointer; white-space: nowrap; }
				.editor-tabs button.active { color: var(--primary-2); border-color: var(--primary); }
				.editor-grid { display: grid; grid-template-columns: 1.22fr .78fr; gap: 14px; }
				.form-card { padding: 18px; }
				.form-label { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; margin-bottom: 6px; }
				.form-label label { font-size: 12.5px; font-weight: 700; color: var(--ink); }
				.form-label span { font-size: 11px; color: var(--muted); }
				.rich { border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden; }
				.rich-tools { display: flex; gap: 2px; padding: 5px 6px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
				.rich-tools button { border: 0; background: transparent; border-radius: 4px; padding: 3px 7px; color: var(--ink-2); font-weight: 700; font-size: 11.5px; cursor: pointer; }
				.rich-tools button:hover { background: var(--surface); }
				.rich .textarea { border: 0; border-radius: 0; display: block; width: 100%; }
				.help { font-size: 11px; color: var(--muted); margin-top: 4px; }
				.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--line); }
				.switch-row:last-child { border-bottom: 0; }
				.switch-row b { display: block; font-size: 12.5px; }
				.switch-row span { display: block; color: var(--muted); font-size: 11px; margin-top: 1px; }
				.toggle { width: 38px; height: 21px; border-radius: 99px; background: var(--line-strong); padding: 2px; border: 0; flex: none; cursor: pointer; position: relative; transition: background .2s; }
				.toggle::after { content: ""; display: block; width: 17px; height: 17px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.15); transition: transform .2s; }
				.toggle.on { background: var(--primary); }
				.toggle.on::after { transform: translateX(17px); }
				.media-drop { border: 1.5px dashed var(--line-strong); border-radius: 10px; min-height: 115px; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 5px; background: var(--surface-2); color: var(--muted); text-align: center; padding: 12px; cursor: pointer; }
				.media-drop svg { width: 22px; height: 22px; color: var(--primary); }
				.media-drop b { font-size: 12.5px; color: var(--ink-2); }
				.media-drop span { font-size: 11px; }
				.media-current { display: flex; gap: 8px; margin-top: 9px; align-items: center; }
				.publish-card { background: var(--sidebar); color: #dbe8e0; border-radius: var(--r-lg); padding: 16px; }
				.publish-card h3 { color: #fff; font-size: 14.5px; margin: 0 0 4px; }
				.publish-card p { color: #9fc2b3; font-size: 11.5px; margin: 0 0 12px; }
				.publish-card .btn { width: 100%; margin-bottom: 8px; }
				.publish-card .btn:last-child { margin-bottom: 0; }
				.publish-card .btn.light { background: #fff; color: var(--primary-2); font-weight: 700; border: 0; }
				.publish-card .btn.light:hover { background: #eef5f1; }
				.publish-card .btn.line { border-color: rgba(255,255,255,.25); color: #fff; background: transparent; }
				.publish-card .btn.line:hover { background: rgba(255,255,255,.08); }
				.side-form { display: grid; gap: 14px; }
				.side-form .card { padding: 16px; }
				.side-form h3 { font-size: 14px; margin: 0 0 10px; }
				.alert { display: flex; gap: 8px; padding: 9px 11px; border-radius: 8px; background: var(--amber-soft); color: #7a4e05; font-size: 11.5px; align-items: flex-start; }
				.alert svg { width: 15px; height: 15px; flex: none; margin-top: 1px; }

				/* MAIN CONTENT */
				.main {
					padding: 18px clamp(14px, 2.5vw, 28px) 36px;
					max-width: 1440px;
					width: 100%;
				}
				.topbar {
					display: flex;
					align-items: center;
					gap: 12px;
					flex-wrap: wrap;
					margin-bottom: 18px;
				}
				.greet h1 { font-size: clamp(1.25rem, 1.8vw, 1.55rem); }
				.greet p { margin: 2px 0 0; color: var(--muted); font-size: 12px; }
				.top-tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
				
				.omni-btn {
					display: flex;
					align-items: center;
					gap: 8px;
					background: var(--surface);
					border: 1px solid var(--line);
					border-radius: 999px;
					padding: 6px 14px;
					color: var(--muted);
					font-size: 12.5px;
					box-shadow: var(--sh-sm);
					cursor: pointer;
				}
				.omni-btn:hover {
					border-color: var(--line-strong);
					color: var(--ink);
				}
				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: 6px;
					font-weight: 600;
					font-size: 12.5px;
					padding: 7px 13px;
					border-radius: 8px;
					border: 1px solid transparent;
					cursor: pointer;
					white-space: nowrap;
					transition: all .15s;
				}
				.btn.solid {
					background: var(--primary);
					color: #fff;
					box-shadow: var(--sh-sm);
				}
				.btn.solid:hover { background: var(--primary-2); }
				.btn.ghost {
					background: var(--surface);
					border-color: var(--line);
					color: var(--ink);
				}
				.btn.ghost:hover { border-color: var(--line-strong); }
				.btn.dark {
					background: var(--sidebar);
					color: #fff;
				}
				.btn.dark:hover { background: var(--sidebar-2); }
				.btn.small {
					padding: 4px 8px;
					font-size: 11px;
					border-radius: 6px;
				}

				/* CARDS & PANELS */
				.card {
					background: var(--surface);
					border: 1px solid var(--line);
					border-radius: var(--r-lg);
					box-shadow: var(--sh);
				}
				.panel { padding: 18px; }
				.panel-head {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 10px;
					margin-bottom: 14px;
				}
				.panel-head h3 { font-size: 16px; }
				.panel-head .sub { font-size: 12px; color: var(--muted); margin-top: 1px; }

				.grid-kpi {
					display: grid;
					grid-template-columns: repeat(4, 1fr);
					gap: 12px;
				}
				.kpi { padding: 14px 16px; }
				.kpi .k-label {
					display: flex;
					align-items: center;
					justify-content: space-between;
					font-size: 11.5px;
					color: var(--muted);
					font-weight: 600;
				}
				.kpi .k-val {
					font-family: var(--display);
					font-weight: 800;
					font-size: clamp(1.4rem, 2vw, 1.8rem);
					letter-spacing: -.04em;
					margin: 6px 0 2px;
				}
				.kpi .k-val .sub { font-size: .85rem; font-weight: 600; color: var(--muted); }
				.kpi .k-foot {
					display: flex;
					align-items: center;
					gap: 6px;
					font-size: 11.5px;
					margin-top: 4px;
				}
				.k-foot .then { color: var(--muted); }

				.chip {
					display: inline-flex;
					align-items: center;
					gap: 3px;
					font-size: 11px;
					font-weight: 700;
					padding: 2px 7px;
					border-radius: 999px;
				}
				.chip.up { background: var(--primary-soft); color: var(--primary-2); }
				.chip.down { background: var(--rose-soft); color: var(--rose); }
				.chip.warn { background: var(--amber-soft); color: #7a4e05; }
				.chip.flat { background: var(--surface-2); color: var(--muted); }

				.meter-card {
					padding: 18px;
					background: linear-gradient(140deg, var(--sidebar), #12513c);
					border: 1px solid rgba(255,255,255,.08);
					color: #dbe8e0;
				}
				.meter-card h3 { color: #fff; font-size: 15.5px; }
				.meter-card .sub { color: #9fc2b3; font-size: 12px; margin-top: 2px; }
				.meter-top {
					display: flex;
					align-items: flex-end;
					gap: 12px;
					flex-wrap: wrap;
					margin: 14px 0 4px;
				}
				.meter-big {
					font-family: var(--display);
					font-weight: 800;
					font-size: clamp(1.5rem, 2.2vw, 2rem);
					letter-spacing: -.04em;
					color: #fff;
					line-height: 1;
				}
				.meter-big .t { font-size: 1rem; color: #9fc2b3; font-weight: 600; }
				.meter-flag { margin-left: auto; text-align: right; }
				.meter-flag b { display: block; color: #4fe0a4; font-family: var(--display); font-weight: 700; font-size: 14px; }
				.meter-flag span { font-size: 11.5px; color: #9fc2b3; }
				.bar {
					height: 12px;
					border-radius: 999px;
					background: rgba(255,255,255,.12);
					overflow: hidden;
					margin-top: 12px;
					position: relative;
				}
				.bar .fill {
					height: 100%;
					background: linear-gradient(90deg, #3fb886, #5fe0a4);
					border-radius: 999px;
				}
				.meter-scale {
					display: flex;
					justify-content: space-between;
					font-size: 11px;
					color: #9fc2b3;
					margin-top: 6px;
				}
				.meter-scale b { color: #e4f0ea; font-weight: 600; }

				.row-2 {
					display: grid;
					grid-template-columns: 1.5fr 1fr;
					gap: 14px;
					margin-bottom: 14px;
				}
				.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
				.three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }

				.table-wrap { overflow-x: auto; width: 100%; }
				.table {
					width: 100%;
					border-collapse: collapse;
					font-size: 13px;
				}
				.table th {
					text-align: left;
					padding: 10px 14px;
					font-size: 11px;
					text-transform: uppercase;
					letter-spacing: .06em;
					color: var(--muted);
					border-bottom: 1px solid var(--line);
					background: var(--surface-2);
					font-weight: 700;
				}
				.table td {
					padding: 10px 14px;
					border-bottom: 1px solid var(--line);
					vertical-align: middle;
				}
				.table tr:last-child td { border-bottom: 0; }
				.table tr:hover td { background: var(--surface-2); }

				/* FORM ELEMENTS */
				.form-group { margin-bottom: 12px; }
				.form-group label {
					display: block;
					font-size: 12px;
					font-weight: 700;
					margin-bottom: 4px;
					color: var(--ink);
				}
				.input, .textarea, .select-full {
					width: 100%;
					border: 1px solid var(--line-strong);
					background: var(--surface);
					border-radius: 8px;
					padding: 8px 11px;
					color: var(--ink);
					font-size: 13px;
				}
				.input:focus, .textarea:focus, .select-full:focus {
					border-color: var(--primary);
					outline: 0;
					box-shadow: 0 0 0 3px rgba(14,124,86,.12);
				}

				/* MODAL CONTAINER & DIALOG */
				#modal-container:not(:empty) {
					position: fixed;
					inset: 0;
					background: rgba(10,47,36,.65);
					backdrop-filter: blur(4px);
					z-index: 1000;
					display: grid;
					place-items: center;
					padding: 20px;
					overflow-y: auto;
				}
				.modal-card {
					background: var(--surface);
					border-radius: var(--r-lg);
					box-shadow: 0 20px 50px -15px rgba(0,0,0,.35);
					width: 100%;
					max-height: 90vh;
					overflow-y: auto;
					border: 1px solid var(--line);
				}
				.modal-head {
					display: flex;
					justify-content: space-between;
					align-items: center;
					padding: 16px 20px;
					border-bottom: 1px solid var(--line);
				}
				.modal-head h3, .modal-head h4 { font-size: 16px; margin: 0; }
				.modal-body { padding: 18px 20px; }
				.modal-foot {
					display: flex;
					justify-content: flex-end;
					gap: 8px;
					padding: 14px 20px;
					border-top: 1px solid var(--line);
					background: var(--surface-2);
					border-radius: 0 0 var(--r-lg) var(--r-lg);
				}
				.close-btn {
					background: transparent;
					border: 0;
					font-size: 22px;
					color: var(--muted);
					cursor: pointer;
					line-height: 1;
				}
				.close-btn:hover { color: var(--rose); }

				dialog.modal-dialog {
					border: 0;
					border-radius: var(--r-lg);
					padding: 0;
					background: transparent;
					box-shadow: 0 24px 60px -15px rgba(0,0,0,.4);
					max-width: 600px;
					width: 90%;
				}
				dialog::backdrop {
					background: rgba(10,47,36,.65);
					backdrop-filter: blur(4px);
				}

				@media(max-width: 1120px) {
					.grid-kpi { grid-template-columns: repeat(2, 1fr); }
					.app { grid-template-columns: 1fr; }
					.side { position: static; height: auto; }
					.row-2 { grid-template-columns: 1fr; }
					.three-col { grid-template-columns: 1fr; }
				}
			</style>
		</head>
		<body>
			<div class="app" id="app-root">
				<script>
					if (localStorage.getItem('merchant_sidebar_collapsed') === '1') {
						document.getElementById('app-root')?.classList.add('collapsed');
					}
				</script>
				<!-- SIDEBAR -->
				@LeftSidebar(store, activeTab)

				<!-- MAIN CONTENT -->
				<main class="main">
					<header class="topbar">
						<button 
							type="button" 
							class="btn ghost small" 
							title="Toggle Sidebar (Ctrl+B)" 
							onclick="toggleMerchantSidebar()"
						>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"></path></svg>
						</button>

						<div class="greet">
							<h1>{ store.Name } Control Desk</h1>
							<p>Enterprise Merchant OS · Sovereign Cloud on pod-za-01, Johannesburg</p>
						</div>

						<div class="top-tools">
							<!-- Omnibar Search Trigger -->
							<div class="omni-btn" onclick="document.getElementById('omnibar-dialog')?.showModal(); document.getElementById('omnibar-search')?.focus();">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4a7 7 0 105 12l4 4"></path></svg>
								<span>Quick Search…</span>
								<span style="font-family:var(--mono); font-size:10.5px; background:var(--surface-2); padding:1px 5px; border-radius:4px; border:1px solid var(--line);">Ctrl+K</span>
							</div>

							<!-- Theme Switcher -->
							<select class="select" onchange="applyTheme(this.value);" style="padding:5px 8px; font-size:11.5px; border-radius:8px; border:1px solid var(--line);">
								<option value="artisan">Artisan Emerald</option>
								<option value="graphite">Dark Graphite</option>
								<option value="light">Studio Light</option>
							</select>

							<a href={ templ.SafeURL(fmt.Sprintf("http://localhost:3001/m/%s", store.ID)) } target="_blank" class="btn ghost small">
								<span>↗</span> Public Store
							</a>

							<button 
								hx-get="/tab/copilot" 
								hx-target="#tab-content" 
								hx-push-url="true" 
								class="btn dark small"
							>
								<span>✨</span> Copilot (Ctrl+J)
							</button>
						</div>
					</header>

					<!-- DYNAMIC TAB CONTENT CONTAINER -->
					<div id="tab-content">
						{ children... }
					</div>
				</main>

				<!-- MODAL CONTAINER (Populated via HTMX swaps) -->
				<div id="modal-container"></div>

				<!-- OMNIBAR DIALOG -->
				@OmnibarDialog()
			</div>

			<script>
				// Toggle Sidebar with localStorage persistence
				function toggleMerchantSidebar() {
					var root = document.getElementById('app-root');
					if (!root) return;
					var isCollapsed = root.classList.toggle('collapsed');
					try {
						localStorage.setItem('merchant_sidebar_collapsed', isCollapsed ? '1' : '0');
					} catch(e) {}
				}

				// Active Tab & Navigation Highlighting
				function syncActiveTabHighlight() {
					var path = window.location.pathname;
					var navItems = document.querySelectorAll('.nav-item');
					var matched = false;
					navItems.forEach(function(item) {
						var href = item.getAttribute('hx-get') || item.getAttribute('href');
						if (href && (path === href || (path.startsWith(href) && href !== '/tab/overview' && href !== '/'))) {
							item.classList.add('active');
							matched = true;
						} else {
							item.classList.remove('active');
						}
					});
					if (!matched && (path === '/' || path === '' || path === '/tab/overview')) {
						var overviewBtn = document.querySelector('.nav-item[hx-get="/tab/overview"]');
						if (overviewBtn) overviewBtn.classList.add('active');
					}
				}

				// Immediate click handlers for active selection
				document.addEventListener('click', function(e) {
					// Sidebar nav item click
					var navBtn = e.target.closest('.nav-item');
					if (navBtn) {
						document.querySelectorAll('.nav-item').forEach(function(el) { el.classList.remove('active'); });
						navBtn.classList.add('active');
					}
					
					// Chat thread item click
					var threadItem = e.target.closest('.thread-item');
					if (threadItem) {
						document.querySelectorAll('.thread-item').forEach(function(el) { el.classList.remove('active-thread', 'selected'); });
						threadItem.classList.add('active-thread', 'selected');
					}

					// Table row selection click (when clicking outside buttons/links)
					var tr = e.target.closest('.table tbody tr');
					if (tr && !e.target.closest('button, a, input, select')) {
						document.querySelectorAll('.table tbody tr').forEach(function(el) { el.classList.remove('selected'); });
						tr.classList.add('selected');
					}
				});

				window.addEventListener('popstate', syncActiveTabHighlight);
				document.body.addEventListener('htmx:afterOnLoad', function() {
					syncActiveTabHighlight();
				});

				// Global Keyboard Shortcuts
				window.addEventListener('keydown', function(e) {
					if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
						e.preventDefault();
						var omni = document.getElementById('omnibar-dialog');
						if (omni) {
							if (omni.open) omni.close();
							else { omni.showModal(); document.getElementById('omnibar-search')?.focus(); }
						}
					}
					if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
						e.preventDefault();
						toggleMerchantSidebar();
					}
					if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'j') {
						e.preventDefault();
						var btn = document.querySelector('[hx-get="/tab/copilot"]');
						if (btn) btn.click();
					}
				});
			</script>
		</body>
	</html>
}

templ LeftSidebar(store models.StoreProfile, activeTab string) {
	<aside class="side">
		<!-- Brand Header -->
		<div class="brand">
			<span class="mark">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
					<path d="M12 2l2.6 6.3L21 11l-6.4 2.7L12 20l-2.6-6.3L3 11l6.4-2.7L12 2z" fill="#fff"></path>
				</svg>
			</span>
			<span class="brand-text">PEMOFY OS</span>
			<button 
				type="button" 
				id="sidebar-toggle-btn" 
				class="side-collapse-btn" 
				title="Collapse / Expand sidebar (Ctrl+B)" 
				onclick="toggleMerchantSidebar()"
			>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="15 18 9 12 15 6"></polyline>
				</svg>
			</button>
		</div>

		<!-- Store Switcher Pill -->
		<div class="store-switch">
			<span class="av">M</span>
			<div class="meta">
				<b>{ store.Name }</b>
				<span><i class="live-dot"></i> Live · CIPC: { store.CIPCRegistration }</span>
			</div>
		</div>

		<!-- Nav: 1. ROLE CENTER -->
		<div class="nav-label">Role Center</div>
		<button hx-get="/tab/overview" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "" || activeTab == "overview") }>
			<span class="icon-span">📊</span>
			<span>Overview &amp; Velocity</span>
		</button>
		<button hx-get="/tab/analytics" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "analytics") }>
			<span class="icon-span">📈</span>
			<span>Analytics &amp; Funnel</span>
		</button>
		<button hx-get="/tab/audit-logs" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "audit-logs") }>
			<span class="icon-span">🔒</span>
			<span>Audit Trail</span>
		</button>
		<button hx-get="/tab/copilot" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "copilot") }>
			<span class="icon-span">✨</span>
			<span>AI Studio</span>
			<span class="badge" style="background:#4fe0a4; color:#0a2f24;">AI</span>
		</button>

		<!-- Nav: 2. SALES & ORDERS -->
		<div class="nav-label">Sales &amp; Orders</div>
		<button hx-get="/tab/chat" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "chat") }>
			<span class="icon-span">💬</span>
			<span>Direct Messages &amp; Chat</span>
			<span class="badge" style="background:#4fe0a4; color:#0a2f24;">Live</span>
		</button>
		<button hx-get="/tab/orders" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "orders") }>
			<span class="icon-span">📑</span>
			<span>Sales Orders &amp; Proformas</span>
		</button>
		<button hx-get="/tab/pick-pack" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "pick-pack") }>
			<span class="icon-span">🏷️</span>
			<span>Pick &amp; Pack Station</span>
			<span class="badge warn">WMS</span>
		</button>
		<button hx-get="/tab/manifests" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "manifests") }>
			<span class="icon-span">🚚</span>
			<span>Carrier Manifests</span>
		</button>
		<button hx-get="/tab/rfqs" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "rfqs") }>
			<span class="icon-span">📑</span>
			<span>Live RFQ Desk</span>
			<span class="badge warn">Quotes</span>
		</button>

		<!-- Nav: 3. INVENTORY & WMS -->
		<div class="nav-label">Inventory &amp; Logistics</div>
		<button hx-get="/tab/catalog" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "catalog") }>
			<span class="icon-span">📦</span>
			<span>Catalog &amp; Stock Matrix</span>
		</button>
		<button hx-get="/tab/inventory" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "inventory") }>
			<span class="icon-span">🏢</span>
			<span>Stock Balances &amp; Hubs</span>
		</button>
		<button hx-get="/tab/transfers" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "transfers") }>
			<span class="icon-span">🔄</span>
			<span>Inter-Hub Transfers</span>
		</button>
		<button hx-get="/tab/scan" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "scan") }>
			<span class="icon-span">📷</span>
			<span>Barcode &amp; Audits</span>
		</button>

		<!-- Nav: 4. CUSTOMERS & TRADE -->
		<div class="nav-label">Customers &amp; Trade</div>
		<button hx-get="/tab/customers" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "customers") }>
			<span class="icon-span">👥</span>
			<span>B2B CRM Accounts</span>
		</button>
		<button hx-get="/tab/discounts" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "discounts") }>
			<span class="icon-span">🏷️</span>
			<span>Wholesale Tiers &amp; Promos</span>
		</button>
		<button hx-get="/tab/pos" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "pos") }>
			<span class="icon-span">💳</span>
			<span>POS Trade Counter</span>
		</button>

		<!-- Nav: 5. GROWTH & CHANNELS -->
		<div class="nav-label">Growth &amp; Channels</div>
		<button hx-get="/tab/channels" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "channels") }>
			<span class="icon-span">🌐</span>
			<span>WhatsApp &amp; Channels</span>
		</button>
		<button hx-get="/tab/flow" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "flow") }>
			<span class="icon-span">⚡</span>
			<span>Flow Automations</span>
		</button>
		<button hx-get="/tab/feeds" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "feeds") }>
			<span class="icon-span">🛒</span>
			<span>Google Shopping Feeds</span>
		</button>
		<button hx-get="/tab/editor" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "editor") }>
			<span class="icon-span">🎨</span>
			<span>Theme Studio</span>
		</button>
		<button hx-get="/tab/media" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "media") }>
			<span class="icon-span">📁</span>
			<span>Media &amp; Documents</span>
		</button>

		<!-- Nav: 6. SETTINGS -->
		<div class="nav-label">Configuration</div>
		<button hx-get="/tab/settings" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", activeTab == "settings") }>
			<span class="icon-span">⚙️</span>
			<span>Settings &amp; Sovereign Pod</span>
		</button>

		<!-- Pod Security Note -->
		<div class="side-foot">
			<div class="side-note">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#4fe0a4" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
				<span>Your store runs in its own database on <b style="color:#fff">pod-za-01</b>, Johannesburg.</span>
			</div>
		</div>
	</aside>
}
