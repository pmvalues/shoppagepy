package templates

import (
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

// fontsHref loads the shared Shoppage type stack (same as the consumer site).
const fontsHref = "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Outfit:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"

func oob(on bool) templ.Attributes {
	if on {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return templ.Attributes{}
}

func docTitle(store models.StoreProfile, tab string) string {
	return PageTitle(tab) + " · " + store.Name + " · Shoppage Merchant"
}

func storeURL(nav models.NavContext, store models.StoreProfile) string {
	return fmt.Sprintf("%s/m/%s", strings.TrimRight(nav.PublicBaseURL, "/"), store.ID)
}

// Layout is the workspace shell: sidebar (7 sections), top bar with page
// title, search and account menu, the section's tab strip, and the content
// area that HTMX swaps. On phones the sidebar becomes a drawer and a bottom
// tab bar appears.
templ Layout(store models.StoreProfile, activeTab string, nav models.NavContext) {
	<!DOCTYPE html>
	<html lang="en-ZA">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="description" content="Shoppage Merchant: orders, products, stock, counter sales, buyer messages and listings in one place."/>
			<meta name="theme-color" content="#0a2f24"/>
			<title>{ docTitle(store, activeTab) }</title>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="alternate icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" href="/favicon.svg"/>
			<link rel="manifest" href="/merchant-static/manifest.webmanifest"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href={ fontsHref } media="print" onload="this.media='all'"/>
			<noscript><link rel="stylesheet" href={ fontsHref }/></noscript>
			<link rel="stylesheet" href="/merchant-static/css/workspace.css"/>
			<script>
				(function () {
					try {
						var t = localStorage.getItem('shoppage_theme');
						var legacy = localStorage.getItem('pemofy_admin_theme');
						if (!t && legacy) { t = legacy === 'graphite' ? 'dark' : 'system'; localStorage.setItem('shoppage_theme', t); }
						if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
					} catch (e) {}
				})();
			</script>
			<script src="/merchant-static/js/htmx.min.js" defer></script>
			<script src="/merchant-static/js/workspace.js" defer></script>
		</head>
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			<div class="app" id="app-root">
				<script>
					try { if (localStorage.getItem('merchant_sidebar_collapsed') === '1') document.getElementById('app-root').classList.add('collapsed'); } catch (e) {}
				</script>
				@LeftSidebar(store, activeTab, nav)
				<div class="scrim" aria-hidden="true"></div>
				<div class="main-col">
					<header class="topbar">
						<button type="button" class="icon-btn menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="side-nav" onclick="toggleMerchantSidebar()">
							@Icon("menu")
						</button>
						@PageTitleBlock(activeTab, false)
						<div class="top-tools">
							<button type="button" class="omni-btn" onclick="openOmnibar()" aria-label="Search products, orders and customers">
								@IconSized("search", 16)
								<span class="label">Search or jump to…</span>
								<kbd>Ctrl K</kbd>
							</button>
							<a class="btn solid small hide-sm" href="/tab/pos" hx-get="/tab/pos" hx-target="#tab-content" hx-push-url="true">
								@IconSized("plus", 16)
								Counter sale
							</a>
							<a class="icon-btn" href="/tab/chat" hx-get="/tab/chat" hx-target="#tab-content" hx-push-url="true" aria-label={ inboxLabel(nav) } title="Inbox">
								@Icon("chat")
								if nav.UnreadThreads > 0 {
									<span class="dot">{ fmt.Sprint(nav.UnreadThreads) }</span>
								}
							</a>
							<a class="icon-btn hide-sm" href={ templ.SafeURL(storeURL(nav, store)) } target="_blank" rel="noopener" aria-label="View your public store (opens in a new tab)" title="View store">
								@Icon("store")
							</a>
							<div class="menu">
								<button type="button" class="icon-btn" data-menu="account-menu" aria-haspopup="true" aria-expanded="false" aria-label="Account and settings">
									<b style="font-size:var(--fs-12)">{ Initials(accountName(nav)) }</b>
								</button>
								<div class="menu-pop" id="account-menu" hidden>
									<div class="menu-head">
										<b>{ store.Name }</b>
										if nav.UserEmail != "" {
											{ nav.UserEmail }
										} else {
											Signed in
										}
									</div>
									<a href="/tab/settings" hx-get="/tab/settings" hx-target="#tab-content" hx-push-url="true">
										@Icon("settings")
										Store settings &amp; billing
									</a>
									<a href="/tab/audit-logs" hx-get="/tab/audit-logs" hx-target="#tab-content" hx-push-url="true">
										@Icon("audit-logs")
										Activity log
									</a>
									<a href={ templ.SafeURL(storeURL(nav, store)) } target="_blank" rel="noopener">
										@Icon("external")
										View public store
									</a>
									<div class="menu-head" style="border:0;margin:6px 0 0;">Appearance</div>
									<div class="seg" role="group" aria-label="Theme">
										<button type="button" data-theme-choice="system" onclick="applyTheme('system')">System</button>
										<button type="button" data-theme-choice="light" onclick="applyTheme('light')">Light</button>
										<button type="button" data-theme-choice="dark" onclick="applyTheme('dark')">Dark</button>
									</div>
									<form method="post" action="/auth/logout">
										<button type="submit" class="menu-item">
											@Icon("logout")
											Sign out
										</button>
									</form>
								</div>
							</div>
						</div>
					</header>
					@SubNav(activeTab, nav, false)
					if nav.DemoData {
						<div class="demo-banner" role="note">
							@IconSized("alert", 16)
							<span><b>Demo workspace.</b> This is a sample business. Nothing here is sent to real buyers, couriers or channels.</span>
						</div>
					}
					<div class="demo-banner" id="offline-banner" role="status" hidden>
						@IconSized("offline", 16)
						<span><b>You're offline.</b> Counter sales are saved on this device and sent when you reconnect.</span>
					</div>
					<main class="main" id="main" tabindex="-1">
						<div id="tab-content">
							{ children... }
						</div>
					</main>
				</div>
				@BottomBar(activeTab, nav, false)
				<div id="modal-container"></div>
				@OmnibarDialog()
				<div id="toast-stack" class="toast-stack" aria-live="polite"></div>
			</div>
		</body>
	</html>
}

func inboxLabel(nav models.NavContext) string {
	if nav.UnreadThreads > 0 {
		return fmt.Sprintf("Inbox, %d unread", nav.UnreadThreads)
	}
	return "Inbox"
}

func accountName(nav models.NavContext) string {
	if nav.UserEmail != "" {
		return nav.UserEmail
	}
	return "Store"
}

// ShellOOB refreshes the shell around a swapped tab (title, tab strip,
// sidebar, bottom bar) so navigation state can never go stale.
templ ShellOOB(store models.StoreProfile, activeTab string, nav models.NavContext) {
	<title>{ docTitle(store, activeTab) }</title>
	@PageTitleBlock(activeTab, true)
	@SubNav(activeTab, nav, true)
	@SideNav(activeTab, nav, true)
	@BottomBar(activeTab, nav, true)
}

templ PageTitleBlock(activeTab string, swap bool) {
	<div class="page-title" id="page-title" { oob(swap)... }>
		<div class="crumb">
			{ WorkspaceFor(activeTab).Label }
			if PageTitle(activeTab) != WorkspaceFor(activeTab).Label {
				@IconSized("chevron", 12)
				{ TabLabel(activeTab) }
			}
		</div>
		<h1>{ PageTitle(activeTab) }</h1>
	</div>
}

templ SubNav(activeTab string, nav models.NavContext, swap bool) {
	<nav class="subnav" id="subnav" aria-label={ WorkspaceFor(activeTab).Label + " pages" } { oob(swap)... } hidden?={ len(WorkspaceFor(activeTab).Tabs) < 2 }>
		for _, t := range WorkspaceFor(activeTab).Tabs {
			<a
				href={ templ.SafeURL(TabHref(t.Key)) }
				hx-get={ "/tab/" + t.Key }
				hx-target="#tab-content"
				hx-push-url={ TabHref(t.Key) }
				class={ templ.KV("active", t.Key == activeTab || (activeTab == "" && t.Key == "overview")) }
				if t.Key == activeTab {
					aria-current="page"
				}
			>
				{ t.Label }
				if TabBadge(t.Key, nav) > 0 {
					<span class="count">{ fmt.Sprint(TabBadge(t.Key, nav)) }</span>
				}
			</a>
		}
	</nav>
}

templ LeftSidebar(store models.StoreProfile, activeTab string, nav models.NavContext) {
	<aside class="side" aria-label="Main">
		<div class="brand">
			<span class="mark" aria-hidden="true">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2l2.6 6.3L21 11l-6.4 2.7L12 20l-2.6-6.3L3 11l6.4-2.7L12 2z" fill="currentColor"></path></svg>
			</span>
			<span class="brand-text">Shoppage<small>Merchant</small></span>
			<button type="button" class="side-collapse-btn" title="Collapse sidebar (Ctrl+B)" aria-label="Collapse sidebar" onclick="toggleMerchantSidebar()">
				@IconSized("collapse", 16)
			</button>
		</div>
		<div class="store-switch">
			<span class="av" aria-hidden="true">{ Initials(store.Name) }</span>
			<div class="meta">
				<b>{ store.Name }</b>
				if nav.DemoData {
					<span><i class="live-dot demo"></i> Demo data</span>
				} else {
					<span><i class="live-dot"></i> Store live</span>
				}
			</div>
		</div>
		@SideNav(activeTab, nav, false)
		<div class="side-foot">
			<a href="/tab/settings" hx-get="/tab/settings" hx-target="#tab-content" hx-push-url="true" class={ "nav-item", templ.KV("active", WorkspaceFor(activeTab).Key == "settings") }>
				<span class="icon-span">
					@Icon("settings")
				</span>
				<span>Settings</span>
			</a>
		</div>
	</aside>
}

templ SideNav(activeTab string, nav models.NavContext, swap bool) {
	<nav id="side-nav" aria-label="Sections" { oob(swap)... }>
		for _, w := range Workspaces {
			<a
				href={ templ.SafeURL(TabHref(w.Tabs[0].Key)) }
				hx-get={ "/tab/" + w.Tabs[0].Key }
				hx-target="#tab-content"
				hx-push-url={ TabHref(w.Tabs[0].Key) }
				class={ "nav-item", templ.KV("active", WorkspaceFor(activeTab).Key == w.Key) }
				if WorkspaceFor(activeTab).Key == w.Key {
					aria-current="page"
				}
				title={ w.Label }
			>
				<span class="icon-span">
					@Icon(w.Icon)
				</span>
				<span>{ w.Label }</span>
				if WorkspaceBadge(w.Key, nav) > 0 {
					<span class="badge warn" aria-label={ fmt.Sprintf("%d need attention", WorkspaceBadge(w.Key, nav)) }>{ fmt.Sprint(WorkspaceBadge(w.Key, nav)) }</span>
				}
			</a>
		}
	</nav>
}

// BottomBar is the phone navigation: the four most-used sections plus More,
// which opens the full sidebar drawer.
templ BottomBar(activeTab string, nav models.NavContext, swap bool) {
	<nav class="bottombar" id="bottombar" aria-label="Quick navigation" { oob(swap)... }>
		@bottomLink("overview", "Home", "overview", WorkspaceFor(activeTab).Key == "home", 0)
		@bottomLink("orders", "Sell", "orders", WorkspaceFor(activeTab).Key == "sell", WorkspaceBadge("sell", nav))
		@bottomLink("catalog", "Products", "catalog", WorkspaceFor(activeTab).Key == "products", 0)
		@bottomLink("inventory", "Stock", "inventory", WorkspaceFor(activeTab).Key == "stock", WorkspaceBadge("stock", nav))
		<button type="button" onclick="toggleMerchantSidebar()" aria-label="More sections">
			@Icon("more")
			More
		</button>
	</nav>
}

templ bottomLink(tab, label, icon string, active bool, badge int) {
	<a href={ templ.SafeURL(TabHref(tab)) } hx-get={ "/tab/" + tab } hx-target="#tab-content" hx-push-url={ TabHref(tab) } class={ templ.KV("active", active) }>
		@Icon(icon)
		{ label }
		if badge > 0 {
			<span class="dot">{ fmt.Sprint(badge) }</span>
		}
	</a>
}
