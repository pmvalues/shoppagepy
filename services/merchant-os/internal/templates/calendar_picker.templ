package templates

templ PeriodCalendarPicker() {
	<div class="calendar-picker-wrapper" style="position:relative; display:inline-block;" id="period-picker-container">
		<!-- Trigger Pill Button -->
		<button
			type="button"
			id="global-calendar-btn"
			class="btn ghost small"
			onclick="togglePeriodPickerPopover();"
			title="Filter transactions and ledger views by accounting period"
			style="display:inline-flex; align-items:center; gap:6px; font-size:11.5px; padding:5px 10px; border-radius:8px; border:1px solid var(--line-strong); background:var(--surface); color:var(--ink);"
		>
			<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--primary);"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
			<span id="global-period-label" style="font-weight:600; max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">This Month (MTD)</span>
			<span id="global-period-badge" class="chip up" style="font-size:10px; padding:1px 5px; font-weight:700;">Filtered</span>
			<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--muted);"><polyline points="6 9 12 15 18 9"></polyline></svg>
		</button>

		<!-- Popover Dropdown Card -->
		<div
			id="period-picker-popover"
			class="card"
			style="display:none; position:absolute; right:0; top:calc(100% + 8px); z-index:1050; box-shadow:0 24px 60px -15px rgba(0,0,0,.35); padding:16px; border:1px solid var(--line-strong); min-width:580px; max-width:92vw; background:var(--surface);"
		>
			<div style="display:flex; flex-direction:row; gap:16px;">
				<!-- Left Preset Sidebar -->
				<div style="width:175px; border-right:1px solid var(--line); padding-right:14px; display:flex; flex-direction:column; justify-content:space-between; flex-shrink:0;">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
							<span style="font-size:10.5px; text-transform:uppercase; letter-spacing:.08em; font-weight:700; color:var(--muted);">Accounting Period</span>
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--muted);"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
						</div>
						<div style="display:flex; flex-direction:column; gap:2px;" id="period-presets-list">
							<button type="button" class="preset-btn" data-preset="all" onclick="selectPeriodPreset('all', 'All Time')">
								<span>All Time</span>
							</button>
							<button type="button" class="preset-btn" data-preset="today" onclick="selectPeriodPreset('today', 'Today')">
								<span>Today</span>
							</button>
							<button type="button" class="preset-btn" data-preset="yesterday" onclick="selectPeriodPreset('yesterday', 'Yesterday')">
								<span>Yesterday</span>
							</button>
							<button type="button" class="preset-btn" data-preset="last_7d" onclick="selectPeriodPreset('last_7d', 'Last 7 Days')">
								<span>Last 7 Days</span>
							</button>
							<button type="button" class="preset-btn" data-preset="last_30d" onclick="selectPeriodPreset('last_30d', 'Last 30 Days')">
								<span>Last 30 Days</span>
							</button>
							<button type="button" class="preset-btn active" data-preset="mtd" onclick="selectPeriodPreset('mtd', 'This Month (MTD)')">
								<span>This Month (MTD)</span>
							</button>
							<button type="button" class="preset-btn" data-preset="qtd" onclick="selectPeriodPreset('qtd', 'This Quarter (QTD)')">
								<span>This Quarter (QTD)</span>
							</button>
							<button type="button" class="preset-btn" data-preset="ytd" onclick="selectPeriodPreset('ytd', 'Year to Date (YTD)')">
								<span>Year to Date (YTD)</span>
							</button>
							<button type="button" class="preset-btn" data-preset="custom" onclick="selectPeriodPreset('custom', 'Custom Range')">
								<span>Custom Range</span>
							</button>
						</div>
					</div>

					<button
						type="button"
						class="btn ghost small"
						style="margin-top:12px; font-size:11px; justify-content:center; gap:4px; width:100%;"
						onclick="selectPeriodPreset('all', 'All Time');"
					>
						<span>↺</span> Reset to All Time
					</button>
				</div>

				<!-- Right Calendar Grid View -->
				<div style="flex:1; min-width:320px;">
					<!-- Month Nav -->
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
						<span id="cal-month-title" style="font-size:13.5px; font-weight:700; font-family:var(--display); color:var(--ink);">September 2026</span>
						<div style="display:flex; gap:4px;">
							<button type="button" class="btn ghost small" style="padding:2px 8px; font-weight:700;" onclick="shiftCalMonth(-1);">‹</button>
							<button type="button" class="btn ghost small" style="padding:2px 8px; font-weight:700;" onclick="shiftCalMonth(1);">›</button>
						</div>
					</div>

					<!-- Weekday Headers -->
					<div style="display:grid; grid-template-columns:repeat(7, 1fr); text-align:center; font-size:10.5px; font-weight:700; color:var(--muted); margin-bottom:6px;">
						<span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
					</div>

					<!-- 42 Day Cells Grid -->
					<div id="cal-days-grid" style="display:grid; grid-template-columns:repeat(7, 1fr); gap:2px; text-align:center;">
						<!-- Injected by JavaScript -->
					</div>

					<!-- Manual Date Entry & Apply Range -->
					<div style="margin-top:14px; padding-top:10px; border-top:1px solid var(--line); display:flex; justify-content:space-between; align-items:flex-end; gap:8px;">
						<div style="display:flex; gap:8px;">
							<div>
								<label style="display:block; font-size:10px; text-transform:uppercase; font-weight:700; color:var(--muted); margin-bottom:2px;">From Date</label>
								<input type="date" id="cal-input-from" style="padding:4px 6px; font-size:11px; border:1px solid var(--line-strong); border-radius:6px; background:var(--surface); color:var(--ink); font-family:var(--mono);" />
							</div>
							<div>
								<label style="display:block; font-size:10px; text-transform:uppercase; font-weight:700; color:var(--muted); margin-bottom:2px;">To Date</label>
								<input type="date" id="cal-input-to" style="padding:4px 6px; font-size:11px; border:1px solid var(--line-strong); border-radius:6px; background:var(--surface); color:var(--ink); font-family:var(--mono);" />
							</div>
						</div>
						<div style="display:flex; gap:6px;">
							<button type="button" class="btn ghost small" onclick="togglePeriodPickerPopover(false);">Cancel</button>
							<button type="button" class="btn solid small" onclick="applyCustomRangeInputs();">Apply Range</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<style>
		.preset-btn {
			display: flex;
			align-items: center;
			justify-content: space-between;
			width: 100%;
			text-align: left;
			padding: 6px 9px;
			border-radius: 7px;
			border: 0;
			background: transparent;
			font-size: 12px;
			font-weight: 500;
			color: var(--ink);
			cursor: pointer;
			transition: background .12s, color .12s;
		}
		.preset-btn:hover {
			background: var(--surface-2);
			color: var(--ink);
		}
		.preset-btn.active {
			background: var(--primary) !important;
			color: #ffffff !important;
			font-weight: 700 !important;
		}
		.cal-day-cell {
			height: 30px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 11.5px;
			font-weight: 500;
			border: 0;
			background: transparent;
			color: var(--ink);
			cursor: pointer;
			border-radius: 6px;
			transition: all .1s;
			position: relative;
		}
		.cal-day-cell:hover {
			background: var(--surface-2);
		}
		.cal-day-cell.other-month {
			opacity: 0.3;
			color: var(--muted);
		}
		.cal-day-cell.selected {
			background: var(--primary) !important;
			color: #ffffff !important;
			font-weight: 700;
			border-radius: 6px;
			z-index: 2;
		}
		.cal-day-cell.in-range {
			background: var(--primary-soft) !important;
			color: var(--primary-2) !important;
			border-radius: 0;
		}
		.cal-day-cell.today::after {
			content: "";
			position: absolute;
			bottom: 2px;
			width: 4px;
			height: 4px;
			border-radius: 50%;
			background: var(--primary);
		}
		.cal-day-cell.selected.today::after {
			background: #ffffff;
		}
	</style>

	<script>
		// Global Accounting Period State
		window.PemofyPeriodState = {
			preset: 'mtd',
			label: 'This Month (MTD)',
			from: null,
			to: null,
			navYear: 2026,
			navMonth: 8, // September (0-indexed: 8)
			selectionStart: null,
			selectionEnd: null
		};

		// Helper to compute preset dates
		function computePresetRange(preset) {
			var now = new Date(2026, 8, 21, 14, 0, 0); // Reference date: 21 Sep 2026
			var from = null, to = null, label = 'All Time';

			if (preset === 'all') {
				return { from: null, to: null, label: 'All Time' };
			} else if (preset === 'today') {
				from = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);
				to = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
				label = 'Today';
			} else if (preset === 'yesterday') {
				from = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1, 0, 0, 0);
				to = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1, 23, 59, 59);
				label = 'Yesterday';
			} else if (preset === 'last_7d') {
				from = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 6, 0, 0, 0);
				to = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
				label = 'Last 7 Days';
			} else if (preset === 'last_30d') {
				from = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 29, 0, 0, 0);
				to = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
				label = 'Last 30 Days';
			} else if (preset === 'mtd') {
				from = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0);
				to = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
				label = 'This Month (MTD)';
			} else if (preset === 'qtd') {
				var q = Math.floor(now.getMonth() / 3);
				from = new Date(now.getFullYear(), q * 3, 1, 0, 0, 0);
				to = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
				label = 'This Quarter (Q' + (q + 1) + ')';
			} else if (preset === 'ytd') {
				from = new Date(now.getFullYear(), 0, 1, 0, 0, 0);
				to = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
				label = 'Year to Date (' + now.getFullYear() + ')';
			}
			return { from: from, to: to, label: label };
		}

		// Toggle popover
		function togglePeriodPickerPopover(forceState) {
			var pop = document.getElementById('period-picker-popover');
			if (!pop) return;
			var shouldOpen = (forceState !== undefined) ? forceState : (pop.style.display === 'none' || pop.style.display === '');
			pop.style.display = shouldOpen ? 'block' : 'none';
			if (shouldOpen) {
				renderCalGrid();
			}
		}

		// Close popover when clicking outside
		document.addEventListener('click', function(e) {
			var container = document.getElementById('period-picker-container');
			if (container && !container.contains(e.target)) {
				var pop = document.getElementById('period-picker-popover');
				if (pop) pop.style.display = 'none';
			}
		});

		// Select a preset
		function selectPeriodPreset(preset, label) {
			window.PemofyPeriodState.preset = preset;
			var range = computePresetRange(preset);
			window.PemofyPeriodState.from = range.from;
			window.PemofyPeriodState.to = range.to;
			window.PemofyPeriodState.label = label || range.label;
			window.PemofyPeriodState.selectionStart = range.from;
			window.PemofyPeriodState.selectionEnd = range.to;

			if (range.from) {
				window.PemofyPeriodState.navYear = range.from.getFullYear();
				window.PemofyPeriodState.navMonth = range.from.getMonth();
			}

			updatePeriodUI();
			dispatchPeriodChangeEvent();
			togglePeriodPickerPopover(false);
		}

		// Update UI elements across the page
		function updatePeriodUI() {
			var state = window.PemofyPeriodState;
			var labelEl = document.getElementById('global-period-label');
			var badgeEl = document.getElementById('global-period-badge');
			if (labelEl) labelEl.textContent = state.label;
			if (badgeEl) {
				badgeEl.style.display = (state.preset === 'all') ? 'none' : 'inline-flex';
			}

			// Update in-page orders period label if present
			var ordersPeriodLabel = document.getElementById('orders-period-label');
			if (ordersPeriodLabel) ordersPeriodLabel.textContent = state.label;

			// Highlight active preset button
			document.querySelectorAll('#period-presets-list .preset-btn').forEach(function(btn) {
				if (btn.dataset.preset === state.preset) {
					btn.classList.add('active');
				} else {
					btn.classList.remove('active');
				}
			});

			// Update date inputs
			var fromInput = document.getElementById('cal-input-from');
			var toInput = document.getElementById('cal-input-to');
			if (fromInput && state.from) {
				fromInput.value = state.from.toISOString().slice(0, 10);
			} else if (fromInput) {
				fromInput.value = '';
			}
			if (toInput && state.to) {
				toInput.value = state.to.toISOString().slice(0, 10);
			} else if (toInput) {
				toInput.value = '';
			}
		}

		// Shift month
		function shiftCalMonth(delta) {
			window.PemofyPeriodState.navMonth += delta;
			if (window.PemofyPeriodState.navMonth > 11) {
				window.PemofyPeriodState.navMonth = 0;
				window.PemofyPeriodState.navYear += 1;
			} else if (window.PemofyPeriodState.navMonth < 0) {
				window.PemofyPeriodState.navMonth = 11;
				window.PemofyPeriodState.navYear -= 1;
			}
			renderCalGrid();
		}

		// Render the 42-day calendar month grid
		function renderCalGrid() {
			var y = window.PemofyPeriodState.navYear;
			var m = window.PemofyPeriodState.navMonth;
			var monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
			var titleEl = document.getElementById('cal-month-title');
			if (titleEl) titleEl.textContent = monthNames[m] + ' ' + y;

			var gridEl = document.getElementById('cal-days-grid');
			if (!gridEl) return;
			gridEl.innerHTML = '';

			var firstDay = new Date(y, m, 1).getDay();
			var daysInMonth = new Date(y, m + 1, 0).getDate();
			var prevDays = new Date(y, m, 0).getDate();

			var today = new Date(2026, 8, 21);
			var sFrom = window.PemofyPeriodState.selectionStart ? new Date(window.PemofyPeriodState.selectionStart).setHours(0,0,0,0) : null;
			var sTo = window.PemofyPeriodState.selectionEnd ? new Date(window.PemofyPeriodState.selectionEnd).setHours(0,0,0,0) : null;

			// Prev month padding
			for (var i = firstDay - 1; i >= 0; i--) {
				var dNum = prevDays - i;
				var btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'cal-day-cell other-month';
				btn.textContent = dNum;
				gridEl.appendChild(btn);
			}

			// Current month days
			for (var d = 1; d <= daysInMonth; d++) {
				var curDate = new Date(y, m, d);
				var curTime = curDate.setHours(0,0,0,0);
				var btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'cal-day-cell';
				btn.textContent = d;

				if (curDate.getFullYear() === today.getFullYear() && curDate.getMonth() === today.getMonth() && curDate.getDate() === today.getDate()) {
					btn.classList.add('today');
				}

				if ((sFrom && curTime === sFrom) || (sTo && curTime === sTo)) {
					btn.classList.add('selected');
				} else if (sFrom && sTo && curTime > sFrom && curTime < sTo) {
					btn.classList.add('in-range');
				}

				(function(dayDate) {
					btn.onclick = function() {
						handleCalDayClick(dayDate);
					};
				})(new Date(y, m, d));

				gridEl.appendChild(btn);
			}

			// Fill remaining to 42 cells
			var remaining = 42 - (firstDay + daysInMonth);
			for (var j = 1; j <= remaining; j++) {
				var btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'cal-day-cell other-month';
				btn.textContent = j;
				gridEl.appendChild(btn);
			}
		}

		// Handle user clicking a day
		function handleCalDayClick(dayDate) {
			var state = window.PemofyPeriodState;
			if (!state.selectionStart || (state.selectionStart && state.selectionEnd)) {
				state.selectionStart = dayDate;
				state.selectionEnd = null;
				state.from = dayDate;
				state.to = null;
				state.preset = 'custom';
				state.label = dayDate.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) + ' – …';
				renderCalGrid();
				updatePeriodUI();
			} else {
				var from = state.selectionStart;
				var to = dayDate;
				if (to < from) {
					var tmp = from;
					from = to;
					to = tmp;
				}
				to.setHours(23, 59, 59);
				state.selectionStart = from;
				state.selectionEnd = to;
				state.from = from;
				state.to = to;
				state.preset = 'custom';
				state.label = from.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) + ' – ' + to.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
				renderCalGrid();
				updatePeriodUI();
				dispatchPeriodChangeEvent();
				togglePeriodPickerPopover(false);
			}
		}

		// Apply manual range inputs
		function applyCustomRangeInputs() {
			var fromVal = document.getElementById('cal-input-from')?.value;
			var toVal = document.getElementById('cal-input-to')?.value;
			if (!fromVal || !toVal) return;

			var from = new Date(fromVal);
			var to = new Date(toVal);
			to.setHours(23, 59, 59);

			var state = window.PemofyPeriodState;
			state.selectionStart = from;
			state.selectionEnd = to;
			state.from = from;
			state.to = to;
			state.preset = 'custom';
			state.label = from.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) + ' – ' + to.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
			updatePeriodUI();
			dispatchPeriodChangeEvent();
			togglePeriodPickerPopover(false);
		}

		// Check if a date string/timestamp falls within the active period
		window.isDateInPeriod = function(dateStr) {
			if (!dateStr) return true;
			var state = window.PemofyPeriodState;
			if (state.preset === 'all' || !state.from || !state.to) return true;
			var d = new Date(dateStr).getTime();
			if (isNaN(d)) return true;
			return d >= state.from.getTime() && d <= state.to.getTime();
		};

		// Dispatch custom event on period change so all tabs can hook in
		function dispatchPeriodChangeEvent() {
			var event = new CustomEvent('pemofy:period-change', {
				detail: {
					preset: window.PemofyPeriodState.preset,
					label: window.PemofyPeriodState.label,
					from: window.PemofyPeriodState.from,
					to: window.PemofyPeriodState.to
				}
			});
			document.dispatchEvent(event);

			// Automatically re-filter active views
			if (typeof filterOrdersTable === 'function') filterOrdersTable();
			if (typeof filterInventoryTable === 'function') filterInventoryTable();
		}

		// Initialize on load
		document.addEventListener('DOMContentLoaded', function() {
			var initRange = computePresetRange('mtd');
			window.PemofyPeriodState.from = initRange.from;
			window.PemofyPeriodState.to = initRange.to;
			updatePeriodUI();
		});
		document.body.addEventListener('htmx:afterOnLoad', function() {
			updatePeriodUI();
			if (typeof filterOrdersTable === 'function') filterOrdersTable();
			if (typeof filterInventoryTable === 'function') filterInventoryTable();
		});
	</script>
}
