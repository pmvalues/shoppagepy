package templates

import (
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

type custStats struct {
	Owed, Credit, Spend float64
	OverLimit, Owing  int
}

func customerStats(cs []models.CustomerAccount) custStats {
	var s custStats
	for _, c := range cs {
		s.Owed += c.BalanceZar
		s.Credit += c.CreditLimit
		s.Spend += c.TotalSpendZar
		if c.BalanceZar > 0 {
			s.Owing++
		}
		if c.CreditLimit > 0 && c.BalanceZar > c.CreditLimit {
			s.OverLimit++
		}
	}
	return s
}

func customerRows(data models.DashboardViewData) []models.CustomerAccount {
	q := strings.ToLower(strings.TrimSpace(data.Query["q"]))
	var out []models.CustomerAccount
	for _, c := range data.Customers {
		if q != "" && !strings.Contains(strings.ToLower(c.Company+" "+c.ContactName+" "+c.Email+" "+c.Phone+" "+c.City), q) {
			continue
		}
		if data.Query["view"] == "owing" && c.BalanceZar <= 0 {
			continue
		}
		out = append(out, c)
	}
	return out
}

func creditPct(c models.CustomerAccount) float64 {
	if c.CreditLimit <= 0 {
		return 0
	}
	return c.BalanceZar / c.CreditLimit * 100
}

templ CustomersTab(data models.DashboardViewData) {
	{{ st := customerStats(data.Customers) }}
	{{ rows := customerRows(data) }}
	<div class="page-head">
		<div class="head-copy">
			<p>{ fmt.Sprintf("%d %s. Contact details are personal information: only use them for this business.", len(data.Customers), Plural(len(data.Customers), "customer", "customers")) }</p>
		</div>
		<div class="actions">
			<a class="btn ghost" href="/customers/export.csv">Export CSV</a>
			<button class="btn solid" type="button" onclick="document.getElementById('new-customer-dialog').showModal()">
				@IconSized("plus", 16)
				Add customer
			</button>
		</div>
	</div>
	<section class="grid-kpi">
		<article class="card kpi">
			<div class="k-label">Customers</div>
			<div class="k-val">{ Int(len(data.Customers)) }</div>
			<div class="k-foot">lifetime spend { ZARWhole(st.Spend) }</div>
		</article>
		<a class="card kpi" href="/tab/customers?view=owing" hx-get="/tab/customers?view=owing" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">Owed to you</div>
			<div class="k-val">{ ZARWhole(st.Owed) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d %s with a balance", st.Owing, Plural(st.Owing, "customer", "customers")) }</div>
		</a>
		<article class="card kpi">
			<div class="k-label">Credit extended</div>
			<div class="k-val">{ ZARWhole(st.Credit) }</div>
			<div class="k-foot">total of credit limits</div>
		</article>
		<article class="card kpi">
			<div class="k-label">
				Over their limit
				if st.OverLimit > 0 {
					<span class="chip bad">Check</span>
				}
			</div>
			<div class="k-val">{ Int(st.OverLimit) }</div>
			<div class="k-foot">balance above credit limit</div>
		</article>
	</section>
	<section class="card">
		<div class="panel" style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; border-bottom:1px solid var(--line);">
			<form hx-get="/tab/customers" hx-target="#tab-content" hx-push-url="true" style="flex:1 1 240px;">
				<label class="sr-only" for="cust-q">Search customers</label>
				<input class="input" id="cust-q" type="search" name="q" value={ data.Query["q"] } placeholder="Search name, contact, phone or email" hx-get="/tab/customers" hx-trigger="input changed delay:350ms, search" hx-target="#tab-content" hx-push-url="true"/>
			</form>
			<div class="seg" role="group" aria-label="Filter customers">
				<a href="/tab/customers" hx-get="/tab/customers" hx-target="#tab-content" hx-push-url="true" class={ templ.KV("on", data.Query["view"] == "") }>All</a>
				<a href="/tab/customers?view=owing" hx-get="/tab/customers?view=owing" hx-target="#tab-content" hx-push-url="true" class={ templ.KV("on", data.Query["view"] == "owing") }>Owing</a>
			</div>
		</div>
		if len(rows) == 0 {
			<div class="empty">
				if len(data.Customers) == 0 {
					<h3>No customers yet</h3>
					<p>Customers are added when you create an order, or you can add them here.</p>
				} else {
					<h3>No customers match</h3>
				}
			</div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr><th>Customer</th><th>Contact</th><th class="r">Orders</th><th class="r">Spend</th><th>Balance / limit</th><th>Last order</th><th><span class="sr-only">Actions</span></th></tr>
					</thead>
					<tbody>
						for _, c := range rows {
							<tr>
								<td>
									<div class="who">
										<span class="av" aria-hidden="true">{ Initials(c.Company) }</span>
										<div><b>{ c.Company }</b><span>{ orDash(c.City) }{ tierSuffix(c.Tier) }</span></div>
									</div>
								</td>
								<td>{ orDash(c.ContactName) }<div class="small-text muted">{ c.Phone }</div></td>
								<td class="r num">{ fmt.Sprint(c.OrderCount) }</td>
								<td class="r amt">{ ZARWhole(c.TotalSpendZar) }</td>
								<td style="min-width:170px;">
									<div class="cluster small-text" style="justify-content:space-between;">
										<b class="num">{ ZAR(c.BalanceZar) }</b>
										if c.CreditLimit > 0 {
											<span class="muted">of { ZARWhole(c.CreditLimit) }</span>
										}
									</div>
									if c.CreditLimit > 0 {
										<div class={ "progress", templ.KV("warn", creditPct(c) >= 80 && creditPct(c) <= 100), templ.KV("bad", creditPct(c) > 100) } style="margin-top:4px;"><span style={ Width(creditPct(c)) }></span></div>
									}
								</td>
								<td class="small-text muted">
									if c.LastOrderDate.IsZero() {
										None yet
									} else {
										{ Ago(c.LastOrderDate, data.Metrics.Now) }
									}
								</td>
								<td class="r">
									if c.Phone != "" && c.BalanceZar > 0 {
										<a class="btn ghost small" target="_blank" rel="noopener" href={ templ.SafeURL(waLink(c.Phone, fmt.Sprintf("Hi %s, a friendly reminder that your account with %s has a balance of %s. Thank you!", c.ContactName, data.Store.Name, models.FormatZAR(c.BalanceZar)))) }>Send reminder</a>
									} else if c.Phone != "" {
										<a class="btn ghost small" target="_blank" rel="noopener" href={ templ.SafeURL(waLink(c.Phone, "Hi "+c.ContactName+", ")) }>WhatsApp</a>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
	<dialog id="new-customer-dialog" class="modal-dialog" aria-labelledby="cust-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="cust-title">Add customer</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/customers/new" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<div class="modal-body">
					<div class="form-group">
						<label for="c-company">Company or name</label>
						<input id="c-company" type="text" name="company" class="input" required autocomplete="organization"/>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="c-contact">Contact person</label>
							<input id="c-contact" type="text" name="contactName" class="input" autocomplete="name"/>
						</div>
						<div class="form-group">
							<label for="c-city">Town or city</label>
							<input id="c-city" type="text" name="city" class="input"/>
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="c-phone">Phone / WhatsApp</label>
							<input id="c-phone" type="tel" name="phone" class="input" autocomplete="tel"/>
						</div>
						<div class="form-group">
							<label for="c-email">Email</label>
							<input id="c-email" type="email" name="email" class="input" autocomplete="email"/>
						</div>
					</div>
					<details>
						<summary class="small-text link" style="cursor:pointer;">Trade account details (optional)</summary>
						<div class="two-col" style="margin-top:10px;">
							<div class="form-group">
								<label for="c-cipc">Company registration</label>
								<input id="c-cipc" type="text" name="cipc" class="input"/>
							</div>
							<div class="form-group">
								<label for="c-vat">VAT number</label>
								<input id="c-vat" type="text" name="vatNumber" class="input"/>
							</div>
						</div>
						<div class="two-col">
							<div class="form-group">
								<label for="c-tier">Price tier</label>
								<select id="c-tier" name="tier" class="select-full">
									<option value="">Standard prices</option>
									for _, t := range data.WholesaleTiers {
										<option value={ t.TierName }>{ t.TierName }</option>
									}
								</select>
							</div>
							<div class="form-group">
								<label for="c-credit">Credit limit</label>
								<input id="c-credit" type="number" name="creditLimit" class="input" min="0" step="100" placeholder="0 = pay upfront"/>
							</div>
						</div>
					</details>
					<p class="help" style="margin-top:10px;">Only add people who've agreed to be contacted by your business.</p>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Add customer</button>
				</div>
			</form>
		</div>
	</dialog>
}

func tierSuffix(t string) string {
	if t == "" {
		return ""
	}
	return " · " + t
}
