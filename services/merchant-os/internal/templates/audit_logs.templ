package templates

import (
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

func auditRows(data models.DashboardViewData) []models.AuditLogEntry {
	q := strings.ToLower(strings.TrimSpace(data.Query["q"]))
	if q == "" {
		return data.AuditLogs
	}
	var out []models.AuditLogEntry
	for _, e := range data.AuditLogs {
		if strings.Contains(strings.ToLower(e.Actor+" "+e.Action+" "+e.EntityID+" "+e.Details), q) {
			out = append(out, e)
		}
	}
	return out
}

// AuditLogsTab is the activity log: who changed what, and when. Entries are
// appended by every action in the workspace and can be exported.
templ AuditLogsTab(data models.DashboardViewData) {
	{{ rows := auditRows(data) }}
	<div class="page-head">
		<div class="head-copy">
			<p>Every change made in your workspace: who made it, what changed and when.</p>
		</div>
		<div class="actions">
			<a class="btn ghost" href="/audit-logs/export.csv">Export CSV</a>
		</div>
	</div>
	<section class="card">
		<div class="panel" style="border-bottom:1px solid var(--line);">
			<form hx-get="/tab/audit-logs" hx-target="#tab-content" hx-push-url="true">
				<label class="sr-only" for="log-q">Search the activity log</label>
				<input class="input" id="log-q" type="search" name="q" value={ data.Query["q"] } placeholder="Search by person, action, SKU or order" hx-get="/tab/audit-logs" hx-trigger="input changed delay:350ms, search" hx-target="#tab-content" hx-push-url="true"/>
			</form>
		</div>
		if len(rows) == 0 {
			<div class="empty"><p>No activity matches.</p></div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr><th>When</th><th>Who</th><th>What</th><th>Record</th><th>Details</th></tr>
					</thead>
					<tbody>
						for _, e := range rows {
							<tr>
								<td class="small-text muted" title={ LocalDateTime(e.Timestamp) }>{ Ago(e.Timestamp, data.Metrics.Now) }</td>
								<td>{ e.Actor }</td>
								<td><b style="font-weight:600;">{ e.Action }</b></td>
								<td class="mono small-text">{ e.EntityID }</td>
								<td class="small-text">{ e.Details }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}
