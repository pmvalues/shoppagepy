package templates

import (
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

// catalogRows applies the list filters from the URL (?q=, ?view=).
func catalogRows(data models.DashboardViewData) []models.CatalogSKU {
	q := strings.ToLower(strings.TrimSpace(data.Query["q"]))
	view := data.Query["view"]
	var out []models.CatalogSKU
	for _, p := range data.Catalog {
		if q != "" && !strings.Contains(strings.ToLower(p.Title+" "+p.SKU+" "+p.Brand+" "+p.Category+" "+p.Spec.Barcode), q) {
			continue
		}
		r := data.Readiness[p.ID]
		switch view {
		case "low":
			if !(p.LowStockAlert > 0 && p.StockQuantity <= p.LowStockAlert) {
				continue
			}
		case "out":
			if p.StockQuantity > 0 {
				continue
			}
		case "issues":
			if r.ReadyCount() == len(models.ListingChannels) {
				continue
			}
		}
		out = append(out, p)
	}
	return out
}

func catalogViewHref(view, q string) string {
	h := "/tab/catalog"
	var parts []string
	if view != "" {
		parts = append(parts, "view="+view)
	}
	if q != "" {
		parts = append(parts, "q="+strings.ReplaceAll(q, " ", "+"))
	}
	if len(parts) > 0 {
		h += "?" + strings.Join(parts, "&")
	}
	return h
}

templ CatalogTab(data models.DashboardViewData) {
	{{ m := data.Metrics }}
	{{ rows := catalogRows(data) }}
	{{ view := data.Query["view"] }}
	<div class="page-head">
		<div class="head-copy">
			<p>{ fmt.Sprintf("%d products · stock worth %s at selling price", m.Products, ZARWhole(m.CatalogValueZar)) }</p>
		</div>
		<div class="actions">
			<a class="btn ghost" href="/catalog/export.csv">Export CSV</a>
			<button class="btn ghost" type="button" onclick="document.getElementById('import-dialog').showModal()">Import spreadsheet</button>
			<a class="btn solid" href="/catalog/new">
				@IconSized("plus", 16)
				Add product
			</a>
		</div>
	</div>
	<section class="grid-kpi">
		<a class="card kpi" href="/tab/catalog" hx-get="/tab/catalog" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">Products</div>
			<div class="k-val">{ Int(m.Products) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d listed for sale", m.Published) }</div>
		</a>
		<a class="card kpi" href="/tab/catalog?view=issues" hx-get="/tab/catalog?view=issues" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">Listing problems</div>
			<div class="k-val">{ Int(m.FeedIssues) }</div>
			<div class="k-foot">can't list on every channel</div>
		</a>
		<a class="card kpi" href="/tab/catalog?view=low" hx-get="/tab/catalog?view=low" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">Low stock</div>
			<div class="k-val">{ Int(len(m.LowStock)) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d out of stock", m.OutOfStock) }</div>
		</a>
		<div class="card kpi">
			<div class="k-label">Stock value</div>
			<div class="k-val">{ ZARWhole(m.CatalogValueZar) }</div>
			<div class="k-foot">{ fmt.Sprintf("%s units at selling price", Int(m.CatalogUnits)) }</div>
		</div>
	</section>
	<section class="card">
		<div class="panel" style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; border-bottom:1px solid var(--line);">
			<form hx-get="/tab/catalog" hx-target="#tab-content" hx-push-url="true" style="flex:1 1 260px;">
				<input type="hidden" name="view" value={ view }/>
				<label class="sr-only" for="catalog-q">Search products</label>
				<input class="input" id="catalog-q" type="search" name="q" value={ data.Query["q"] } placeholder="Search by name, SKU, brand or barcode" hx-get="/tab/catalog" hx-trigger="input changed delay:350ms, search" hx-include="closest form" hx-target="#tab-content" hx-push-url="true"/>
			</form>
			<div class="seg" role="group" aria-label="Filter products">
				for _, f := range [][2]string{{"", "All"}, {"issues", "Listing problems"}, {"low", "Low stock"}, {"out", "Out of stock"}} {
					<a href={ templ.SafeURL(catalogViewHref(f[0], data.Query["q"])) } hx-get={ catalogViewHref(f[0], data.Query["q"]) } hx-target="#tab-content" hx-push-url="true" class={ templ.KV("on", view == f[0]) } aria-pressed={ fmt.Sprint(view == f[0]) }>{ f[1] }</a>
				}
			</div>
		</div>
		if len(rows) == 0 {
			<div class="empty">
				<div class="empty-icon">
					@IconSized("catalog", 22)
				</div>
				if len(data.Catalog) == 0 {
					<h3>No products yet</h3>
					<p>Add your first product, or import a spreadsheet of your catalogue.</p>
					<a class="btn solid" href="/catalog/new">Add product</a>
				} else {
					<h3>No products match</h3>
					<p>Try a different search or filter.</p>
					<a class="btn ghost" href="/tab/catalog" hx-get="/tab/catalog" hx-target="#tab-content" hx-push-url="true">Clear filters</a>
				}
			</div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Product</th>
							<th class="r">Price (excl. VAT)</th>
							<th class="r">In stock</th>
							<th>Listing</th>
							<th>Available</th>
							<th><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, sku := range rows {
							{{ r := data.Readiness[sku.ID] }}
							<tr>
								<td>
									<a class="link" href={ templ.SafeURL("/catalog/" + sku.ID) } hx-get={ "/catalog/" + sku.ID } hx-target="#tab-content" hx-push-url="true">{ sku.Title }</a>
									<div class="small-text muted"><span class="mono">{ sku.SKU }</span> · { sku.Category }</div>
								</td>
								<td class="r">
									<form hx-post={ "/catalog/" + sku.ID + "/price" } hx-trigger="change" hx-swap="none" class="money-field">
										<span aria-hidden="true">R</span>
										<label class="sr-only" for={ "price-" + sku.ID }>{ "Price for " + sku.Title }</label>
										<input class="input money" id={ "price-" + sku.ID } data-price-input type="number" name="price" min="0" step="0.01" inputmode="decimal" value={ fmt.Sprintf("%.2f", sku.WholesaleZar) }/>
									</form>
								</td>
								<td class="r num">
									<b>{ Int(sku.StockQuantity) }</b>
									if sku.StockQuantity <= 0 {
										<div><span class="chip bad">Out</span></div>
									} else if sku.LowStockAlert > 0 && sku.StockQuantity <= sku.LowStockAlert {
										<div><span class="chip warn">Low</span></div>
									}
								</td>
								<td>
									<a href={ templ.SafeURL("/catalog/" + sku.ID) } hx-get={ "/catalog/" + sku.ID } hx-target="#tab-content" hx-push-url="true" class="cluster" title="See what's missing">
										<span class={ listingChip(r) }>{ fmt.Sprintf("%d/100", r.Score) }</span>
										<span class="small-text muted">{ fmt.Sprintf("%d of %d channels", r.ReadyCount(), len(models.ListingChannels)) }</span>
									</a>
								</td>
								<td>
									@StockButtonComponent(sku)
								</td>
								<td class="r">
									<a class="btn ghost small" href={ templ.SafeURL("/catalog/" + sku.ID + "/edit") } hx-get={ "/catalog/" + sku.ID + "/edit" } hx-target="#tab-content" hx-push-url="true">Edit</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
	<p class="muted small-text" style="margin-top:10px;">Price changes save as soon as you leave the field. Each one is logged, and you can undo it from the confirmation.</p>
	@ImportDialog()
}

// ImportDialog uploads a spreadsheet of products.
templ ImportDialog() {
	<dialog id="import-dialog" class="modal-dialog" aria-labelledby="import-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="import-title">Import products from a spreadsheet</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/catalog/import" hx-encoding="multipart/form-data" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<div class="modal-body">
					<div class="form-group">
						<label for="import-file">CSV file</label>
						<input id="import-file" type="file" name="file" accept=".csv,text/csv" class="input" required/>
						<p class="help">Save your spreadsheet as CSV. It needs at least a SKU and a Title column; Price, Stock, Barcode, Category, Brand and Description are picked up too.</p>
					</div>
					<ul class="small-text muted" style="padding-left:18px; display:grid; gap:4px;">
						<li>New SKUs are added with their opening stock.</li>
						<li>Existing SKUs get the new details and price. Their stock isn't changed.</li>
						<li>Up to 5 000 rows at a time.</li>
					</ul>
				</div>
				<div class="modal-foot">
					<a class="btn quiet" href="/catalog/import-template.csv" style="margin-right:auto;">Download template</a>
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Import</button>
				</div>
			</form>
		</div>
	</dialog>
}

func listingChip(r models.ProductReadiness) string {
	switch {
	case r.ReadyCount() == len(models.ListingChannels):
		return "chip ok"
	case r.ReadyCount() == 0:
		return "chip bad"
	}
	return "chip warn"
}

// StockButtonComponent toggles whether a product is offered for sale.
templ StockButtonComponent(sku models.CatalogSKU) {
	<button
		type="button"
		id={ "stock-btn-" + sku.ID }
		hx-post={ "/catalog/" + sku.ID + "/toggle-stock" }
		hx-target={ "#stock-btn-" + sku.ID }
		hx-swap="outerHTML"
		class={ "toggle", templ.KV("on", sku.InStock) }
		role="switch"
		aria-checked={ fmt.Sprint(sku.InStock) }
		aria-label={ "Offer " + sku.Title + " for sale" }
		title={ availabilityTitle(sku) }
	></button>
}

func availabilityTitle(p models.CatalogSKU) string {
	if p.InStock {
		return "Available to buyers. Click to hide."
	}
	if p.StockQuantity <= 0 {
		return "Out of stock. Record a delivery to make it available."
	}
	return "Hidden from buyers. Click to make available."
}
