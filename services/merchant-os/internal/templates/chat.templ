package templates

import (
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

var dealStatuses = []string{"Negotiating", "Proforma Issued", "Stock Reserved", "Paid & Dispatched"}

func dealLabel(s string) string {
	switch s {
	case "Proforma Issued":
		return "Invoice sent"
	case "Stock Reserved":
		return "Stock held"
	case "Paid & Dispatched":
		return "Paid & sent"
	}
	return s
}

func threadPhone(data models.DashboardViewData, t *models.ChatThread) string {
	for _, c := range data.Customers {
		if strings.EqualFold(c.Company, t.BuyerCompany) && c.Phone != "" {
			return c.Phone
		}
	}
	for _, l := range data.Leads {
		if strings.EqualFold(l.BuyerName, t.BuyerName) && l.BuyerPhone != "" {
			return l.BuyerPhone
		}
	}
	return ""
}

// ChatTab is the Inbox: conversations on the left, the selected
// conversation with quote, stock-hold and payment cards on the right.
// Internal notes are visibly separate and never shown to the buyer.
templ ChatTab(data models.DashboardViewData) {
	{{ active := data.GetActiveThread() }}
	<div class="inbox" style="display:grid; grid-template-columns:minmax(260px, 320px) minmax(0, 1fr); gap:var(--s-4); align-items:start;">
		<section class="card" aria-label="Conversations">
			<div class="panel" style="border-bottom:1px solid var(--line);">
				<label class="sr-only" for="inbox-q">Search conversations</label>
				<input class="input" id="inbox-q" type="search" placeholder="Search buyer, company or deal" oninput="document.querySelectorAll('[data-thread]').forEach(function(el){el.hidden=this.value&&el.dataset.thread.indexOf(this.value.toLowerCase())<0;}, this)"/>
			</div>
			if len(data.ChatThreads) == 0 {
				<div class="empty"><h3>No conversations yet</h3><p>Share your store link so buyers can message you.</p></div>
			}
			<div class="list">
				for _, t := range data.ChatThreads {
					<a
						class={ "li thread-item", templ.KV("active-thread", active != nil && t.ID == active.ID) }
						style="padding:12px 16px;"
						href={ templ.SafeURL("/chat/thread/" + t.ID) }
						hx-get={ "/chat/thread/" + t.ID }
						hx-target="#tab-content"
						hx-push-url="true"
						data-thread={ strings.ToLower(t.BuyerName + " " + t.BuyerCompany + " " + t.DealContext) }
						if active != nil && t.ID == active.ID {
							aria-current="true"
						}
					>
						<span class="thumb" style="border-radius:10px;" aria-hidden="true">{ t.AvatarInit }</span>
						<div class="txt">
							<b>{ t.BuyerName }</b>
							<span>{ t.BuyerCompany }</span>
							<span>{ t.LastMessage }</span>
						</div>
						<div class="val">
							<span>{ t.LastTime }</span>
							if t.UnreadCount > 0 {
								<span class="chip warn" style="margin-top:4px;">{ fmt.Sprintf("%d new", t.UnreadCount) }</span>
							}
						</div>
					</a>
				}
			</div>
		</section>
		if active != nil {
			<section class="card" aria-label={ "Conversation with " + active.BuyerName } style="display:flex; flex-direction:column; min-height:70vh;">
				<header class="panel" style="border-bottom:1px solid var(--line);">
					<div class="panel-head" style="margin:0;">
						<div class="who">
							<span class="av" aria-hidden="true">{ active.AvatarInit }</span>
							<div>
								<b>{ active.BuyerName }</b>
								<span>{ active.BuyerCompany } · { active.BuyerCity } · via { active.Channel }</span>
							</div>
						</div>
						<div class="right cluster">
							if phone := threadPhone(data, active); phone != "" {
								<a class="btn ghost small" target="_blank" rel="noopener" href={ templ.SafeURL(waLink(phone, "Hi "+active.BuyerName+", ")) }>WhatsApp</a>
							}
							<button type="button" class="btn ghost small" onclick="document.getElementById('stock-lock-modal').showModal()">Hold stock</button>
							<button type="button" class="btn solid small" onclick="document.getElementById('quote-modal').showModal()">Send quote</button>
						</div>
					</div>
					if active.DealContext != "" {
						<div class="cluster small-text" style="margin-top:10px;">
							<span class="chip info">{ active.DealContext }</span>
							if active.DealAmount > 0 {
								<b class="num">{ ZAR(active.DealAmount) }</b>
							}
							<form hx-post="/chat/action" hx-target="#tab-content" class="cluster" style="margin-left:auto;">
								<input type="hidden" name="thread_id" value={ active.ID }/>
								<input type="hidden" name="action" value="set_deal_status"/>
								<label for="deal-status" class="muted">Stage</label>
								<select id="deal-status" name="status" class="select" onchange="this.form.requestSubmit()">
									for _, st := range dealStatuses {
										<option value={ st } selected?={ active.DealStatus == st }>{ dealLabel(st) }</option>
									}
								</select>
							</form>
						</div>
					}
				</header>
				<div id="chat-messages-stream" class="panel" style="flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:12px; max-height:60vh;">
					for _, msg := range active.Messages {
						@ChatMessageView(data, active, msg)
					}
				</div>
				<footer class="panel" style="border-top:1px solid var(--line);">
					<form hx-post="/chat/send" hx-target="#tab-content" id="chat-send-form" hx-on::after-request="this.reset()">
						<input type="hidden" name="thread_id" value={ active.ID }/>
						<div class="seg" role="radiogroup" aria-label="Message type" style="margin-bottom:8px;">
							<label><input type="radio" name="is_internal" value="false" checked class="sr-only"/>Reply to buyer</label>
							<label><input type="radio" name="is_internal" value="true" class="sr-only"/>Internal note</label>
						</div>
						<div class="composer">
							<label class="sr-only" for="chat-input-text">Message</label>
							<input id="chat-input-text" name="message" type="text" placeholder="Write a reply…" autocomplete="off" required/>
							<button class="send" type="submit" aria-label="Send">
								@IconSized("chevron", 18)
							</button>
						</div>
						<p class="help" id="chat-mode-help">Buyers see replies. Internal notes are only visible to your team.</p>
					</form>
				</footer>
			</section>
			@QuoteDialog(data, active)
			@HoldStockDialog(data, active)
		} else {
			<div class="card empty"><h3>Select a conversation</h3></div>
		}
	</div>
	<script>
		(function () {
			var s = document.getElementById('chat-messages-stream');
			if (s) s.scrollTop = s.scrollHeight;
			var form = document.getElementById('chat-send-form');
			if (!form) return;
			function sync() {
				var internal = form.querySelector('input[name=is_internal]:checked').value === 'true';
				form.querySelectorAll('.seg label').forEach(function (l) { l.classList.toggle('on', l.querySelector('input').checked); });
				var input = document.getElementById('chat-input-text');
				input.placeholder = internal ? 'Note for your team (buyer won’t see this)…' : 'Write a reply…';
				input.style.background = internal ? 'var(--warning-soft)' : '';
			}
			form.addEventListener('change', sync);
			sync();
		})();
	</script>
	<style>
		@media (max-width: 900px) { .inbox { grid-template-columns: minmax(0, 1fr) !important; } }
	</style>
	<div hidden id="inbox-live" data-store={ data.Store.ID }></div>
	<script>
		// Live updates from the chat gateway: when a buyer message arrives,
		// reload the Inbox. Replies sent here are relayed to the buyer.
		(function () {
			var el = document.getElementById('inbox-live');
			if (!el || window.__inboxSocket) return;
			var storeId = el.dataset.store, room = 'conv_' + storeId;
			function connect() {
				try {
					var proto = location.protocol === 'https:' ? 'wss://' : 'ws://';
					var port = location.port === '3000' ? ':8080' : (location.port ? ':' + location.port : '');
					var ws = new WebSocket(proto + location.hostname + port + '/ws/chat?roomId=' + encodeURIComponent(room) + '&userId=merchant_' + encodeURIComponent(storeId) + '&role=merchant');
					window.__inboxSocket = ws;
					ws.onmessage = function (ev) {
						String(ev.data).split('
').forEach(function (line) {
							try {
								var d = JSON.parse(line);
								if (d.event === 'message_received' && d.message && d.message.senderRole !== 'merchant' && document.getElementById('chat-messages-stream') && window.htmx) {
									htmx.ajax('GET', location.pathname, { target: '#tab-content' });
								}
							} catch (e) {}
						});
					};
					ws.onclose = function () { window.__inboxSocket = null; if (document.getElementById('inbox-live')) setTimeout(connect, 5000); };
				} catch (e) {}
			}
			connect();
			document.addEventListener('shoppage:chat-sent', function (e) {
				var ws = window.__inboxSocket, text = e.detail && e.detail.message;
				if (ws && ws.readyState === 1 && text) ws.send(JSON.stringify({ action: 'send_message', conversationId: room, content: text }));
			});
		})();
	</script>
}

templ ChatMessageView(data models.DashboardViewData, t *models.ChatThread, msg models.ChatMessage) {
	if msg.IsInternalNote {
		<div class="notice warn" role="note">
			<div>
				<b>Internal note · { msg.SenderName }</b>
				<div>{ msg.Text }</div>
				<div class="small-text">{ LocalDateTime(msg.Timestamp) } · not visible to the buyer</div>
			</div>
		</div>
	} else {
		<div class={ "msg", templ.KV("me", msg.IsMerchant), templ.KV("bot", !msg.IsMerchant) }>
			<span class="ava" aria-hidden="true">
				if msg.IsMerchant {
					{ Initials(data.Store.Name) }
				} else {
					{ t.AvatarInit }
				}
			</span>
			<div>
				<div class="bubble">
					if msg.Text != "" {
						<div>{ msg.Text }</div>
					}
					if msg.Quote != nil {
						@QuoteCard(t, *msg.Quote)
					}
					if msg.StockLock != nil {
						<div class="card" style="padding:10px; margin-top:8px;">
							<b>Stock held · { msg.StockLock.LockID }</b>
							<div class="small-text">{ Int(msg.StockLock.Quantity) } × { msg.StockLock.ProductTitle } at { msg.StockLock.Warehouse }</div>
							<div class="small-text muted">Until { LocalDateTime(msg.StockLock.ExpiresAt) }</div>
						</div>
					}
					if msg.PaymentProof != nil {
						<div class="card" style="padding:10px; margin-top:8px;">
							<b>Proof of payment · { ZAR(msg.PaymentProof.AmountZar) }</b>
							<div class="small-text">{ msg.PaymentProof.BankName } · ref <span class="mono">{ msg.PaymentProof.ReferenceNumber }</span></div>
							if msg.PaymentProof.Verified {
								<div class="small-text" style="color:var(--success-ink);">Checked against the bank statement by { msg.PaymentProof.VerifiedBy }</div>
							} else {
								<div class="notice warn small-text" style="margin-top:6px;">A proof-of-payment slip isn't proof the money arrived. Check your bank statement before dispatching.</div>
								<form hx-post="/chat/action" hx-target="#tab-content" style="margin-top:6px;">
									<input type="hidden" name="thread_id" value={ t.ID }/>
									<input type="hidden" name="action" value="verify_pop"/>
									<button type="submit" class="btn solid small">I've seen it in my bank account</button>
								</form>
							}
						</div>
					}
				</div>
				<div class="small-text muted" style="margin-top:3px;">{ msg.SenderName } · { LocalDateTime(msg.Timestamp) }</div>
			</div>
		</div>
	}
}

templ QuoteCard(t *models.ChatThread, q models.StructuredQuote) {
	<div class="card" style="padding:10px; margin-top:8px;">
		<div class="cluster" style="justify-content:space-between;">
			<b>Quote { q.QuoteNumber }</b>
			<span class="chip info">{ q.Status }</span>
		</div>
		<div class="small-text">{ Int(q.Quantity) } × { q.ProductTitle } at { ZAR(q.UnitPriceZar) }</div>
		<div class="kv-list small-text" style="margin-top:6px;">
			<div class="kv-row"><span>Subtotal</span><b class="num">{ ZAR(q.SubtotalZar) }</b></div>
			<div class="kv-row"><span>VAT</span><b class="num">{ ZAR(q.VATZar) }</b></div>
			<div class="kv-row"><span>Total</span><b class="num">{ ZAR(q.TotalZar) }</b></div>
		</div>
		<div class="small-text muted">Valid until { LocalDate(q.ValidUntil) }</div>
		<form hx-post="/chat/action" hx-target="#tab-content" style="margin-top:6px;">
			<input type="hidden" name="thread_id" value={ t.ID }/>
			<input type="hidden" name="action" value="lock_stock"/>
			<input type="hidden" name="sku" value={ q.SKU }/>
			<input type="hidden" name="quantity" value={ fmt.Sprint(q.Quantity) }/>
			<button type="submit" class="btn ghost small">Hold this stock for 2 hours</button>
		</form>
	</div>
}

templ QuoteDialog(data models.DashboardViewData, t *models.ChatThread) {
	<dialog id="quote-modal" class="modal-dialog" aria-labelledby="cq-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="cq-title">Send a quote to { t.BuyerName }</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/chat/quote" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<input type="hidden" name="thread_id" value={ t.ID }/>
				<div class="modal-body">
					<div class="two-col">
						<div class="form-group">
							<label for="cq-sku">Product</label>
							<select id="cq-sku" name="sku" class="select-full">
								for _, p := range data.Catalog {
									<option value={ p.SKU }>{ p.Title } · { ZAR(p.WholesaleZar) }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="cq-qty">Quantity</label>
							<input id="cq-qty" type="number" name="quantity" class="input" min="1" required/>
						</div>
					</div>
					<p class="help">Your volume price tiers apply automatically. The buyer sees the quote with VAT in this conversation.</p>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Send quote</button>
				</div>
			</form>
		</div>
	</dialog>
}

templ HoldStockDialog(data models.DashboardViewData, t *models.ChatThread) {
	<dialog id="stock-lock-modal" class="modal-dialog" aria-labelledby="hs-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="hs-title">Hold stock for { t.BuyerName }</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/chat/action" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<input type="hidden" name="thread_id" value={ t.ID }/>
				<input type="hidden" name="action" value="lock_stock"/>
				<div class="modal-body">
					<div class="two-col">
						<div class="form-group">
							<label for="hs-sku">Product</label>
							<select id="hs-sku" name="sku" class="select-full">
								for _, p := range data.Catalog {
									<option value={ p.SKU }>{ p.Title } ({ Int(p.StockQuantity) } on hand)</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="hs-qty">Quantity</label>
							<input id="hs-qty" type="number" name="quantity" class="input" min="1" required/>
						</div>
					</div>
					<div class="form-group">
						<label for="hs-wh">Location</label>
						<select id="hs-wh" name="warehouse" class="select-full">
							for _, h := range data.Warehouses {
								<option value={ h.ID }>{ h.Name }</option>
							}
						</select>
					</div>
					<p class="help">The hold lasts 2 hours and is shown to the buyer in this conversation.</p>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Hold stock</button>
				</div>
			</form>
		</div>
	</dialog>
}
