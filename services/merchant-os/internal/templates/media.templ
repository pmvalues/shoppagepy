package templates

import (
	"fmt"

	"github.com/shoppage/merchant-os/internal/models"
)

templ MediaTab(data models.DashboardViewData) {
	<div class="page-head">
		<div class="head-copy">
			<p>Product photos, certificates, datasheets and brochures.</p>
		</div>
		<div class="actions">
			<button class="btn solid small" onclick="document.getElementById('upload-media-dialog')?.showModal();">
				Upload file
			</button>
		</div>
	</div>

	<!-- Storage Metrics (computed from records) -->
	<div class="three-col" style="margin-bottom:18px;">
		<div class="card kpi">
			<div class="k-label"><span>Assets Registered</span><span class="chip up">{ fmt.Sprintf("%d", len(data.MediaAssets)) }</span></div>
			<div class="k-val" style="font-size:1.5rem; margin:6px 0 2px;">{ fmt.Sprintf("%d Files", len(data.MediaAssets)) }</div>
			<div class="k-foot"><span class="then">uploaded or linked</span></div>
		</div>
		<div class="card kpi">
			<div class="k-label"><span>Compliance Documents</span><span class="chip up">Certificates</span></div>
			<div class="k-val" style="font-size:1.5rem; margin:6px 0 2px;">{ fmt.Sprintf("%d", MediaCountCategory(data.MediaAssets, "SABS")) } <span class="sub">Certificates</span></div>
			<div class="k-foot"><span class="then">Compliance certificates and datasheets</span></div>
		</div>
		<div class="card kpi">
			<div class="k-label"><span>Storage Used</span><span class="chip up">Local</span></div>
			<div class="k-val" style="font-size:1.5rem; margin:6px 0 2px;">{ fmt.Sprintf("%.2f", float64(MediaTotalKb(data.MediaAssets))/1024.0) } <span class="sub">MB Recorded</span></div>
			<div class="k-foot"><span class="then">Across all registered assets</span></div>
		</div>
	</div>

	<!-- Category Filter Toolbar -->
	<div class="card panel" style="padding:10px 14px; margin-bottom:18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
		<div style="display:flex; gap:6px; flex-wrap:wrap;">
			<button type="button" class="chip flat" onclick="filterMedia('all');">All Documents &amp; Photos</button>
			<button type="button" class="chip flat" onclick="filterMedia('sabs');">SABS Certificates</button>
			<button type="button" class="chip flat" onclick="filterMedia('photo');">Packshots &amp; Studio</button>
			<button type="button" class="chip flat" onclick="filterMedia('spec');">Datasheets</button>
		</div>
		<span style="font-size:12px; color:var(--muted);">{ fmt.Sprintf("%d files", len(data.MediaAssets)) }</span>
	</div>

	<!-- Media Asset Grid -->
	if len(data.MediaAssets) == 0 {
		<div class="card panel" style="padding:48px 24px; text-align:center;">
			<div style="font-size:34px; margin-bottom:10px;">@Icon("media")</div>
			<b style="display:block; margin-bottom:6px;">No media assets yet</b>
			<div style="font-size:12.5px; color:var(--muted); margin-bottom:16px;">Upload product photography or compliance documents to attach them to your catalogue.</div>
			<button class="btn solid small" onclick="document.getElementById('upload-media-dialog')?.showModal();">Upload your first asset</button>
		</div>
	}
	<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:14px;">
		for _, asset := range data.MediaAssets {
			<div class="card panel media-card" data-category={ asset.Category } style="display:flex; flex-direction:column; justify-content:space-between;">
				<div>
					<div style="height:110px; border-radius:8px; background:var(--surface-2); display:grid; place-items:center; font-size:38px; margin-bottom:12px; border:1px solid var(--line); overflow:hidden;">
						if MediaStoredLocally(asset) {
							<img src={ templ.SafeURL(asset.URL) } alt={ asset.Name } loading="lazy" style="width:100%; height:100%; object-fit:cover;"/>
						} else if asset.Category == "SABS Certificate" {
							@Icon("audit-logs")
						} else if asset.Category == "Spec Sheet" {
							@Icon("orders")
						} else {
							@Icon("media")
						}
					</div>
					<b style="font-size:13.5px; display:block; word-break:break-all; line-height:1.35;">{ asset.Name }</b>
					<div style="font-size:11.5px; color:var(--muted); margin-top:4px;">
						<span class="chip flat">{ asset.Category }</span> · { fmt.Sprintf("%d KB", asset.SizeKb) }
						if !MediaStoredLocally(asset) {
							<span class="chip flat">External link</span>
						}
					</div>
				</div>
				<div style="border-top:1px solid var(--line); padding-top:10px; margin-top:14px; display:flex; justify-content:space-between; align-items:center;">
					<span style="font-size:11px; color:var(--muted);">{ asset.UploadedAt.Format("02 Jan 2006") }</span>
					<div style="display:flex; gap:6px;">
						<a href={ templ.SafeURL(asset.URL) } target="_blank" class="btn solid small">View</a>
					</div>
				</div>
			</div>
		}
	</div>


	<!-- Upload Media Dialog (real multipart upload) -->
	<dialog id="upload-media-dialog" class="modal-dialog">
		<div class="modal-card">
			<div class="modal-head">
				<h4>Upload a Media Asset or Compliance Document</h4>
				<button type="button" class="close-btn" onclick="document.getElementById('upload-media-dialog').close();">&times;</button>
			</div>
			<form hx-post="/media/new" hx-encoding="multipart/form-data" hx-target="#tab-content" onsubmit="document.getElementById('upload-media-dialog')?.close();">
				<div class="modal-body">
					<div class="form-group">
						<label>File (PDF, JPG, PNG or WEBP — max 20 MB)</label>
						<input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,.webp" class="input"/>
					</div>
					<div class="form-group">
						<label>Display Name (optional — defaults to the file name)</label>
						<input type="text" name="name" class="input" placeholder="e.g. SABS 1422 Commercial Hotel Certificate 2026"/>
					</div>
					<div class="form-group">
						<label for="media-sku">Product (for product photos)</label>
						<select id="media-sku" name="sku" class="select-full">
							<option value="">Not for a specific product</option>
							for _, p := range data.Catalog {
								<option value={ p.SKU }>{ p.SKU } · { p.Title }</option>
							}
						</select>
						<p class="help">A product photo lets the product list on Google, Facebook, Instagram and WhatsApp.</p>
					</div>
					<div class="form-group">
						<label>Asset Category</label>
						<select name="category" class="select-full">
							<option value="SABS Certificate">SABS Compliance Certificate</option>
							<option value="Product Photography">Product Photography (Packshot)</option>
							<option value="Spec Sheet">Material Safety / Tech Datasheet</option>
							<option value="Trade Brochure">Wholesale Commercial Trade Brochure</option>
						</select>
					</div>
					<div class="form-group" style="border-top:1px dashed var(--line); padding-top:12px;">
						<label>Or link an externally hosted asset (URL)</label>
						<input type="text" name="url" class="input" placeholder="https://cdn.example.co.za/brochure.pdf"/>
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="document.getElementById('upload-media-dialog').close();">Cancel</button>
					<button type="submit" class="btn solid">Save Asset</button>
				</div>
			</form>
		</div>
	</dialog>

	<script>
		function filterMedia(cat) {
			var cards = document.querySelectorAll('.media-card');
			cards.forEach(function(card) {
				if (cat === 'all') {
					card.style.display = 'flex';
				} else if (cat === 'sabs') {
					card.style.display = card.dataset.category.includes('SABS') ? 'flex' : 'none';
				} else if (cat === 'photo') {
					card.style.display = card.dataset.category.includes('Photography') ? 'flex' : 'none';
				} else if (cat === 'spec') {
					card.style.display = card.dataset.category.includes('Spec') ? 'flex' : 'none';
				}
			});
		}
	</script>
}
