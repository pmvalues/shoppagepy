package templates

import (
	"fmt"
	"strings"
	"github.com/shoppage/merchant-os/internal/models"
)

templ InventoryTab(data models.DashboardViewData) {
	<div class="panel-head">
		<div>
			<h3>Inventory &amp; Multi-Warehouse Hubs</h3>
			<div class="sub">Regional depot distribution, double-entry ILE tracking &amp; safety stock allocations</div>
		</div>
		<div class="right">
			<a href="/inventory/export.csv" class="btn ghost small">
				<span>📥</span> Export Audit CSV
			</a>
			<button class="btn solid small" onclick="document.getElementById('adjust-modal')?.showModal();">
				<span>+</span> Stock Intake
			</button>
		</div>
	</div>

	<!-- Warehouse Hubs Overview -->
	<div class="grid-kpi" style="margin-bottom:18px;">
		for _, hub := range data.Warehouses {
			<div class="card kpi">
				<div class="k-label">
					<span>{ hub.Name }</span>
					<span class="chip up">{ hub.Status }</span>
				</div>
				<div class="k-val" style="font-size:1.6rem; margin:6px 0 2px;">
					{ fmt.Sprintf("%d", hub.SKUsStocked) } <span class="sub">SKUs</span>
				</div>
				<div class="k-foot">
					<span class="then">{ hub.Location }, { hub.Province }</span>
				</div>
				<div style="margin-top:10px;">
					<div style="display:flex; justify-content:space-between; font-size:11.5px; color:var(--muted); margin-bottom:4px;">
						<span>Depot Capacity</span>
						<b>{ fmt.Sprintf("%d%%", hub.CapacityUsedPct) }</b>
					</div>
					<div style="height:6px; border-radius:99px; background:var(--surface-2); overflow:hidden;">
						<div style={ fmt.Sprintf("height:100%%; background:var(--primary); width:%d%%; border-radius:99px;", hub.CapacityUsedPct) }></div>
					</div>
				</div>
			</div>
		}
		<!-- Inventory Asset Valuation Card -->
		<div class="card kpi">
			<div class="k-label">
				<span>Total Stock Valuation</span>
				<span class="chip up">FIFO Landed</span>
			</div>
			<div class="k-val" style="font-size:1.6rem; margin:6px 0 2px; color:var(--primary-2);">
				R 84,260 <span class="sub">ZAR</span>
			</div>
			<div class="k-foot">
				<span class="then">4 Active SKUs across 3 Hubs</span>
			</div>
			<div style="margin-top:10px; font-size:11px; color:var(--muted); display:flex; justify-content:space-between;">
				<span>Turnover Rate: <b>4.8x/yr</b></span>
				<span>Safety Deficit: <b style="color:var(--rose);">0</b></span>
			</div>
		</div>
	</div>

	<!-- Inventory Multi-Criteria Filter Bar (Matching Pemofy Inventory Workbench) -->
	<div class="card panel" style="padding:12px 16px; margin-bottom:14px; background:var(--surface); border:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
		<div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
			<!-- Search Filter -->
			<div class="search" style="min-width:240px;">
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4a7 7 0 105 12l4 4"></path></svg>
				<input 
					type="text" 
					id="inv-search-input" 
					placeholder="Search SKU code, title, or category…" 
					style="border:0; outline:0; background:transparent; width:100%; font-size:12.5px; color:var(--ink);"
					onkeyup="filterInventoryTable();"
				/>
			</div>

			<!-- Category Filter -->
			<select id="inv-category-filter" onchange="filterInventoryTable();" style="padding:4px 8px; font-size:12px; border-radius:7px; border:1px solid var(--line-strong); background:var(--surface); color:var(--ink); font-weight:500;">
				<option value="">All Categories</option>
				<option value="Hospitality Supplies">Hospitality Supplies</option>
				<option value="Packaging & Catering">Packaging &amp; Catering</option>
			</select>

			<!-- Stock Level Status Filter -->
			<select id="inv-stock-filter" onchange="filterInventoryTable();" style="padding:4px 8px; font-size:12px; border-radius:7px; border:1px solid var(--line-strong); background:var(--surface); color:var(--ink); font-weight:500;">
				<option value="">All Stock Levels</option>
				<option value="instock">In Stock</option>
				<option value="low">Low Stock Buffer Alert</option>
				<option value="depleted">Depleted / Out of Stock</option>
			</select>
		</div>

		<!-- Live Counter -->
		<div style="display:flex; align-items:center; gap:6px; font-size:12px; font-family:var(--mono); color:var(--muted);">
			<span>Showing:</span>
			<span id="inv-matching-count" style="font-weight:700; color:var(--ink);">{ fmt.Sprintf("%d", len(data.Catalog)) }</span>
			<span>of { fmt.Sprintf("%d", len(data.Catalog)) } SKUs</span>
		</div>
	</div>

	<script>
		function filterInventoryTable() {
			var searchVal = (document.getElementById('inv-search-input')?.value || '').toLowerCase().trim();
			var catVal = document.getElementById('inv-category-filter')?.value || '';
			var stockVal = document.getElementById('inv-stock-filter')?.value || '';
			var matchCount = 0;

			document.querySelectorAll('.inv-row').forEach(function(row) {
				var rowSearch = row.dataset.search || '';
				var rowCat = row.dataset.category || '';
				var rowStock = row.dataset.stockStatus || '';

				var matchesSearch = !searchVal || rowSearch.includes(searchVal);
				var matchesCat = !catVal || rowCat === catVal;
				var matchesStock = !stockVal || rowStock === stockVal;

				if (matchesSearch && matchesCat && matchesStock) {
					row.style.display = '';
					matchCount++;
				} else {
					row.style.display = 'none';
				}
			});

			var countEl = document.getElementById('inv-matching-count');
			if (countEl) countEl.textContent = matchCount;
		}
	</script>

	<!-- Stock Levels Table -->
	<div class="card panel" style="margin-bottom:18px;">
		<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px;">
			<div>
				<h4 style="font-size:15px; font-weight:700;">Live SKU Stock Matrix &amp; Multi-Hub Allocations</h4>
				<div style="font-size:12px; color:var(--muted);">Audited physical on-hand balances with real-time double-entry ledger integration</div>
			</div>
			<span style="font-size:12px; color:var(--muted);">{ fmt.Sprintf("%d SKUs in Catalog", len(data.Catalog)) }</span>
		</div>
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>SKU &amp; Title</th>
						<th>Category</th>
						<th>Total Stock</th>
						<th>Midrand (JHB)</th>
						<th>Cape Town (CPT)</th>
						<th>Durban (DBN)</th>
						<th>Buffer</th>
						<th>Status</th>
						<th>Quick Adjust</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range data.Catalog {
						<tr class="inv-row" data-search={ strings.ToLower(fmt.Sprintf("%s %s %s", item.SKU, item.Title, item.Category)) } data-category={ item.Category } data-stock-status={ func() string { if !item.InStock || item.StockQuantity == 0 { return "depleted" } else if item.StockQuantity <= item.LowStockAlert { return "low" } else { return "instock" } }() }>
							<td>
								<b>{ item.SKU }</b>
								<div style="font-size:12px; color:var(--muted);">{ item.Title }</div>
							</td>
							<td><span class="chip flat">{ item.Category }</span></td>
							<td>
								if item.InStock {
									<span class="stock" style="font-weight:700; color:var(--primary-2);">
										<i></i> { fmt.Sprintf("%d units", item.StockQuantity) }
									</span>
								} else {
									<span class="stock out" style="font-weight:700; color:var(--rose);">
										<i></i> Depleted (0)
									</span>
								}
							</td>
							<td>
								<span style="font-family:var(--mono); font-size:12px; font-weight:600;">
									{ fmt.Sprintf("%d", int(float64(item.StockQuantity)*0.65)) }
								</span>
							</td>
							<td>
								<span style="font-family:var(--mono); font-size:12px; font-weight:600;">
									{ fmt.Sprintf("%d", int(float64(item.StockQuantity)*0.25)) }
								</span>
							</td>
							<td>
								<span style="font-family:var(--mono); font-size:12px; font-weight:600;">
									{ fmt.Sprintf("%d", int(float64(item.StockQuantity)*0.10)) }
								</span>
							</td>
							<td>
								<span style="font-size:12px; color:var(--muted);">
									Min: { fmt.Sprintf("%d", item.LowStockAlert) }
								</span>
							</td>
							<td>
								if item.StockQuantity > item.LowStockAlert {
									<span class="chip up">Healthy</span>
								} else if item.StockQuantity > 0 {
									<span class="chip warn">Low Stock</span>
								} else {
									<span class="chip down">Depleted</span>
								}
							</td>
							<td>
								<form hx-post={ fmt.Sprintf("/inventory/%s/adjust", item.ID) } hx-target="#tab-content" style="display:flex; gap:6px; align-items:center;">
									<input type="number" name="adjustment" value="10" style="width:60px; padding:4px 6px; border:1px solid var(--line); border-radius:6px; font-size:12px;" />
									<button type="submit" class="btn ghost small" style="padding:4px 8px; font-size:11px;">+ Restock</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<!-- Multi-Warehouse Stock Allocation Breakdown Panel -->
	<div class="row-2">
		<div class="card panel">
			<h4 style="font-size:15px; font-weight:700; margin-bottom:6px;">Regional Depot Fulfillment SLAs</h4>
			<p style="font-size:12.5px; color:var(--muted); margin-bottom:14px;">Logistics corridors optimized for same-day dispatch via The Courier Guy.</p>

			<div style="display:grid; gap:10px; font-size:12.5px;">
				<div style="display:flex; justify-content:space-between; align-items:center; padding:10px 12px; background:var(--surface-2); border-radius:8px;">
					<div>
						<b>Gauteng Golden Triangle (JHB / PTA / Midrand)</b>
						<div style="font-size:11.5px; color:var(--muted);">Primary Hub ERF710 · Same-day delivery cut-off 14:00</div>
					</div>
					<span class="chip up">SLA 4 Hours</span>
				</div>
				<div style="display:flex; justify-content:space-between; align-items:center; padding:10px 12px; background:var(--surface-2); border-radius:8px;">
					<div>
						<b>Western Cape Corridor (CPT Depot)</b>
						<div style="font-size:11.5px; color:var(--muted);">Airport Industrial Park Unit 4 · Next-day dispatch</div>
					</div>
					<span class="chip up">SLA 24 Hours</span>
				</div>
				<div style="display:flex; justify-content:space-between; align-items:center; padding:10px 12px; background:var(--surface-2); border-radius:8px;">
					<div>
						<b>KZN Coastal Corridor (Durban Port)</b>
						<div style="font-size:11.5px; color:var(--muted);">Bayhead Harbor Hub · Road freight transfer buffer</div>
					</div>
					<span class="chip warn">SLA 48 Hours</span>
				</div>
			</div>
		</div>

		<div class="card panel">
			<h4 style="font-size:15px; font-weight:700; margin-bottom:6px;">Sovereign Stocktake Compliance</h4>
			<p style="font-size:12.5px; color:var(--muted); margin-bottom:14px;">Cryptographic double-entry integrity conforming to SARS Tax Invoice rules.</p>

			<div style="display:grid; gap:8px; font-size:12.5px;">
				<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--line); padding-bottom:6px;">
					<span style="color:var(--muted);">Valuation Method</span>
					<b>FIFO (First-In, First-Out)</b>
				</div>
				<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--line); padding-bottom:6px;">
					<span style="color:var(--muted);">SARS 15% VAT Tracking</span>
					<b style="color:var(--primary-2);">Automated on Inward / Outward</b>
				</div>
				<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--line); padding-bottom:6px;">
					<span style="color:var(--muted);">Audit Ledger Hash</span>
					<b style="font-family:var(--mono); font-size:11px;">pod-za-01:merkle:9e4b7</b>
				</div>
				<div style="display:flex; justify-content:space-between;">
					<span style="color:var(--muted);">Last Physical Audit</span>
					<b>Today, 09:30 SAST (Cycle Count)</b>
				</div>
			</div>
		</div>
	</div>

	<!-- Full-Blown Stock Intake Dialog -->
	<dialog id="adjust-modal" class="modal-dialog">
		<div class="modal-card">
			<div class="modal-head">
				<div>
					<div class="breadcrumb" style="margin-bottom:2px;">
						<span>Inventory</span>
						<span>&gt;</span>
						<b>Stock Intake &amp; Ledger Posting</b>
					</div>
					<h4 style="font-size:16px;">Post Warehouse Stock Intake / Adjustment</h4>
				</div>
				<button type="button" class="close-btn" onclick="document.getElementById('adjust-modal').close();">&times;</button>
			</div>
			<form hx-post="/inventory/intake" hx-target="#tab-content" onsubmit="document.getElementById('adjust-modal').close();">
				<div class="modal-body">
					<div class="form-group">
						<label>Product SKU to Adjust</label>
						<select name="skuId" class="select-full">
							for _, item := range data.Catalog {
								<option value={ item.ID }>{ item.SKU } — { item.Title } (Current: { fmt.Sprintf("%d units", item.StockQuantity) })</option>
							}
						</select>
					</div>

					<div class="two-col">
						<div class="form-group">
							<label>Target Warehouse Hub</label>
							<select name="hubName" class="select-full">
								<option value="MIDRAND-01">Midrand Central Hub (JHB)</option>
								<option value="CPT-DOCK">Cape Town Depot (CPT)</option>
								<option value="DBN-TRANSIT">Durban Port Transit (DBN)</option>
							</select>
						</div>
						<div class="form-group">
							<label>Warehouse Storage Bin</label>
							<input type="text" name="bin" class="input" placeholder="e.g. Bay 4, Shelf B-02" value="Bay 4, Shelf B-02" required />
						</div>
					</div>

					<div class="two-col">
						<div class="form-group">
							<label>Movement Reason Code</label>
							<select name="reason" class="select-full">
								<option value="Purchase Order Inward">Purchase Order Inward (PO Receipt)</option>
								<option value="Sales Return">Customer Return (Restock)</option>
								<option value="Stocktake Physical Variance">Stocktake Physical Variance</option>
								<option value="Scrap / Damaged">Damaged / Scrap Write-Off (-)</option>
								<option value="Sample Requisition">Internal Trade Sample (-)</option>
							</select>
						</div>
						<div class="form-group">
							<label>Quantity Delta (units)</label>
							<input type="number" name="quantity" class="input" value="50" required />
							<div class="micro">Enter negative numbers for write-offs / deductions.</div>
						</div>
					</div>

					<div class="form-group">
						<label>Batch / Purchase Order Reference</label>
						<input type="text" name="batchRef" class="input" placeholder="e.g. PO-2026-9921" value="PO-2026-9921" required />
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="document.getElementById('adjust-modal').close();">Cancel</button>
					<button type="submit" class="btn solid">Post to Item Ledger (ILE)</button>
				</div>
			</form>
		</div>
	</dialog>
}
