package templates

import (
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

func inventoryRows(data models.DashboardViewData) []models.CatalogSKU {
	q := strings.ToLower(strings.TrimSpace(data.Query["q"]))
	stock := data.Query["stock"]
	var out []models.CatalogSKU
	for _, p := range data.Catalog {
		if q != "" && !strings.Contains(strings.ToLower(p.SKU+" "+p.Title+" "+p.Category+" "+p.Spec.Barcode), q) {
			continue
		}
		low := p.LowStockAlert > 0 && p.StockQuantity <= p.LowStockAlert
		switch stock {
		case "low":
			if !low {
				continue
			}
		case "out":
			if p.StockQuantity > 0 {
				continue
			}
		}
		out = append(out, p)
	}
	return out
}

func ledgerTone(entryType string, qty int) string {
	if qty < 0 {
		return "chip bad"
	}
	if strings.Contains(entryType, "Receipt") {
		return "chip ok"
	}
	return "chip info"
}

func ledgerLabel(entryType string) string {
	switch entryType {
	case "Positive Adjmt.":
		return "Adjustment +"
	case "Negative Adjmt.":
		return "Adjustment −"
	case "Purchase Receipt":
		return "Delivery in"
	case "Sale Shipment":
		return "Sale"
	case "Assembly Consumption":
		return "Used in assembly"
	case "Transfer Receipt":
		return "Transfer in"
	}
	return entryType
}

templ InventoryTab(data models.DashboardViewData) {
	{{ m := data.Metrics }}
	{{ rows := inventoryRows(data) }}
	{{ stock := data.Query["stock"] }}
	<div class="page-head">
		<div class="head-copy">
			<p>{ fmt.Sprintf("%s units across %d %s · worth %s at selling price", Int(m.CatalogUnits), len(m.Hubs), Plural(len(m.Hubs), "location", "locations"), ZARWhole(m.CatalogValueZar)) }</p>
		</div>
		<div class="actions">
			<a class="btn ghost" href="/inventory/export.csv">Export CSV</a>
			<button class="btn solid" type="button" onclick="document.getElementById('adjust-modal').showModal()">Record stock movement</button>
		</div>
	</div>
	<section class="grid-kpi">
		for _, h := range m.Hubs {
			<article class="card kpi">
				<div class="k-label">
					{ h.Hub.Name }
					if h.Hub.Status != "" && h.Hub.Status != "Operational" {
						<span class="chip warn">{ h.Hub.Status }</span>
					}
				</div>
				<div class="k-val">{ Int(h.Units) } <span class="sub">units</span></div>
				<div class="k-foot">{ fmt.Sprintf("%d %s · %s", h.Products, Plural(h.Products, "product", "products"), ZARWhole(h.ValueZar)) }</div>
				if h.Hub.CapacityUsedPct > 0 {
					<div style="margin-top:8px;">
						<div class="cluster small-text muted" style="justify-content:space-between;"><span>Space used (last recorded)</span><b>{ fmt.Sprintf("%d%%", h.Hub.CapacityUsedPct) }</b></div>
						<div class={ "progress", templ.KV("warn", h.Hub.CapacityUsedPct >= 80) } style="margin-top:4px;"><span style={ Width(float64(h.Hub.CapacityUsedPct)) }></span></div>
					</div>
				}
			</article>
		}
		<a class="card kpi" href="/tab/inventory?stock=low" hx-get="/tab/inventory?stock=low" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">Needs reordering</div>
			<div class="k-val">{ Int(len(m.LowStock)) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d out of stock", m.OutOfStock) }</div>
		</a>
	</section>
	<section class="card section">
		<div class="panel" style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; border-bottom:1px solid var(--line);">
			<form hx-get="/tab/inventory" hx-target="#tab-content" hx-push-url="true" style="flex:1 1 240px;">
				<input type="hidden" name="stock" value={ stock }/>
				<label class="sr-only" for="inv-q">Search stock</label>
				<input class="input" id="inv-q" type="search" name="q" value={ data.Query["q"] } placeholder="Search SKU, product or barcode" hx-get="/tab/inventory" hx-trigger="input changed delay:350ms, search" hx-include="closest form" hx-target="#tab-content" hx-push-url="true"/>
			</form>
			<div class="seg" role="group" aria-label="Filter stock">
				for _, f := range [][2]string{{"", "All"}, {"low", "Low"}, {"out", "Out of stock"}} {
					<a href={ templ.SafeURL("/tab/inventory?stock=" + f[0]) } hx-get={ "/tab/inventory?stock=" + f[0] } hx-target="#tab-content" hx-push-url="true" class={ templ.KV("on", stock == f[0]) }>{ f[1] }</a>
				}
			</div>
		</div>
		if len(rows) == 0 {
			<div class="empty">
				<h3>Nothing to show</h3>
				<p>No products match this filter.</p>
			</div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Product</th>
							for _, h := range data.Warehouses {
								<th class="r">{ h.Name }</th>
							}
							<th class="r">Total</th>
							<th class="r">Reorder at</th>
							<th>Adjust</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range rows {
							<tr>
								<td>
									<a class="link" href={ templ.SafeURL("/catalog/" + p.ID) } hx-get={ "/catalog/" + p.ID } hx-target="#tab-content" hx-push-url="true">{ p.Title }</a>
									<div class="small-text muted mono">{ p.SKU }</div>
								</td>
								for _, h := range data.Warehouses {
									<td class="r num">{ Int(p.StockByHub[h.ID]) }</td>
								}
								<td class="r num">
									<b>{ Int(p.StockQuantity) }</b>
									if p.StockQuantity <= 0 {
										<div><span class="chip bad">Out</span></div>
									} else if p.LowStockAlert > 0 && p.StockQuantity <= p.LowStockAlert {
										<div><span class="chip warn">Low</span></div>
									}
								</td>
								<td class="r num muted">{ Int(p.LowStockAlert) }</td>
								<td>
									<form class="cluster" hx-post={ "/inventory/" + p.ID + "/adjust" } hx-target="#tab-content" style="flex-wrap:nowrap;">
										<label class="sr-only" for={ "adj-hub-" + p.ID }>Location</label>
										<select id={ "adj-hub-" + p.ID } name="hub" class="select">
											for _, h := range data.Warehouses {
												<option value={ h.ID }>{ h.Name }</option>
											}
										</select>
										<label class="sr-only" for={ "adj-" + p.ID }>{ "Units to add or remove for " + p.SKU }</label>
										<input id={ "adj-" + p.ID } class="input" type="number" name="adjustment" placeholder="±0" style="width:84px; min-height:32px;" required/>
										<button type="submit" class="btn ghost small">Apply</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
	<section class="card">
		<div class="panel-head panel" style="margin:0; border-bottom:1px solid var(--line);">
			<div>
				<h3>Stock movements</h3>
				<div class="sub">Every change to stock, newest first</div>
			</div>
		</div>
		if len(data.ItemLedger) == 0 {
			<div class="empty"><p>No stock movements recorded yet.</p></div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>When</th>
							<th>Type</th>
							<th>Product</th>
							<th>Location</th>
							<th>Reference</th>
							<th class="r">Change</th>
							<th class="r">Left after</th>
						</tr>
					</thead>
					<tbody>
						for i, e := range data.ItemLedger {
							if i < 25 {
								<tr>
									<td class="small-text muted" title={ LocalDateTime(e.PostingDate) }>{ Ago(e.PostingDate, data.Metrics.Now) }</td>
									<td><span class={ ledgerTone(e.EntryType, e.Quantity) }>{ ledgerLabel(e.EntryType) }</span></td>
									<td><span class="mono">{ e.SKU }</span><div class="small-text muted">{ e.Description }</div></td>
									<td class="small-text">{ e.Location }</td>
									<td class="mono small-text">{ e.DocumentNo }</td>
									<td class="r num"><b>{ fmt.Sprintf("%+d", e.Quantity) }</b></td>
									<td class="r num">{ Int(e.RemainingQty) }</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		}
	</section>
	<dialog id="adjust-modal" class="modal-dialog" aria-labelledby="adjust-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="adjust-title">Record stock movement</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/inventory/intake" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<div class="modal-body">
					<div class="form-group">
						<label for="mv-sku">Product</label>
						<select id="mv-sku" name="skuId" class="select-full">
							for _, item := range data.Catalog {
								<option value={ item.ID }>{ item.SKU } · { item.Title } ({ Int(item.StockQuantity) } on hand)</option>
							}
						</select>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="mv-hub">Location</label>
							<select id="mv-hub" name="hubName" class="select-full">
								for _, h := range data.Warehouses {
									<option value={ h.ID }>{ h.Name }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="mv-reason">Reason</label>
							<select id="mv-reason" name="reason" class="select-full">
								<option value="Delivery received">Delivery received (+)</option>
								<option value="Sales Return">Customer return (+)</option>
								<option value="Count correction">Count correction (±)</option>
								<option value="Damaged or expired">Damaged or expired (−)</option>
								<option value="Sample or own use">Sample or own use (−)</option>
							</select>
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="mv-qty">Units</label>
							<input id="mv-qty" type="number" name="quantity" class="input" required inputmode="numeric"/>
							<p class="help">Use a minus sign to remove stock, e.g. −12.</p>
						</div>
						<div class="form-group">
							<label for="mv-ref">Reference (optional)</label>
							<input id="mv-ref" type="text" name="batchRef" class="input" placeholder="Supplier invoice or PO number"/>
						</div>
					</div>
					<div class="form-group">
						<label for="mv-bin">Shelf or bin (optional)</label>
						<input id="mv-bin" type="text" name="bin" class="input"/>
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Save movement</button>
				</div>
			</form>
		</div>
	</dialog>
}
