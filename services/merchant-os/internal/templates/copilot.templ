package templates

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

// followUpHref opens WhatsApp with a draft follow-up for a quoted lead. The
// merchant reviews and sends it; nothing is sent automatically.
func followUpHref(p models.Proposal, data models.DashboardViewData) string {
	for _, l := range data.Leads {
		if "follow_"+l.ID != p.ID {
			continue
		}
		phone := strings.TrimPrefix(strings.ReplaceAll(l.BuyerPhone, " ", ""), "+")
		msg := fmt.Sprintf("Hi %s, just checking in on our quote for %d × %s (%s). Happy to answer any questions. %s",
			l.BuyerName, l.Quantity, l.ItemRequested, models.FormatZAR(l.EstimatedTotal), data.Store.Name)
		return "https://wa.me/" + phone + "?text=" + url.QueryEscape(msg)
	}
	return ""
}

func proposalStatus(s string) string {
	switch s {
	case "applied":
		return "Approved"
	case "dismissed":
		return "Dismissed"
	case "undone":
		return "Undone"
	}
	return ""
}

templ CopilotTab(data models.DashboardViewData) {
	<div class="page-head">
		<div class="head-copy">
			if data.Nav.AIConnected {
				<p>Answers use your store's records. Suggestions change nothing until you approve them.</p>
			} else {
				<p>Rules-based assistant: answers are calculated from your store's records. No AI model is connected, and nothing changes until you approve it.</p>
			}
		</div>
	</div>
	<div class="row-2">
		<article class="card panel copilot" aria-labelledby="ask-title">
			<div class="panel-head">
				<h3 id="ask-title">Ask about your store</h3>
			</div>
			if len(data.CopilotMessages) == 0 {
				<div class="msg bot">
					<span class="ava" aria-hidden="true">S</span>
					<div class="bubble">Ask me about sales, top products, stock to reorder, unpaid orders, quotes or listings. I only use your records, and I'll say so when I can't answer.</div>
				</div>
			}
			for _, msg := range data.CopilotMessages {
				if msg.Role == "user" {
					<div class="msg me">
						<span class="ava" aria-hidden="true">{ Initials(accountName(data.Nav)) }</span>
						<div class="bubble">{ msg.Content }</div>
					</div>
				} else {
					<div class="msg bot">
						<span class="ava" aria-hidden="true">S</span>
						<div class="bubble">
							{ msg.Content }
							<div class="small-text muted" style="margin-top:4px;">{ LocalDateTime(msg.Timestamp) }</div>
						</div>
					</div>
				}
			}
			<form class="composer" hx-post="/copilot/ask" hx-target="#tab-content">
				<label class="sr-only" for="assistant-input">Question</label>
				<input type="text" id="assistant-input" name="prompt" placeholder="e.g. Which items need restocking?" autocomplete="off" required/>
				<button type="submit" class="send" aria-label="Ask">
					@IconSized("chevron", 18)
				</button>
			</form>
			<div class="suggest">
				for _, q := range []string{"Which items need restocking?", "What were my top products this month?", "Which orders are unpaid?", "How are my sales this month?"} {
					<button type="button" hx-post="/copilot/ask" hx-vals={ fmt.Sprintf(`{"prompt": %q}`, q) } hx-target="#tab-content">{ q }</button>
				}
			</div>
		</article>
		<article class="card panel" aria-labelledby="sugg-title">
			<div class="panel-head">
				<div>
					<h3 id="sugg-title">Suggestions</h3>
					<div class="sub">Each shows the data behind it. Approve, dismiss or undo.</div>
				</div>
			</div>
			if len(data.Proposals) == 0 {
				<div class="empty">
					<h3>No suggestions</h3>
					<p>Suggestions appear when stock runs low, a quote goes quiet, or a listing is missing something.</p>
				</div>
			}
			<div class="stack" style="gap:10px;">
				for _, p := range data.Proposals {
					if p.Status != "dismissed" {
						<div class={ "proposal", templ.KV("applied", p.Status == "applied") }>
							<div class="cluster">
								<b>{ p.Title }</b>
								if proposalStatus(p.Status) != "" {
									<span class="chip ok">{ proposalStatus(p.Status) }</span>
								}
							</div>
							<span class="why">{ p.Reason }</span>
							<span class="change">{ p.Change }</span>
							<div class="cluster">
								switch p.Kind {
									case "restock":
										if p.Status == "pending" || p.Status == "undone" {
											<button class="btn solid small" hx-post="/copilot/action" hx-vals={ fmt.Sprintf(`{"proposal": %q, "op": "approve"}`, p.ID) } hx-target="#tab-content">Approve draft</button>
										}
										if p.Status == "applied" {
											<button class="btn ghost small" hx-post="/copilot/action" hx-vals={ fmt.Sprintf(`{"proposal": %q, "op": "undo"}`, p.ID) } hx-target="#tab-content">
												@IconSized("undo", 14)
												Undo
											</button>
										}
									case "follow_up":
										if href := followUpHref(p, data); href != "" {
											<a class="btn solid small" href={ templ.SafeURL(href) } target="_blank" rel="noopener">Open in WhatsApp</a>
										}
									case "listing":
										<a class="btn solid small" href={ templ.SafeURL("/catalog/" + p.TargetID) } hx-get={ "/catalog/" + p.TargetID } hx-target="#tab-content" hx-push-url="true">See what's missing</a>
								}
								if p.Status == "pending" {
									<button class="btn quiet small" hx-post="/copilot/action" hx-vals={ fmt.Sprintf(`{"proposal": %q, "op": "dismiss"}`, p.ID) } hx-target="#tab-content">Dismiss</button>
								}
							</div>
						</div>
					}
				}
			</div>
		</article>
	</div>
}
