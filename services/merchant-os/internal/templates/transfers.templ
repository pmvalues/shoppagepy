package templates

import (
	"fmt"

	"github.com/shoppage/merchant-os/internal/models"
)

func inTransit(ts []models.StockTransfer) int {
	n := 0
	for _, t := range ts {
		if t.Status != "Received" {
			n++
		}
	}
	return n
}

// TransfersTab moves stock between locations. Units stay counted at the
// source until the transfer is received.
templ TransfersTab(data models.DashboardViewData) {
	<div class="page-head">
		<div class="head-copy">
			<p>{ fmt.Sprintf("%d in transit. Stock stays counted at the sending location until you mark it received.", inTransit(data.Transfers)) }</p>
		</div>
		<div class="actions">
			<button class="btn solid" type="button" onclick="document.getElementById('new-transfer-dialog').showModal()" disabled?={ len(data.Warehouses) < 2 }>
				@IconSized("plus", 16)
				New transfer
			</button>
		</div>
	</div>
	<section class="card">
		if len(data.Transfers) == 0 {
			<div class="empty">
				<div class="empty-icon">
					@IconSized("transfers", 22)
				</div>
				<h3>No transfers yet</h3>
				if len(data.Warehouses) < 2 {
					<p>Transfers move stock between locations. Add a second location to use them.</p>
				} else {
					<p>Move stock between your locations and keep counts right at both ends.</p>
				}
			</div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Transfer</th>
							<th>Route</th>
							<th>Product</th>
							<th class="r">Units</th>
							<th>Sent</th>
							<th>Status</th>
							<th><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, tr := range data.Transfers {
							<tr>
								<td class="mono"><b>{ tr.TransferRef }</b></td>
								<td>{ tr.SourceHub } → { tr.DestHub }<div class="small-text muted">{ tr.Carrier }</div></td>
								<td><span class="mono">{ tr.SKU }</span><div class="small-text muted">{ tr.ItemTitle }</div></td>
								<td class="r num">{ Int(tr.Quantity) }</td>
								<td class="small-text muted" title={ LocalDateTime(tr.DispatchedAt) }>
									{ Ago(tr.DispatchedAt, data.Metrics.Now) }
									if tr.Status != "Received" {
										<div>expected { LocalDate(tr.ExpectedAt) }</div>
									}
								</td>
								<td>
									if tr.Status == "Received" {
										<span class="status ok">Received</span>
									} else {
										<span class="status warn">In transit</span>
									}
								</td>
								<td class="r">
									if tr.Status != "Received" {
										<button class="btn solid small" type="button" hx-post={ "/transfers/" + tr.ID + "/receive" } hx-target="#tab-content" hx-confirm={ fmt.Sprintf("Mark %d × %s as received at %s?", tr.Quantity, tr.SKU, tr.DestHub) }>Mark received</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
	<dialog id="new-transfer-dialog" class="modal-dialog" aria-labelledby="tr-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="tr-title">New transfer</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/transfers/new" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<div class="modal-body">
					<div class="two-col">
						<div class="form-group">
							<label for="tr-from">From</label>
							<select id="tr-from" name="sourceHub" class="select-full">
								for _, h := range data.Warehouses {
									<option value={ h.ID }>{ h.Name }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="tr-to">To</label>
							<select id="tr-to" name="destHub" class="select-full">
								for i, h := range data.Warehouses {
									<option value={ h.ID } selected?={ i == 1 }>{ h.Name }</option>
								}
							</select>
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="tr-sku">Product</label>
							<select id="tr-sku" name="skuId" class="select-full">
								for _, p := range data.Catalog {
									<option value={ p.ID }>{ p.SKU } · { p.Title }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="tr-qty">Units</label>
							<input id="tr-qty" type="number" name="quantity" class="input" min="1" required inputmode="numeric"/>
						</div>
					</div>
					<div class="form-group">
						<label for="tr-carrier">Carrier (optional)</label>
						<input id="tr-carrier" type="text" name="carrier" class="input" placeholder="e.g. own vehicle, courier name"/>
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Send transfer</button>
				</div>
			</form>
		</div>
	</dialog>
}
