package templates

import (
	"fmt"

	"github.com/shoppage/merchant-os/internal/models"
)

func marginPct(p models.CatalogSKU) float64 {
	if p.RetailZar <= 0 {
		return 0
	}
	return (p.RetailZar - p.WholesaleZar) / p.RetailZar * 100
}

func stockTone(p models.CatalogSKU) string {
	switch {
	case p.StockQuantity <= 0:
		return "chip bad"
	case p.LowStockAlert > 0 && p.StockQuantity <= p.LowStockAlert:
		return "chip warn"
	}
	return "chip ok"
}

func stockLabel(p models.CatalogSKU) string {
	switch {
	case p.StockQuantity <= 0:
		return "Out of stock"
	case p.LowStockAlert > 0 && p.StockQuantity <= p.LowStockAlert:
		return "Low stock"
	}
	return "In stock"
}

// ProductDetailView is the product page: listing quality and where it can
// sell, stock by warehouse, and the facts on record.
templ ProductDetailView(sku models.CatalogSKU, r models.ProductReadiness, hubs []models.WarehouseHub) {
	<section id="detail">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/tab/catalog" hx-get="/tab/catalog" hx-target="#tab-content" hx-push-url="true">Products</a>
			@IconSized("chevron", 14)
			<span>{ sku.Title }</span>
		</nav>
		<div class="detail-head">
			<div class="head-copy">
				<h2>
					{ sku.Title }
					<span class={ stockTone(sku) }>{ stockLabel(sku) }</span>
				</h2>
				<p><span class="mono">{ sku.SKU }</span> · { sku.Brand } · { sku.Category }</p>
			</div>
			<div class="detail-actions">
				<a class="btn ghost" href={ templ.SafeURL("/catalog/" + sku.ID + "/edit") } hx-get={ "/catalog/" + sku.ID + "/edit" } hx-target="#tab-content" hx-push-url="true">
					Edit product
				</a>
			</div>
		</div>
		<div class="detail-grid">
			<article class="card info-card">
				<div class="price-line">
					<span class="large-price">{ ZAR(sku.WholesaleZar) }</span>
					<span class="muted">selling price, excl. VAT</span>
				</div>
				if sku.RetailZar > 0 {
					<p class="muted small-text" style="margin-top:4px;">
						Recommended retail { ZAR(sku.RetailZar) }
						if marginPct(sku) > 0 {
							· buyer's markup { Pct(marginPct(sku)) }
						}
					</p>
				}
				if sku.Spec.LongDesc != "" {
					<p class="description">{ sku.Spec.LongDesc }</p>
				} else {
					<div class="notice warn" style="margin:16px 0;">No description yet. Buyers and AI search both rely on it.</div>
				}
				<div class="info-grid">
					<div class="info-cell">
						<label>On hand</label>
						<b class="num">{ Int(sku.StockQuantity) } units</b>
						if sku.LowStockAlert > 0 {
							<p class="small-text muted">Reorder at { Int(sku.LowStockAlert) }</p>
						}
					</div>
					<div class="info-cell">
						<label>Stock value</label>
						<b class="num">{ ZARWhole(float64(sku.StockQuantity) * sku.WholesaleZar) }</b>
						<p class="small-text muted">at selling price</p>
					</div>
					<div class="info-cell">
						<label>Size</label>
						<b style="font-size:var(--fs-14)">
							if sku.Spec.Dimensions != "" {
								{ sku.Spec.Dimensions }
							} else {
								Not set
							}
						</b>
						if sku.Spec.WeightKg > 0 {
							<p class="small-text muted">{ fmt.Sprintf("%.3g kg packed", sku.Spec.WeightKg) }</p>
						}
					</div>
					<div class="info-cell">
						<label>Compliance on file</label>
						if sku.Spec.SABSApproved {
							<b style="font-size:var(--fs-14)">SABS approved</b>
							<p class="small-text muted">Keep the certificate in Photos &amp; documents</p>
						} else {
							<b style="font-size:var(--fs-14)">None recorded</b>
						}
					</div>
				</div>
				if len(hubs) > 0 {
					<h4 style="margin:4px 0 8px;">Stock by location</h4>
					<div class="kv-list">
						for _, h := range hubs {
							<div class="kv-row"><span>{ h.Name }</span><b class="num">{ Int(sku.StockByHub[h.ID]) }</b></div>
						}
					</div>
				}
			</article>
			<article class="card panel">
				<div class="panel-title">
					<h3>Listing quality</h3>
					<span class="muted small-text">{ fmt.Sprintf("Ready on %d of %d channels", r.ReadyCount(), len(models.ListingChannels)) }</span>
				</div>
				<div class="seo-score" style="margin-bottom:12px;">
					<div class={ ScoreClass(r.Score) } style={ ScoreStyle(r.Score) } role="img" aria-label={ fmt.Sprintf("Listing score %d out of 100", r.Score) }>
						<b>{ fmt.Sprint(r.Score) }</b>
					</div>
					<div>
						if len(r.FailedChecks()) == 0 {
							<b>Complete listing</b>
							<p class="muted small-text">Every channel's requirements are met.</p>
						} else {
							<b>{ fmt.Sprintf("%d %s to fix", len(r.FailedChecks()), Plural(len(r.FailedChecks()), "thing", "things")) }</b>
							<p class="muted small-text">Each fix below adds to the score and reach.</p>
						}
					</div>
				</div>
				<div class="channel-grid" style="margin-bottom:12px;">
					for _, ch := range models.ListingChannels {
						if r.ReadyOn(ch) {
							<div class="channel-pill ok"><span class="ic">✓</span><div>{ ch }<small>Listed</small></div></div>
						} else {
							<div class="channel-pill no"><span class="ic">!</span><div>{ ch }<small>Needs { joinShort(r.Blocked[ch]) }</small></div></div>
						}
					}
				</div>
				<div class="check-list">
					for _, c := range r.Checks {
						<div class="check">
							if c.Passed {
								<span class="ic ok" aria-label="Done">✓</span>
								<div><b>{ c.Label }</b></div>
							} else {
								<span class="ic no" aria-label="To fix">!</span>
								<div><b>{ c.Label }</b><p>{ c.Fix }</p></div>
							}
							<span class="pts">{ fmt.Sprintf("%d pts", c.Points) }</span>
						</div>
					}
				</div>
			</article>
		</div>
		<div class="detail-lower">
			<article class="card panel">
				<div class="panel-title"><h3>Product facts</h3></div>
				<div class="kv-list">
					<div class="kv-row"><span>SKU</span><b class="mono">{ sku.SKU }</b></div>
					<div class="kv-row"><span>Barcode</span><b class="mono">{ orDash(sku.Spec.Barcode) }</b></div>
					<div class="kv-row"><span>Brand</span><b>{ orDash(sku.Brand) }</b></div>
					<div class="kv-row"><span>Category</span><b>{ orDash(sku.Category) }</b></div>
					<div class="kv-row"><span>Material</span><b>{ orDash(sku.Spec.Material) }</b></div>
					<div class="kv-row"><span>Customs (HS) code</span><b class="mono">{ orDash(sku.Spec.HSCode) }</b></div>
				</div>
			</article>
			<article class="card panel">
				<div class="panel-title"><h3>Search keywords</h3></div>
				if len(sku.Spec.SEOTags) == 0 {
					<p class="muted small-text">No keywords yet. Add the words buyers type when they look for this.</p>
				} else {
					<div class="tag-list">
						for _, tag := range sku.Spec.SEOTags {
							<span>{ tag }</span>
						}
					</div>
				}
			</article>
			<article class="card panel">
				<div class="panel-title"><h3>History</h3></div>
				if len(sku.Spec.Activities) == 0 {
					<p class="muted small-text">No changes recorded yet.</p>
				}
				<div class="activity">
					for _, act := range sku.Spec.Activities {
						<div class="activity-row">
							<span class="bullet"></span>
							<span>{ act.Description }</span>
							<span class="time">{ act.TimeAgo }</span>
						</div>
					}
				</div>
			</article>
		</div>
	</section>
}

func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

func joinShort(items []string) string {
	switch len(items) {
	case 0:
		return ""
	case 1:
		return lowerFirst(items[0])
	}
	return lowerFirst(items[0]) + fmt.Sprintf(" + %d more", len(items)-1)
}

func lowerFirst(s string) string {
	if s == "" {
		return s
	}
	b := []byte(s)
	if b[0] >= 'A' && b[0] <= 'Z' && !(len(b) > 1 && b[1] >= 'A' && b[1] <= 'Z') {
		b[0] += 32
	}
	return string(b)
}

// NotFoundView is the workspace 404 body.
templ NotFoundView(title, message, href, action string) {
	<div class="card panel empty" style="margin-top:24px;">
		<div class="empty-icon" aria-hidden="true">
			@IconSized("search", 22)
		</div>
		<h3>{ title }</h3>
		<p>{ message }</p>
		<a class="btn solid" href={ templ.SafeURL(href) }>{ action }</a>
	</div>
}
