package templates

import (
	"fmt"
	"github.com/shoppage/merchant-os/internal/models"
)

templ ProformaInvoiceModal(store models.StoreProfile, order models.ProformaOrder) {
	<div class="modal-card" style="max-width:820px; background:#fff; color:#0d1c15;">
		<div class="modal-head" style="border-bottom:1px solid #e0e6e2; padding-bottom:12px;">
			<div>
				<span class="chip up">Official B2B Proforma Tax Invoice</span>
				<h3 style="margin-top:4px; font-size:1.4rem;">{ order.OrderNumber }</h3>
			</div>
			<div style="display:flex; gap:8px;">
				<button class="btn ghost small" onclick="window.print();">
					<span>🖨️</span> Print Invoice
				</button>
				<button type="button" class="close-btn" onclick="document.getElementById('modal-container').innerHTML = '';">&times;</button>
			</div>
		</div>

		<div class="modal-body" style="padding:20px 0;">
			<!-- Invoice Header -->
			<div style="display:flex; justify-content:space-between; margin-bottom:24px; gap:20px; flex-wrap:wrap;">
				<div>
					<div style="font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); font-weight:700;">SUPPLIER / ISSUER</div>
					<b style="font-size:16px; display:block; margin-top:2px;">{ store.LegalName }</b>
					<div style="font-size:12.5px; color:#37473e; line-height:1.4; margin-top:4px;">
						{ store.Address }<br/>
						{ store.City }, South Africa<br/>
						CIPC Reg: <b>{ store.CIPCRegistration }</b><br/>
						VAT No: <b>{ store.VATNumber }</b><br/>
						Email: { store.Email } · Tel: { store.Phone }
					</div>
				</div>

				<div style="text-align:right;">
					<div style="font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); font-weight:700;">PROFORMA DETAILS</div>
					<div style="font-size:13px; margin-top:4px; line-height:1.5;">
						Invoice No: <b>{ order.OrderNumber }</b><br/>
						Date Issued: <b>{ order.Date.Format("02 Jan 2006") }</b><br/>
						Payment Terms: <b>Bank EFT / Due on Presentation</b><br/>
						Settlement Status: <span class="chip warn" style="text-transform:uppercase;">{ order.Status }</span>
					</div>
				</div>
			</div>

			<!-- Invoiced To -->
			<div style="background:var(--surface-2); padding:14px; border-radius:9px; margin-bottom:20px; border:1px solid var(--line);">
				<div style="font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); font-weight:700; margin-bottom:4px;">INVOICED TO (BUYER)</div>
				<b style="font-size:14.5px;">{ order.Company }</b>
				<div style="font-size:12.5px; color:#37473e; margin-top:2px;">
					Attn: { order.Customer } · Tel: { order.Phone } · Email: { order.Email }<br/>
					Delivery: { order.Address }<br/>
					Buyer VAT: { order.VatNumber }
				</div>
			</div>

			<!-- Line Items Table -->
			<table class="table" style="margin-bottom:20px;">
				<thead>
					<tr>
						<th style="width:15%;">SKU</th>
						<th>Description</th>
						<th style="text-align:right; width:12%;">Qty</th>
						<th style="text-align:right; width:18%;">Unit Price</th>
						<th style="text-align:right; width:18%;">Total (Excl. VAT)</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range order.LineItems {
						<tr>
							<td><span style="font-family:var(--mono); font-size:12px;">{ item.SKU }</span></td>
							<td><b>{ item.Title }</b></td>
							<td style="text-align:right; font-family:var(--mono);">{ fmt.Sprintf("%d", item.Quantity) }</td>
							<td style="text-align:right; font-family:var(--mono);">{ fmt.Sprintf("R%.2f", item.UnitPriceZar) }</td>
							<td style="text-align:right; font-family:var(--mono); font-weight:700;">{ fmt.Sprintf("R%.2f", item.TotalZar) }</td>
						</tr>
					}
				</tbody>
			</table>

			<!-- Totals Breakdown -->
			<div style="display:flex; justify-content:flex-end; margin-bottom:24px;">
				<div style="width:280px; display:grid; gap:6px; font-size:13px;">
					<div style="display:flex; justify-content:space-between;">
						<span style="color:var(--muted);">Subtotal (Excl. VAT)</span>
						<b style="font-family:var(--mono);">{ fmt.Sprintf("R%.2f", order.SubtotalZar) }</b>
					</div>
					<div style="display:flex; justify-content:space-between;">
						<span style="color:var(--muted);">SARS VAT (15%)</span>
						<b style="font-family:var(--mono);">{ fmt.Sprintf("R%.2f", order.VatZar) }</b>
					</div>
					<div style="display:flex; justify-content:space-between; border-top:2px solid #0d1c15; padding-top:8px; font-size:16px;">
						<b>Total Due (ZAR)</b>
						<b style="font-family:var(--display); color:var(--primary-2);">{ fmt.Sprintf("R%.2f", order.GrandTotal) }</b>
					</div>
				</div>
			</div>

			<!-- Banking EFT Settlement Instructions -->
			<div style="border:1px dashed var(--primary); background:var(--primary-soft); padding:16px; border-radius:10px;">
				<b style="font-size:13.5px; color:var(--primary-2); display:block; margin-bottom:6px;">Direct Bank EFT Remittance Details</b>
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:10px; font-size:12px;">
					<div>
						<span style="color:var(--muted); display:block;">Bank</span>
						<b>{ store.BankName }</b>
					</div>
					<div>
						<span style="color:var(--muted); display:block;">Account Name</span>
						<b>{ store.LegalName }</b>
					</div>
					<div>
						<span style="color:var(--muted); display:block;">Account Number</span>
						<b style="font-family:var(--mono);">{ store.BankAccount }</b>
					</div>
					<div>
						<span style="color:var(--muted); display:block;">Branch Code</span>
						<b style="font-family:var(--mono);">{ store.BankBranchCode }</b>
					</div>
					<div>
						<span style="color:var(--muted); display:block;">Payment Reference</span>
						<b style="font-family:var(--mono); color:var(--rose);">{ order.BankingRef }</b>
					</div>
				</div>
			</div>
		</div>

		<div class="modal-foot">
			<a 
				href={ templ.SafeURL(fmt.Sprintf("https://wa.me/%s?text=Proforma%%20Invoice%%20%s%%20for%%20R%.2f%%20ready.%%20Please%%20use%%20EFT%%20ref%%20%s", order.Phone, order.OrderNumber, order.GrandTotal, order.BankingRef)) } 
				target="_blank" 
				class="btn ghost"
			>
				<span>💬</span> WhatsApp to Buyer
			</a>
			<button type="button" class="btn solid" onclick="document.getElementById('modal-container').innerHTML = '';">
				Done
			</button>
		</div>
	</div>
}
