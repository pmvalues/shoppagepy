package templates

import (
	"fmt"

	"github.com/shoppage/merchant-os/internal/models"
)

// invoiceTitle follows SA VAT rules: only a VAT-registered supplier may issue
// a tax invoice.
func invoiceTitle(store models.StoreProfile) string {
	if store.VATNumber != "" {
		return "Tax invoice"
	}
	return "Invoice"
}

templ ProformaInvoiceModal(store models.StoreProfile, order models.ProformaOrder) {
	<div class="modal-card" style="max-width:820px;" role="dialog" aria-modal="true" aria-labelledby="inv-title">
		<div class="modal-head">
			<div>
				<span class={ OrderStatusClass(order.Status) }>{ OrderStatusLabel(order.Status) }</span>
				<h3 id="inv-title" style="margin-top:6px;">{ invoiceTitle(store) } { order.OrderNumber }</h3>
			</div>
			<div class="cluster">
				<button class="btn ghost small" type="button" onclick="window.print()">Print</button>
				<button type="button" class="close-btn" aria-label="Close" onclick="document.getElementById('modal-container').innerHTML = ''">×</button>
			</div>
		</div>
		<div class="modal-body">
			<div class="two-col" style="margin-bottom:16px;">
				<div>
					<div class="small-text muted">From</div>
					<b>{ orText(store.LegalName, store.Name) }</b>
					<div class="small-text">
						{ store.Address }
						if store.City != "" {
							, { store.City }
						}
					</div>
					if store.CIPCRegistration != "" {
						<div class="small-text">Company reg. { store.CIPCRegistration }</div>
					}
					if store.VATNumber != "" {
						<div class="small-text">VAT no. { store.VATNumber }</div>
					}
					<div class="small-text">{ store.Email } · { store.Phone }</div>
				</div>
				<div>
					<div class="small-text muted">To</div>
					<b>{ order.Company }</b>
					if order.Customer != "" {
						<div class="small-text">Attn. { order.Customer }</div>
					}
					if order.Address != "" {
						<div class="small-text">{ order.Address }</div>
					}
					if order.VatNumber != "" {
						<div class="small-text">VAT no. { order.VatNumber }</div>
					}
					<div class="small-text">Date { LocalDate(order.Date) } · due { LocalDate(order.DueDate) }</div>
				</div>
			</div>
			<div class="table-wrap no-cards">
				<table class="table">
					<thead>
						<tr><th>Item</th><th class="r">Qty</th><th class="r">Unit price</th><th class="r">Amount</th></tr>
					</thead>
					<tbody>
						for _, it := range order.LineItems {
							<tr>
								<td>{ it.Title }<div class="small-text muted mono">{ it.SKU }</div></td>
								<td class="r num">{ Int(it.Quantity) }</td>
								<td class="r num">{ ZAR(it.UnitPriceZar) }</td>
								<td class="r num">{ ZAR(it.TotalZar) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="kv-list" style="max-width:300px; margin:14px 0 18px auto;">
				<div class="kv-row"><span>Subtotal</span><b class="num">{ ZAR(order.SubtotalZar) }</b></div>
				<div class="kv-row"><span>VAT (15%)</span><b class="num">{ ZAR(order.VatZar) }</b></div>
				<div class="kv-row" style="font-size:var(--fs-18);"><span style="color:var(--ink); font-weight:700;">Total</span><b class="num">{ ZAR(order.GrandTotal) }</b></div>
			</div>
			if store.BankAccount != "" {
				<div class="notice ok">
					<div>
						<b>Pay by EFT</b>
						<div class="small-text">{ store.BankName } · account { store.BankAccount } · branch { store.BankBranchCode } · account name { orText(store.LegalName, store.Name) }</div>
						<div class="small-text">Use reference <b class="mono">{ order.BankingRef }</b></div>
					</div>
				</div>
			} else {
				<div class="notice warn">Add your payout bank account in Settings so buyers can pay this invoice.</div>
			}
		</div>
		<div class="modal-foot">
			if order.Phone != "" {
				<a class="btn ghost" target="_blank" rel="noopener" href={ templ.SafeURL(waLink(order.Phone, fmt.Sprintf("Hi %s, here's invoice %s for %s. Please pay by EFT using reference %s. %s", order.Customer, order.OrderNumber, models.FormatZAR(order.GrandTotal), order.BankingRef, store.Name))) }>Send on WhatsApp</a>
			}
			<button type="button" class="btn solid" onclick="document.getElementById('modal-container').innerHTML = ''">Done</button>
		</div>
	</div>
}
