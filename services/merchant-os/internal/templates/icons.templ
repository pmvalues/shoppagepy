package templates

import "fmt"

// Icon renders a single-stroke SVG icon for the workspace navigation. The icon
// set replaces emoji in chrome (emoji remain allowed only inside user-generated
// content). All icons share one stroke width, cap and join so the shell reads
// as a single family.
templ Icon(name string) {
	@IconSized(name, 18)
}

// IconSized renders an icon at a given pixel size.
templ IconSized(name string, size int) {
	<svg class="nav-icon" width={ fmt.Sprint(size) } height={ fmt.Sprint(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "overview":
				<rect x="3" y="3" width="7.5" height="7.5" rx="1.5"></rect>
				<rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"></rect>
				<rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"></rect>
				<rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"></rect>
			case "orders":
				<path d="M13.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5z"></path>
				<path d="M13.5 3v5.5H19"></path>
				<path d="M9 13h6M9 17h6M9 9h2.5"></path>
			case "catalog":
				<path d="M21 8.5v7L12 20.5 3 15.5v-7L12 3.5z"></path>
				<path d="M3.3 8.6 12 13l8.7-4.4"></path>
				<path d="M12 13v7.5"></path>
			case "inventory":
				<path d="M3 9.5 12 4l9 5.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"></path>
				<path d="M8 21v-7h8v7"></path>
				<path d="M8 17h8"></path>
			case "customers":
				<circle cx="9.5" cy="8" r="3.2"></circle>
				<path d="M4 20a5.5 5.5 0 0 1 11 0"></path>
				<path d="M16 5.1a3.2 3.2 0 0 1 0 5.9"></path>
				<path d="M18.6 14.8a5.5 5.5 0 0 1 2.9 5.2"></path>
			case "pick-pack":
				<rect x="5" y="4.5" width="14" height="16.5" rx="2"></rect>
				<path d="M9 4.5V3.2A1.2 1.2 0 0 1 10.2 2h3.6A1.2 1.2 0 0 1 15 3.2v1.3"></path>
				<path d="m9 14.5 2 2 4-4.5"></path>
			case "manifests":
				<path d="M2.5 6.5h11.5v11H2.5z"></path>
				<path d="M14 10h4.2L21.5 13.5v4H14z"></path>
				<circle cx="6.5" cy="18.5" r="1.8"></circle>
				<circle cx="17.5" cy="18.5" r="1.8"></circle>
			case "transfers":
				<path d="M4 8h13"></path>
				<path d="m13 4.5 4 3.5-4 3.5"></path>
				<path d="M20 16H7"></path>
				<path d="m11 12.5-4 3.5 4 3.5"></path>
			case "scan":
				<path d="M4 6v12M8 6v12M11.5 6v9M14.5 6v12M18 6v10M21 6v12"></path>
			case "analytics":
				<path d="M3 20.5h18"></path>
				<path d="m5 16 5-5 3 3 6-7.5"></path>
				<path d="M16.5 6.5H19.5v3"></path>
			case "discounts":
				<path d="M12.6 2.5H21v8.4L11.9 20.9a1.6 1.6 0 0 1-2.3 0L3.1 14.4a1.6 1.6 0 0 1 0-2.3z"></path>
				<circle cx="16.2" cy="7.3" r="1.4"></circle>
			case "rfqs":
				<path d="M21 15a2 2 0 0 1-2 2H8l-4.5 4.5V5a2 2 0 0 1 2-2h13.5a2 2 0 0 1 2 2z"></path>
				<path d="M9.5 14.5l1.3-1.3 1.2 1.3 1.3-1.3 1.2 1.3"></path>
			case "pos":
				<rect x="2.5" y="5.5" width="19" height="13" rx="2.5"></rect>
				<path d="M2.5 9.5h19"></path>
				<path d="M6 14.5h4"></path>
			case "channels":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M3 12h18"></path>
				<path d="M12 3a15 15 0 0 1 0 18"></path>
				<path d="M12 3a15 15 0 0 0 0 18"></path>
			case "feeds":
				<path d="M4.5 11a8.5 8.5 0 0 1 8.5 8.5"></path>
				<path d="M4.5 5a14.5 14.5 0 0 1 14.5 14.5"></path>
				<circle cx="5.5" cy="18.5" r="1.4" fill="currentColor" stroke="none"></circle>
			case "editor":
				<path d="M12 21a9 9 0 1 1 0-18 8.5 8.5 0 0 1 8.5 8.5 2.5 2.5 0 0 1-2.5 2.5h-2a2 2 0 0 0-2 2c0 .7.3 1 .3 1.5a2 2 0 0 1-1.8 2.3z"></path>
				<circle cx="7.5" cy="10.5" r="1.1"></circle>
				<circle cx="10.5" cy="6.5" r="1.1"></circle>
				<circle cx="14.5" cy="6.5" r="1.1"></circle>
			case "media":
				<rect x="3" y="4.5" width="18" height="15" rx="2.5"></rect>
				<circle cx="8.5" cy="9.5" r="1.6"></circle>
				<path d="m3 17 5-5 4 4 3-3 6 6"></path>
			case "flow":
				<path d="M13 2.5 4 13.5h6L10.5 21.5 20 10h-6z"></path>
			case "copilot":
				<path d="m12 3.5 1.8 4.7 4.7 1.8-4.7 1.8L12 16.5l-1.8-4.7L5.5 10l4.7-1.8z"></path>
				<path d="m18.5 14.5.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9z"></path>
			case "chat":
				<path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.6 0-3.2-.4-4.5-1.2L3 20.5l1.7-5A8.5 8.5 0 1 1 21 11.5z"></path>
			case "audit-logs":
				<path d="M12 2.5l7.5 3v6c0 5-3.4 8.6-7.5 10-4.1-1.4-7.5-5-7.5-10v-6z"></path>
				<path d="m8.8 11.8 2.2 2.2 4.2-4.5"></path>
			case "settings":
				<circle cx="12" cy="12" r="3.2"></circle>
				<path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1.1-1.55 1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.55-1 1.7 1.7 0 0 0 .34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34 1.7 1.7 0 0 0 1.1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.88v.1c.28.58.9 1 1.6 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.5 1z"></path>
			case "external":
				<path d="M15 3h6v6"></path>
				<path d="M10 14 21 3"></path>
				<path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"></path>
			case "search":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			case "menu":
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			case "more":
				<circle cx="5" cy="12" r="1.2"></circle>
				<circle cx="12" cy="12" r="1.2"></circle>
				<circle cx="19" cy="12" r="1.2"></circle>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "logout":
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
				<path d="m16 17 5-5-5-5M21 12H9"></path>
			case "check":
				<path d="m5 12.5 4.5 4.5L19 7.5"></path>
			case "alert":
				<path d="M12 3.5 2.5 20h19z"></path>
				<path d="M12 10v4.5M12 17.5h.01"></path>
			case "store":
				<path d="M3.5 9.5 5 4h14l1.5 5.5"></path>
				<path d="M3.5 9.5a2.8 2.8 0 0 0 5.6 0 2.8 2.8 0 0 0 5.8 0 2.8 2.8 0 0 0 5.6 0"></path>
				<path d="M5 12.5V20h14v-7.5M10 20v-4.5h4V20"></path>
			case "chevron":
				<path d="m9 6 6 6-6 6"></path>
			case "collapse":
				<path d="m15 18-6-6 6-6"></path>
			case "undo":
				<path d="M9 14 4 9l5-5"></path>
				<path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"></path>
			case "image":
				<rect x="3" y="3" width="18" height="18" rx="2"></rect>
				<circle cx="9" cy="9" r="2"></circle>
				<path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
			case "barcode":
				<path d="M4 5v14M8 5v14M11 5v14M15 5v14M18 5v14M20 5v14"></path>
			case "offline":
				<path d="M2 2l20 20M8.5 16.4a5 5 0 0 1 7 0M12 20h.01M5 12.6a10 10 0 0 1 5.2-2.4M2 8.8a15 15 0 0 1 4.2-2.6"></path>
			default:
				<circle cx="12" cy="12" r="8"></circle>
		}
	</svg>
}
