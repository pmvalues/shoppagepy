package templates

import (
	"fmt"
	"github.com/shoppage/merchant-os/internal/models"
)

func joinTags(tags []string) string {
	res := ""
	for i, t := range tags {
		if i > 0 {
			res += ", "
		}
		res += t
	}
	return res
}

templ ProductEditModal(sku models.CatalogSKU) {
	<div class="modal-card" style="max-width:1160px; width:95%;">
		<form 
			hx-post={ fmt.Sprintf("/catalog/%s/edit", sku.ID) } 
			hx-target="#tab-content" 
			onsubmit="document.getElementById('modal-container').innerHTML = '';"
		>
			<div class="modal-body" style="padding: 24px;">
				<!-- Editor Bar -->
				<div class="editor-bar">
					<div class="head-copy">
						<div class="breadcrumb" style="margin: 0 0 6px;">
							<a href="javascript:void(0)" onclick="document.getElementById('modal-container').innerHTML = '';">Products</a>
							<svg viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
							<a href="javascript:void(0)" hx-get={ fmt.Sprintf("/catalog/%s", sku.ID) } hx-target="#modal-container">{ sku.Title }</a>
							<svg viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
							<span style="color:var(--ink); font-weight:600;">Edit</span>
						</div>
						<h1>Edit: { sku.Title }</h1>
						<p class="micro" style="margin: 4px 0 0;">Commercial Catalog SKU · { sku.SKU } · Sovereign Pod pod-za-01</p>
					</div>
					<div class="view-actions">
						<button type="button" class="btn ghost" onclick="document.getElementById('modal-container').innerHTML = '';">Discard changes</button>
						<button type="submit" class="btn solid" id="saveBtn">Save changes</button>
						<button type="button" class="close-btn" onclick="document.getElementById('modal-container').innerHTML = '';" title="Close">&times;</button>
					</div>
				</div>

				<!-- 5 Editor Tabs -->
				<div class="editor-tabs">
					<button type="button" class="active" onclick="switchEditTab('general', this)">General</button>
					<button type="button" onclick="switchEditTab('inventory', this)">Inventory</button>
					<button type="button" onclick="switchEditTab('variants', this)">Variants</button>
					<button type="button" onclick="switchEditTab('seo', this)">SEO &amp; discovery</button>
					<button type="button" onclick="switchEditTab('channels', this)">Channels</button>
				</div>

				<!-- 2-Column Editor Grid -->
				<div class="editor-grid">
					<!-- LEFT: Main Tabbed Content -->
					<div>
						<article class="card form-card">
							<!-- 1. GENERAL TAB -->
							<div id="tab-pane-general">
								<div class="form-group">
									<div class="form-label">
										<label for="productTitle">Product title</label>
										<span id="title-char-count">{ fmt.Sprintf("%d / 80", len(sku.Title)) }</span>
									</div>
									<input 
										class="input" 
										id="productTitle" 
										name="title" 
										value={ sku.Title } 
										oninput="document.getElementById('title-char-count').textContent = this.value.length + ' / 80';" 
										required 
									/>
								</div>

								<div class="form-group">
									<div class="form-label">
										<label for="description">Description &amp; Specifications</label>
										<span>Rich text</span>
									</div>
									<div class="rich">
										<div class="rich-tools">
											<button type="button" onclick="formatDesc('bold')"><b>B</b></button>
											<button type="button" onclick="formatDesc('italic')"><i>I</i></button>
											<button type="button" onclick="formatDesc('h2')">H2</button>
											<button type="button" onclick="formatDesc('list')">• List</button>
											<button type="button" onclick="formatDesc('link')">Link</button>
										</div>
										<textarea class="textarea" id="description" name="description" rows="4">{ sku.Spec.LongDesc }</textarea>
									</div>
									<div class="help">Use plain commercial specifications. Pemofy AI can also draft descriptions from product photos.</div>
								</div>

								<div class="form-group">
									<div class="form-label">
										<label>Product media</label>
										<span>1 of 8 images</span>
									</div>
									<div class="media-drop" onclick="document.getElementById('product-media-file').click();">
										<svg viewBox="0 0 24 24" fill="none"><path d="M12 16V4m0 0L8 8m4-4l4 4M5 12v6h14v-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
										<b>Drop images here or choose files</b>
										<span>WebP, JPG or PNG · up to 10 MB each</span>
										<input type="file" id="product-media-file" style="display:none;" accept="image/*" onchange="alert('Image selected: ' + this.files[0]?.name);"/>
									</div>
									<div class="media-current">
										<div style="width:48px; height:48px; border-radius:9px; background:linear-gradient(135deg, #dcefe4, #a7cfba); display:grid; place-items:center; font-size:22px; flex:none;">
											📦
										</div>
										<div class="micro" style="padding:2px 0;">
											<b>sku-{ sku.SKU }.webp</b><br/>
											<span style="color:var(--primary);">Optimised CDN asset · 124 KB</span>
										</div>
									</div>
								</div>

								<div class="form-group">
									<div class="form-label">
										<label>Pricing</label>
										<span>Currency: ZAR</span>
									</div>
									<div class="two-col">
										<div>
											<label class="help" for="wholesaleZar">Wholesale / Trade Price (excl. VAT)</label>
											<input class="input" id="wholesaleZar" name="wholesaleZar" type="number" step="0.01" value={ fmt.Sprintf("%.2f", sku.WholesaleZar) } required />
										</div>
										<div>
											<label class="help" for="retailZar">Compare-at Retail Price (incl. VAT)</label>
											<input class="input" id="retailZar" name="retailZar" type="number" step="0.01" value={ fmt.Sprintf("%.2f", sku.RetailZar) } required />
										</div>
									</div>
								</div>

								<div class="form-group">
									<div class="form-label">
										<label>Organisation</label>
										<span>Discovery &amp; Filters</span>
									</div>
									<div class="two-col">
										<div>
											<label class="help" for="category">Category</label>
											<select class="select-full" id="category" name="category">
												<option value="Hospitality Supplies" selected?={ sku.Category == "Hospitality Supplies" }>Hospitality Supplies</option>
												<option value="Packaging & Catering" selected?={ sku.Category == "Packaging & Catering" }>Packaging &amp; Catering</option>
												<option value="Eco Cleaning" selected?={ sku.Category == "Eco Cleaning" }>Eco Cleaning</option>
												<option value="Homeware & Ceramics" selected?={ sku.Category == "Homeware & Ceramics" }>Homeware &amp; Ceramics</option>
											</select>
										</div>
										<div>
											<label class="help" for="brand">Vendor / Brand</label>
											<input class="input" id="brand" name="brand" value={ sku.Brand } required />
										</div>
									</div>
									<div style="margin-top:10px;">
										<label class="help" for="material">Material Composition</label>
										<input class="input" id="material" name="material" value={ sku.Spec.Material } />
									</div>
								</div>
							</div>

							<!-- 2. INVENTORY TAB -->
							<div id="tab-pane-inventory" style="display:none;">
								<div class="form-group">
									<div class="form-label">
										<label>Inventory Tracking</label>
										<span>WMS Hub: Midrand Sovereign Hub</span>
									</div>
									<div class="two-col">
										<div>
											<label class="help">SKU Code</label>
											<input class="input" name="sku" value={ sku.SKU } required />
										</div>
										<div>
											<label class="help">Barcode (EAN-13)</label>
											<input class="input" name="barcode" value={ sku.Spec.Barcode } />
										</div>
									</div>
									<div class="two-col" style="margin-top:10px;">
										<div>
											<label class="help">Stock on Hand (Units)</label>
											<input class="input" name="stockQuantity" type="number" value={ fmt.Sprintf("%d", sku.StockQuantity) } required />
										</div>
										<div>
											<label class="help">Low-Stock Alert Threshold</label>
											<input class="input" name="lowStockAlert" type="number" value={ fmt.Sprintf("%d", sku.LowStockAlert) } required />
										</div>
									</div>
									<div class="switch-row" style="margin-top:14px;">
										<div>
											<b>Automatic Restock Workflow</b>
											<span>Issue restock purchase order proposal when stock hits alert threshold</span>
										</div>
										<button type="button" class="toggle on" onclick="this.classList.toggle('on')"></button>
									</div>
								</div>
							</div>

							<!-- 3. VARIANTS TAB -->
							<div id="tab-pane-variants" style="display:none;">
								<div class="form-group">
									<div class="form-label">
										<label>Wholesale Pack Variants</label>
										<span>Tiered B2B quantities</span>
									</div>
									<div style="background:var(--surface-2); border-radius:8px; padding:12px; border:1px solid var(--line);">
										<div class="variant-row" style="font-weight:700; font-size:11.5px; color:var(--muted); margin-bottom:8px;">
											<span>Variant / Pack Size</span>
											<span>SKU Suffix</span>
											<span>Price Adj.</span>
											<span></span>
										</div>
										<div class="variant-row">
											<input class="input" value="Single Carton Unit (Standard)" readonly />
											<input class="input" value={ sku.SKU } readonly />
											<input class="input" value="Base Price" readonly />
											<button type="button" class="remove" title="Base SKU">✓</button>
										</div>
										<div class="variant-row">
											<input class="input" value="Bulk Outer Box (1,000s)" />
											<input class="input" value={ sku.SKU + "-BULK" } />
											<input class="input" value="-15% Tier" />
											<button type="button" class="remove" onclick="this.parentElement.remove()">&times;</button>
										</div>
										<div class="variant-row">
											<input class="input" value="Pallet Layer (10,000s)" />
											<input class="input" value={ sku.SKU + "-PLT" } />
											<input class="input" value="-25% Tier" />
											<button type="button" class="remove" onclick="this.parentElement.remove()">&times;</button>
										</div>
										<button type="button" class="add-link" onclick="addVariantRow(this)">+ Add pack variant</button>
									</div>
								</div>
							</div>

							<!-- 4. SEO & DISCOVERY TAB -->
							<div id="tab-pane-seo" style="display:none;">
								<div class="form-group">
									<div class="form-label">
										<label>Search Engine Optimization</label>
										<span>SEO Score: { fmt.Sprintf("%d / 100", sku.Spec.SEOScore) }</span>
									</div>
									<div>
										<label class="help">SEO Page Title</label>
										<input class="input" name="seoTitle" value={ sku.Title + " | " + sku.Brand + " South Africa" } />
									</div>
									<div style="margin-top:10px;">
										<label class="help">Meta Description</label>
										<textarea class="textarea" name="metaDesc" rows="2">{ sku.Spec.LongDesc }</textarea>
									</div>
									<div style="margin-top:10px;">
										<label class="help">Tags (Comma-separated)</label>
										<input class="input" name="tags" value={ joinTags(sku.Spec.SEOTags) } />
									</div>
									<div class="micro" style="margin-top:8px; color:var(--primary-2);">
										✓ Generates valid Schema.org Product JSON-LD and OpenGraph tags for WhatsApp &amp; Google Merchant Center.
									</div>
								</div>
							</div>

							<!-- 5. CHANNELS TAB -->
							<div id="tab-pane-channels" style="display:none;">
								<div class="form-group">
									<div class="form-label">
										<label>Omnichannel Channel Routing</label>
										<span>Unified stock ledger</span>
									</div>
									<div class="switch-row">
										<div>
											<b>Direct Web Storefront</b>
											<span>Visible on your online storefront</span>
										</div>
										<button type="button" class="toggle on" onclick="this.classList.toggle('on'); document.getElementById('chk-direct').checked = this.classList.contains('on');"></button>
										<input type="checkbox" id="chk-direct" name="directStore" checked="checked" style="display:none;" />
									</div>
									<div class="switch-row">
										<div>
											<b>WhatsApp Commerce Desk</b>
											<span>Available in quick quote search &amp; buyer chats</span>
										</div>
										<button type="button" class="toggle on" onclick="this.classList.toggle('on'); document.getElementById('chk-wa').checked = this.classList.contains('on');"></button>
										<input type="checkbox" id="chk-wa" name="whatsappSync" checked="checked" style="display:none;" />
									</div>
									<div class="switch-row">
										<div>
											<b>Shoppage B2B Discovery Grid</b>
											<span>National South African commercial buyer index</span>
										</div>
										<button type="button" class="toggle on" onclick="this.classList.toggle('on'); document.getElementById('chk-shop').checked = this.classList.contains('on');"></button>
										<input type="checkbox" id="chk-shop" name="shoppagePublic" checked="checked" style="display:none;" />
									</div>
									<div class="switch-row">
										<div>
											<b>Google Merchant Center XML Feed</b>
											<span>Automated daily XML export</span>
										</div>
										<button type="button" class="toggle on" onclick="this.classList.toggle('on')"></button>
									</div>
								</div>
							</div>
						</article>
					</div>

					<!-- RIGHT: Side Form & Publishing Controls -->
					<aside class="side-form">
						<!-- Publish Card -->
						<article class="publish-card">
							<h3>Ready to publish?</h3>
							<p>Your product is visible on all active channels. Check inventory before you save.</p>
							<button type="submit" class="btn light" id="publishBtn">Save &amp; publish</button>
							<button type="button" class="btn line" id="draftBtn" onclick="document.getElementById('modal-container').innerHTML = '';">Cancel / Discard</button>
						</article>

						<!-- Inventory Snapshot -->
						<article class="card">
							<h3>Inventory Snapshot</h3>
							<div class="two-col" style="margin-top:10px;">
								<div>
									<label class="help">SKU</label>
									<input class="input" value={ sku.SKU } readonly style="background:var(--surface-2);" />
								</div>
								<div>
									<label class="help">Barcode</label>
									<input class="input" value={ sku.Spec.Barcode } readonly style="background:var(--surface-2);" />
								</div>
							</div>
							<div class="two-col" style="margin-top:10px;">
								<div>
									<label class="help">Stock on Hand</label>
									<b style="display:block; font-size:15px; margin-top:4px;">{ fmt.Sprintf("%d units", sku.StockQuantity) }</b>
								</div>
								<div>
									<label class="help">Reorder Buffer</label>
									<b style="display:block; font-size:15px; margin-top:4px;">{ fmt.Sprintf("%d units", sku.LowStockAlert) }</b>
								</div>
							</div>
							if sku.StockQuantity <= sku.LowStockAlert {
								<div class="alert" style="margin-top:12px;">
									<svg viewBox="0 0 24 24" fill="none"><path d="M12 3l9 17H3L12 3zM12 9v4m0 3v.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
									<span>Stock is at or below reorder threshold ({ fmt.Sprintf("%d", sku.StockQuantity) } &le; { fmt.Sprintf("%d", sku.LowStockAlert) }).</span>
								</div>
							}
						</article>

						<!-- Shipping & Logistics -->
						<article class="card">
							<h3>Shipping &amp; Logistics</h3>
							<div class="switch-row">
								<div>
									<b>Physical product</b>
									<span>Requires delivery or collection</span>
								</div>
								<button type="button" class="toggle on" onclick="this.classList.toggle('on')"></button>
							</div>
							<div class="two-col" style="margin-top:10px;">
								<div>
									<label class="help">Weight (kg)</label>
									<input class="input" name="weightKg" type="number" step="0.001" value={ fmt.Sprintf("%.3f", sku.Spec.WeightKg) } />
								</div>
								<div>
									<label class="help">HS Code</label>
									<input class="input" name="hsCode" value={ sku.Spec.HSCode } />
								</div>
							</div>
							<div style="margin-top:8px;">
								<label class="help">Dimensions (LxWxH or Diameter)</label>
								<input class="input" name="dimensions" value={ sku.Spec.Dimensions } />
							</div>
						</article>

						<!-- Store Visibility -->
						<article class="card">
							<h3>Store visibility</h3>
							<div class="switch-row">
								<div>
									<b>Online storefront</b>
									<span>Visible on your store</span>
								</div>
								<button type="button" class="toggle on" onclick="this.classList.toggle('on')"></button>
							</div>
							<div class="switch-row">
								<div>
									<b>WhatsApp catalog</b>
									<span>Available in order chats</span>
								</div>
								<button type="button" class="toggle on" onclick="this.classList.toggle('on')"></button>
							</div>
							<div class="switch-row">
								<div>
									<b>Shoppage discovery</b>
									<span>Public B2B marketplace index</span>
								</div>
								<button type="button" class="toggle on" onclick="this.classList.toggle('on')"></button>
							</div>
						</article>
					</aside>
				</div>
			</div>
		</form>

		<script>
			function switchEditTab(tabName, btn) {
				document.querySelectorAll('.editor-tabs button').forEach(function(b) { b.classList.remove('active'); });
				if (btn) btn.classList.add('active');
				
				var tabs = ['general', 'inventory', 'variants', 'seo', 'channels'];
				tabs.forEach(function(t) {
					var el = document.getElementById('tab-pane-' + t);
					if (el) el.style.display = (t === tabName) ? 'block' : 'none';
				});
			}

			function formatDesc(cmd) {
				var txt = document.getElementById('description');
				if (!txt) return;
				if (cmd === 'bold') txt.value += ' **bold**';
				else if (cmd === 'italic') txt.value += ' *italic*';
				else if (cmd === 'h2') txt.value += '\n\n## Section Title\n';
				else if (cmd === 'list') txt.value += '\n- Item 1\n- Item 2\n';
				else if (cmd === 'link') txt.value += ' [link text](https://)';
			}

			function addVariantRow(btn) {
				var div = document.createElement('div');
				div.className = 'variant-row';
				div.innerHTML = '<input class="input" placeholder="e.g. Master Carton 5,000s"><input class="input" placeholder="SKU-EXT"><input class="input" placeholder="-20% Tier"><button type="button" class="remove" onclick="this.parentElement.remove()">&times;</button>';
				btn.parentElement.insertBefore(div, btn);
			}
		</script>
	</div>
}
