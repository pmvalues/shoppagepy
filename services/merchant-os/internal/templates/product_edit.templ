package templates

import (
	"fmt"
	"github.com/shoppage/merchant-os/internal/models"
)

templ ProductEditModal(sku models.CatalogSKU) {
	<div class="modal-card" style="max-width:880px;">
		<div class="modal-head">
			<div>
				<div class="breadcrumb" style="margin-bottom:4px;">
					<span>Catalog</span>
					<span>&gt;</span>
					<b>Edit Product</b>
				</div>
				<h3>Edit: { sku.Title }</h3>
			</div>
			<button type="button" class="close-btn" onclick="document.getElementById('modal-container').innerHTML = '';">&times;</button>
		</div>

		<form hx-post={ fmt.Sprintf("/catalog/%s/edit", sku.ID) } hx-target="#tab-content" onsubmit="document.getElementById('modal-container').innerHTML = '';">
			<div class="modal-body">
				<div class="form-group">
					<label>Product Title</label>
					<input type="text" name="title" class="input" value={ sku.Title } required />
				</div>

				<div class="two-col">
					<div class="form-group">
						<label>SKU Code</label>
						<input type="text" name="sku" class="input" value={ sku.SKU } required />
					</div>
					<div class="form-group">
						<label>Brand</label>
						<input type="text" name="brand" class="input" value={ sku.Brand } required />
					</div>
				</div>

				<div class="two-col">
					<div class="form-group">
						<label>Wholesale Trade Price (ZAR)</label>
						<input type="number" step="0.01" name="wholesaleZar" class="input" value={ fmt.Sprintf("%.2f", sku.WholesaleZar) } required />
					</div>
					<div class="form-group">
						<label>Compare-at Retail Price (ZAR)</label>
						<input type="number" step="0.01" name="retailZar" class="input" value={ fmt.Sprintf("%.2f", sku.RetailZar) } required />
					</div>
				</div>

				<div class="two-col">
					<div class="form-group">
						<label>Stock Quantity on Hand</label>
						<input type="number" name="stockQuantity" class="input" value={ fmt.Sprintf("%d", sku.StockQuantity) } required />
					</div>
					<div class="form-group">
						<label>Low-Stock Reorder Buffer</label>
						<input type="number" name="lowStockAlert" class="input" value={ fmt.Sprintf("%d", sku.LowStockAlert) } required />
					</div>
				</div>

				<div class="two-col">
					<div class="form-group">
						<label>Category</label>
						<select name="category" class="select-full">
							<option value="Hospitality Supplies" selected?={ sku.Category == "Hospitality Supplies" }>Hospitality Supplies</option>
							<option value="Packaging & Catering" selected?={ sku.Category == "Packaging & Catering" }>Packaging &amp; Catering</option>
							<option value="Eco Cleaning" selected?={ sku.Category == "Eco Cleaning" }>Eco Cleaning</option>
						</select>
					</div>
					<div class="form-group">
						<label>HS Tariff Code (Export)</label>
						<input type="text" name="hsCode" class="input" value={ sku.Spec.HSCode } />
					</div>
				</div>

				<div class="form-group">
					<label>Description &amp; Specifications</label>
					<textarea name="description" class="textarea" rows="3">{ sku.Spec.LongDesc }</textarea>
				</div>

				<div style="background:var(--surface-2); padding:12px; border-radius:9px; margin-top:8px;">
					<b style="font-size:13px; display:block; margin-bottom:8px;">Omnichannel Distribution</b>
					<div style="display:flex; gap:16px; flex-wrap:wrap;">
						<label style="display:flex; align-items:center; gap:6px; font-size:12.5px;">
							<input type="checkbox" name="directStore" checked="checked" style="accent-color:var(--primary);" />
							Online Storefront
						</label>
						<label style="display:flex; align-items:center; gap:6px; font-size:12.5px;">
							<input type="checkbox" name="whatsappSync" checked="checked" style="accent-color:var(--primary);" />
							WhatsApp Catalog
						</label>
						<label style="display:flex; align-items:center; gap:6px; font-size:12.5px;">
							<input type="checkbox" name="shoppagePublic" checked="checked" style="accent-color:var(--primary);" />
							Shoppage Discovery Network
						</label>
					</div>
				</div>
			</div>

			<div class="modal-foot">
				<button type="button" class="btn ghost" onclick="document.getElementById('modal-container').innerHTML = '';">Cancel</button>
				<button type="submit" class="btn solid">Save Changes &amp; Publish</button>
			</div>
		</form>
	</div>
}
