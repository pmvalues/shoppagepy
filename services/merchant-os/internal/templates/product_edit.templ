package templates

import (
	"fmt"
	"sort"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

func joinTags(tags []string) string { return strings.Join(tags, ", ") }

func categories(catalog []models.CatalogSKU) []string {
	seen := map[string]bool{}
	var out []string
	for _, p := range catalog {
		if p.Category != "" && !seen[p.Category] {
			seen[p.Category] = true
			out = append(out, p.Category)
		}
	}
	sort.Strings(out)
	return out
}

func editAction(sku models.CatalogSKU, isNew bool) string {
	if isNew {
		return "/catalog/new"
	}
	return "/catalog/" + sku.ID + "/edit"
}

// ProductEditView is the single product record. Every field here feeds the
// store, the listing feeds and search, so the checklist on the right updates
// as the merchant types.
templ ProductEditView(data models.DashboardViewData, sku models.CatalogSKU, isNew bool) {
	{{ r := data.Readiness[sku.ID] }}
	<form id="product-form" hx-post={ editAction(sku, isNew) } hx-target="#tab-content" data-product-form>
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/tab/catalog" hx-get="/tab/catalog" hx-target="#tab-content" hx-push-url="true">Products</a>
			@IconSized("chevron", 14)
			if isNew {
				<span>New product</span>
			} else {
				<a href={ templ.SafeURL("/catalog/" + sku.ID) } hx-get={ "/catalog/" + sku.ID } hx-target="#tab-content" hx-push-url="true">{ sku.Title }</a>
				@IconSized("chevron", 14)
				<span>Edit</span>
			}
		</nav>
		<div class="detail-head">
			<div class="head-copy">
				if isNew {
					<h2>New product</h2>
					<p>Fill in what buyers need to know. You can save now and finish later.</p>
				} else {
					<h2>Edit product</h2>
					<p><span class="mono">{ sku.SKU }</span> · changes are live as soon as you save</p>
				}
			</div>
			<div class="detail-actions">
				if isNew {
					<a class="btn ghost" href="/tab/catalog" hx-get="/tab/catalog" hx-target="#tab-content" hx-push-url="true">Cancel</a>
				} else {
					<a class="btn ghost" href={ templ.SafeURL("/catalog/" + sku.ID) } hx-get={ "/catalog/" + sku.ID } hx-target="#tab-content" hx-push-url="true">Cancel</a>
				}
				<button type="submit" class="btn solid">
					if isNew {
						Save product
					} else {
						Save changes
					}
				</button>
			</div>
		</div>
		<div class="editor-grid">
			<div class="stack">
				<article class="card form-card">
					<h3 style="margin-bottom:12px;">What it is</h3>
					<div class="form-group">
						<div class="form-label"><label for="pe-title">Title</label><span data-count="pe-title">{ fmt.Sprintf("%d", len([]rune(sku.Title))) } / 150</span></div>
						<input class="input" id="pe-title" name="title" value={ sku.Title } placeholder="Brand, product type, size and key feature" required maxlength="150"/>
					</div>
					<div class="form-group">
						<div class="form-label"><label for="pe-desc">Description</label><span data-count="pe-desc">{ fmt.Sprintf("%d", len([]rune(sku.Spec.LongDesc))) } characters · aim for 150+</span></div>
						<textarea class="textarea" id="pe-desc" name="description" rows="5" placeholder="Materials, size, pack quantity, what it's for and who buys it">{ sku.Spec.LongDesc }</textarea>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="pe-cat">Category</label>
							<input class="input" id="pe-cat" name="category" value={ sku.Category } list="pe-cats"/>
							<datalist id="pe-cats">
								for _, c := range categories(data.Catalog) {
									<option value={ c }></option>
								}
							</datalist>
						</div>
						<div class="form-group">
							<label for="pe-brand">Brand</label>
							<input class="input" id="pe-brand" name="brand" value={ sku.Brand } placeholder="Or your store name for own-brand goods"/>
						</div>
					</div>
					<div class="form-group">
						<label for="pe-tags">Search keywords</label>
						<input class="input" id="pe-tags" name="tags" value={ joinTags(sku.Spec.SEOTags) } placeholder="Words buyers type, separated by commas"/>
					</div>
				</article>
				<article class="card form-card">
					<h3 style="margin-bottom:12px;">Price</h3>
					<div class="two-col">
						<div class="form-group">
							<label for="pe-price">Selling price (excl. VAT)</label>
							<input class="input money" id="pe-price" name="wholesaleZar" type="number" min="0" step="0.01" inputmode="decimal" value={ priceValue(sku.WholesaleZar) } required/>
						</div>
						<div class="form-group">
							<label for="pe-rrp">Recommended retail (optional)</label>
							<input class="input money" id="pe-rrp" name="retailZar" type="number" min="0" step="0.01" inputmode="decimal" value={ priceValue(sku.RetailZar) }/>
						</div>
					</div>
					<p class="help">Volume discounts come from your price tiers (Marketing → Promotions).</p>
				</article>
				<article class="card form-card">
					<h3 style="margin-bottom:12px;">Codes &amp; stock</h3>
					<div class="two-col">
						<div class="form-group">
							<label for="pe-sku">SKU</label>
							<input class="input mono" id="pe-sku" name="sku" value={ sku.SKU } required/>
						</div>
						<div class="form-group">
							<label for="pe-barcode">Barcode (EAN / GTIN)</label>
							<input class="input mono" id="pe-barcode" name="barcode" value={ sku.Spec.Barcode } inputmode="numeric" data-gtin/>
							<p class="help" data-gtin-help></p>
						</div>
					</div>
					<div class="two-col">
						if isNew {
							<div class="form-group">
								<label for="pe-stock">Opening stock</label>
								<input class="input" id="pe-stock" name="stockQuantity" type="number" min="0" inputmode="numeric" value="0"/>
							</div>
						} else {
							<div class="form-group">
								<label>On hand</label>
								<p style="padding:9px 0;"><b>{ Int(sku.StockQuantity) }</b> <a class="link small-text" href="/tab/inventory" hx-get="/tab/inventory" hx-target="#tab-content" hx-push-url="true">Record a movement</a></p>
							</div>
						}
						<div class="form-group">
							<label for="pe-reorder">Reorder when stock reaches</label>
							<input class="input" id="pe-reorder" name="lowStockAlert" type="number" min="0" inputmode="numeric" value={ fmt.Sprint(sku.LowStockAlert) }/>
						</div>
					</div>
				</article>
				<article class="card form-card">
					<h3 style="margin-bottom:12px;">Shipping details</h3>
					<div class="three-col">
						<div class="form-group">
							<label for="pe-weight">Packed weight (kg)</label>
							<input class="input" id="pe-weight" name="weightKg" type="number" min="0" step="0.001" inputmode="decimal" value={ weightValue(sku.Spec.WeightKg) }/>
						</div>
						<div class="form-group">
							<label for="pe-dims">Size</label>
							<input class="input" id="pe-dims" name="dimensions" value={ sku.Spec.Dimensions } placeholder="e.g. 44 × 22 × 1.4 cm"/>
						</div>
						<div class="form-group">
							<label for="pe-material">Material</label>
							<input class="input" id="pe-material" name="material" value={ sku.Spec.Material }/>
						</div>
					</div>
					<div class="form-group" style="max-width:240px;">
						<label for="pe-hs">Customs (HS) code, for export</label>
						<input class="input mono" id="pe-hs" name="hsCode" value={ sku.Spec.HSCode }/>
					</div>
				</article>
			</div>
			<aside class="side-form">
				<article class="card">
					<h3>Search preview</h3>
					<p class="small-text muted" style="margin-bottom:10px;">Roughly how the listing appears in Google and Shoppage search.</p>
					<div style="border:1px solid var(--line); border-radius:var(--r-lg); padding:12px;">
						<div class="small-text muted mono" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{ strings.TrimRight(data.Nav.PublicBaseURL, "/") }/p/{ sku.ID }</div>
						<div style="color:var(--info); font-size:var(--fs-16); font-weight:600; margin:2px 0;" data-preview-title>{ orText(sku.Title, "Product title") }</div>
						<div class="small-text"><b data-preview-price>{ ZAR(sku.WholesaleZar) }</b> · { stockLabel(sku) }</div>
						<div class="small-text muted" style="margin-top:4px;" data-preview-desc>{ previewDesc(sku.Spec.LongDesc) }</div>
					</div>
				</article>
				<article class="card">
					<h3>Listing checklist</h3>
					<div class="check-list" style="margin-top:6px;">
						for _, c := range models.ComputeReadiness(sku, r.HasPhoto).Checks {
							<div class="check" data-check={ c.Label }>
								if c.Passed {
									<span class="ic ok" aria-label="Done">✓</span>
								} else {
									<span class="ic no" aria-label="To do">!</span>
								}
								<div><b>{ c.Label }</b></div>
								<span class="pts">{ fmt.Sprintf("%d", c.Points) }</span>
							</div>
						}
					</div>
					if !isNew && !r.HasPhoto {
						<a class="btn ghost small block" style="margin-top:10px;" href="/tab/media" hx-get="/tab/media" hx-target="#tab-content" hx-push-url="true">Add a product photo</a>
					}
				</article>
			</aside>
		</div>
	</form>
	<script>
		(function () {
			var form = document.querySelector('[data-product-form]');
			if (!form) return;
			var $ = function (id) { return document.getElementById(id); };
			function validGTIN(c) {
				if (!/^(\d{8}|\d{12}|\d{13}|\d{14})$/.test(c)) return false;
				var sum = 0, n = c.length;
				for (var i = 0; i < n - 1; i++) { var d = +c[i]; if ((n - 1 - i) % 2 === 1) d *= 3; sum += d; }
				return (10 - sum % 10) % 10 === +c[n - 1];
			}
			function mark(label, ok) {
				var row = form.querySelector('[data-check="' + label + '"] .ic');
				if (!row) return;
				row.className = 'ic ' + (ok ? 'ok' : 'no'); row.textContent = ok ? '✓' : '!';
			}
			function update() {
				var t = $('pe-title').value.trim(), d = $('pe-desc').value.trim(), g = $('pe-barcode').value.trim(), p = parseFloat($('pe-price').value);
				form.querySelector('[data-count="pe-title"]').textContent = t.length + ' / 150';
				form.querySelector('[data-count="pe-desc"]').textContent = d.length + ' characters · aim for 150+';
				form.querySelector('[data-preview-title]').textContent = t || 'Product title';
				form.querySelector('[data-preview-desc]').textContent = d ? d.slice(0, 160) + (d.length > 160 ? '…' : '') : 'Add a description to show here.';
				form.querySelector('[data-preview-price]').textContent = 'R ' + (isNaN(p) ? 0 : p).toFixed(2);
				var help = form.querySelector('[data-gtin-help]');
				help.textContent = !g ? 'Printed under the barcode on the pack.' : validGTIN(g) ? 'Valid barcode.' : g.replace(/\D/g, '').length !== g.length ? 'Digits only.' : 'This barcode doesn’t check out. Re-enter it from the pack.';
				help.className = 'help' + (g && !validGTIN(g) ? ' field-error' : '');
				mark('Product title', t.length >= 20 && t.length <= 150);
				mark('Description', d.length >= 150);
				mark('Barcode (GTIN)', validGTIN(g));
				mark('Price', p > 0);
				mark('Category', $('pe-cat').value.trim() !== '');
				mark('Brand', $('pe-brand').value.trim() !== '');
				mark('Search keywords', $('pe-tags').value.split(',').filter(function (x) { return x.trim(); }).length >= 3);
				mark('Shipping weight', parseFloat($('pe-weight').value) > 0);
			}
			form.addEventListener('input', update);
			update();
		})();
	</script>
}

func priceValue(v float64) string {
	if v <= 0 {
		return ""
	}
	return fmt.Sprintf("%.2f", v)
}

func weightValue(v float64) string {
	if v <= 0 {
		return ""
	}
	return fmt.Sprintf("%g", v)
}

func orText(s, fallback string) string {
	if strings.TrimSpace(s) == "" {
		return fallback
	}
	return s
}

func previewDesc(d string) string {
	r := []rune(strings.TrimSpace(d))
	if len(r) == 0 {
		return "Add a description to show here."
	}
	if len(r) > 160 {
		return string(r[:160]) + "…"
	}
	return string(r)
}

templ ProductEditPage(data models.DashboardViewData, sku models.CatalogSKU, isNew bool) {
	@Layout(data.Store, "catalog", data.Nav) {
		@ProductEditView(data, sku, isNew)
	}
}
