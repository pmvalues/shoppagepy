package templates

import (
	"fmt"

	"github.com/shoppage/merchant-os/internal/models"
)

func seoTitle(data models.DashboardViewData) string {
	if data.Store.Storefront.SEOTitle != "" {
		return data.Store.Storefront.SEOTitle
	}
	t := data.Store.Name
	if data.Store.City != "" {
		t += " · " + data.Store.City
	}
	return t
}

func seoDesc(data models.DashboardViewData) string {
	sf := data.Store.Storefront
	switch {
	case sf.SEODescription != "":
		return sf.SEODescription
	case sf.About != "":
		return sf.About
	}
	return "Add a short description of what you sell and who you sell to."
}

// EditorTab edits the public store page and how it appears in search. The
// preview uses the same values; structured data only includes stored facts.
templ EditorTab(data models.DashboardViewData) {
	{{ sf := data.Store.Storefront }}
	<div class="page-head">
		<div class="head-copy">
			<p>Your store page on Shoppage, and how it shows up in Google and AI search.</p>
		</div>
		<div class="actions">
			<a class="btn ghost" href={ templ.SafeURL(storeLink(data)) } target="_blank" rel="noopener">View store</a>
		</div>
	</div>
	if data.Nav.DemoData {
		<div class="notice warn section">Demo: settings save here, but the public demo store doesn't read them yet. The preview shows how they'll look.</div>
	}
	<div class="row-2 even">
		<article class="card panel">
			<form hx-post="/editor/save" hx-target="#tab-content" data-store-form>
				<h3 style="margin-bottom:12px;">Store page</h3>
				<div class="form-group">
					<label for="sf-headline">Headline</label>
					<input id="sf-headline" type="text" name="heroHeadline" class="input" value={ sf.Headline } maxlength="90" placeholder="What you sell, in one line"/>
				</div>
				<div class="form-group">
					<label for="sf-about">About your business</label>
					<textarea id="sf-about" name="about" class="textarea" rows="3" maxlength="400" placeholder="Who you supply, where you deliver, what makes you different">{ sf.About }</textarea>
				</div>
				<div class="two-col">
					<div class="form-group">
						<label for="sf-hours">Trading hours</label>
						<input id="sf-hours" type="text" name="tradingHours" class="input" value={ sf.TradingHours } placeholder="Mon–Fri 08:00–17:00"/>
					</div>
					<div class="form-group">
						<label for="sf-ribbon">Announcement</label>
						<input id="sf-ribbon" type="text" name="ribbonText" class="input" value={ sf.Ribbon } maxlength="100"/>
					</div>
				</div>
				<label class="switch-row">
					<div><b>Show the announcement</b><span>A thin banner across the top of your store.</span></div>
					<input type="checkbox" name="ribbonActive" value="on" checked?={ sf.RibbonOn }/>
				</label>
				<label class="switch-row">
					<div><b>WhatsApp button</b><span>Lets buyers message you from any page.</span></div>
					<input type="checkbox" name="whatsappFloat" value="on" checked?={ sf.WhatsAppButton }/>
				</label>
				<h3 style="margin:18px 0 12px;">Search snippet</h3>
				<div class="form-group">
					<div class="form-label"><label for="sf-seo-title">Title</label><span data-count-for="sf-seo-title">{ fmt.Sprintf("%d / 60", len([]rune(sf.SEOTitle))) }</span></div>
					<input id="sf-seo-title" type="text" name="seoTitle" class="input" value={ sf.SEOTitle } maxlength="70" placeholder={ seoTitle(data) }/>
				</div>
				<div class="form-group">
					<div class="form-label"><label for="sf-seo-desc">Description</label><span data-count-for="sf-seo-desc">{ fmt.Sprintf("%d / 155", len([]rune(sf.SEODescription))) }</span></div>
					<textarea id="sf-seo-desc" name="seoDescription" class="textarea" rows="2" maxlength="170" placeholder="Leave blank to use your About text">{ sf.SEODescription }</textarea>
				</div>
				<div style="text-align:right;"><button type="submit" class="btn solid">Save store page</button></div>
			</form>
		</article>
		<div class="stack">
			<article class="card panel">
				<h3 style="margin-bottom:10px;">Preview</h3>
				<div class="card" style="overflow:hidden;">
					if sf.RibbonOn && sf.Ribbon != "" {
						<div style="background:var(--sidebar); color:#fff; font-size:var(--fs-12); text-align:center; padding:6px 10px;" data-pv="ribbon">{ sf.Ribbon }</div>
					}
					<div style="padding:16px;">
						<div class="who" style="margin-bottom:10px;">
							<span class="av" aria-hidden="true">{ Initials(data.Store.Name) }</span>
							<div><b>{ data.Store.Name }</b><span>{ data.Store.City }</span></div>
						</div>
						<h3 data-pv="headline">{ orText(sf.Headline, "Your headline") }</h3>
						<p class="small-text muted" style="margin-top:4px;" data-pv="about">{ orText(sf.About, "Tell buyers about your business.") }</p>
						<p class="small-text" style="margin-top:8px;">{ fmt.Sprintf("%d products", len(data.Catalog)) }
							if sf.TradingHours != "" {
								· { sf.TradingHours }
							}
						</p>
					</div>
				</div>
			</article>
			<article class="card panel">
				<h3 style="margin-bottom:10px;">In search results</h3>
				<div style="border:1px solid var(--line); border-radius:var(--r-lg); padding:12px;">
					<div class="small-text muted mono">{ storeLink(data) }</div>
					<div style="color:var(--info); font-size:var(--fs-16); font-weight:600;" data-pv="seo-title">{ seoTitle(data) }</div>
					<div class="small-text muted" data-pv="seo-desc">{ seoDesc(data) }</div>
				</div>
				<p class="help" style="margin-top:10px;">
					Your store also publishes structured data (business name, address, phone
					if data.Store.VerificationStatus == "fully_verified" {
						, verified status
					}
					) so search engines and AI assistants can answer questions about you accurately. Only facts on record are included.
				</p>
			</article>
		</div>
	</div>
	<script>
		(function () {
			var f = document.querySelector('[data-store-form]');
			if (!f) return;
			var map = { 'sf-headline': 'headline', 'sf-about': 'about', 'sf-ribbon': 'ribbon', 'sf-seo-title': 'seo-title', 'sf-seo-desc': 'seo-desc' };
			f.addEventListener('input', function (e) {
				var key = map[e.target.id];
				if (key) document.querySelectorAll('[data-pv="' + key + '"]').forEach(function (el) { if (e.target.value) el.textContent = e.target.value; });
				var c = f.querySelector('[data-count-for="' + e.target.id + '"]');
				if (c) c.textContent = e.target.value.length + ' / ' + (e.target.id === 'sf-seo-title' ? 60 : 155);
			});
		})();
	</script>
}
