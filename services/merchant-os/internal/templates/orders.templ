package templates

import (
	"fmt"
	"strings"
	"github.com/shoppage/merchant-os/internal/models"
)

templ OrdersTab(data models.DashboardViewData) {
	<div style="margin-bottom: 20px;">
		<div class="panel-head" style="margin-bottom: 16px;">
			<div>
				<h3 style="font-size: 1.3rem;">B2B Proforma Orders Ledger</h3>
				<div class="sub">South African bank EFT settlements, 15% VAT calculation &amp; proforma delivery pipeline</div>
			</div>
			<div style="margin-left: auto;">
				<button class="btn solid small" onclick="document.getElementById('new-order-dialog')?.showModal();">
					<span>+</span> Issue Proforma Invoice
				</button>
			</div>
		</div>

		<!-- ERP Accounting Period & Filter Bar (Matching Pemofy OrderWorkbench) -->
		<div class="card panel" style="padding:12px 16px; margin-bottom:14px; background:var(--surface); border:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
			<div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
				<!-- Period Selector Button -->
				<div style="display:flex; align-items:center; gap:6px;">
					<span style="font-size:12px; font-weight:700; color:var(--ink);">Accounting Period:</span>
					<button type="button" class="btn ghost small" onclick="togglePeriodPickerPopover();" style="display:inline-flex; align-items:center; gap:6px; font-weight:600; padding:4px 9px; border-radius:7px; border:1px solid var(--line-strong);">
						<span style="color:var(--primary);">📅</span>
						<span id="orders-period-label">This Month (MTD)</span>
						<span style="color:var(--muted); font-size:10px;">▼</span>
					</button>
				</div>

				<!-- Text Search Filter -->
				<div class="search" style="min-width:230px;">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4a7 7 0 105 12l4 4"></path></svg>
					<input 
						type="text" 
						id="orders-search-input" 
						placeholder="Search order #, buyer, company…" 
						style="border:0; outline:0; background:transparent; width:100%; font-size:12.5px; color:var(--ink);"
						onkeyup="filterOrdersTable();"
					/>
				</div>

				<!-- Status Filter Select -->
				<select id="orders-status-filter" onchange="filterOrdersTable();" style="padding:4px 8px; font-size:12px; border-radius:7px; border:1px solid var(--line-strong); background:var(--surface); color:var(--ink); font-weight:500;">
					<option value="">All Statuses</option>
					<option value="issued">Issued</option>
					<option value="confirmed">Confirmed</option>
					<option value="paid">Paid (EFT)</option>
					<option value="dispatched">Dispatched</option>
				</select>
			</div>

			<!-- Live Matching Metrics Counter -->
			<div style="display:flex; align-items:center; gap:6px; font-size:12px; font-family:var(--mono); color:var(--muted);">
				<span>Matching:</span>
				<span id="orders-matching-count" style="font-weight:700; color:var(--ink);">{ fmt.Sprintf("%d", len(data.Orders)) }</span>
				<span>transactions ·</span>
				<span id="orders-matching-total" style="font-weight:800; color:var(--primary); font-family:var(--display); font-size:14px;">R 18,420.00</span>
			</div>
		</div>

		<script>
			function filterOrdersTable() {
				var searchVal = (document.getElementById('orders-search-input')?.value || '').toLowerCase().trim();
				var statusVal = document.getElementById('orders-status-filter')?.value || '';
				var matchCount = 0;
				var totalZar = 0;

				document.querySelectorAll('.order-row').forEach(function(row) {
					var rowStatus = row.dataset.status || '';
					var rowDate = row.dataset.date || '';
					var rowSearch = row.dataset.search || '';
					var rowTotal = parseFloat(row.dataset.total || '0');

					var matchesStatus = !statusVal || rowStatus === statusVal;
					var matchesSearch = !searchVal || rowSearch.includes(searchVal);
					var matchesDate = !window.isDateInPeriod || window.isDateInPeriod(rowDate);

					if (matchesStatus && matchesSearch && matchesDate) {
						row.style.display = '';
						matchCount++;
						totalZar += rowTotal;
					} else {
						row.style.display = 'none';
					}
				});

				var countEl = document.getElementById('orders-matching-count');
				var totalEl = document.getElementById('orders-matching-total');
				if (countEl) countEl.textContent = matchCount;
				if (totalEl) totalEl.textContent = 'R ' + totalZar.toLocaleString('en-ZA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
			}

			// Initialize filter on load
			filterOrdersTable();
		</script>

		<!-- Orders Table Card -->
		<div class="card panel" style="padding: 0; overflow: hidden;">
			<table class="table">
				<thead>
					<tr>
						<th style="padding-left: 20px;">Order # &amp; Buyer</th>
						<th>Company / Contact</th>
						<th>Date</th>
						<th>Grand Total (ZAR)</th>
						<th>Status Pipeline</th>
						<th style="text-align: right; padding-right: 20px;">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, order := range data.Orders {
						<tr class="order-row" data-status={ order.Status } data-date={ order.Date.Format("2006-01-02T15:04:05Z") } data-total={ fmt.Sprintf("%.2f", order.GrandTotal) } data-search={ strings.ToLower(fmt.Sprintf("%s %s %s %s", order.OrderNumber, order.Customer, order.Company, order.Phone)) }>
							<td style="padding-left: 20px;">
								<a 
									href="javascript:void(0)" 
									hx-get={ fmt.Sprintf("/orders/%s/invoice", order.ID) } 
									hx-target="#modal-container"
									style="font-weight: 700; color: var(--primary-2); font-family: var(--mono); text-decoration: none;"
								>
									{ order.OrderNumber }
								</a>
								<div style="font-size: 12px; color: var(--ink-2);">{ order.Customer }</div>
							</td>
							<td>
								<div style="font-size: 12.5px; font-weight: 600;">{ order.Company }</div>
								<div style="font-size: 11.5px; color: var(--muted);">{ order.Phone }</div>
							</td>
							<td style="font-size: 12px; color: var(--muted);">{ order.Date.Format("02 Jan 2006 · 15:04") }</td>
							<td>
								<div style="font-family: var(--display); font-weight: 800; font-size: 15px; color: var(--ink);">
									{ fmt.Sprintf("R%.2f", order.GrandTotal) }
								</div>
								<div style="font-size: 10.5px; color: var(--muted);">Incl. 15% VAT</div>
							</td>
							<td>
								if order.Status == "paid" {
									<span class="chip up">Paid · EFT Verified</span>
								} else if order.Status == "dispatched" {
									<span class="chip up">Dispatched · Courier Guy</span>
								} else if order.Status == "confirmed" {
									<span class="chip warn">Confirmed · Awaiting Proof</span>
								} else {
									<span class="chip warn">Issued · Waiting EFT</span>
								}
							</td>
							<td style="text-align: right; padding-right: 20px;">
								<div style="display:flex; justify-content:flex-end; gap:6px; align-items:center;">
									<button 
										type="button" 
										hx-get={ fmt.Sprintf("/orders/%s/invoice", order.ID) } 
										hx-target="#modal-container" 
										class="btn ghost small"
										style="padding:4px 8px; font-size:11.5px;"
									>
										View Tax Proforma
									</button>

									<form hx-post={ fmt.Sprintf("/orders/%s/advance-status", order.ID) } hx-target="#tab-content" style="display:inline;">
										if order.Status == "issued" {
											<button type="submit" class="btn solid small" style="padding:4px 8px; font-size:11.5px;">Mark Confirmed</button>
										} else if order.Status == "confirmed" {
											<button type="submit" class="btn solid small" style="padding:4px 8px; font-size:11.5px; background:var(--primary-2);">Verify Paid</button>
										} else if order.Status == "paid" {
											<button type="submit" class="btn ghost small" style="padding:4px 8px; font-size:11.5px;">Dispatch</button>
										}
									</form>

									<a 
										href={ templ.SafeURL(fmt.Sprintf("https://wa.me/%s?text=Proforma%%20Invoice%%20%s%%20for%%20R%.2f%%20ready", order.Phone, order.OrderNumber, order.GrandTotal)) } 
										target="_blank"
										class="btn ghost small"
										style="padding:4px 8px; font-size:11.5px;"
									>
										💬 WhatsApp
									</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<!-- New Proforma Dialog -->
	<dialog id="new-order-dialog" class="modal-dialog">
		<div class="modal-card">
			<div class="modal-head">
				<h4>Issue B2B Commercial Proforma</h4>
				<button type="button" class="close-btn" onclick="document.getElementById('new-order-dialog').close();">&times;</button>
			</div>
			<form hx-post="/orders/new" hx-target="#tab-content" onsubmit="document.getElementById('new-order-dialog').close();">
				<div class="modal-body">
					<div class="form-group">
						<label>Buyer Company / Account</label>
						<input type="text" name="company" class="input" placeholder="e.g. Radisson Blu Sandton" required />
					</div>
					<div class="two-col">
						<div class="form-group">
							<label>Contact Person</label>
							<input type="text" name="customer" class="input" placeholder="e.g. Nomvula Sithole" required />
						</div>
						<div class="form-group">
							<label>WhatsApp / Phone</label>
							<input type="text" name="phone" class="input" placeholder="27821234567" required />
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label>Select Product Item</label>
							<select name="skuId" class="select-full">
								for _, item := range data.Catalog {
									<option value={ item.ID }>{ item.Title } (R{ fmt.Sprintf("%.2f", item.WholesaleZar) })</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label>Carton Quantity</label>
							<input type="number" name="quantity" class="input" value="100" min="1" required />
						</div>
					</div>
					<div class="form-group">
						<label>Delivery Destination Address</label>
						<input type="text" name="address" class="input" placeholder="e.g. Cnr Rivonia Rd & Daisy St, Sandton" required />
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="document.getElementById('new-order-dialog').close();">Cancel</button>
					<button type="submit" class="btn solid">Issue Proforma (EFT)</button>
				</div>
			</form>
		</div>
	</dialog>
}
