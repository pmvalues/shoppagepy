package templates

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

// Order views are addressable (/tab/orders?status=awaiting_payment) so a
// filtered list can be shared or linked from Home.
var orderViews = [][2]string{
	{"", "All open"},
	{"awaiting_payment", "Awaiting payment"},
	{"to_pack", "To pack"},
	{"dispatched", "Dispatched"},
	{"done", "Completed"},
	{"returns", "Returns"},
}

func orderInView(o models.ProformaOrder, view string) bool {
	s := strings.ToLower(o.Status)
	switch view {
	case "":
		return s == "issued" || s == "confirmed" || s == "paid" || s == "packed"
	case "awaiting_payment":
		return s == "issued"
	case "to_pack":
		return s == "confirmed" || s == "paid" || s == "packed"
	case "dispatched":
		return s == "dispatched"
	case "done":
		return s == "delivered" || s == "collected" || s == "cancelled" || s == "refunded"
	case "all":
		return true
	}
	return false
}

func orderRows(data models.DashboardViewData) []models.ProformaOrder {
	view := orderView(data)
	q := strings.ToLower(strings.TrimSpace(data.Query["q"]))
	var out []models.ProformaOrder
	for _, o := range data.Orders {
		if q != "" {
			if !strings.Contains(strings.ToLower(o.OrderNumber+" "+o.Company+" "+o.Customer+" "+o.Phone), q) {
				continue
			}
		} else if !orderInView(o, view) {
			continue
		}
		out = append(out, o)
	}
	return out
}

func orderView(data models.DashboardViewData) string {
	if v := data.Query["view"]; v != "" {
		return v
	}
	return data.Query["status"]
}

func orderViewCount(data models.DashboardViewData, view string) int {
	if view == "returns" {
		n := 0
		for _, r := range data.ReturnRequests {
			if r.Status != "Refund Issued" && r.Status != "Rejected" {
				n++
			}
		}
		return n
	}
	n := 0
	for _, o := range data.Orders {
		if orderInView(o, view) {
			n++
		}
	}
	return n
}

func sumOrders(orders []models.ProformaOrder) float64 {
	t := 0.0
	for _, o := range orders {
		t += o.GrandTotal
	}
	return t
}

func orderNextAction(status string) string {
	switch strings.ToLower(status) {
	case "issued":
		return "Mark paid"
	case "confirmed", "paid", "packed":
		return "Mark dispatched"
	case "dispatched":
		return "Mark delivered"
	}
	return ""
}

func waLink(phone, msg string) string {
	p := strings.TrimPrefix(strings.ReplaceAll(phone, " ", ""), "+")
	return "https://wa.me/" + p + "?text=" + url.QueryEscape(msg)
}

func itemsSummary(o models.ProformaOrder) string {
	units := 0
	for _, ln := range o.LineItems {
		units += ln.Quantity
	}
	return fmt.Sprintf("%d %s · %s units", len(o.LineItems), Plural(len(o.LineItems), "line", "lines"), Int(units))
}

templ OrdersTab(data models.DashboardViewData) {
	{{ view := orderView(data) }}
	{{ rows := orderRows(data) }}
	<div class="page-head">
		<div class="head-copy">
			<p>Trade orders and invoices. Totals include 15% VAT.</p>
		</div>
		<div class="actions">
			<button class="btn ghost" type="button" onclick="document.getElementById('new-rma-dialog').showModal()">Record a return</button>
			<button class="btn solid" type="button" onclick="document.getElementById('new-order-dialog').showModal()">
				@IconSized("plus", 16)
				New order
			</button>
		</div>
	</div>
	<section class="card">
		<div class="panel" style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; border-bottom:1px solid var(--line);">
			<div class="seg" role="group" aria-label="Order views" style="flex-wrap:wrap;">
				for _, v := range orderViews {
					<a href={ templ.SafeURL("/tab/orders?view=" + v[0]) } hx-get={ "/tab/orders?view=" + v[0] } hx-target="#tab-content" hx-push-url="true" class={ templ.KV("on", view == v[0] && data.Query["q"] == "") }>
						{ v[1] }
						if c := orderViewCount(data, v[0]); c > 0 && v[0] != "done" && v[0] != "dispatched" {
							<span class="muted">{ fmt.Sprint(c) }</span>
						}
					</a>
				}
			</div>
			<form hx-get="/tab/orders" hx-target="#tab-content" hx-push-url="true" style="flex:1 1 220px;">
				<label class="sr-only" for="orders-q">Search orders</label>
				<input class="input" id="orders-q" type="search" name="q" value={ data.Query["q"] } placeholder="Search order number, company or phone" hx-get="/tab/orders" hx-trigger="input changed delay:350ms, search" hx-target="#tab-content" hx-push-url="true"/>
			</form>
		</div>
		if view == "returns" && data.Query["q"] == "" {
			@ReturnsTable(data)
		} else if len(rows) == 0 {
			<div class="empty">
				<div class="empty-icon">
					@IconSized("orders", 22)
				</div>
				if data.Query["q"] != "" {
					<h3>No orders match "{ data.Query["q"] }"</h3>
					<p>Search by order number, company or phone number.</p>
				} else {
					<h3>Nothing here</h3>
					<p>Orders in this view will appear here.</p>
				}
			</div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Order</th>
							<th>Buyer</th>
							<th>Date</th>
							<th class="r">Total</th>
							<th>Status</th>
							<th><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, o := range rows {
							<tr>
								<td>
									<button type="button" class="link" style="border:0;background:none;padding:0;font:inherit;font-weight:600;" hx-get={ "/orders/" + o.ID + "/invoice" } hx-target="#modal-container">{ o.OrderNumber }</button>
									<div class="small-text muted">{ itemsSummary(o) }</div>
								</td>
								<td>
									<b style="font-weight:600;">{ o.Company }</b>
									<div class="small-text muted">{ orDash(o.Customer) }</div>
								</td>
								<td class="small-text muted" title={ LocalDateTime(o.Date) }>{ Ago(o.Date, data.Metrics.Now) }</td>
								<td class="r"><span class="amt">{ ZAR(o.GrandTotal) }</span><div class="small-text muted">{ o.PaymentMethod }</div></td>
								<td><span class={ OrderStatusClass(o.Status) }>{ OrderStatusLabel(o.Status) }</span></td>
								<td class="r">
									<div class="cluster" style="justify-content:flex-end;">
										if o.Phone != "" {
											<a class="btn ghost small" target="_blank" rel="noopener" href={ templ.SafeURL(waLink(o.Phone, fmt.Sprintf("Hi %s, your invoice %s for %s is ready. Bank reference: %s. %s", o.Customer, o.OrderNumber, models.FormatZAR(o.GrandTotal), o.BankingRef, data.Store.Name))) }>WhatsApp</a>
										}
										if orderNextAction(o.Status) != "" {
											<button class="btn solid small" type="button" hx-post={ "/orders/" + o.ID + "/advance-status" } hx-target="#tab-content">{ orderNextAction(o.Status) }</button>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="panel small-text muted" style="border-top:1px solid var(--line);">
				{ fmt.Sprintf("%d %s · %s", len(rows), Plural(len(rows), "order", "orders"), ZAR(sumOrders(rows))) }
			</div>
		}
	</section>
	@NewOrderDialog(data)
	@NewReturnDialog(data)
}

templ ReturnsTable(data models.DashboardViewData) {
	if len(data.ReturnRequests) == 0 {
		<div class="empty">
			<h3>No returns</h3>
			<p>When a buyer sends goods back, record it here so stock and refunds stay right.</p>
		</div>
	} else {
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>Return</th>
						<th>Buyer</th>
						<th>Item</th>
						<th>Reason</th>
						<th class="r">Refund</th>
						<th>Status</th>
						<th><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					for _, rm := range data.ReturnRequests {
						<tr>
							<td><b class="mono">{ rm.RMANumber }</b><div class="small-text muted">{ LocalDate(rm.CreatedAt) }</div></td>
							<td>{ rm.CustomerName }<div class="small-text muted">{ rm.OrderNumber }</div></td>
							<td>{ fmt.Sprintf("%d × ", rm.Quantity) }<span class="mono">{ rm.SKU }</span><div class="small-text muted">{ rm.ItemTitle }</div></td>
							<td>{ rm.Reason }<div class="small-text muted">
								if rm.WaybillNo != "" {
									Waybill <span class="mono">{ rm.WaybillNo }</span>
								} else {
									No courier booked yet
								}
							</div></td>
							<td class="r amt">{ ZAR(rm.RefundAmount) }</td>
							<td>
								switch rm.Status {
									case "Refund Issued":
										<span class="status ok">Refunded</span>
									case "Goods Received":
										<span class="status info">Goods received</span>
									case "Rejected":
										<span class="status bad">Rejected</span>
									default:
										<span class="status warn">{ rm.Status }</span>
								}
							</td>
							<td class="r">
								if rm.Status == "Authorized" || rm.Status == "Requested" {
									<button class="btn ghost small" hx-post="/rma/update" hx-vals={ fmt.Sprintf(`{"rmaId": %q, "status": "Goods Received"}`, rm.ID) } hx-target="#tab-content">Goods received</button>
								} else if rm.Status == "Goods Received" {
									<button class="btn solid small" hx-post="/rma/update" hx-vals={ fmt.Sprintf(`{"rmaId": %q, "status": "Refund Issued"}`, rm.ID) } hx-target="#tab-content">Mark refunded</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ NewOrderDialog(data models.DashboardViewData) {
	<dialog id="new-order-dialog" class="modal-dialog" aria-labelledby="new-order-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="new-order-title">New order</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/orders/new" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<div class="modal-body">
					<div class="form-group">
						<label for="no-company">Buyer's company</label>
						<input id="no-company" type="text" name="company" class="input" list="customer-list" required autocomplete="organization"/>
						<datalist id="customer-list">
							for _, c := range data.Customers {
								<option value={ c.Company }></option>
							}
						</datalist>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="no-contact">Contact person</label>
							<input id="no-contact" type="text" name="customer" class="input" autocomplete="name"/>
						</div>
						<div class="form-group">
							<label for="no-phone">WhatsApp number</label>
							<input id="no-phone" type="tel" name="phone" class="input" placeholder="27 82 123 4567" autocomplete="tel"/>
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="no-sku">Product</label>
							<select id="no-sku" name="skuId" class="select-full" required>
								for _, item := range data.Catalog {
									<option value={ item.ID }>{ item.Title } · { ZAR(item.WholesaleZar) }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="no-qty">Quantity</label>
							<input id="no-qty" type="number" name="quantity" class="input" min="1" required inputmode="numeric"/>
						</div>
					</div>
					<div class="form-group">
						<label for="no-address">Delivery address</label>
						<input id="no-address" type="text" name="address" class="input" autocomplete="street-address"/>
					</div>
					<p class="help">Priced from your catalogue plus 15% VAT. The order starts as awaiting payment.</p>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Create order</button>
				</div>
			</form>
		</div>
	</dialog>
}

templ NewReturnDialog(data models.DashboardViewData) {
	<dialog id="new-rma-dialog" class="modal-dialog" aria-labelledby="new-rma-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="new-rma-title">Record a return</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/rma/new" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<div class="modal-body">
					<div class="two-col">
						<div class="form-group">
							<label for="rma-order">Order number</label>
							<input id="rma-order" type="text" name="orderNumber" class="input" placeholder="#ORD-9824" required/>
						</div>
						<div class="form-group">
							<label for="rma-customer">Buyer</label>
							<input id="rma-customer" type="text" name="customer" class="input" list="customer-list" required/>
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="rma-sku">Product returned</label>
							<select id="rma-sku" name="sku" class="select-full">
								for _, item := range data.Catalog {
									<option value={ item.SKU }>{ item.Title }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="rma-qty">Quantity</label>
							<input id="rma-qty" type="number" name="quantity" class="input" min="1" value="1" required/>
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="rma-reason">Reason</label>
							<select id="rma-reason" name="reason" class="select-full">
								<option>Damaged in transit</option>
								<option>Faulty</option>
								<option>Wrong item delivered</option>
								<option>Buyer ordered the wrong item</option>
							</select>
						</div>
						<div class="form-group">
							<label for="rma-refund">Refund (optional)</label>
							<input id="rma-refund" type="number" name="refundAmount" class="input" min="0" step="0.01" placeholder="Calculated from price + VAT"/>
						</div>
					</div>
					<div class="form-group">
						<label for="rma-waybill">Return waybill (optional)</label>
						<input id="rma-waybill" type="text" name="waybill" class="input"/>
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Authorise return</button>
				</div>
			</form>
		</div>
	</dialog>
}
