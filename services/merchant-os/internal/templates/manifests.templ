package templates

import (
	"fmt"

	"github.com/shoppage/merchant-os/internal/models"
)

// ManifestsTab lists courier handover sheets. A printed sheet is signed by
// the driver on paper; the screen never claims a signature it doesn't have.
templ ManifestsTab(data models.DashboardViewData) {
	<div class="page-head">
		<div class="head-copy">
			<p>A handover sheet for each courier collection. Print it and have the driver sign.</p>
		</div>
		<div class="actions">
			<button class="btn solid" type="button" onclick="document.getElementById('new-manifest-dialog').showModal()">
				@IconSized("plus", 16)
				New manifest
			</button>
		</div>
	</div>
	<section class="card">
		if len(data.Manifests) == 0 {
			<div class="empty">
				<h3>No manifests yet</h3>
				<p>Create one when a courier collects parcels.</p>
			</div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr><th>Manifest</th><th>Courier</th><th class="r">Parcels</th><th class="r">Weight</th><th>Driver</th><th>Created</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr>
					</thead>
					<tbody>
						for _, m := range data.Manifests {
							<tr>
								<td class="mono"><b>{ m.ManifestRef }</b></td>
								<td>{ m.CarrierName }</td>
								<td class="r num">{ fmt.Sprint(m.WaybillCount) }</td>
								<td class="r num">{ fmt.Sprintf("%.1f kg", m.TotalWeightKg) }</td>
								<td>{ orDash(m.DriverName) }<div class="small-text muted mono">{ m.VehicleReg }</div></td>
								<td class="small-text muted" title={ LocalDateTime(m.Date) }>{ Ago(m.Date, data.Metrics.Now) }</td>
								<td>
									if m.Status == "Handed Over" || m.Status == "Delivered" {
										<span class="status ok">{ m.Status }</span>
									} else {
										<span class="status warn">{ m.Status }</span>
									}
								</td>
								<td class="r"><button type="button" class="btn ghost small" onclick={ openDialog("manifest-" + m.ID) }>Print sheet</button></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
	for _, m := range data.Manifests {
		<dialog id={ "manifest-" + m.ID } class="modal-dialog" aria-label={ "Manifest " + m.ManifestRef }>
			<div class="modal-card">
				<div class="modal-head">
					<h3>Courier handover · { m.ManifestRef }</h3>
					<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
				</div>
				<div class="modal-body">
					<div class="kv-list">
						<div class="kv-row"><span>From</span><b>{ data.Store.Name }, { data.Store.Address }</b></div>
						<div class="kv-row"><span>Courier</span><b>{ m.CarrierName }</b></div>
						<div class="kv-row"><span>Parcels</span><b>{ fmt.Sprint(m.WaybillCount) }</b></div>
						<div class="kv-row"><span>Total weight</span><b>{ fmt.Sprintf("%.1f kg", m.TotalWeightKg) }</b></div>
						<div class="kv-row"><span>Driver</span><b>{ orDash(m.DriverName) } { m.VehicleReg }</b></div>
						<div class="kv-row"><span>Date</span><b>{ LocalDateTime(m.Date) }</b></div>
					</div>
					<p class="small-text muted" style="margin:14px 0 28px;">The courier confirms receipt of the parcels listed above in good condition.</p>
					<div class="two-col">
						<div style="border-top:1px solid var(--ink); padding-top:6px;" class="small-text">Driver signature</div>
						<div style="border-top:1px solid var(--ink); padding-top:6px;" class="small-text">Dispatched by</div>
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Close</button>
					<button type="button" class="btn solid" onclick="window.print()">Print</button>
				</div>
			</div>
		</dialog>
	}
	<dialog id="new-manifest-dialog" class="modal-dialog" aria-labelledby="man-title">
		<div class="modal-card">
			<div class="modal-head">
				<h3 id="man-title">New courier manifest</h3>
				<button type="button" class="close-btn" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
			</div>
			<form hx-post="/manifests/new" hx-target="#tab-content" hx-on::after-request="this.closest('dialog').close()">
				<div class="modal-body">
					<div class="form-group">
						<label for="man-carrier">Courier</label>
						<input id="man-carrier" type="text" name="carrier" class="input" list="carrier-list" required/>
						<datalist id="carrier-list">
							<option value="The Courier Guy"></option>
							<option value="Pargo"></option>
							<option value="Pudo"></option>
							<option value="RAM"></option>
							<option value="Customer collection"></option>
						</datalist>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="man-driver">Driver name</label>
							<input id="man-driver" type="text" name="driverName" class="input"/>
						</div>
						<div class="form-group">
							<label for="man-reg">Vehicle registration</label>
							<input id="man-reg" type="text" name="vehicleReg" class="input"/>
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label for="man-parcels">Parcels</label>
							<input id="man-parcels" type="number" name="waybillCount" class="input" min="1" placeholder="From dispatched orders"/>
						</div>
						<div class="form-group">
							<label for="man-kg">Total weight (kg)</label>
							<input id="man-kg" type="number" name="totalWeightKg" class="input" min="0" step="0.1" placeholder="From product weights"/>
						</div>
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="this.closest('dialog').close()">Cancel</button>
					<button type="submit" class="btn solid">Create manifest</button>
				</div>
			</form>
		</div>
	</dialog>
}

// openDialog opens a <dialog> by id.
script openDialog(id string) {
	var d = document.getElementById(id);
	if (d) d.showModal();
}
