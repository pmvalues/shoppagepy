package templates

import (
	"fmt"
	"github.com/shoppage/merchant-os/internal/models"
)

templ ManifestsTab(data models.DashboardViewData) {
	<div class="panel-head">
		<div>
			<h3>Carrier Shipping Manifests &amp; Waybill Dispatch</h3>
			<div class="sub">Courier Guy road freight, Pargo mall collection lockers &amp; driver sign-off sheets</div>
		</div>
		<div class="right">
			<button class="btn solid small" onclick="document.getElementById('new-manifest-dialog')?.showModal();">
				<span>+</span> Generate Today's Manifest
			</button>
		</div>
	</div>

	<!-- Carrier Integration Status Cards -->
	<div class="three-col" style="margin-bottom:18px;">
		<div class="card kpi">
			<div class="k-label"><span>Primary Freight Partner</span><span class="chip up">Connected</span></div>
			<div class="k-val" style="font-size:1.4rem; margin:6px 0 2px;">The Courier Guy</div>
			<div class="k-foot"><span class="then">Daily collection 15:30 SAST · Account: TCG-MIT882</span></div>
		</div>
		<div class="card kpi">
			<div class="k-label"><span>Smart Locker Network</span><span class="chip up">Active</span></div>
			<div class="k-val" style="font-size:1.4rem; margin:6px 0 2px;">Pargo Mall Points</div>
			<div class="k-foot"><span class="then">3,315 Shopping Centre Pickup Lockers</span></div>
		</div>
		<div class="card kpi">
			<div class="k-label"><span>Warehouse Depot Desk</span><span class="chip flat">Midrand</span></div>
			<div class="k-val" style="font-size:1.4rem; margin:6px 0 2px;">Click &amp; Collect</div>
			<div class="k-foot"><span class="then">Customer collection bay open 08:00–17:00</span></div>
		</div>
	</div>

	<!-- Manifests Table -->
	<div class="card panel">
		<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
			<h4 style="font-size:15px; font-weight:700;">Recent Dispatch Manifests</h4>
			<span style="font-size:12px; color:var(--muted);">{ fmt.Sprintf("%d Manifests Logged", len(data.Manifests)) }</span>
		</div>

		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>Manifest Ref</th>
						<th>Carrier / Channel</th>
						<th>Waybills / Parcels</th>
						<th>Total Weight</th>
						<th>Driver &amp; Vehicle</th>
						<th>Dispatch Date</th>
						<th>Status</th>
						<th style="text-align:right;">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, man := range data.Manifests {
						<tr>
							<td>
								<b style="font-family:var(--mono); color:var(--primary-2); font-size:13px;">{ man.ManifestRef }</b>
							</td>
							<td>
								<b>{ man.CarrierName }</b>
							</td>
							<td>
								<span style="font-family:var(--mono); font-weight:600;">{ fmt.Sprintf("%d waybills", man.WaybillCount) }</span>
							</td>
							<td>
								<span style="font-family:var(--mono);">{ fmt.Sprintf("%.1f kg", man.TotalWeightKg) }</span>
							</td>
							<td>
								<div><b>{ man.DriverName }</b></div>
								<div style="font-family:var(--mono); font-size:11px; color:var(--muted);">{ man.VehicleReg }</div>
							</td>
							<td style="font-size:12px; color:var(--muted);">
								{ man.Date.Format("02 Jan 15:04") }
							</td>
							<td>
								if man.Status == "Handed Over" {
									<span class="chip up">Handed Over</span>
								} else {
									<span class="chip warn">{ man.Status }</span>
								}
							</td>
							<td style="text-align:right;">
								<button type="button" class="btn ghost small" onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('manifest-modal-%s')?.showModal();", man.ID)} }>
									<span>📑</span> View Sheet
								</button>
							</td>
						</tr>

						<!-- Handover Sheet Modal -->
						<dialog id={ fmt.Sprintf("manifest-modal-%s", man.ID) } class="modal-dialog" style="max-width:560px;">
							<div class="modal-card">
								<div class="modal-head">
									<h4>Carrier Handover Dispatch Manifest</h4>
									<button type="button" class="close-btn" onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('manifest-modal-%s')?.close();", man.ID)} }>&times;</button>
								</div>
								<div class="modal-body" style="font-size:13px;">
									<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--line); padding-bottom:12px; margin-bottom:12px;">
										<div>
											<div style="font-weight:800; font-size:16px;">{ man.CarrierName }</div>
											<div style="font-family:var(--mono); color:var(--muted); font-size:12px;">Ref: { man.ManifestRef }</div>
										</div>
										<div style="text-align:right;">
											<div style="font-weight:700;">Mitrand Products Central Hub</div>
											<div style="color:var(--muted); font-size:12px;">Midrand, Gauteng</div>
										</div>
									</div>

									<div style="background:var(--surface-2); padding:10px 14px; border-radius:8px; margin-bottom:14px; font-size:12.5px;">
										<div><b>Driver Name:</b> { man.DriverName }</div>
										<div><b>Vehicle Registration:</b> { man.VehicleReg }</div>
										<div><b>Total Parcels:</b> { fmt.Sprintf("%d cartons", man.WaybillCount) } (Gross Weight: { fmt.Sprintf("%.1f kg", man.TotalWeightKg) })</div>
										<div><b>Collection Time:</b> { man.Date.Format("02 Jan 2006 · 15:04 SAST") }</div>
									</div>

									<p style="font-size:11.5px; color:var(--muted); line-height:1.4;">
										Carrier confirms receipt of above documented consignments in sound condition. Subject to the Standard Trading Terms and Conditions of carriage and SARS export compliance.
									</p>

									<div style="margin-top:16px; border-top:1px dashed var(--line); padding-top:14px; display:flex; justify-content:space-between; align-items:flex-end;">
										<div>
											<div style="font-size:11px; color:var(--muted);">Driver Signature:</div>
											<div style="font-family:cursive; font-size:16px; margin-top:4px; color:var(--ink-2);">{ man.DriverName }</div>
										</div>
										<div style="text-align:right;">
											<span class="chip up">Signed &amp; Verified</span>
										</div>
									</div>
								</div>
								<div class="modal-foot">
									<button type="button" class="btn ghost" onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('manifest-modal-%s')?.close();", man.ID)} }>Close</button>
									<button type="button" class="btn solid" onclick="window.print();">Print Handover Sheet</button>
								</div>
							</div>
						</dialog>
					}
				</tbody>
			</table>
		</div>
	</div>

	<!-- New Manifest Dialog -->
	<dialog id="new-manifest-dialog" class="modal-dialog">
		<div class="modal-card">
			<div class="modal-head">
				<h4>Generate Daily Carrier Handover Manifest</h4>
				<button type="button" class="close-btn" onclick="document.getElementById('new-manifest-dialog').close();">&times;</button>
			</div>
			<form hx-post="/manifests/new" hx-target="#tab-content" onsubmit="document.getElementById('new-manifest-dialog').close();">
				<div class="modal-body">
					<div class="form-group">
						<label>Carrier Partner</label>
						<select name="carrier" class="select-full">
							<option value="The Courier Guy Road Freight">The Courier Guy Road Freight</option>
							<option value="Pargo Smart Mall Lockers">Pargo Smart Mall Lockers</option>
							<option value="Customer Depot Collection">Customer Depot Click &amp; Collect</option>
							<option value="RAM Specialized Courier">RAM Hand-to-Hand Courier</option>
						</select>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label>Driver Full Name</label>
							<input type="text" name="driverName" class="input" placeholder="e.g. Kagiso Mokoena" value="Mandla Zulu" required />
						</div>
						<div class="form-group">
							<label>Vehicle Registration Number</label>
							<input type="text" name="vehicleReg" class="input" placeholder="e.g. JM 92 YB GP" value="CA 449-102" required />
						</div>
					</div>
					<div class="two-col">
						<div class="form-group">
							<label>Total Parcels / Waybills</label>
							<input type="number" name="waybillCount" class="input" value="6" min="1" required />
						</div>
						<div class="form-group">
							<label>Total Gross Weight (kg)</label>
							<input type="number" name="totalWeightKg" class="input" value="85.0" step="0.5" min="0.5" required />
						</div>
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn ghost" onclick="document.getElementById('new-manifest-dialog').close();">Cancel</button>
					<button type="submit" class="btn solid">Generate &amp; Dispatch Manifest</button>
				</div>
			</form>
		</div>
	</dialog>
}
