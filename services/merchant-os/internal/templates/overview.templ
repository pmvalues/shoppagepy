package templates

import (
	"fmt"
	"github.com/shoppage/merchant-os/internal/models"
)

templ OverviewTab(data models.DashboardViewData) {
	<!-- GMV METER & TOP BANNER -->
	<div class="meter-card" style="margin-bottom: 20px;">
		<div style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
			<div>
				<div style="display: flex; align-items: center; gap: 8px;">
					<span style="font-size: 11px; text-transform: uppercase; letter-spacing: .12em; color: #4fe0a4; font-weight: 700;">Signature SME Tier</span>
					<span style="background: rgba(79,224,164,.15); color: #4fe0a4; font-size: 10.5px; font-weight: 700; padding: 2px 7px; border-radius: 999px;">0% Platform Fee</span>
					<span style="background: rgba(255,255,255,.08); color: #b7d6c7; font-size: 10.5px; font-weight: 600; padding: 2px 7px; border-radius: 999px;">pod-za-01 · Johannesburg</span>
				</div>
				<h3 style="margin-top: 4px;">Free GMV Threshold Meter</h3>
				<p class="sub">Trade up to R50,000 monthly volume completely free before standard micro-fees apply.</p>
			</div>
			<div style="text-align: right;">
				<div style="font-size: 11.5px; color: #9fc2b3;">Remaining in Free Quota</div>
				<div style="font-family: var(--display); font-weight: 800; font-size: 18px; color: #4fe0a4;">
					R { fmt.Sprintf("%.2f", 50000.0 - data.Store.GrossRevenueZar) }
				</div>
			</div>
		</div>

		<div style="display: flex; align-items: flex-end; gap: 12px; margin: 16px 0 6px;">
			<div class="meter-big">
				R { fmt.Sprintf("%.2f", data.Store.GrossRevenueZar) }
				<span style="font-size: 1rem; color: #9fc2b3; font-weight: 600;">/ R 50,000.00</span>
			</div>
			<span style="margin-left: auto; font-size: 12px; color: #4fe0a4; font-weight: 700;">96.5% Utilized</span>
		</div>

		<div class="bar">
			<div class="fill" style="width: 96.5%;"></div>
		</div>
		<div style="display: flex; justify-content: space-between; font-size: 11px; color: #9fc2b3; margin-top: 7px;">
			<span>R 0</span>
			<span>R 25,000</span>
			<b style="color: #e4f0ea;">R 50,000 (Free Cap)</b>
		</div>
	</div>

	<!-- 4 MODERN ROLE CENTER KPI CARDS (From Pemofy Executive Dashboard) -->
	<div class="grid-kpi" style="margin-bottom: 20px;">
		<!-- KPI 1: Revenue 7-Days -->
		<div class="card kpi">
			<div class="k-label">
				<span>Revenue (7-Days)</span>
				<span class="chip up">↑ +18.4%</span>
			</div>
			<div class="k-val">R 14,535.40</div>
			<div style="font-size: 12px; color: var(--muted);">vs R 12,280.00 last week</div>
			<svg class="spark" height="30" width="100%" viewBox="0 0 100 30" preserveAspectRatio="none">
				<path d="M0,25 Q25,20 40,22 T70,10 T100,5" fill="none" stroke="#0e7c56" stroke-width="2.5"></path>
			</svg>
		</div>

		<!-- KPI 2: Order Backlog -->
		<div class="card kpi">
			<div class="k-label">
				<span>Order Backlog</span>
				<span class="chip warn">4 Pending</span>
			</div>
			<div class="k-val">R 6,566.00</div>
			<div style="font-size: 12px; color: var(--muted);">Awaiting pick, pack &amp; dispatch</div>
			<svg class="spark" height="30" width="100%" viewBox="0 0 100 30" preserveAspectRatio="none">
				<path d="M0,20 Q20,18 45,12 T80,15 T100,6" fill="none" stroke="#c47c14" stroke-width="2.5"></path>
			</svg>
		</div>

		<!-- KPI 3: Inventory Valuation -->
		<div class="card kpi">
			<div class="k-label">
				<span>Inventory Valuation</span>
				<span class="chip up">FIFO Basis</span>
			</div>
			<div class="k-val">R 532,164.00</div>
			<div style="font-size: 12px; color: var(--muted);">Across Midrand, CPT &amp; DBN Hubs</div>
			<svg class="spark" height="30" width="100%" viewBox="0 0 100 30" preserveAspectRatio="none">
				<path d="M0,15 Q30,15 60,10 T100,8" fill="none" stroke="#0e7c56" stroke-width="2.5"></path>
			</svg>
		</div>

		<!-- KPI 4: Available-To-Promise (ATP) -->
		<div class="card kpi">
			<div class="k-label">
				<span>Available-To-Promise (ATP)</span>
				<span class="chip up">97.2% Ready</span>
			</div>
			<div class="k-val">107 / 110 <span style="font-size:.9rem; font-weight:600; color:var(--muted);">SKUs</span></div>
			<div style="font-size: 12px; color: var(--muted);">Ready for same-day dispatch</div>
			<svg class="spark" height="30" width="100%" viewBox="0 0 100 30" preserveAspectRatio="none">
				<path d="M0,10 Q35,8 70,5 T100,4" fill="none" stroke="#0e7c56" stroke-width="2.5"></path>
			</svg>
		</div>
	</div>

	<!-- SALES TREND & NEEDS ACTION QUEUE (2-COLUMN) -->
	<div style="display: grid; grid-template-columns: 1.55fr 1fr; gap: 16px; margin-bottom: 20px;">
		<!-- Sales Trend Chart Panel -->
		<div class="card panel">
			<div class="panel-head">
				<div>
					<h3>Sales &amp; Quotation Velocity</h3>
					<div class="sub">Weekly trading volume across highveld trade routes</div>
				</div>
				<div style="margin-left: auto; display: flex; gap: 4px; background: var(--surface-2); padding: 2px; border-radius: 9px; border: 1px solid var(--line);">
					<span style="font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 7px; background: var(--surface); color: var(--ink); box-shadow: var(--sh-sm);">7D</span>
					<span style="font-size: 11px; font-weight: 600; padding: 3px 8px; color: var(--muted); cursor: pointer;">30D</span>
					<span style="font-size: 11px; font-weight: 600; padding: 3px 8px; color: var(--muted); cursor: pointer;">90D</span>
				</div>
			</div>

			<div style="position: relative; height: 180px; width: 100%; margin-top: 10px;">
				<svg width="100%" height="180" viewBox="0 0 500 180" preserveAspectRatio="none">
					<defs>
						<linearGradient id="chartGrad" x1="0%" y1="0%" x2="0%" y2="100%">
							<stop offset="0%" stop-color="#0e7c56" stop-opacity="0.25"></stop>
							<stop offset="100%" stop-color="#0e7c56" stop-opacity="0.0"></stop>
						</linearGradient>
					</defs>
					<path d="M0,140 Q80,120 150,130 T300,70 T420,40 T500,20 L500,180 L0,180 Z" fill="url(#chartGrad)"></path>
					<path d="M0,140 Q80,120 150,130 T300,70 T420,40 T500,20" fill="none" stroke="#0e7c56" stroke-width="3"></path>
					<circle cx="300" cy="70" r="5" fill="#0e7c56"></circle>
					<circle cx="420" cy="40" r="5" fill="#0e7c56"></circle>
					<circle cx="500" cy="20" r="5" fill="#0e7c56"></circle>
				</svg>
			</div>

			<div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: 8px;">
				<span>Mon (R 4.2k)</span>
				<span>Wed (R 8.9k)</span>
				<span>Fri (R 12.4k)</span>
				<b style="color: var(--primary);">Today (R 14.8k)</b>
			</div>
		</div>

		<!-- NEEDS ACTION CARD (From Pemofy Executive Role Center) -->
		<div class="card panel" style="display: flex; flex-direction: column;">
			<div class="panel-head">
				<div>
					<h3 style="display: flex; align-items: center; gap: 6px;">
						<span>⚡</span> Needs Action
					</h3>
					<div class="sub">Immediate priority execution queue</div>
				</div>
				<span class="badge" style="background: var(--amber-soft); color: #3a2600; font-weight: 700;">5 Items</span>
			</div>

			<div style="display: flex; flex-direction: column; gap: 10px; flex: 1;">
				<!-- Item 1: Awaiting Payment -->
				<div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; background: var(--surface-2); border-radius: 8px; border: 1px solid var(--line);">
					<div style="display: flex; align-items: center; gap: 8px;">
						<span style="font-size: 16px;">⏳</span>
						<div>
							<div style="font-weight: 700; font-size: 12.5px;">2 Awaiting Payment</div>
							<div style="font-size: 11px; color: var(--muted);">Proformas #ORD-9824 &amp; #ORD-9825</div>
						</div>
					</div>
					<button hx-get="/tab/orders" hx-target="#tab-content" hx-push-url="true" class="btn ghost small" style="padding: 3px 8px; font-size: 11px;">
						Review
					</button>
				</div>

				<!-- Item 2: Paid Not Shipped -->
				<div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; background: var(--surface-2); border-radius: 8px; border: 1px solid var(--line);">
					<div style="display: flex; align-items: center; gap: 8px;">
						<span style="font-size: 16px;">📦</span>
						<div>
							<div style="font-weight: 700; font-size: 12.5px;">2 Paid, Not Shipped</div>
							<div style="font-size: 11px; color: var(--muted);">WMS pick tickets ready</div>
						</div>
					</div>
					<button hx-get="/tab/pick-pack" hx-target="#tab-content" hx-push-url="true" class="btn solid small" style="padding: 3px 8px; font-size: 11px;">
						Pick &amp; Pack
					</button>
				</div>

				<!-- Item 3: Low Stock Alert -->
				<div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; background: var(--rose-soft); border-radius: 8px; border: 1px solid rgba(181,72,58,.2);">
					<div style="display: flex; align-items: center; gap: 8px;">
						<span style="font-size: 16px;">⚠️</span>
						<div>
							<div style="font-weight: 700; font-size: 12.5px; color: var(--rose);">1 Low Stock SKU</div>
							<div style="font-size: 11px; color: #611e15;">Measuring Teaspoon (0 units)</div>
						</div>
					</div>
					<button hx-get="/tab/catalog" hx-target="#tab-content" hx-push-url="true" class="btn ghost small" style="padding: 3px 8px; font-size: 11px; color: var(--rose); border-color: rgba(181,72,58,.3);">
						Restock
					</button>
				</div>

				<!-- Item 4: Inter-Hub Transfer En Route -->
				<div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; background: var(--surface-2); border-radius: 8px; border: 1px solid var(--line);">
					<div style="display: flex; align-items: center; gap: 8px;">
						<span style="font-size: 16px;">🚚</span>
						<div>
							<div style="font-weight: 700; font-size: 12.5px;">1 Inter-Hub Transfer</div>
							<div style="font-size: 11px; color: var(--muted);">Midrand &rarr; Cape Town Depot</div>
						</div>
					</div>
					<button hx-get="/tab/transfers" hx-target="#tab-content" hx-push-url="true" class="btn ghost small" style="padding: 3px 8px; font-size: 11px;">
						Track
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- ITEM LEDGER ENTRIES (ILE) DOUBLE-ENTRY TABLE (Exact feature from Pemofy Role Center) -->
	<div class="card panel" style="margin-bottom: 20px;">
		<div class="panel-head">
			<div>
				<div style="display: flex; align-items: center; gap: 8px;">
					<h3>Item Ledger Entries (ILE)</h3>
					<span class="chip up">Double-Entry Stock Movement</span>
				</div>
				<div class="sub">Immutable real-time audit ledger tracking assembly consumption, negative adjustments &amp; trade sales</div>
			</div>
			<div style="display: flex; gap: 8px;">
				<button 
					hx-get="/tab/inventory" 
					hx-target="#tab-content" 
					hx-push-url="true" 
					class="btn ghost small"
				>
					<span>⚙️</span> Stock Adjustment
				</button>
				<button 
					hx-get="/tab/scan" 
					hx-target="#tab-content" 
					hx-push-url="true" 
					class="btn solid small"
				>
					<span>📷</span> Cycle Count Audit
				</button>
			</div>
		</div>

		<div style="overflow-x: auto;">
			<table class="table">
				<thead>
					<tr>
						<th>Entry #</th>
						<th>Posting Date</th>
						<th>Entry Type</th>
						<th>Document No.</th>
						<th>Item SKU &amp; Title</th>
						<th>Location</th>
						<th style="text-align: right;">Quantity</th>
						<th style="text-align: right;">Remaining</th>
						<th style="text-align: right;">Cost Amount</th>
					</tr>
				</thead>
				<tbody>
					for _, ile := range data.ItemLedger {
						<tr>
							<td style="font-family: var(--mono); font-size: 11.5px; color: var(--muted);">#{ fmt.Sprintf("%d", ile.EntryNumber) }</td>
							<td style="font-size: 12px; color: var(--muted);">{ ile.PostingDate.Format("02 Jan 15:04") }</td>
							<td>
								if ile.EntryType == "Assembly Consumption" {
									<span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600;">Assembly Consumption</span>
								} else if ile.EntryType == "Positive Adjmt." {
									<span class="badge" style="background:#dcfce7; color:#15803d; font-weight:600;">Positive Adjmt.</span>
								} else if ile.EntryType == "Negative Adjmt." {
									<span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:600;">Negative Adjmt.</span>
								} else if ile.EntryType == "Purchase Receipt" {
									<span class="badge" style="background:#f3e8ff; color:#7e22ce; font-weight:600;">Purchase Receipt</span>
								} else {
									<span class="badge" style="background:var(--surface-2); color:var(--ink); font-weight:600;">{ ile.EntryType }</span>
								}
							</td>
							<td style="font-family: var(--mono); font-size: 12px; font-weight: 600;">{ ile.DocumentNo }</td>
							<td>
								<div style="font-weight: 700; color: var(--ink);">{ ile.SKU }</div>
								<div style="font-size: 11px; color: var(--muted);">{ ile.Description }</div>
							</td>
							<td><span class="chip" style="font-size: 11px;">{ ile.Location }</span></td>
							<td style="text-align: right; font-weight: 700; font-family: var(--mono);">
								if ile.Quantity > 0 {
									<span style="color: #0e7c56;">+{ fmt.Sprintf("%d", ile.Quantity) }</span>
								} else {
									<span style="color: #b5483a;">{ fmt.Sprintf("%d", ile.Quantity) }</span>
								}
							</td>
							<td style="text-align: right; font-weight: 600; font-family: var(--mono); color: var(--ink);">{ fmt.Sprintf("%d", ile.RemainingQty) }</td>
							<td style="text-align: right; font-family: var(--display); font-weight: 700;">R { fmt.Sprintf("%.2f", ile.CostAmount) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<!-- RECENT ORDERS & RESTOCK WATCHLIST (2-COLUMN) -->
	<div style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 16px; margin-bottom: 20px;">
		<!-- Recent B2B Proforma Orders Table -->
		<div class="card panel">
			<div class="panel-head">
				<div>
					<h3>Recent B2B Proforma Orders</h3>
					<div class="sub">Direct bank EFT &amp; trade credit settlements</div>
				</div>
				<button 
					hx-get="/tab/orders" 
					hx-target="#tab-content"
					hx-push-url="true"
					style="margin-left: auto; font-size: 12px; font-weight: 700; color: var(--primary); border: 0; background: transparent; cursor: pointer;"
				>
					View All ({ fmt.Sprintf("%d", len(data.Orders)) }) &rarr;
				</button>
			</div>

			<table>
				<thead>
					<tr>
						<th>Invoice / Customer</th>
						<th>Date</th>
						<th>Amount (ZAR)</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody>
					for _, order := range data.Orders {
						<tr>
							<td>
								<div style="font-weight: 700; color: var(--ink);">{ order.Customer }</div>
								<div style="font-family: var(--mono); font-size: 11px; color: var(--muted);">{ order.OrderNumber }</div>
							</td>
							<td style="font-size: 12px; color: var(--muted);">{ order.Date.Format("02 Jan 15:04") }</td>
							<td style="font-weight: 800; font-family: var(--display);">R { fmt.Sprintf("%.2f", order.GrandTotal) }</td>
							<td>
								if order.Status == "paid" {
									<span class="status st-paid">EFT Paid</span>
								} else {
									<span class="status st-wait">Awaiting Payment</span>
								}
							</td>
							<td>
								<a 
									href={ templ.SafeURL(fmt.Sprintf("https://wa.me/%s?text=Proforma%%20Invoice%%20%s%%20for%%20R%.2f", order.Phone, order.OrderNumber, order.GrandTotal)) } 
									target="_blank"
									style="font-size: 11.5px; font-weight: 700; color: var(--primary); background: var(--primary-soft); padding: 3px 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;"
								>
									<span>💬</span> Send
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<!-- Restock Watchlist (Direct from screenshot: SKUs with direct Draft / Order buttons) -->
		<div class="card panel">
			<div class="panel-head">
				<div>
					<h3>Restock Watchlist</h3>
					<div class="sub">Depot reorder triggers &amp; buffers</div>
				</div>
				<button 
					hx-get="/tab/catalog" 
					hx-target="#tab-content"
					hx-push-url="true"
					class="btn ghost small"
				>
					Catalog &rarr;
				</button>
			</div>

			<div style="display: flex; flex-direction: column; gap: 12px; margin-top: 6px;">
				for _, item := range data.Catalog {
					if item.StockQuantity <= item.LowStockAlert {
						<div style="padding: 10px 12px; background: var(--rose-soft); border-radius: 9px; border: 1px solid rgba(181,72,58,.2); display: flex; align-items: center; justify-content: space-between;">
							<div>
								<div style="font-weight: 700; color: #611e15; font-size: 12.5px;">{ item.SKU } · { item.Title }</div>
								<div style="font-size: 11px; color: var(--rose); margin-top: 2px;">
									Current: <b>{ fmt.Sprintf("%d", item.StockQuantity) }</b> | Reorder Alert: <b>{ fmt.Sprintf("%d", item.LowStockAlert) }</b>
								</div>
							</div>
							<div style="display: flex; gap: 6px;">
								<form hx-post="/inventory/intake" hx-target="#tab-content" style="display:inline;">
									<input type="hidden" name="skuId" value={ item.ID } />
									<input type="hidden" name="quantity" value="200" />
									<input type="hidden" name="reason" value="Purchase Order Inward" />
									<input type="hidden" name="batchRef" value="PO-RESTOCK-200" />
									<button 
										type="submit" 
										class="btn solid small" 
										style="background: var(--rose); font-size: 11px; padding: 3px 8px;"
									>
										Order +200
									</button>
								</form>
							</div>
						</div>
					} else {
						<div style="padding: 8px 12px; background: var(--surface-2); border-radius: 8px; border: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between;">
							<div>
								<div style="font-weight: 600; font-size: 12px;">{ item.SKU } · { item.Title }</div>
								<div style="font-size: 10.5px; color: var(--muted); margin-top: 1px;">
									Stock: <b>{ fmt.Sprintf("%d", item.StockQuantity) }</b> | Threshold: { fmt.Sprintf("%d", item.LowStockAlert) }
								</div>
							</div>
							<span class="chip up" style="font-size: 10px;">OK</span>
						</div>
					}
				}
			</div>

			<!-- Sales Channels Breakdown Bar -->
			<div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line);">
				<div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; margin-bottom: 6px;">
					<span>Commercial Distribution</span>
					<span style="color: var(--primary);">4 Channels Synced</span>
				</div>
				<div style="display: flex; height: 8px; border-radius: 999px; overflow: hidden; background: var(--surface-2);">
					<div style="width: 64%; background: #0e7c56;" title="Web Storefront (64%)"></div>
					<div style="width: 28%; background: #25D366;" title="WhatsApp Desk (28%)"></div>
					<div style="width: 8%; background: #c47c14;" title="Shoppage Grid (8%)"></div>
				</div>
				<div style="display: flex; justify-content: space-between; font-size: 10.5px; color: var(--muted); margin-top: 6px;">
					<span>Storefront 64%</span>
					<span>WhatsApp 28%</span>
					<span>Shoppage 8%</span>
				</div>
			</div>
		</div>
	</div>

	<!-- PEMOFY SIGNATURE SECURITY & SOVEREIGN ISOLATION CARD -->
	<div class="card panel" style="margin-bottom: 20px;">
		<div class="panel-head">
			<div>
				<h3>Security &amp; Sovereign Tenant Hosting</h3>
				<div class="sub">Dedicated pod isolation and data governance on pod-za-01</div>
			</div>
			<span class="chip up">● POPIA Compliant</span>
		</div>
		<div style="display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap;">
			<div style="width: 44px; height: 44px; border-radius: 12px; background: var(--sidebar); color: #4fe0a4; display: grid; place-items: center; flex: none;">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
			</div>
			<div style="flex: 1; min-width: 240px;">
				<b style="font-size: 15px; color: var(--ink);">Dedicated Tenant Database Instance</b>
				<p style="margin: 4px 0 0; font-size: 13px; color: var(--muted); line-height: 1.5;">
					Your catalog, customer CRM, wholesale price matrices and B2B orders live in an isolated SQLite-WAL database that no other merchant can query. Backed up nightly to sovereign vault storage in Johannesburg.
				</p>
				<div style="display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap;">
					<span style="font-family: var(--mono); font-size: 11px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 7px; padding: 4px 9px;">pemofy_tenant_mitrend</span>
					<span style="font-family: var(--mono); font-size: 11px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 7px; padding: 4px 9px;">pod-za-01 · JHB</span>
					<span style="font-family: var(--mono); font-size: 11px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 7px; padding: 4px 9px;">Nightly Backup 02:00 SAST</span>
					<span style="font-family: var(--mono); font-size: 11px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 7px; padding: 4px 9px;">POPIA Enforced</span>
				</div>
			</div>
			<div style="border-left: 1px solid var(--line); padding-left: 18px; display: flex; flex-direction: column; gap: 8px; min-width: 200px;">
				<div style="display: flex; justify-content: space-between; font-size: 12.5px;">
					<span style="color: var(--muted);">Page Speed (Mobile)</span>
					<b style="color: var(--primary);">99 / 100</b>
				</div>
				<div style="display: flex; justify-content: space-between; font-size: 12.5px;">
					<span style="color: var(--muted);">Local TTFB</span>
					<b style="color: var(--primary);">0.74 ms</b>
				</div>
				<a href="/audit-logs/export.csv" class="btn ghost small" style="margin-top: 6px; justify-content: center;">
					<span>💾</span> Download Data (Audit CSV)
				</a>
			</div>
		</div>
	</div>

	<!-- SOVEREIGN POD RESIDENCY FOOTER (As shown in screenshot) -->
	<div style="display: flex; align-items: center; justify-content: space-between; font-size: 11.5px; color: var(--muted); padding: 12px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); flex-wrap: wrap; gap: 8px;">
		<div style="display: flex; align-items: center; gap: 8px;">
			<span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #4fe0a4;"></span>
			<span>Sovereign Pod Residency: <b style="color: var(--ink);">pod-za-01 (Midrand / JHB)</b></span>
			<span>·</span>
			<span>HTTP Latency: <b style="color: #0e7c56;">0.74ms</b></span>
			<span>·</span>
			<span>RAM Footprint: <b style="color: #0e7c56;">11.8 MB</b></span>
		</div>
		<div style="display: flex; align-items: center; gap: 12px;">
			<span>Database: <b>SQLite-WAL Native</b></span>
			<span>CIPC: <b>{ data.Store.CIPCRegistration }</b></span>
			<span>SABS: <b>Verified Standards</b></span>
		</div>
	</div>
}
