package templates

import (
	"fmt"
	"strings"
	"time"

	"github.com/shoppage/merchant-os/internal/models"
)

func barHeight(v, max float64) string {
	if max <= 0 || v <= 0 {
		return "height:2px"
	}
	return fmt.Sprintf("height:%.1f%%", v/max*100)
}

func maxDaily(days []models.DayPoint) float64 {
	m := 0.0
	for _, d := range days {
		if d.SalesZar > m {
			m = d.SalesZar
		}
	}
	return m
}

func attentionIcon(kind string) string {
	switch kind {
	case "message":
		return "chat"
	case "stock":
		return "inventory"
	case "quote":
		return "rfqs"
	case "feed":
		return "feeds"
	}
	return "orders"
}

func attentionTone(tone string) string {
	switch tone {
	case "danger":
		return "thumb danger"
	case "warn":
		return "thumb warn"
	}
	return "thumb info"
}

// sparkPath maps vals onto the sparkline's 120×30 viewBox, normalised to their
// own minimum and maximum so a flat series draws a straight mid-line.
func sparkPath(vals []float64) string {
	if len(vals) == 0 {
		return ""
	}
	lo, hi := vals[0], vals[0]
	for _, v := range vals {
		if v < lo {
			lo = v
		}
		if v > hi {
			hi = v
		}
	}
	flat := hi-lo < 1e-9
	pts := make([]string, 0, len(vals))
	for i, v := range vals {
		x := 0.0
		if len(vals) > 1 {
			x = float64(i) / float64(len(vals)-1) * 120
		}
		y := 15.0
		if !flat {
			y = 26 - (v-lo)/(hi-lo)*20
		}
		pts = append(pts, fmt.Sprintf("%.1f %.1f", x, y))
	}
	return "M" + strings.Join(pts, " L")
}

// sparkArea closes the sparkline path into a filled area under the line.
func sparkArea(vals []float64) string {
	p := sparkPath(vals)
	if p == "" {
		return ""
	}
	return p + " L120 30 L0 30 Z"
}

func salesSeries(days []models.DayPoint) []float64 {
	out := make([]float64, 0, len(days))
	for _, d := range days {
		out = append(out, d.SalesZar)
	}
	return out
}

func ordersSeries(days []models.DayPoint) []float64 {
	out := make([]float64, 0, len(days))
	for _, d := range days {
		out = append(out, float64(d.Orders))
	}
	return out
}

// aovSeries is sales per order for each day; quiet days read as zero.
func aovSeries(days []models.DayPoint) []float64 {
	out := make([]float64, 0, len(days))
	for _, d := range days {
		if d.Orders > 0 {
			out = append(out, d.SalesZar/float64(d.Orders))
		} else {
			out = append(out, 0)
		}
	}
	return out
}

// cumSeries runs the window's sales total up day by day.
func cumSeries(days []models.DayPoint) []float64 {
	out := make([]float64, 0, len(days))
	sum := 0.0
	for _, d := range days {
		sum += d.SalesZar
		out = append(out, sum)
	}
	return out
}

// recentMsgs keeps a dashboard panel to the newest messages.
func recentMsgs(msgs []models.CopilotMessage, n int) []models.CopilotMessage {
	if len(msgs) <= n {
		return msgs
	}
	return msgs[len(msgs)-n:]
}

func sumSalesDays(days []models.DayPoint) float64 {
	sum := 0.0
	for _, d := range days {
		sum += d.SalesZar
	}
	return sum
}

func sumOrdersDays(days []models.DayPoint) int {
	sum := 0
	for _, d := range days {
		sum += d.Orders
	}
	return sum
}

func bestDay(days []models.DayPoint) models.DayPoint {
	best := models.DayPoint{}
	for _, d := range days {
		if d.SalesZar > best.SalesZar {
			best = d
		}
	}
	return best
}

type chartBar struct {
	X, Y, W, H float64
	Day        time.Time
	Orders     int
	SalesZar   float64
}

type chartGeom struct {
	Bars   []chartBar
	Line   string
	Area   string
	LastX  float64
	LastY  float64
	MaxSal float64
}

// revenueGeom turns a day window into SVG geometry: order bars sized against
// the busiest day, a sales line scaled to its own maximum, and the area under
// that line. Nothing is smoothed or projected.
func revenueGeom(days []models.DayPoint) chartGeom {
	const (
		width    = 620.0
		baseline = 190.0
		top      = 24.0
	)
	n := len(days)
	if n == 0 {
		return chartGeom{MaxSal: 1}
	}
	slot := width / float64(n)
	barW := slot * 0.55
	if barW > 34 {
		barW = 34
	}
	maxOrders, maxSales := 1.0, 0.0
	for _, d := range days {
		if float64(d.Orders) > maxOrders {
			maxOrders = float64(d.Orders)
		}
		if d.SalesZar > maxSales {
			maxSales = d.SalesZar
		}
	}
	if maxSales <= 0 {
		maxSales = 1
	}
	g := chartGeom{MaxSal: maxSales}
	pts := make([]string, 0, n)
	for i, d := range days {
		x := float64(i)*slot + (slot-barW)/2
		h := float64(d.Orders) / maxOrders * (baseline - top - 8)
		if h < 3 {
			h = 3
		}
		g.Bars = append(g.Bars, chartBar{
			X: x, Y: baseline - h, W: barW, H: h,
			Day: d.Day, Orders: d.Orders, SalesZar: d.SalesZar,
		})
		cx := float64(i)*slot + slot/2
		cy := baseline - d.SalesZar/maxSales*(baseline-top)
		pts = append(pts, fmt.Sprintf("%.1f %.1f", cx, cy))
		g.LastX, g.LastY = cx, cy
	}
	g.Line = "M" + strings.Join(pts, " L")
	g.Area = g.Line + fmt.Sprintf(" L%.1f %.1f L%.1f %.1f Z", g.LastX, baseline, slot/2, baseline)
	return g
}

// OverviewTab is Home: what needs the merchant now, then how the month is
// going. Every figure comes from data.Metrics and links to the list behind it.
templ OverviewTab(data models.DashboardViewData) {
	{{ m := data.Metrics }}
	{{ seven := data.Query["range"] == "7" }}
	{{ days := m.Daily }}
	{{ if seven && len(m.Daily) > 7 { days = m.Daily[len(m.Daily)-7:] } }}
	{{ geom := revenueGeom(days) }}
	{{ sparkSales := salesSeries(m.Daily) }}
	{{ sparkOrders := ordersSeries(m.Daily) }}
	{{ sparkAov := aovSeries(m.Daily) }}
	{{ sparkCum := cumSeries(m.Daily) }}
	<div class="page-head">
		<div class="head-copy">
			<h2>{ Greeting(m.Now.In(sast)) }</h2>
			if len(m.Attention) > 0 {
				<p>{ fmt.Sprintf("%d %s need your attention.", len(m.Attention), Plural(len(m.Attention), "thing", "things")) }</p>
			} else {
				<p>You're all caught up.</p>
			}
		</div>
		<div class="actions">
			<a class="btn ghost" href="/catalog/new">
				@IconSized("plus", 16)
				Add product
			</a>
			<a class="btn solid" href="/tab/pos" hx-get="/tab/pos" hx-target="#tab-content" hx-push-url="true">Counter sale</a>
		</div>
	</div>
	if m.SetupDone < len(m.Setup) {
		<section class="card panel section" aria-labelledby="setup-title">
			<div class="panel-head">
				<div>
					<h3 id="setup-title">Finish setting up your store</h3>
					<div class="sub">{ fmt.Sprintf("%d of %d done", m.SetupDone, len(m.Setup)) }</div>
				</div>
				<div class="right" style="min-width:160px;">
					<div class="progress" style="width:160px;"><span style={ Width(float64(m.SetupDone) / float64(len(m.Setup)) * 100) }></span></div>
				</div>
			</div>
			<div class="setup">
				for _, st := range m.Setup {
					<div class={ "setup-step", templ.KV("done", st.Done) }>
						<span class="ic" aria-hidden="true">✓</span>
						<div>
							<b>{ st.Title }</b>
							if !st.Done {
								<p>{ st.Detail }</p>
							}
						</div>
						if !st.Done {
							<a class="btn small ghost" href={ templ.SafeURL(st.Href) } hx-get={ st.Href } hx-target="#tab-content" hx-push-url="true">Start</a>
						} else {
							<span class="sr-only">Done</span>
						}
					</div>
				}
			</div>
		</section>
	}
	<section class="grid-kpi" aria-label="Key figures">
		<a class="card kpi" href="/tab/analytics" hx-get="/tab/analytics" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">
				Sales today
				if pct, ok := models.PctChange(m.TodaySalesZar, m.YesterdaySalesZar); ok {
					<span class={ "chip", templ.KV("up", pct >= 0), templ.KV("down", pct < 0) }>{ Signed(pct) }</span>
				}
			</div>
			<div class="k-val">{ ZARWhole(m.TodaySalesZar) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d %s", m.TodayOrders, Plural(m.TodayOrders, "sale", "sales")) } · yesterday { ZARWhole(m.YesterdaySalesZar) }</div>
			<svg class="spark" viewBox="0 0 120 30" preserveAspectRatio="none" aria-hidden="true">
				<path d={ sparkPath(sparkSales) } fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d={ sparkArea(sparkSales) } fill="currentColor" opacity="0.08"></path>
			</svg>
		</a>
		<a class="card kpi" href="/tab/analytics" hx-get="/tab/analytics" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">
				Sales this month
				if pct, ok := models.PctChange(m.MonthSalesZar, m.PrevMonthSalesZar); ok {
					<span class={ "chip", templ.KV("up", pct >= 0), templ.KV("down", pct < 0) } title="Compared with the same days last month">{ Signed(pct) }</span>
				}
			</div>
			<div class="k-val">{ ZARWhole(m.MonthSalesZar) }</div>
			<div class="k-foot">
				{ fmt.Sprintf("%d %s", m.MonthOrders, Plural(m.MonthOrders, "sale", "sales")) }
				if m.MonthOrders > 0 {
					· average { ZARWhole(m.AvgOrderValueZar) }
				}
			</div>
			<svg class="spark" viewBox="0 0 120 30" preserveAspectRatio="none" aria-hidden="true">
				<path d={ sparkPath(sparkCum) } fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d={ sparkArea(sparkCum) } fill="currentColor" opacity="0.08"></path>
			</svg>
		</a>
		<a class="card kpi" href="/tab/orders" hx-get="/tab/orders" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">Open orders</div>
			<div class="k-val">{ Int(m.OpenOrders) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d awaiting payment · %d to pack", m.AwaitingPayment, m.ToFulfil) }</div>
			<svg class="spark" viewBox="0 0 120 30" preserveAspectRatio="none" aria-hidden="true">
				<path d={ sparkPath(sparkOrders) } fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d={ sparkArea(sparkOrders) } fill="currentColor" opacity="0.08"></path>
			</svg>
		</a>
		<a class="card kpi" href="/tab/analytics" hx-get="/tab/analytics" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">Average order value</div>
			<div class="k-val">{ ZARWhole(m.AvgOrderValueZar) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d %s this month", m.MonthOrders, Plural(m.MonthOrders, "sale", "sales")) }</div>
			<svg class="spark" viewBox="0 0 120 30" preserveAspectRatio="none" aria-hidden="true">
				<path d={ sparkPath(sparkAov) } fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d={ sparkArea(sparkAov) } fill="currentColor" opacity="0.08"></path>
			</svg>
		</a>
	</section>
	<section class="row-2">
		<article class="card panel" aria-labelledby="attention-title">
			<div class="panel-head">
				<div>
					<h3 id="attention-title">Needs you</h3>
					<div class="sub">Most urgent first</div>
				</div>
			</div>
			if len(m.Attention) == 0 {
				<div class="empty">
					<div class="empty-icon">
						@IconSized("check", 22)
					</div>
					<h3>Nothing waiting</h3>
					<p>New messages, orders to pack and low stock will show up here.</p>
				</div>
			} else {
				<div class="list">
					for _, it := range m.Attention {
						<a class="li" href={ templ.SafeURL(it.Href) } hx-get={ it.Href } hx-target="#tab-content" hx-push-url="true">
							<span class={ attentionTone(it.Tone) } aria-hidden="true">
								@IconSized(attentionIcon(it.Kind), 18)
							</span>
							<div class="txt">
								<b>{ it.Title }</b>
								<span>{ it.Detail }</span>
							</div>
							<span class="btn small ghost">{ it.Action }</span>
						</a>
					}
				</div>
			}
		</article>
		<article class="card meter-card" aria-labelledby="allowance-title">
			<h3 id="allowance-title">Free sales allowance</h3>
			<div class="sub">
				{ m.Plan.Label } plan · no platform fee on your first { ZARWhole(m.Plan.FreeAllowanceZar) } of sales each month
			</div>
			<div class="meter-top">
				<div class="meter-big">{ ZARWhole(m.AllowanceUsedZar) } <span class="t">of { ZARWhole(m.Plan.FreeAllowanceZar) }</span></div>
				<div class="meter-flag">
					if m.AllowanceRemainingZar > 0 {
						<b>{ ZARWhole(m.AllowanceRemainingZar) } left</b>
						<span>then { fmt.Sprintf("%.1f%%", m.Plan.FeeRatePct) } on sales above it</span>
					} else {
						<b>Allowance used</b>
						<span>{ fmt.Sprintf("%.1f%%", m.Plan.FeeRatePct) } fee applies to further sales</span>
					}
				</div>
			</div>
			<div class="bar" role="img" aria-label={ fmt.Sprintf("%s of the free allowance used", Pct(m.AllowancePct)) }>
				<div class="fill" style={ Width(m.AllowancePct) }></div>
			</div>
			<div class="meter-scale"><span><b>R 0</b></span><span>{ ZARWhole(m.Plan.FreeAllowanceZar) }</span></div>
			<div class="meter-stats">
				<div><span>Platform fee so far</span><b>{ ZAR(m.PlatformFeeZar) }</b></div>
				<div><span>Month-end forecast</span><b>{ ZARWhole(m.ProjectedMonthZar) }</b></div>
				<div><span>Forecast fee</span><b>{ ZAR(m.ProjectedFeeZar) }</b></div>
			</div>
		</article>
	</section>
	<section class="row-2">
		<article class="card panel" aria-labelledby="revenue-title">
			<div class="panel-head">
				<div>
					<h3 id="revenue-title">Revenue</h3>
					<div class="sub">Last { len(days) } days · ZAR</div>
				</div>
				<div class="right seg">
					<a class={ templ.KV("on", seven) } href="/tab/overview?range=7" hx-get="/tab/overview?range=7" hx-target="#tab-content" hx-push-url="true">7d</a>
					<a class={ templ.KV("on", !seven) } href="/tab/overview?range=14" hx-get="/tab/overview?range=14" hx-target="#tab-content" hx-push-url="true">14d</a>
				</div>
			</div>
			<div class="chart-legend">
				<span><i class="lg-bar"></i> Orders (count)</span>
				<span><i class="lg-line"></i> Sales (R, scaled)</span>
			</div>
			<div class="chart-wrap">
				<svg class="chart" viewBox="0 0 620 200" preserveAspectRatio="none" role="img" aria-label={ fmt.Sprintf("Daily orders as bars and daily sales as a line over the last %d days", len(days)) }>
					<defs>
						<linearGradient id="revenueArea" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" style="stop-color:var(--primary); stop-opacity:0.20"></stop>
							<stop offset="100%" style="stop-color:var(--primary); stop-opacity:0"></stop>
						</linearGradient>
					</defs>
					<g style="stroke:var(--line)" stroke-width="1">
						<line x1="0" y1="40" x2="620" y2="40"></line>
						<line x1="0" y1="80" x2="620" y2="80"></line>
						<line x1="0" y1="120" x2="620" y2="120"></line>
						<line x1="0" y1="160" x2="620" y2="160"></line>
					</g>
					<g style="fill:var(--primary-soft); stroke:var(--primary-line)" stroke-width="1">
						for _, b := range geom.Bars {
							<rect x={ fmt.Sprintf("%.1f", b.X) } y={ fmt.Sprintf("%.1f", b.Y) } width={ fmt.Sprintf("%.1f", b.W) } height={ fmt.Sprintf("%.1f", b.H) } rx="4" vector-effect="non-scaling-stroke">
								<title>{ fmt.Sprintf("%s: %s, %d %s", b.Day.Format("Mon 2 Jan"), ZAR(b.SalesZar), b.Orders, Plural(b.Orders, "sale", "sales")) }</title>
							</rect>
						}
					</g>
					<path d={ geom.Area } fill="url(#revenueArea)"></path>
					<path d={ geom.Line } fill="none" style="stroke:var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
					<circle cx={ fmt.Sprintf("%.1f", geom.LastX) } cy={ fmt.Sprintf("%.1f", geom.LastY) } r="4.5" style="fill:var(--primary); stroke:var(--surface)" stroke-width="2.5" vector-effect="non-scaling-stroke"></circle>
				</svg>
				<div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:6px;" aria-hidden="true">
					if len(days) >= 3 {
						<span>{ days[0].Day.Format("2 Jan") }</span>
						<span>{ days[len(days)/2].Day.Format("2 Jan") }</span>
						<span>{ days[len(days)-1].Day.Format("2 Jan") }</span>
					} else if len(days) > 0 {
						<span>{ days[0].Day.Format("2 Jan") }</span>
					}
				</div>
			</div>
			<div class="cluster" style="gap:22px;margin-top:12px;padding-top:12px;border-top:1px solid var(--line);">
				<div>
					<div class="small-text muted">{ len(days) }-day sales</div>
					<div style="font-family:var(--font-display);font-weight:700;font-size:1.15rem;">{ ZAR(sumSalesDays(days)) }</div>
				</div>
				<div>
					<div class="small-text muted">{ len(days) }-day orders</div>
					<div style="font-family:var(--font-display);font-weight:700;font-size:1.15rem;">{ Int(sumOrdersDays(days)) }</div>
				</div>
				if b := bestDay(days); b.SalesZar > 0 {
					<div>
						<div class="small-text muted">Best day</div>
						<div style="font-family:var(--font-display);font-weight:700;font-size:1.15rem;">{ b.Day.Format("Mon 2 Jan") } · { ZARWhole(b.SalesZar) }</div>
					</div>
				}
			</div>
		</article>
		<article class="card panel" aria-labelledby="recent-title">
			<div class="panel-head">
				<div>
					<h3 id="recent-title">Recent orders</h3>
					<div class="sub">Newest first · click a name to open the invoice</div>
				</div>
				<a class="right link small-text" href="/tab/orders" hx-get="/tab/orders" hx-target="#tab-content" hx-push-url="true">View all →</a>
			</div>
			if len(data.Orders) == 0 {
				<div class="empty">
					<div class="empty-icon">
						@IconSized("orders", 22)
					</div>
					<h3>No orders yet</h3>
					<p>New orders land here the moment they come in.</p>
				</div>
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr><th>Order</th><th>Payment</th><th class="r">Total</th><th>Status</th></tr>
						</thead>
						<tbody>
							for i, o := range data.Orders {
								if i < 5 {
									<tr>
										<td>
											<button type="button" class="link" style="border:0;background:none;padding:0;font:inherit;font-weight:600;" hx-get={ "/orders/" + o.ID + "/invoice" } hx-target="#modal-container">{ orDash(o.Customer) }</button>
											<div class="oid" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{ o.OrderNumber }</div>
										</td>
										<td class="pay">{ o.PaymentMethod }</td>
										<td class="amt" style="text-align:right;">{ ZAR(o.GrandTotal) }</td>
										<td><span class={ OrderStatusClass(o.Status) }>{ OrderStatusLabel(o.Status) }</span></td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			}
		</article>
	</section>
	<section class="row-2">
		<article class="card panel copilot" aria-labelledby="assist-title">
			<div class="panel-head">
				<div>
					<h3 id="assist-title">Assistant</h3>
					if data.Nav.AIConnected {
						<div class="sub">Answers use your store's records. Nothing changes until you approve it.</div>
					} else {
						<div class="sub">Rules-based answers from your own records. Nothing changes until you approve it.</div>
					}
				</div>
				<a class="right link small-text" href="/tab/copilot" hx-get="/tab/copilot" hx-target="#tab-content" hx-push-url="true">Open →</a>
			</div>
			if len(data.CopilotMessages) == 0 {
				<div class="msg bot">
					<span class="ava" aria-hidden="true">S</span>
					<div class="bubble">Ask about sales, top products, stock to reorder, unpaid orders, quotes or listings. I only use your records, and I'll say so when I can't answer.</div>
				</div>
			}
			for _, msg := range recentMsgs(data.CopilotMessages, 5) {
				if msg.Role == "user" {
					<div class="msg me">
						<span class="ava" aria-hidden="true">{ Initials(accountName(data.Nav)) }</span>
						<div class="bubble">{ msg.Content }</div>
					</div>
				} else {
					<div class="msg bot">
						<span class="ava" aria-hidden="true">S</span>
						<div class="bubble">
							{ msg.Content }
							<div class="small-text muted" style="margin-top:4px;">{ Ago(msg.Timestamp, m.Now) }</div>
						</div>
					</div>
				}
			}
			<form class="composer" hx-post="/copilot/ask" hx-target="#tab-content">
				<label class="sr-only" for="dash-assistant-input">Question</label>
				<input type="text" id="dash-assistant-input" name="prompt" placeholder="e.g. Which items need restocking?" autocomplete="off" required/>
				<button type="submit" class="send" aria-label="Ask">
					@IconSized("chevron", 18)
				</button>
			</form>
			<div class="suggest">
				for _, q := range []string{"Which items need restocking?", "What were my top products this month?", "Which orders are unpaid?", "How are my sales this month?"} {
					<button type="button" hx-post="/copilot/ask" hx-vals={ fmt.Sprintf(`{"prompt": %q}`, q) } hx-target="#tab-content">{ q }</button>
				}
			</div>
		</article>
		<article class="card panel" aria-labelledby="sugg-title">
			<div class="panel-head">
				<div>
					<h3 id="sugg-title">Suggestions</h3>
					<div class="sub">From your stock, quotes and listings. You approve every change.</div>
				</div>
				<a class="right link small-text" href="/tab/copilot" hx-get="/tab/copilot" hx-target="#tab-content" hx-push-url="true">All →</a>
			</div>
			{{ shown := 0 }}
			<div class="stack" style="gap:8px;">
				for _, p := range data.Proposals {
					if p.Status == "pending" && shown < 3 {
						{{ shown++ }}
						<div class="proposal">
							<b>{ p.Title }</b>
							<span class="why">{ p.Reason }</span>
						</div>
					}
				}
			</div>
			if shown == 0 {
				<p class="muted small-text">No suggestions right now.</p>
			}
		</article>
	</section>
	<section class="row-3">
		<article class="card panel" aria-labelledby="restock-title">
			<div class="panel-head">
				<div>
					<h3 id="restock-title">Restock alerts</h3>
					<div class="sub">At or below the reorder level</div>
				</div>
				if len(m.LowStock) > 0 {
					<span class="right chip down">{ fmt.Sprintf("%d low", len(m.LowStock)) }</span>
				}
			</div>
			if len(m.LowStock) == 0 {
				<div class="empty">
					<div class="empty-icon">
						@IconSized("check", 22)
					</div>
					<h3>Stock levels look fine</h3>
					<p>Products at or below their reorder level show up here.</p>
				</div>
			} else {
				<ul class="list">
					for _, a := range m.LowStock {
						<li class="li">
							<span class="thumb warn" aria-hidden="true">
								@IconSized("inventory", 18)
							</span>
							<div class="txt">
								<b>{ a.Title }</b>
								<span>SKU { a.SKU } · reorder at { a.Threshold }</span>
							</div>
							<div class="val"><b>{ a.Quantity }</b><span>left</span></div>
						</li>
					}
				</ul>
				<a class="btn ghost small" style="width:100%;justify-content:center;margin-top:14px;" href="/tab/inventory?stock=low" hx-get="/tab/inventory?stock=low" hx-target="#tab-content" hx-push-url="true">
					Open stock levels
				</a>
			}
		</article>
		<article class="card panel">
			<div class="panel-head">
				<div>
					<h3>Sales by channel</h3>
					<div class="sub">This month</div>
				</div>
			</div>
			@ShareList(m.ChannelMix, "No sales this month yet.")
		</article>
		<article class="card panel">
			<div class="panel-head"><h3>Top products this month</h3></div>
			@ShareList(m.TopProducts, "No sales this month yet.")
		</article>
	</section>
	<section class="card panel" style="margin-bottom:14px;" aria-labelledby="ile-title">
		<div class="panel-head">
			<div>
				<div class="cluster">
					<h3 id="ile-title">Item Ledger Entries (ILE)</h3>
					<span class="chip up">Perpetual double-entry</span>
				</div>
				<div class="sub">Every stock movement posted, newest first · Value is quantity × trade price</div>
			</div>
			<a class="right link small-text" href="/tab/inventory" hx-get="/tab/inventory" hx-target="#tab-content" hx-push-url="true">Full ledger →</a>
		</div>
		if len(data.ItemLedger) == 0 {
			<div class="empty">
				<h3>No ledger entries yet</h3>
				<p>Purchases, sales and adjustments post here as they happen.</p>
			</div>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Entry #</th>
							<th>Posted</th>
							<th>Type</th>
							<th>Document</th>
							<th>SKU &amp; description</th>
							<th>Location</th>
							<th class="r">Change</th>
							<th class="r">Left after</th>
							<th class="r">Value</th>
						</tr>
					</thead>
					<tbody>
						for _, entry := range data.ItemLedger {
							<tr>
								<td><span class="oid">#{ entry.EntryNumber }</span></td>
								<td class="small-text muted" title={ LocalDateTime(entry.PostingDate) }>{ LocalDateTime(entry.PostingDate) }</td>
								<td><span class={ ledgerTone(entry.EntryType, entry.Quantity) }>{ ledgerLabel(entry.EntryType) }</span></td>
								<td><span class="oid">{ entry.DocumentNo }</span></td>
								<td>
									<div style="font-weight:700;">{ entry.SKU }</div>
									<div class="small-text muted">{ entry.Description }</div>
								</td>
								<td><span class="chip flat">{ entry.Location }</span></td>
								<td class="r" style="font-weight:700;">
									if entry.Quantity > 0 {
										<b style="color:var(--success-ink);">+{ entry.Quantity }</b>
									} else if entry.Quantity < 0 {
										<b style="color:var(--danger-ink);">{ entry.Quantity }</b>
									} else {
										<b>{ entry.Quantity }</b>
									}
								</td>
								<td class="r oid">{ entry.RemainingQty }</td>
								<td class="r amt" title="Quantity × trade price">{ ZAR(entry.CostAmount) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
	<footer class="dash-footer">
		<span>{ data.Store.Name } · { m.Plan.Label } plan · South Africa (ZAR)</span>
		if data.Nav.DemoData {
			<span>Demo workspace · every figure above is read from this sample business</span>
		} else {
			<span>Every figure above is read from your own orders, stock and quotes</span>
		}
	</footer>
}

// SalesBars is a 14-day bar chart; each bar has a text alternative.
templ SalesBars(days []models.DayPoint) {
	{{ max := maxDaily(days) }}
	<div class="bars" role="img" aria-label="Daily sales for the last 14 days">
		for i, d := range days {
			<div
				class={ "b", templ.KV("today", i == len(days)-1) }
				style={ barHeight(d.SalesZar, max) }
				title={ fmt.Sprintf("%s: %s, %d %s", d.Day.Format("Mon 2 Jan"), ZAR(d.SalesZar), d.Orders, Plural(d.Orders, "sale", "sales")) }
			></div>
		}
	</div>
	<div class="bars-axis" aria-hidden="true">
		for i, d := range days {
			<span>
				if i == 0 || i == len(days)-1 || i == len(days)/2 {
					{ d.Day.Format("2 Jan") }
				}
			</span>
		}
	</div>
}

// ShareList shows a ranked mix with amounts and share bars.
templ ShareList(rows []models.ShareRow, empty string) {
	if len(rows) == 0 {
		<p class="muted small-text">{ empty }</p>
	}
	for _, r := range rows {
		<div class="share-row">
			<span>{ r.Label }</span>
			<b>{ ZARWhole(r.ValueZar) } <span class="muted" style="font-weight:500;">· { Pct(r.Pct) }</span></b>
			<div class="progress"><span style={ Width(r.Pct) }></span></div>
		</div>
	}
}
