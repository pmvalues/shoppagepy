package templates

import (
	"fmt"

	"github.com/shoppage/merchant-os/internal/models"
)

func barHeight(v, max float64) string {
	if max <= 0 || v <= 0 {
		return "height:2px"
	}
	return fmt.Sprintf("height:%.1f%%", v/max*100)
}

func maxDaily(days []models.DayPoint) float64 {
	m := 0.0
	for _, d := range days {
		if d.SalesZar > m {
			m = d.SalesZar
		}
	}
	return m
}

func attentionIcon(kind string) string {
	switch kind {
	case "message":
		return "chat"
	case "stock":
		return "inventory"
	case "quote":
		return "rfqs"
	case "feed":
		return "feeds"
	}
	return "orders"
}

func attentionTone(tone string) string {
	switch tone {
	case "danger":
		return "thumb danger"
	case "warn":
		return "thumb warn"
	}
	return "thumb info"
}

// OverviewTab is Home: what needs the merchant now, then how the month is
// going. Every figure comes from data.Metrics and links to the list behind it.
templ OverviewTab(data models.DashboardViewData) {
	{{ m := data.Metrics }}
	<div class="page-head">
		<div class="head-copy">
			<h2>{ Greeting(m.Now.In(sast)) }</h2>
			if len(m.Attention) > 0 {
				<p>{ fmt.Sprintf("%d %s need your attention.", len(m.Attention), Plural(len(m.Attention), "thing", "things")) }</p>
			} else {
				<p>You're all caught up.</p>
			}
		</div>
		<div class="actions">
			<a class="btn ghost" href="/catalog/new">
				@IconSized("plus", 16)
				Add product
			</a>
			<a class="btn solid" href="/tab/pos" hx-get="/tab/pos" hx-target="#tab-content" hx-push-url="true">Counter sale</a>
		</div>
	</div>
	if m.SetupDone < len(m.Setup) {
		<section class="card panel section" aria-labelledby="setup-title">
			<div class="panel-head">
				<div>
					<h3 id="setup-title">Finish setting up your store</h3>
					<div class="sub">{ fmt.Sprintf("%d of %d done", m.SetupDone, len(m.Setup)) }</div>
				</div>
				<div class="right" style="min-width:160px;">
					<div class="progress" style="width:160px;"><span style={ Width(float64(m.SetupDone) / float64(len(m.Setup)) * 100) }></span></div>
				</div>
			</div>
			<div class="setup">
				for _, st := range m.Setup {
					<div class={ "setup-step", templ.KV("done", st.Done) }>
						<span class="ic" aria-hidden="true">✓</span>
						<div>
							<b>{ st.Title }</b>
							if !st.Done {
								<p>{ st.Detail }</p>
							}
						</div>
						if !st.Done {
							<a class="btn small ghost" href={ templ.SafeURL(st.Href) } hx-get={ st.Href } hx-target="#tab-content" hx-push-url="true">Start</a>
						} else {
							<span class="sr-only">Done</span>
						}
					</div>
				}
			</div>
		</section>
	}
	<section class="grid-kpi" aria-label="Key figures">
		<a class="card kpi" href="/tab/analytics" hx-get="/tab/analytics" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">
				Sales today
				if pct, ok := models.PctChange(m.TodaySalesZar, m.YesterdaySalesZar); ok {
					<span class={ "chip", templ.KV("up", pct >= 0), templ.KV("down", pct < 0) }>{ Signed(pct) }</span>
				}
			</div>
			<div class="k-val">{ ZARWhole(m.TodaySalesZar) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d %s", m.TodayOrders, Plural(m.TodayOrders, "sale", "sales")) } · yesterday { ZARWhole(m.YesterdaySalesZar) }</div>
		</a>
		<a class="card kpi" href="/tab/analytics" hx-get="/tab/analytics" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">
				Sales this month
				if pct, ok := models.PctChange(m.MonthSalesZar, m.PrevMonthSalesZar); ok {
					<span class={ "chip", templ.KV("up", pct >= 0), templ.KV("down", pct < 0) } title="Compared with the same days last month">{ Signed(pct) }</span>
				}
			</div>
			<div class="k-val">{ ZARWhole(m.MonthSalesZar) }</div>
			<div class="k-foot">
				{ fmt.Sprintf("%d %s", m.MonthOrders, Plural(m.MonthOrders, "sale", "sales")) }
				if m.MonthOrders > 0 {
					· average { ZARWhole(m.AvgOrderValueZar) }
				}
			</div>
		</a>
		<a class="card kpi" href="/tab/orders" hx-get="/tab/orders" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">Open orders</div>
			<div class="k-val">{ Int(m.OpenOrders) }</div>
			<div class="k-foot">{ fmt.Sprintf("%d awaiting payment · %d to pack", m.AwaitingPayment, m.ToFulfil) }</div>
		</a>
		<a class="card kpi" href="/tab/inventory?stock=low" hx-get="/tab/inventory?stock=low" hx-target="#tab-content" hx-push-url="true">
			<div class="k-label">
				Low on stock
				if m.OutOfStock > 0 {
					<span class="chip down">{ fmt.Sprintf("%d out", m.OutOfStock) }</span>
				}
			</div>
			<div class="k-val">{ Int(len(m.LowStock)) }</div>
			<div class="k-foot">{ fmt.Sprintf("of %d products · stock worth %s", m.Products, ZARWhole(m.CatalogValueZar)) }</div>
		</a>
	</section>
	<section class="row-2">
		<article class="card panel" aria-labelledby="attention-title">
			<div class="panel-head">
				<div>
					<h3 id="attention-title">Needs you</h3>
					<div class="sub">Most urgent first</div>
				</div>
			</div>
			if len(m.Attention) == 0 {
				<div class="empty">
					<div class="empty-icon">
						@IconSized("check", 22)
					</div>
					<h3>Nothing waiting</h3>
					<p>New messages, orders to pack and low stock will show up here.</p>
				</div>
			} else {
				<div class="list">
					for _, it := range m.Attention {
						<a class="li" href={ templ.SafeURL(it.Href) } hx-get={ it.Href } hx-target="#tab-content" hx-push-url="true">
							<span class={ attentionTone(it.Tone) } aria-hidden="true">
								@IconSized(attentionIcon(it.Kind), 18)
							</span>
							<div class="txt">
								<b>{ it.Title }</b>
								<span>{ it.Detail }</span>
							</div>
							<span class="btn small ghost">{ it.Action }</span>
						</a>
					}
				</div>
			}
		</article>
		<article class="card meter-card" aria-labelledby="allowance-title">
			<h3 id="allowance-title">Free sales allowance</h3>
			<div class="sub">
				{ m.Plan.Label } plan · no platform fee on your first { ZARWhole(m.Plan.FreeAllowanceZar) } of sales each month
			</div>
			<div class="meter-top">
				<div class="meter-big">{ ZARWhole(m.AllowanceUsedZar) } <span class="t">of { ZARWhole(m.Plan.FreeAllowanceZar) }</span></div>
				<div class="meter-flag">
					if m.AllowanceRemainingZar > 0 {
						<b>{ ZARWhole(m.AllowanceRemainingZar) } left</b>
						<span>then { fmt.Sprintf("%.1f%%", m.Plan.FeeRatePct) } on sales above it</span>
					} else {
						<b>Allowance used</b>
						<span>{ fmt.Sprintf("%.1f%%", m.Plan.FeeRatePct) } fee applies to further sales</span>
					}
				</div>
			</div>
			<div class="bar" role="img" aria-label={ fmt.Sprintf("%s of the free allowance used", Pct(m.AllowancePct)) }>
				<div class="fill" style={ Width(m.AllowancePct) }></div>
			</div>
			<div class="meter-scale"><span><b>R 0</b></span><span>{ ZARWhole(m.Plan.FreeAllowanceZar) }</span></div>
			<div class="meter-stats">
				<div><span>Platform fee so far</span><b>{ ZAR(m.PlatformFeeZar) }</b></div>
				<div><span>Month-end forecast</span><b>{ ZARWhole(m.ProjectedMonthZar) }</b></div>
				<div><span>Forecast fee</span><b>{ ZAR(m.ProjectedFeeZar) }</b></div>
			</div>
		</article>
	</section>
	<section class="row-2">
		<article class="card panel" aria-labelledby="sales-title">
			<div class="panel-head">
				<div>
					<h3 id="sales-title">Sales, last 14 days</h3>
					<div class="sub">{ ZARWhole(m.Last14Sales) } from { fmt.Sprintf("%d %s", m.Last14Orders, Plural(m.Last14Orders, "sale", "sales")) }</div>
				</div>
				<a class="right link small-text" href="/tab/analytics" hx-get="/tab/analytics" hx-target="#tab-content" hx-push-url="true">Analytics →</a>
			</div>
			@SalesBars(m.Daily)
			if m.Best.SalesZar > 0 {
				<p class="muted small-text" style="margin-top:10px;">Best day: { m.Best.Day.Format("Mon 2 Jan") } · { ZARWhole(m.Best.SalesZar) }</p>
			}
		</article>
		<article class="card panel" aria-labelledby="assist-title">
			<div class="panel-head">
				<div>
					<h3 id="assist-title">Suggestions</h3>
					<div class="sub">From your stock, quotes and listings. You approve every change.</div>
				</div>
				<a class="right link small-text" href="/tab/copilot" hx-get="/tab/copilot" hx-target="#tab-content" hx-push-url="true">All →</a>
			</div>
			{{ shown := 0 }}
			<div class="stack" style="gap:8px;">
				for _, p := range data.Proposals {
					if p.Status == "pending" && shown < 3 {
						{{ shown++ }}
						<div class="proposal">
							<b>{ p.Title }</b>
							<span class="why">{ p.Reason }</span>
						</div>
					}
				}
			</div>
			if shown == 0 {
				<p class="muted small-text">No suggestions right now.</p>
			}
		</article>
	</section>
	<section class="row-3">
		<article class="card panel">
			<div class="panel-head"><h3>Top products this month</h3></div>
			@ShareList(m.TopProducts, "No sales this month yet.")
		</article>
		<article class="card panel">
			<div class="panel-head"><h3>Where sales came from</h3></div>
			@ShareList(m.ChannelMix, "No sales this month yet.")
		</article>
		<article class="card panel">
			<div class="panel-head"><h3>How buyers paid</h3></div>
			@ShareList(m.PaymentMix, "No sales this month yet.")
		</article>
	</section>
}

// SalesBars is a 14-day bar chart; each bar has a text alternative.
templ SalesBars(days []models.DayPoint) {
	{{ max := maxDaily(days) }}
	<div class="bars" role="img" aria-label="Daily sales for the last 14 days">
		for i, d := range days {
			<div
				class={ "b", templ.KV("today", i == len(days)-1) }
				style={ barHeight(d.SalesZar, max) }
				title={ fmt.Sprintf("%s: %s, %d %s", d.Day.Format("Mon 2 Jan"), ZAR(d.SalesZar), d.Orders, Plural(d.Orders, "sale", "sales")) }
			></div>
		}
	</div>
	<div class="bars-axis" aria-hidden="true">
		for i, d := range days {
			<span>
				if i == 0 || i == len(days)-1 || i == len(days)/2 {
					{ d.Day.Format("2 Jan") }
				}
			</span>
		}
	</div>
}

// ShareList shows a ranked mix with amounts and share bars.
templ ShareList(rows []models.ShareRow, empty string) {
	if len(rows) == 0 {
		<p class="muted small-text">{ empty }</p>
	}
	for _, r := range rows {
		<div class="share-row">
			<span>{ r.Label }</span>
			<b>{ ZARWhole(r.ValueZar) } <span class="muted" style="font-weight:500;">· { Pct(r.Pct) }</span></b>
			<div class="progress"><span style={ Width(r.Pct) }></span></div>
		</div>
	}
}
