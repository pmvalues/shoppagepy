package templates

import (
	"fmt"
	"strings"

	"github.com/shoppage/merchant-os/internal/models"
)

func recentCounts(ledger []models.ItemLedgerEntry) []models.ItemLedgerEntry {
	var out []models.ItemLedgerEntry
	for _, e := range ledger {
		if strings.HasPrefix(e.Description, "Count at") || strings.HasPrefix(e.DocumentNo, "COUNT-") || strings.HasPrefix(e.DocumentNo, "CYCLE-") {
			out = append(out, e)
		}
	}
	return out
}

// ScanStationTab records physical stock counts. Scan with a handheld scanner,
// the phone camera (where the browser supports it) or type the code; the
// count replaces the location's quantity and the difference is logged.
templ ScanStationTab(data models.DashboardViewData) {
	<div class="page-head">
		<div class="head-copy">
			<p>Count what's on the shelf. The difference from your records is logged as an adjustment.</p>
		</div>
	</div>
	<div class="row-2 even">
		<article class="card panel">
			<div class="panel-head"><h3>Count a product</h3></div>
			<div class="form-group">
				<label for="count-find">Scan or enter a barcode or SKU</label>
				<div class="cluster" style="flex-wrap:nowrap;">
					<input class="input mono" id="count-find" type="search" autocomplete="off" placeholder="e.g. 6009882400018 or MIT-3361" autofocus/>
					<button type="button" class="btn ghost" id="count-camera" hidden>
						@IconSized("barcode", 16)
						Camera
					</button>
				</div>
				<video id="count-video" playsinline muted hidden style="width:100%; border-radius:var(--r-lg); margin-top:8px; background:#000;"></video>
			</div>
			<form id="count-form" hx-post="/scan/reconcile" hx-target="#tab-content" hidden>
				<input type="hidden" name="skuId" id="count-sku"/>
				<div class="card" style="padding:12px; background:var(--surface-2); margin-bottom:12px;">
					<b id="count-title"></b>
					<div class="small-text muted mono" id="count-code"></div>
				</div>
				<div class="two-col">
					<div class="form-group">
						<label for="count-hub">Location</label>
						<select id="count-hub" name="hub" class="select-full">
							for _, h := range data.Warehouses {
								<option value={ h.ID }>{ h.Name }</option>
							}
						</select>
					</div>
					<div class="form-group">
						<label for="count-qty">Counted</label>
						<input id="count-qty" type="number" name="physicalCount" class="input" min="0" inputmode="numeric" required/>
						<p class="help" id="count-diff"></p>
					</div>
				</div>
				<button type="submit" class="btn solid block">Save count</button>
			</form>
			<p class="muted small-text" id="count-hint">Nothing selected yet.</p>
			<div hidden id="count-data">
				for _, p := range data.Catalog {
					<span
						data-id={ p.ID }
						data-sku={ p.SKU }
						data-barcode={ p.Spec.Barcode }
						data-title={ p.Title }
						{ hubAttrs(p, data.Warehouses)... }
					></span>
				}
			</div>
		</article>
		<article class="card panel">
			<div class="panel-head">
				<div>
					<h3>Recent counts</h3>
					<div class="sub">Newest first</div>
				</div>
			</div>
			if len(recentCounts(data.ItemLedger)) == 0 {
				<p class="muted small-text">No counts recorded yet.</p>
			}
			<div class="list">
				for _, e := range recentCounts(data.ItemLedger) {
					<div class="li">
						<span class={ countThumb(e.Quantity) } aria-hidden="true">{ fmt.Sprintf("%+d", e.Quantity) }</span>
						<div class="txt">
							<b>{ e.SKU }</b>
							<span>{ e.Description }</span>
						</div>
						<div class="val"><span title={ LocalDateTime(e.PostingDate) }>{ Ago(e.PostingDate, data.Metrics.Now) }</span></div>
					</div>
				}
			</div>
		</article>
	</div>
	<script>
		(function () {
			var $ = function (id) { return document.getElementById(id); };
			var items = Array.prototype.slice.call(document.querySelectorAll('#count-data span'));
			var current = null;
			function pick(el) {
				current = el;
				$('count-form').hidden = false;
				$('count-hint').hidden = true;
				$('count-sku').value = el.dataset.id;
				$('count-title').textContent = el.dataset.title;
				$('count-code').textContent = el.dataset.sku + ' · ' + el.dataset.barcode;
				$('count-qty').value = '';
				diff();
				$('count-qty').focus();
			}
			function onRecord() { return current ? parseInt(current.getAttribute('data-hub-' + $('count-hub').value) || '0', 10) : 0; }
			function diff() {
				var rec = onRecord(), c = parseInt($('count-qty').value, 10);
				$('count-diff').textContent = isNaN(c) ? 'On record here: ' + rec : 'On record ' + rec + ' · difference ' + (c - rec > 0 ? '+' : '') + (c - rec);
			}
			function find(q) {
				q = (q || '').trim().toLowerCase();
				if (!q) return;
				var hit = items.find(function (el) { return el.dataset.barcode === q || el.dataset.sku.toLowerCase() === q; }) ||
					items.find(function (el) { return (el.dataset.title + ' ' + el.dataset.sku).toLowerCase().indexOf(q) >= 0; });
				if (hit) { pick(hit); $('count-find').value = ''; }
				else if (window.showToast) showToast('No product has the code "' + q + '".');
			}
			$('count-find').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); find(this.value); } });
			$('count-hub').onchange = diff;
			$('count-qty').oninput = diff;

			// Camera scanning where the browser has a built-in barcode reader.
			if ('BarcodeDetector' in window && navigator.mediaDevices) {
				var btn = $('count-camera'), video = $('count-video'), stream = null;
				btn.hidden = false;
				btn.onclick = function () {
					if (stream) { stream.getTracks().forEach(function (t) { t.stop(); }); stream = null; video.hidden = true; return; }
					var det = new BarcodeDetector({ formats: ['ean_13', 'ean_8', 'upc_a', 'code_128'] });
					navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } }).then(function (s) {
						stream = s; video.srcObject = s; video.hidden = false; video.play();
						(function loop() {
							if (!stream) return;
							det.detect(video).then(function (codes) {
								if (codes.length) { find(codes[0].rawValue); stream.getTracks().forEach(function (t) { t.stop(); }); stream = null; video.hidden = true; }
								else requestAnimationFrame(loop);
							}).catch(function () { requestAnimationFrame(loop); });
						})();
					}).catch(function () { if (window.showToast) showToast('Camera access was blocked.'); });
				};
			}
		})();
	</script>
}

func countThumb(q int) string {
	switch {
	case q > 0:
		return "thumb ok"
	case q < 0:
		return "thumb danger"
	}
	return "thumb"
}

func hubAttrs(p models.CatalogSKU, hubs []models.WarehouseHub) templ.Attributes {
	a := templ.Attributes{}
	for _, h := range hubs {
		a["data-hub-"+h.ID] = fmt.Sprint(p.StockByHub[h.ID])
	}
	return a
}
