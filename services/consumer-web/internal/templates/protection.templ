package templates

import (
	"github.com/shoppage/consumer-web/internal/models"
)

templ BuyerProtectionPageComponent(data BuyerProtectionViewData) {
	@Layout(data.Title, data.Description, data.CurrentTab, []models.TradeTrend{}, []models.RetailerDeal{}, []models.CommunityGuild{}) {
		<main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
			<!-- Hero Header -->
			<div class="relative overflow-hidden rounded-3xl bg-slate-950 p-8 sm:p-12 text-white shadow-xl border border-slate-800 mb-10" style="background-color: #090d16; background-image: linear-gradient(135deg, #090d16 0%, #0f172a 55%, #064e3b 100%);">
				<div class="relative z-10 max-w-2xl space-y-4">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider" style="background: rgba(16, 185, 129, 0.12); color: #34d399; border-color: rgba(52, 211, 153, 0.35);">
						<span>🛡️ Shoppage Trade Assurance</span>
					</div>
					<h1 class="text-3xl sm:text-5xl font-extrabold font-display tracking-tight text-white leading-tight" style="color: #ffffff !important;">
						Commercial Buyer Protection &amp; Escrow Guarantee
					</h1>
					<p class="text-sm sm:text-base text-slate-200 leading-relaxed max-w-xl" style="color: #cbd5e1 !important;">
						Every commercial transaction on Shoppage is backed by South African bank escrow, CIPC business vetting, and 14-day CPA dispute coverage.
					</p>
				</div>
			</div>

			<!-- 4 Core Pillars of Commercial Trust -->
			<div class="space-y-6">
				<!-- Pillar 1: Bank Escrow -->
				<div id="escrow" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col md:flex-row items-start gap-6">
					<div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-700 text-2xl font-bold flex items-center justify-center shrink-0">
						🔒
					</div>
					<div class="space-y-2 flex-1">
						<div class="flex items-center gap-2">
							<h3 class="text-base font-extrabold text-slate-900">1. South African Bank Escrow Settlement</h3>
							<span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">Guaranteed</span>
						</div>
						<p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
							When you purchase through BuyBox or instant proforma EFT, your payment is held in a dedicated South African commercial trust account. Funds are only released to the supplier once The Courier Guy registers an in-transit scan or the package is successfully collected from a Pudo Smart Locker.
						</p>
					</div>
				</div>

				<!-- Pillar 2: CIPC Enterprise Verification -->
				<div id="verification" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col md:flex-row items-start gap-6">
					<div class="w-14 h-14 rounded-2xl bg-slate-900 text-emerald-400 text-2xl font-bold flex items-center justify-center shrink-0">
						🏢
					</div>
					<div class="space-y-2 flex-1">
						<div class="flex items-center gap-2">
							<h3 class="text-base font-extrabold text-slate-900">2. CIPC &amp; SABS Enterprise Vetting</h3>
							<span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-800 text-[10px] font-bold">Legally Verified</span>
						</div>
						<p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
							Shoppage eliminates rogue traders and ghost suppliers. All featured wholesalers and suppliers must submit valid Companies and Intellectual Property Commission (CIPC) registration documentation, physical depot addresses, and SABS / CE product conformity certifications.
						</p>
					</div>
				</div>

				<!-- Pillar 3: 14-Day CPA Returns Policy -->
				<div id="cpa" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col md:flex-row items-start gap-6">
					<div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 text-2xl font-bold flex items-center justify-center shrink-0">
						📦
					</div>
					<div class="space-y-2 flex-1">
						<div class="flex items-center gap-2">
							<h3 class="text-base font-extrabold text-slate-900">3. 14-Day Consumer Protection Act (CPA) Replacement</h3>
							<span class="px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 text-[10px] font-bold">Hassle-Free</span>
						</div>
						<p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
							In accordance with the South African Consumer Protection Act 68 of 2008, if merchandise is delivered defective, damaged in transit, or fails to match technical specifications, you have 14 days to request an immediate RMA return with free reverse logistics via The Courier Guy.
						</p>
					</div>
				</div>

				<!-- Pillar 4: SARS 15% VAT Tax Compliance -->
				<div id="sars" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col md:flex-row items-start gap-6">
					<div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-700 text-2xl font-bold flex items-center justify-center shrink-0">
						🧾
					</div>
					<div class="space-y-2 flex-1">
						<div class="flex items-center gap-2">
							<h3 class="text-base font-extrabold text-slate-900">4. SARS Compliant Tax Invoicing</h3>
							<span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold">SARS 15% VAT</span>
						</div>
						<p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
							Every order generates an immediate South African Revenue Service (SARS) compliant Tax Invoice including full VAT registration numbers, merchant legal entities, and itemized VAT breakdowns for seamless corporate accounting and input tax deductions.
						</p>
					</div>
				</div>
			</div>

			<!-- Support CTA Card -->
			<div class="mt-10 p-8 rounded-3xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-6" style="background-color: #090d16;">
				<div>
					<h3 class="text-lg font-bold text-white">Need assistance with an active order or dispute?</h3>
					<p class="text-xs text-slate-400 mt-1">Our South African operations desk in Midrand resolves 98.4% of queries within 2 hours.</p>
				</div>
				<div class="flex items-center gap-3 shrink-0">
					<a href="/track" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold transition border border-slate-700">
						Track Order
					</a>
					<a href="https://wa.me/27825551234?text=Hi%20Shoppage%20Support,%20I%20need%20help%20with%20my%20order" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition shadow-sm">
						WhatsApp Operations Desk &rarr;
					</a>
				</div>
			</div>
		</main>
	}
}
