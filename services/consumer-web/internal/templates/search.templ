package templates

import (
	"fmt"
	"net/url"
	"sort"

	"github.com/shoppage/consumer-web/internal/models"
)

// searchSummary is a computed overview of the results (price range, where
// it's cheapest). It never states anything the result rows don't show.
type searchSummary struct {
	Count       int
	Low, High   float64
	LowTitle    string
	LowID       string
	Stores      int
	InStock     int
	Median      float64
}

func summarise(items []models.SearchItem) searchSummary {
	s := searchSummary{Count: len(items)}
	var prices []float64
	for _, it := range items {
		if it.PriceZar <= 0 {
			continue
		}
		prices = append(prices, it.PriceZar)
		if s.Low == 0 || it.PriceZar < s.Low {
			s.Low, s.LowTitle, s.LowID = it.PriceZar, it.Title, it.ID
		}
		if it.PriceZar > s.High {
			s.High = it.PriceZar
		}
		s.Stores += it.OffersCount
		if it.InStock {
			s.InStock++
		}
	}
	if len(prices) > 0 {
		sort.Float64s(prices)
		s.Median = prices[len(prices)/2]
	}
	return s
}

func searchHref(d SearchViewData, key, val string) string {
	v := url.Values{}
	set := func(k, x string) {
		if x != "" && x != "all" {
			v.Set(k, x)
		}
	}
	set("q", d.Query)
	set("tab", d.CurrentTab)
	set("category", d.Category)
	set("province", d.Province)
	set("sort", d.Sort)
	if d.InStockOnly {
		v.Set("in_stock", "true")
	}
	if val == "" {
		v.Del(key)
	} else {
		v.Set(key, val)
	}
	return "/search?" + v.Encode()
}

var provinces = []string{"Gauteng", "Western Cape", "KwaZulu-Natal", "Eastern Cape", "Free State", "Limpopo", "Mpumalanga", "North West", "Northern Cape"}

// SearchPageComponent is the full results page.
templ SearchPageComponent(data SearchViewData) {
	@Layout(searchTitle(data), data.Description, "all", []models.TradeTrend{}, []models.RetailerDeal{}, []models.CommunityGuild{}) {
		<nav class="tabs" aria-label="Result types">
			<a href={ templ.SafeURL(searchHref(data, "tab", "")) } { current(data.CurrentTab != "deals")... }>All</a>
			<a href={ templ.SafeURL(searchHref(data, "tab", "deals")) } { current(data.CurrentTab == "deals")... }>Deals</a>
			<a href={ templ.SafeURL("/malls?q=" + url.QueryEscape(data.Query)) }>Stores &amp; markets</a>
		</nav>
		<div id="results">
			@SearchResultsGridComponent(data)
		</div>
	}
}

func searchTitle(d SearchViewData) string {
	if d.Query != "" {
		return d.Query
	}
	if d.Category != "" {
		return d.Category
	}
	return "Search"
}

// SearchResultsGridComponent is the results body (also returned for HTMX).
templ SearchResultsGridComponent(data SearchViewData) {
	{{ sum := summarise(data.Products) }}
	<div class="results" id="results-grid">
		<form class="filters" action="/search" method="get" aria-label="Filters" data-autosubmit>
			<input type="hidden" name="q" value={ data.Query }/>
			if data.CurrentTab == "deals" {
				<input type="hidden" name="tab" value="deals"/>
			}
			<div class="fgroup">
				<h3>Sort by</h3>
				for _, s := range [][2]string{{"", "Relevance"}, {"price_asc", "Price: low to high"}, {"price_desc", "Price: high to low"}} {
					<label><input type="radio" name="sort" value={ s[0] } checked?={ data.Sort == s[0] } onchange="this.form.requestSubmit()"/>{ s[1] }</label>
				}
			</div>
			<div class="fgroup">
				<h3>Availability</h3>
				<label><input type="checkbox" name="in_stock" value="true" checked?={ data.InStockOnly } onchange="this.form.requestSubmit()"/>In stock</label>
			</div>
			if len(data.Categories) > 0 {
				<div class="fgroup">
					<h3>Category</h3>
					<label><input type="radio" name="category" value="" checked?={ data.Category == "" } onchange="this.form.requestSubmit()"/>All</label>
					for _, c := range data.Categories {
						<label><input type="radio" name="category" value={ c } checked?={ data.Category == c } onchange="this.form.requestSubmit()"/>{ Humanize(c) }</label>
					}
				</div>
			}
			<div class="fgroup">
				<h3>Province</h3>
				<label><input type="radio" name="province" value="" checked?={ data.Province == "" } onchange="this.form.requestSubmit()"/>All of South Africa</label>
				for _, p := range provinces {
					<label><input type="radio" name="province" value={ p } checked?={ data.Province == p } onchange="this.form.requestSubmit()"/>{ p }</label>
				}
			</div>
			<noscript><button class="btn btn-outline btn-sm" type="submit">Apply</button></noscript>
			<!-- Compact chips for narrow screens (filter groups are hidden there) -->
			<a class="chip narrow" href={ templ.SafeURL(searchHref(data, "sort", "price_asc")) } aria-pressed={ pressed(data.Sort == "price_asc") }>Lowest price</a>
			<a class="chip narrow" href={ templ.SafeURL(searchHref(data, "in_stock", boolParam(!data.InStockOnly))) } aria-pressed={ pressed(data.InStockOnly) }>In stock</a>
			for _, c := range firstN(data.Categories, 5) {
				<a class="chip narrow" href={ templ.SafeURL(searchHref(data, "category", toggle(data.Category, c))) } aria-pressed={ pressed(data.Category == c) }>{ Humanize(c) }</a>
			}
		</form>
		<div style="min-width:0;">
			<p class="res-meta">
				if sum.Count > 0 {
					{ fmt.Sprintf("%d %s", sum.Count, plural(sum.Count, "result", "results")) }
				} else {
					No products found
				}
				if data.LatencyMs > 0 {
					<span class="faint">{ fmt.Sprintf("(%.2f seconds)", data.LatencyMs/1000) }</span>
				}
			</p>
			if sum.Count >= 2 && sum.Low > 0 {
				<section class="overview" aria-label="Summary">
					<h2>
						@Ico("spark", 16)
						Summary
					</h2>
					<p>{ summarySentence(sum) }</p>
					<ul>
						<li>Lowest price: <a href={ templ.SafeURL("/p/" + sum.LowID) } style="color:var(--link)">{ sum.LowTitle }</a> at R { FormatZAR(sum.Low) }.</li>
						if sum.InStock > 0 {
							<li>{ fmt.Sprintf("%d of %d are shown as in stock.", sum.InStock, sum.Count) }</li>
						}
					</ul>
				</section>
			}
			if sum.Count > 0 {
				<div class="tiles">
					for _, p := range data.Products {
						@ProductTile(p)
					}
				</div>
			} else if len(data.MatchingMerchants) == 0 && len(data.MatchingMalls) == 0 {
				<div class="empty">
					@Ico("search", 40)
					if data.Query != "" {
						<h2>No results for "{ data.Query }"</h2>
					} else {
						<h2>Search for a product</h2>
					}
					<p>Check the spelling, try a more general word, or ask stores directly.</p>
					<a class="btn btn-brand" href="/?tab=tradewire#compose">Post a request</a>
				</div>
			}
			if len(data.MatchingMerchants) > 0 || len(data.MatchingMalls) > 0 {
				<h2 style="font-size:20px;margin:28px 0 4px;">Stores and markets</h2>
				<div class="webres">
					for _, m := range data.MatchingMerchants {
						<div>
							<div class="site-line">
								<span class="fav" aria-hidden="true">{ FirstRune(m.Name) }</span>
								<div>
									{ m.Name }
									<small>shoppage.co.za › m › { m.ID }</small>
								</div>
							</div>
							<h3><a href={ templ.SafeURL("/m/" + m.ID) }>{ m.Name }{ storeSuffix(m) }</a></h3>
							<p>{ storeSnippet(m) }</p>
						</div>
					}
					for _, mall := range data.MatchingMalls {
						<div>
							<div class="site-line">
								<span class="fav" aria-hidden="true">
									@Ico("store", 16)
								</span>
								<div>
									{ mall.Name }
									<small>{ placeLabel(mall.Suburb, mall.Metro) }</small>
								</div>
							</div>
							<h3><a href={ templ.SafeURL("/malls/" + mall.ID) }>{ mall.Name }</a></h3>
							<p>
								{ mall.StreetAddress }
								if mall.StoreCount > 0 {
									{ fmt.Sprintf(" · %d stores", mall.StoreCount) }
								}
							</p>
						</div>
					}
				</div>
			}
		</div>
	</div>
}

func boolParam(b bool) string {
	if b {
		return "true"
	}
	return ""
}

func toggle(cur, v string) string {
	if cur == v {
		return ""
	}
	return v
}

func plural(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}

func storeSuffix(m models.MerchantStorefront) string {
	if m.City != "" {
		return " — " + m.City
	}
	return ""
}

func storeSnippet(m models.MerchantStorefront) string {
	if m.AboutText != "" {
		r := []rune(m.AboutText)
		if len(r) > 180 {
			return string(r[:180]) + "…"
		}
		return m.AboutText
	}
	s := m.Category
	if m.Address != "" {
		s += " · " + m.Address
	}
	if n := len(m.Catalog); n > 0 {
		s += fmt.Sprintf(" · %d products", n)
	}
	return s
}

func summarySentence(s searchSummary) string {
	out := fmt.Sprintf("Prices range from R %s to R %s", FormatZAR(s.Low), FormatZAR(s.High))
	if s.Median > 0 && s.Median != s.Low && s.Median != s.High {
		out += fmt.Sprintf(", with most around R %s", FormatZARWhole(s.Median))
	}
	return out + "."
}
