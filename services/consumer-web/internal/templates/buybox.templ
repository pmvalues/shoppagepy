package templates

import (
	"fmt"
	"net/url"
)

// BuyBoxDrawerComponent is the "where to buy" side sheet: the product, then
// every store's price, cheapest first, with a way to contact each one.
templ BuyBoxDrawerComponent(data BuyBoxViewData) {
	{{ offers := sortedOffers(data.Product) }}
	<div class="drawer-scrim" aria-hidden="true"></div>
	<aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
		<header>
			<h2 id="drawer-title">Where to buy</h2>
			<button type="button" class="icon-btn" data-drawer-close aria-label="Close">
				@Ico("x", 20)
			</button>
		</header>
		<div class="body">
			<div style="display:flex;gap:14px;align-items:center;padding:16px;border-bottom:1px solid var(--line);">
				<div class="t-img" style="width:88px;flex:none;">
					if data.Product.ImageURL != "" {
						<img src={ data.Product.ImageURL } alt=""/>
					}
				</div>
				<div style="min-width:0;">
					if data.Product.Brand != "" {
						<div class="muted" style="font-size:13px;">{ data.Product.Brand }</div>
					}
					<div style="font-weight:600;">{ data.Product.Title }</div>
					<div class="num" style="font-weight:700;font-size:18px;margin-top:2px;">
						if data.LowestPrice > 0 {
							From R { FormatZAR(data.LowestPrice) }
						} else {
							Price on request
						}
					</div>
				</div>
			</div>
			if len(data.Product.DeliveryOptions) > 0 {
				<div class="facts" style="padding:0 16px;">
					for _, d := range data.Product.DeliveryOptions {
						<span class="fact">
							@Ico("truck", 14)
							{ d.Label }
							if d.CostDisplay != "" {
								· { d.CostDisplay }
							}
						</span>
					}
				</div>
			}
			<div class="compare" style="margin:16px;">
				<h2>
					Stores
					<small>{ fmt.Sprintf("%d", len(offers)) }</small>
				</h2>
				if len(offers) == 0 {
					<p class="muted" style="padding:14px 16px;margin:0;">No store prices yet.</p>
				}
				for i, o := range offers {
					<div class="offer">
						<div class="who">
							{ o.MerchantName }
							if i == 0 && len(offers) > 1 && o.PriceZar > 0 {
								<span class="best">Lowest</span>
							}
						</div>
						<div class="p num">
							if o.PriceZar > 0 {
								R { FormatZAR(o.PriceZar) }
							} else {
								On request
							}
						</div>
						<div class="det">{ offerDetail(o) }</div>
						<div class="go">
							if o.WhatsApp != "" {
								<a class="btn btn-outline btn-sm" target="_blank" rel="noopener" href={ templ.SafeURL("https://wa.me/" + o.WhatsApp + "?text=" + url.QueryEscape(offerMessage(data.Product, o))) }>Contact</a>
							}
						</div>
					</div>
				}
			</div>
			if data.Product.CanonicalID != "" {
				<div style="padding:0 16px 20px;">
					<a class="btn btn-primary btn-block" href={ templ.SafeURL("/p/" + data.Product.CanonicalID) }>View product</a>
				</div>
			}
		</div>
	</aside>
}
