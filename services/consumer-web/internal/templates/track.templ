package templates

import (
	"fmt"
	"github.com/shoppage/consumer-web/internal/models"
)

templ TrackPageComponent(data TrackViewData) {
	@Layout(data.Title, data.Description, data.CurrentTab, []models.TradeTrend{}, []models.RetailerDeal{}, []models.CommunityGuild{}) {
		<main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
			<!-- Header -->
			<div class="mb-8 text-center max-w-2xl mx-auto">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-3">
					<span>🚚 Live Logistics &amp; Waybill Tracking</span>
				</div>
				<h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight font-display">
					Track Your Commercial Order &amp; Delivery
				</h1>
				<p class="text-xs sm:text-sm text-slate-500 mt-2">
					Real-time courier telemetry via The Courier Guy and Pudo Smart Lockers across all 9 South African provinces.
				</p>

				<!-- Tracking Input Bar -->
				<form action="/track" method="GET" class="mt-6 flex items-center gap-2 max-w-md mx-auto bg-white p-2 rounded-2xl border border-slate-200 shadow-sm">
					<div class="pl-3 text-slate-400">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.35-4.35"></path></svg>
					</div>
					<input 
						type="text" 
						name="q" 
						value={ data.Query }
						placeholder="Enter Order # (e.g. ORD-2026-1042) or Waybill..." 
						class="flex-1 px-2 py-2 text-xs sm:text-sm font-medium outline-none text-slate-900 placeholder:text-slate-400"
						required
					/>
					<button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition shadow-xs cursor-pointer shrink-0">
						Track Order
					</button>
				</form>

				<!-- Quick Try Shortcuts -->
				<div class="mt-3 flex items-center justify-center gap-2 text-[11px] text-slate-400 flex-wrap">
					<span>Quick search samples:</span>
					<a href="/track?q=ORD-2026-1042" class="font-mono text-emerald-700 hover:underline font-bold">ORD-2026-1042</a>
					<span>•</span>
					<a href="/track?q=TCG-ZA-849201" class="font-mono text-emerald-700 hover:underline font-bold">TCG-ZA-849201 (The Courier Guy)</a>
					<span>•</span>
					<a href="/track?q=PUDO-ZA-392180" class="font-mono text-emerald-700 hover:underline font-bold">PUDO-ZA-392180 (Pudo Locker)</a>
				</div>
			</div>

			if data.Found {
				<!-- ORDER FOUND DISPLAY -->
				<div class="space-y-6 animate-fadeIn">
					<!-- Top Summary Card -->
					<div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
						<div class="flex items-start gap-4">
							<div class="w-12 h-12 rounded-2xl bg-slate-900 text-white font-bold flex items-center justify-center text-xl shrink-0">
								📦
							</div>
							<div>
								<div class="flex items-center gap-2 flex-wrap">
									<h2 class="text-base sm:text-lg font-black text-slate-900">{ data.Order.OrderNumber }</h2>
									<span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">
										✓ { data.Order.Status }
									</span>
								</div>
								<div class="text-xs text-slate-500 mt-0.5">
									Placed: <span class="font-semibold text-slate-700">{ data.Order.DateStr }</span> · Carrier: <span class="font-bold text-slate-800">{ data.Order.DeliveryMethod }</span>
								</div>
							</div>
						</div>

						<div class="flex items-center gap-3 w-full md:w-auto pt-3 md:pt-0 border-t md:border-t-0 border-slate-100">
							<div class="text-right flex-1 md:flex-initial">
								<div class="text-[10px] text-slate-400 uppercase font-bold">Courier Waybill #</div>
								<div class="font-mono font-bold text-emerald-700 text-sm">{ data.Order.Waybill }</div>
							</div>
							<button type="button" onclick="window.print();" class="px-3 py-2 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-bold transition flex items-center gap-1.5 shrink-0">
								<span>📄 Tax Invoice</span>
							</button>
						</div>
					</div>

					<!-- Delivery Stepper Progress -->
					<div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
						<h3 class="text-xs font-black text-slate-900 uppercase tracking-wider mb-6">Fulfillment &amp; Transit Milestones</h3>
						<div class="relative flex flex-col sm:flex-row justify-between gap-6 sm:gap-0">
							<!-- Connecting line on desktop -->
							<div class="hidden sm:block absolute top-4 left-6 right-6 h-0.5 bg-slate-200 -z-0"></div>

							<!-- Step 1: Payment Settled -->
							<div class="relative z-10 flex sm:flex-col items-center sm:text-center gap-3 sm:gap-2 sm:w-1/4">
								<div class="w-8 h-8 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-xs shadow-sm shrink-0">
									✓
								</div>
								<div>
									<div class="text-xs font-bold text-slate-900">Payment Settled</div>
									<div class="text-[11px] text-slate-500">{ data.Order.PaymentMethod }</div>
								</div>
							</div>

							<!-- Step 2: Picked & Packed -->
							<div class="relative z-10 flex sm:flex-col items-center sm:text-center gap-3 sm:gap-2 sm:w-1/4">
								<div class="w-8 h-8 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-xs shadow-sm shrink-0">
									✓
								</div>
								<div>
									<div class="text-xs font-bold text-slate-900">Picked &amp; Packed</div>
									<div class="text-[11px] text-slate-500">Midrand Warehouse Bay 4</div>
								</div>
							</div>

							<!-- Step 3: Courier In Transit -->
							<div class="relative z-10 flex sm:flex-col items-center sm:text-center gap-3 sm:gap-2 sm:w-1/4">
								if data.Order.Status == "In Transit" || data.Order.Status == "Delivered" {
									<div class="w-8 h-8 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-xs shadow-sm shrink-0">
										🚚
									</div>
								} else {
									<div class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 font-bold flex items-center justify-center text-xs shrink-0">
										3
									</div>
								}
								<div>
									<div class="text-xs font-bold text-slate-900">Carrier In Transit</div>
									<div class="text-[11px] text-slate-500">{ data.Order.Waybill }</div>
								</div>
							</div>

							<!-- Step 4: Final Delivery -->
							<div class="relative z-10 flex sm:flex-col items-center sm:text-center gap-3 sm:gap-2 sm:w-1/4">
								if data.Order.Status == "Delivered" {
									<div class="w-8 h-8 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-xs shadow-sm shrink-0">
										✓
									</div>
									<div>
										<div class="text-xs font-bold text-emerald-700">Delivered / Ready</div>
										<div class="text-[11px] text-slate-500">{ data.Order.EstimatedEta }</div>
									</div>
								} else {
									<div class="w-8 h-8 rounded-full bg-slate-100 border border-slate-300 text-slate-400 font-bold flex items-center justify-center text-xs shrink-0">
										4
									</div>
									<div>
										<div class="text-xs font-bold text-slate-500">Estimated Delivery</div>
										<div class="text-[11px] text-slate-400">{ data.Order.EstimatedEta }</div>
									</div>
								}
							</div>
						</div>
					</div>

					<!-- Two Columns: Item details and Official SARS Tax Breakdown -->
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<!-- Left: Product & Shipping Details -->
						<div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
							<h3 class="text-xs font-black text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-3">
								Purchased Commercial Goods
							</h3>
							<div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
								<div class="font-bold text-slate-900 text-sm leading-snug">{ data.Order.ProductTitle }</div>
								<div class="text-xs text-slate-500 mt-1">
									SKU: <span class="font-mono font-bold text-slate-700">{ data.Order.SKU }</span> · Quantity: <span class="font-bold text-slate-900">{ fmt.Sprintf("%d", data.Order.Quantity) } Unit(s)</span>
								</div>
								<div class="text-xs text-slate-500 mt-0.5">
									Unit Wholesale Price: <span class="font-bold text-slate-900">R { fmt.Sprintf("%.2f", data.Order.UnitPriceZar) } Excl. VAT</span>
								</div>
							</div>

							<div class="space-y-2 text-xs">
								<div class="flex justify-between py-1 border-b border-slate-100">
									<span class="text-slate-500">Fulfilling Supplier:</span>
									<span class="font-bold text-slate-900">{ data.Order.MerchantName }</span>
								</div>
								<div class="flex justify-between py-1 border-b border-slate-100">
									<span class="text-slate-500">Supplier Depot:</span>
									<span class="font-semibold text-slate-700 text-right max-w-xs truncate">{ data.Order.MerchantAddress }</span>
								</div>
								<div class="flex justify-between py-1 border-b border-slate-100">
									<span class="text-slate-500">Recipient Name / Company:</span>
									<span class="font-bold text-slate-900">{ data.Order.BuyerName } ({ data.Order.Company })</span>
								</div>
								<div class="flex justify-between py-1 border-b border-slate-100">
									<span class="text-slate-500">Destination Address:</span>
									<span class="font-semibold text-slate-700 text-right max-w-xs">{ data.Order.DeliveryAddress }</span>
								</div>
							</div>
						</div>

						<!-- Right: SARS Tax Compliant Breakdown -->
						<div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4 flex flex-col justify-between">
							<div>
								<div class="flex items-center justify-between border-b border-slate-100 pb-3">
									<h3 class="text-xs font-black text-slate-900 uppercase tracking-wider">SARS Tax Invoice Breakdown</h3>
									<span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold font-mono">15% RSA VAT</span>
								</div>
								<div class="space-y-2 text-xs pt-4">
									<div class="flex justify-between text-slate-600">
										<span>Merchandise Subtotal (Excl. VAT):</span>
										<span class="font-mono font-bold text-slate-900">R { fmt.Sprintf("%.2f", data.Order.SubtotalZar) }</span>
									</div>
									<div class="flex justify-between text-slate-600">
										<span>Logistics / Fulfillment Fee:</span>
										<span class="font-mono font-bold text-emerald-700">INCLUDED (FREE)</span>
									</div>
									<div class="flex justify-between text-slate-600">
										<span>SARS 15% Standard VAT:</span>
										<span class="font-mono font-bold text-slate-900">R { fmt.Sprintf("%.2f", data.Order.VatZar) }</span>
									</div>
									<div class="pt-3 mt-2 border-t-2 border-slate-900 flex justify-between items-baseline">
										<span class="text-sm font-black text-slate-900">Grand Total Settled:</span>
										<span class="text-lg font-black text-emerald-700 font-display">R { fmt.Sprintf("%.2f", data.Order.GrandTotal) }</span>
									</div>
								</div>
							</div>

							<div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
								<a href={ templ.SafeURL(fmt.Sprintf("https://wa.me/27825551234?text=Hi%%20Shoppage,%%20inquiry%%20regarding%%20order%%20%s", data.Order.OrderNumber)) } target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 text-xs font-bold transition flex items-center gap-1.5">
									<span>WhatsApp Helpdesk</span>
								</a>
								<a href="/buyer-protection" class="text-xs font-bold text-slate-500 hover:text-slate-800 transition">
									Buyer Protection &amp; Returns &rarr;
								</a>
							</div>
						</div>
					</div>
				</div>
			} else if data.Query != "" {
				<!-- NOT FOUND STATE -->
				<div class="bg-white rounded-3xl border border-dashed border-slate-300 p-12 text-center max-w-lg mx-auto">
					<div class="text-3xl mb-2">🔍</div>
					<h3 class="text-base font-bold text-slate-900 mb-1">No order found for "{ data.Query }"</h3>
					<p class="text-xs text-slate-500 mb-6">
						Please verify your Order Number (e.g. ORD-2026-1042) or The Courier Guy Waybill code.
					</p>
					<div class="flex justify-center gap-3">
						<a href="/track?q=ORD-2026-1042" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition">
							View Sample Order
						</a>
						<a href="/" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 text-xs font-bold hover:bg-slate-50 transition">
							Return Home
						</a>
					</div>
				</div>
			}
		</main>
	}
}
