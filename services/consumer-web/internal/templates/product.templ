package templates

import (
	"encoding/json"
	"fmt"
	"net/url"
	"sort"
	"strings"

	"github.com/shoppage/consumer-web/internal/models"
)

// productJSONLD builds schema.org Product data from the record, so search
// engines and AI assistants read real values (the old template emitted the
// literal text "{ data.Product.Title }").
func productJSONLD(p models.ProductDetail) string {
	offers := map[string]any{
		"@type":         "AggregateOffer",
		"priceCurrency": "ZAR",
		"offerCount":    len(p.Offers),
	}
	low, high := 0.0, 0.0
	inStock := false
	for _, o := range p.Offers {
		if o.PriceZar > 0 && (low == 0 || o.PriceZar < low) {
			low = o.PriceZar
		}
		if o.PriceZar > high {
			high = o.PriceZar
		}
		inStock = inStock || o.InStock
	}
	if low == 0 {
		low = p.LowestOfferPrice
	}
	if low > 0 {
		offers["lowPrice"] = fmt.Sprintf("%.2f", low)
	}
	if high > 0 {
		offers["highPrice"] = fmt.Sprintf("%.2f", high)
	}
	if len(p.Offers) > 0 {
		if inStock {
			offers["availability"] = "https://schema.org/InStock"
		} else {
			offers["availability"] = "https://schema.org/OutOfStock"
		}
	}
	doc := map[string]any{
		"@context":    "https://schema.org/",
		"@type":       "Product",
		"name":        p.Title,
		"description": p.Description,
		"sku":         p.Model,
		"offers":      offers,
	}
	if p.ImageURL != "" {
		doc["image"] = append([]string{p.ImageURL}, p.Gallery...)
	}
	if p.Brand != "" {
		doc["brand"] = map[string]string{"@type": "Brand", "name": p.Brand}
	}
	if p.Category != "" {
		doc["category"] = p.Category
	}
	b, _ := json.Marshal(doc)
	// Keep "</script>" from ever closing the tag early.
	return strings.ReplaceAll(string(b), "</", "<\\/")
}

// sortedOffers orders offers cheapest first.
func sortedOffers(p models.ProductDetail) []models.MerchantOffer {
	out := append([]models.MerchantOffer(nil), p.Offers...)
	sort.SliceStable(out, func(a, b int) bool {
		if out[a].PriceZar <= 0 {
			return false
		}
		if out[b].PriceZar <= 0 {
			return true
		}
		return out[a].PriceZar < out[b].PriceZar
	})
	return out
}

func lowestPrice(p models.ProductDetail) float64 {
	if o := sortedOffers(p); len(o) > 0 && o[0].PriceZar > 0 {
		return o[0].PriceZar
	}
	return p.LowestOfferPrice
}

func sortedSpecs(m map[string]string) [][2]string {
	var out [][2]string
	for k, v := range m {
		if strings.TrimSpace(v) != "" {
			out = append(out, [2]string{k, v})
		}
	}
	sort.Slice(out, func(a, b int) bool { return out[a][0] < out[b][0] })
	return out
}

func offerMessage(p models.ProductDetail, o models.MerchantOffer) string {
	return fmt.Sprintf("Hi %s, I found %s on Shoppage for R %s. Is it available?", o.MerchantName, p.Title, FormatZAR(o.PriceZar))
}

func offerPlace(o models.MerchantOffer) string {
	return placeLabel(o.City, o.Province)
}

templ ProductDetailComponent(data ProductViewData) {
	@Layout(data.Title, data.Description, data.CurrentTab, []models.TradeTrend{}, []models.RetailerDeal{}, []models.CommunityGuild{}) {
		<script type="application/ld+json">
			@templ.Raw(productJSONLD(data.Product))
		</script>
		{{ p := data.Product }}
		{{ offers := sortedOffers(p) }}
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			if p.Category != "" {
				@Ico("chev", 14)
				<a href={ templ.SafeURL("/search?category=" + url.QueryEscape(p.Category)) }>{ Humanize(p.Category) }</a>
			}
		</nav>
		<div class="pdp">
			<div class="gallery">
				<div class="main-img">
					if p.ImageURL != "" {
						<img data-main-img src={ p.ImageURL } alt={ p.Title } width="600" height="600"/>
					} else {
						<span class="faint">
							@Ico("bag", 64)
						</span>
					}
				</div>
				if len(p.Gallery) > 0 {
					<div class="thumbs" role="group" aria-label="Photos">
						<button type="button" data-thumb={ p.ImageURL } aria-pressed="true"><img src={ p.ImageURL } alt="Photo 1"/></button>
						for i, g := range p.Gallery {
							<button type="button" data-thumb={ g } aria-pressed="false"><img src={ g } alt={ fmt.Sprintf("Photo %d", i+2) } loading="lazy"/></button>
						}
					</div>
				}
			</div>
			<div>
				if p.Brand != "" {
					<div class="brand-line">{ p.Brand }</div>
				}
				<h1>{ p.Title }</h1>
				<div class="price-big num">
					if lowestPrice(p) > 0 {
						R { FormatZAR(lowestPrice(p)) }
					} else {
						Price on request
					}
				</div>
				<div class="price-sub">
					if len(offers) > 1 {
						{ fmt.Sprintf("Lowest of %d stores", len(offers)) }
					} else if len(offers) == 1 {
						From { offers[0].MerchantName }
					}
				</div>
				<div class="facts">
					if p.IsLocalSAStock {
						<span class="fact ok">
							@Ico("check", 14)
							Stocked in South Africa
						</span>
					}
					for _, d := range p.DeliveryOptions {
						<span class="fact">
							@Ico("truck", 14)
							{ d.Label }
							if d.CostDisplay != "" {
								· { d.CostDisplay }
							}
						</span>
					}
				</div>
				<div style="display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 4px;">
					if len(offers) > 0 && offers[0].WhatsApp != "" {
						<a class="btn btn-brand" target="_blank" rel="noopener" href={ templ.SafeURL("https://wa.me/" + offers[0].WhatsApp + "?text=" + url.QueryEscape(offerMessage(p, offers[0]))) }>
							@Ico("wa", 18)
							Ask { offers[0].MerchantName }
						</a>
					}
					<button type="button" class="btn btn-outline" onclick="document.getElementById('reserve-modal').showModal()">Reserve</button>
					<button type="button" class="icon-btn" aria-label="Share" onclick="navigator.share ? navigator.share({title: document.title, url: location.href}) : navigator.clipboard.writeText(location.href)">
						@Ico("share", 20)
					</button>
				</div>
				<section class="compare" aria-labelledby="compare-h">
					<h2 id="compare-h">
						Compare prices
						<small>{ fmt.Sprintf("%d %s", len(offers), plural(len(offers), "store", "stores")) }</small>
					</h2>
					if len(offers) == 0 {
						<p class="muted" style="padding:14px 16px;margin:0;">No store has listed a price yet. Post a request and stores can quote you.</p>
					}
					for i, o := range offers {
						<div class="offer">
							<div class="who">
								{ o.MerchantName }
								if i == 0 && len(offers) > 1 && o.PriceZar > 0 {
									<span class="best">Lowest price</span>
								}
							</div>
							<div class="p num">
								if o.PriceZar > 0 {
									R { FormatZAR(o.PriceZar) }
								} else {
									On request
								}
							</div>
							<div class="det">{ offerDetail(o) }</div>
							<div class="go">
								if o.WhatsApp != "" {
									<a class="btn btn-outline btn-sm" target="_blank" rel="noopener" href={ templ.SafeURL("https://wa.me/" + o.WhatsApp + "?text=" + url.QueryEscape(offerMessage(p, o))) }>Contact</a>
								}
								<button class="btn btn-ghost btn-sm" type="button" hx-get={ fmt.Sprintf("/offer/modal/%s?price=%.2f&merchant=%s", url.PathEscape(p.CanonicalID), o.PriceZar, url.QueryEscape(o.MerchantID)) } hx-target="#modal-container">Make an offer</button>
							</div>
						</div>
					}
				</section>
				if len(p.VolumeTiers) > 0 {
					<section style="margin-top:20px;">
						<h2 style="font-size:16px;font-family:var(--font);margin:0 0 8px;">Buy in bulk</h2>
						<div class="tiers">
							for _, t := range p.VolumeTiers {
								<div>
									<span>{ t.Label }</span>
									<b class="num">
										R { FormatZAR(t.PriceZar) }
										if t.DiscountPct > 0 {
											<span style="color:var(--brand-ink);font-weight:600;">{ fmt.Sprintf(" −%d%%", t.DiscountPct) }</span>
										}
									</b>
								</div>
							}
						</div>
					</section>
				}
			</div>
		</div>
		if p.Description != "" || len(p.Specs) > 0 {
			<section class="section" style="border-top:1px solid var(--line);">
				<div class="pdp" style="padding:0;">
					if p.Description != "" {
						<div>
							<h2 style="font-size:20px;margin:0 0 8px;">About this product</h2>
							<p style="margin:0;color:var(--ink-2);">{ p.Description }</p>
						</div>
					}
					if len(p.Specs) > 0 {
						<div>
							<h2 style="font-size:20px;margin:0 0 8px;">Specifications</h2>
							<dl class="kv">
								for _, kv := range sortedSpecs(p.Specs) {
									<dt>{ kv[0] }</dt>
									<dd>
										if kv[0] == "Category" {
											{ Humanize(kv[1]) }
										} else if strings.HasPrefix(kv[1], "http") {
											<a href={ templ.SafeURL(kv[1]) } target="_blank" rel="noopener nofollow" style="color:var(--link)">Retailer page</a>
										} else {
											{ kv[1] }
										}
									</dd>
								}
							</dl>
						</div>
					}
				</div>
			</section>
		}
		@ReserveDialog(p)
	}
}

// ReserveDialog asks the store to hold the item. It is a reservation: no
// payment is taken on Shoppage, and the page says so.
templ ReserveDialog(p models.ProductDetail) {
	<dialog id="reserve-modal" style="border:0;border-radius:var(--r-xl);padding:0;max-width:480px;width:calc(100% - 32px);background:var(--bg);color:var(--ink);box-shadow:var(--shadow-pop);">
		<div id="checkout-result-stage" style="padding:20px;">
			<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
				<h2 style="font-size:20px;margin:0;flex:1;">Reserve this item</h2>
				<button type="button" class="icon-btn" aria-label="Close" onclick="this.closest('dialog').close()">
					@Ico("x", 20)
				</button>
			</div>
			<p class="muted" style="margin:0 0 14px;font-size:14px;">The store confirms availability and how you'd like to pay and receive it. Nothing is charged on Shoppage.</p>
			<form hx-post="/checkout/instant" hx-target="#checkout-result-stage" style="display:grid;gap:12px;">
				<input type="hidden" name="product_title" value={ p.Title }/>
				<input type="hidden" name="sku" value={ p.Model }/>
				<input type="hidden" name="unit_price" value={ fmt.Sprintf("%.2f", lowestPrice(p)) }/>
				<label style="display:grid;gap:4px;font-size:14px;font-weight:600;">
					Quantity
					<input class="chip" style="height:42px;width:100%;" type="number" name="quantity" value="1" min="1" required/>
				</label>
				<label style="display:grid;gap:4px;font-size:14px;font-weight:600;">
					Your name
					<input class="chip" style="height:42px;width:100%;" type="text" name="buyer_name" autocomplete="name" required/>
				</label>
				<label style="display:grid;gap:4px;font-size:14px;font-weight:600;">
					Phone or WhatsApp
					<input class="chip" style="height:42px;width:100%;" type="tel" name="phone" autocomplete="tel" required/>
				</label>
				<label style="display:grid;gap:4px;font-size:14px;font-weight:600;">
					Delivery address (optional)
					<input class="chip" style="height:42px;width:100%;" type="text" name="delivery_address" autocomplete="street-address"/>
				</label>
				<button type="submit" class="btn btn-brand btn-lg">Send reservation</button>
			</form>
		</div>
	</dialog>
}

func offerDetail(o models.MerchantOffer) string {
	stock, when := "", ""
	if o.InStock {
		stock = "In stock"
	}
	if o.PickupAvailable && o.PickupTime != "" {
		when = "Collect: " + o.PickupTime
	} else if o.LeadTimeDays > 0 {
		when = fmt.Sprintf("Ready in %d %s", o.LeadTimeDays, plural(o.LeadTimeDays, "day", "days"))
	}
	return joinDot(offerPlace(o), stock, when)
}
