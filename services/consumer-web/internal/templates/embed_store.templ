package templates

import (
	"fmt"
	"github.com/shoppage/consumer-web/internal/models"
)

type EmbedStoreViewData struct {
	Store   models.MerchantStorefront
	Catalog []models.SearchItem
	BaseURL string
}

templ EmbedStoreComponent(data EmbedStoreViewData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			<title>{ data.Store.Name } — Live Wholesale Catalog</title>
			<link rel="stylesheet" href="/static/css/tailwind.css" />
			<script src="/static/js/htmx.min.js"></script>
			<style>
				body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
			</style>
		</head>
		<body class="bg-slate-50 text-slate-900 antialiased p-3 sm:p-5">
			<div class="max-w-4xl mx-auto space-y-4">
				<!-- Embed Header -->
				<header class="bg-white rounded-2xl border border-slate-200 p-4 shadow-2xs flex items-center justify-between gap-4">
					<div class="flex items-center gap-3 min-w-0">
						<div class="w-11 h-11 rounded-xl bg-emerald-600 text-white font-black text-xl flex items-center justify-center shrink-0">
							if len(data.Store.Name) > 0 {
								{ string([]rune(data.Store.Name)[0]) }
							} else {
								S
							}
						</div>
						<div class="min-w-0">
							<div class="flex items-center gap-2 flex-wrap">
								<h1 class="text-sm font-extrabold text-slate-900 truncate">{ data.Store.Name }</h1>
								if data.Store.Verified {
									<span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold shrink-0">
										✓ Verified Supplier
									</span>
								} else {
									<span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200 text-[10px] font-bold shrink-0">
										Verification pending
									</span>
								}
							</div>
							<p class="text-[11px] text-slate-500 truncate">
								if data.Store.Rating > 0 && data.Store.ReviewsCount > 0 {
									★ { fmt.Sprintf("%.1f", data.Store.Rating) } ({ fmt.Sprintf("%d", data.Store.ReviewsCount) })
									if data.Store.CIPCNumber != "" || data.Store.City != "" {
										·
									}
								}
								if data.Store.CIPCNumber != "" {
									CIPC: { data.Store.CIPCNumber }
									if data.Store.City != "" {
										·
									}
								}
								if data.Store.City != "" {
									{ data.Store.City }
								}
							</p>
						</div>
					</div>

					<a 
						href={ templ.SafeURL(fmt.Sprintf("%s/m/%s", data.BaseURL, data.Store.ID)) } 
						target="_blank" 
						rel="noopener noreferrer"
						class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition inline-flex items-center gap-1 shadow-2xs shrink-0"
					>
						<span>Open Full Desk</span>
						<span>↗</span>
					</a>
				</header>

				<!-- Products Grid -->
				if len(data.Catalog) == 0 {
					<div class="bg-white rounded-2xl border border-dashed border-slate-300 p-8 text-center">
						<div class="text-2xl mb-2">📦</div>
						<div class="text-sm font-bold text-slate-800">No published trade listings yet</div>
						<p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
							This supplier has not published catalogue lines to Shoppage. Open the full desk to request a quote directly.
						</p>
					</div>
				} else {
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
						for _, item := range data.Catalog {
							<div class="bg-white rounded-xl border border-slate-200 p-3 shadow-2xs hover:shadow-md transition flex flex-col justify-between">
								<div>
									<div class="h-32 w-full bg-slate-50 rounded-lg mb-2.5 overflow-hidden flex items-center justify-center">
										if item.ImageURL != "" {
											<img src={ item.ImageURL } alt={ item.Title } class="h-full w-full object-contain p-2" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
											<span class="hidden text-3xl items-center justify-center h-full w-full">📦</span>
										} else {
											<span class="text-3xl">📦</span>
										}
									</div>
									<div class="text-[10px] font-mono font-bold text-slate-400 uppercase">{ item.Brand } · { item.Category }</div>
									<h3 class="text-xs font-bold text-slate-900 leading-snug line-clamp-2 mt-0.5" title={ item.Title }>{ item.Title }</h3>
								</div>

								<div class="pt-3 border-t border-slate-100 mt-2.5 flex items-center justify-between gap-2">
									<div class="min-w-0">
										<div class="text-[10px] text-slate-400 uppercase">Wholesale Excl. VAT</div>
										if item.PriceZar > 0 {
											<div class="text-xs font-black font-mono text-emerald-700">R { FormatZAR(item.PriceZar) }</div>
										} else {
											<div class="text-xs font-black text-slate-600">Price on request</div>
										}
									</div>
									if data.Store.WhatsApp != "" {
										<a 
											href={ templ.SafeURL(fmt.Sprintf("https://wa.me/%s?text=Hi,%%20I'd%%20like%%20to%%20order%%20wholesale%%20units%%20of%%20%s%%20(SKU:%%20%s)%%20listed%%20on%%20Shoppage.", data.Store.WhatsApp, item.Title, item.ID)) }
											target="_blank"
											rel="noopener noreferrer"
											class="px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-bold transition inline-flex items-center gap-1 shrink-0"
										>
											<span>💬 Quote</span>
										</a>
									} else {
										<a 
											href={ templ.SafeURL(fmt.Sprintf("%s/m/%s", data.BaseURL, data.Store.ID)) }
											target="_blank"
											rel="noopener noreferrer"
											class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-[11px] font-bold transition inline-flex items-center gap-1 shrink-0"
										>
											<span>Contact</span>
										</a>
									}
								</div>
							</div>
						}
					</div>
				}

				<!-- Embed Footer -->
				<footer class="pt-2 flex items-center justify-between text-[11px] text-slate-400">
					<span>Wholesale catalogue widget</span>
					<a href={ templ.SafeURL(data.BaseURL) } target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 font-bold flex items-center gap-1 transition">
						<span>Powered by Shoppage South Africa</span>
						<span>↗</span>
					</a>
				</footer>
			</div>
		</body>
	</html>
}
