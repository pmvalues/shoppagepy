package templates

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/shoppage/consumer-web/internal/models"
)

func storeHref(d StorefrontViewData, key, val string) string {
	v := url.Values{}
	if d.ActiveCategory != "" {
		v.Set("category", d.ActiveCategory)
	}
	if d.Sort != "" {
		v.Set("sort", d.Sort)
	}
	if d.Query != "" {
		v.Set("q", d.Query)
	}
	if d.InStockOnly {
		v.Set("in_stock", "true")
	}
	if val == "" {
		v.Del(key)
	} else {
		v.Set(key, val)
	}
	if len(v) == 0 {
		return "/m/" + d.Store.ID
	}
	return "/m/" + d.Store.ID + "?" + v.Encode()
}

func storePlace(s models.MerchantStorefront) string {
	return joinDot(s.Suburb, s.City)
}

func telHref(p string) string {
	return "tel:" + strings.NewReplacer(" ", "", "(", "", ")", "", "-", "").Replace(p)
}

func stars(n int) string {
	if n < 0 {
		n = 0
	}
	if n > 5 {
		n = 5
	}
	return strings.Repeat("★", n) + strings.Repeat("☆", 5-n)
}

// StorefrontComponent is a store's public page, laid out like an X profile:
// cover, avatar, name and facts, then its catalogue as a Shopping grid.
// A buyer can collect items into a quote list and send it on WhatsApp.
templ StorefrontComponent(data StorefrontViewData) {
	@Layout(data.Title, data.Description, data.CurrentTab, []models.TradeTrend{}, []models.RetailerDeal{}, []models.CommunityGuild{}) {
		@templ.Raw("<script type=\"application/ld+json\">\n" + schemaOrgStoreJSON(data.Store, data.Description, data.BaseURL) + "\n</script>")
		{{ s := data.Store }}
		if data.AnnouncementText != "" {
			<div class="notice info" style="border-radius:0;justify-content:center;">{ data.AnnouncementText }</div>
		}
		<section class="store-hero">
			<div class="store-cover" aria-hidden="true"></div>
			<div class="store-id">
				<div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;">
					<span class="avatar" aria-hidden="true">{ FirstRune(s.Name) }</span>
					<div style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;padding-top:12px;">
						if s.WhatsApp != "" {
							<a class="btn btn-brand" target="_blank" rel="noopener" href={ templ.SafeURL("https://wa.me/" + s.WhatsApp + "?text=" + url.QueryEscape("Hi "+s.Name+", I found you on Shoppage.")) }>
								@Ico("wa", 18)
								Message
							</a>
						}
						if s.Phone != "" {
							<a class="btn btn-outline" href={ templ.SafeURL(telHref(s.Phone)) }>Call</a>
						}
						if s.DirectionsURL != "" {
							<a class="btn btn-outline" href={ templ.SafeURL(s.DirectionsURL) } target="_blank" rel="noopener">Directions</a>
						}
						<button type="button" class="icon-btn" aria-label="Share this store" onclick="navigator.share ? navigator.share({title: document.title, url: location.href}) : navigator.clipboard.writeText(location.href)">
							@Ico("share", 20)
						</button>
					</div>
				</div>
				<h1>
					{ s.Name }
					if s.Verified {
						<span class="verified-mark" title="Business registration checked">
							@Ico("shield", 20)
						</span>
					}
				</h1>
				<div class="line">
					if s.Category != "" {
						<span>{ Humanize(s.Category) }</span>
					}
					if storePlace(s) != "" {
						<span>
							@Ico("pin", 14)
							{ storePlace(s) }
						</span>
					}
					if openLabel(s) != "" {
						<span style={ openColour(s.IsOpenNow) }>{ openLabel(s) }</span>
					}
					if s.Website != "" {
						<a href={ templ.SafeURL(s.Website) } target="_blank" rel="noopener">{ strings.TrimPrefix(strings.TrimPrefix(s.Website, "https://"), "http://") }</a>
					}
				</div>
				if s.AboutText != "" {
					<p class="about">{ s.AboutText }</p>
				}
				<div class="line">
					<span><b style="color:var(--ink)">{ fmt.Sprint(data.TotalCount) }</b> products</span>
					if s.ReviewsCount > 0 && s.Rating > 0 {
						<span><b style="color:var(--ink)">{ fmt.Sprintf("%.1f", s.Rating) }</b> from { fmt.Sprint(s.ReviewsCount) } reviews</span>
					}
					if s.CIPCNumber != "" {
						<span>Company reg. { s.CIPCNumber }</span>
					}
					if s.BBBEELevel != "" {
						<span>B-BBEE { s.BBBEELevel }</span>
					}
					for _, c := range s.Certifications {
						<span class="fact">{ c }</span>
					}
				</div>
			</div>
		</section>
		<nav class="tabs" aria-label="Store sections">
			<a href="#catalogue" aria-current="page">Products</a>
			<a href="#reviews">Reviews</a>
			<a href="#contact">Contact</a>
		</nav>
		<section class="section" id="catalogue">
			<form style="margin-bottom:12px;" action={ templ.SafeURL("/m/" + s.ID) } method="get" hx-get={ "/m/" + s.ID } hx-target="#store-catalog-grid" hx-push-url="true">
				<div style="display:flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:1px solid var(--line-2);border-radius:var(--pill);">
					@Ico("search", 18)
					<label class="sr" for="store-q">Search this store</label>
					<input id="store-q" type="search" name="q" value={ data.Query } placeholder={ "Search " + s.Name } style="flex:1;border:0;outline:0;background:transparent;font:inherit;color:var(--ink);" hx-get={ "/m/" + s.ID } hx-target="#store-catalog-grid" hx-trigger="input changed delay:300ms, search" hx-push-url="true"/>
				</div>
			</form>
			<div class="chips" style="padding:0 0 12px;">
				<a class="chip" href={ templ.SafeURL(storeHref(data, "category", "")) } aria-pressed={ pressed(data.ActiveCategory == "") }>All</a>
				for _, c := range data.Categories {
					<a class="chip" href={ templ.SafeURL(storeHref(data, "category", c)) } aria-pressed={ pressed(strings.EqualFold(data.ActiveCategory, c)) }>{ Humanize(c) }</a>
				}
				<a class="chip" href={ templ.SafeURL(storeHref(data, "in_stock", boolParam(!data.InStockOnly))) } aria-pressed={ pressed(data.InStockOnly) }>In stock</a>
				<a class="chip" href={ templ.SafeURL(storeHref(data, "sort", toggle(data.Sort, "price-asc"))) } aria-pressed={ pressed(data.Sort == "price-asc") }>Lowest price</a>
			</div>
			<div id="store-catalog-grid">
				@StoreCatalogGridComponent(data)
			</div>
		</section>
		<section class="section" id="reviews">
			<div class="sec-head">
				<div>
					<h2>Reviews</h2>
					<p>From buyers. Reviews are shown as written and aren't checked against orders.</p>
				</div>
			</div>
			<div id="review-list" style="display:grid;gap:12px;">
				if len(data.Testimonials) == 0 {
					<p class="muted" id="no-reviews">No reviews yet.</p>
				}
				for _, t := range data.Testimonials {
					@ReviewCard(t, false)
				}
			</div>
			<details style="margin-top:16px;">
				<summary class="btn btn-outline btn-sm" style="list-style:none;">Write a review</summary>
				<form hx-post="/store/review" hx-target="#review-list" hx-swap="afterbegin" hx-on::after-request="if(event.detail.successful){this.reset();this.closest('details').open=false;var n=document.getElementById('no-reviews');if(n)n.remove();}" style="display:grid;gap:10px;margin-top:12px;max-width:520px;">
					<input type="hidden" name="store_id" value={ s.ID }/>
					<label style="display:grid;gap:4px;font-size:14px;font-weight:600;">Rating
						<select name="rating" class="chip" style="height:40px;" required>
							for _, n := range []int{5, 4, 3, 2, 1} {
								<option value={ fmt.Sprint(n) }>{ stars(n) }</option>
							}
						</select>
					</label>
					<label style="display:grid;gap:4px;font-size:14px;font-weight:600;">Your name
						<input class="chip" style="height:40px;width:100%;" type="text" name="author_name" maxlength="60" required/>
					</label>
					<label style="display:grid;gap:4px;font-size:14px;font-weight:600;">Business (optional)
						<input class="chip" style="height:40px;width:100%;" type="text" name="company" maxlength="80"/>
					</label>
					<label style="display:grid;gap:4px;font-size:14px;font-weight:600;">Your review
						<textarea class="chip" style="height:auto;min-height:96px;width:100%;padding:10px 12px;" name="review_text" maxlength="600" required></textarea>
					</label>
					<button type="submit" class="btn btn-brand" style="justify-self:start;">Post review</button>
				</form>
			</details>
		</section>
		<section class="section" id="contact">
			<div class="sec-head"><h2>Contact</h2></div>
			<dl class="kv">
				if s.Address != "" {
					<dt>Address</dt>
					<dd>{ s.Address }</dd>
				}
				if s.Phone != "" {
					<dt>Phone</dt>
					<dd><a href={ templ.SafeURL(telHref(s.Phone)) } style="color:var(--link)">{ s.Phone }</a></dd>
				}
				if s.Email != "" {
					<dt>Email</dt>
					<dd><a href={ templ.SafeURL("mailto:" + s.Email) } style="color:var(--link)">{ s.Email }</a></dd>
				}
				if s.HoursStatus != "" {
					<dt>Hours</dt>
					<dd>{ s.HoursStatus }</dd>
				}
				for _, l := range s.SocialLinks {
					<dt>{ Humanize(l.Platform) }</dt>
					<dd><a href={ templ.SafeURL(l.URL) } target="_blank" rel="noopener" style="color:var(--link)">{ l.URL }</a></dd>
				}
			</dl>
		</section>
		<div id="quote-bar" hidden style="position:sticky;bottom:12px;margin:0 20px 12px;z-index:30;">
			<div style="display:flex;align-items:center;gap:12px;padding:10px 12px 10px 18px;border-radius:var(--pill);background:var(--ink);color:var(--bg);box-shadow:var(--shadow-pop);">
				<span style="flex:1;font-weight:600;" data-quote-count></span>
				<button type="button" class="btn btn-sm" style="background:transparent;color:inherit;border:1px solid currentColor;" data-quote-clear>Clear</button>
				if s.WhatsApp != "" {
					<a class="btn btn-brand btn-sm" data-quote-send data-wa={ s.WhatsApp } data-store={ s.Name } href="#">Ask for a quote</a>
				}
			</div>
		</div>
		<script>
			(function () {
				var key = 'shoppage_quote_' + location.pathname;
				var bar = document.getElementById('quote-bar');
				if (!bar) return;
				function load() { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) { return []; } }
				function save(l) { try { localStorage.setItem(key, JSON.stringify(l)); } catch (e) {} render(); }
				function render() {
					var l = load();
					bar.hidden = !l.length;
					var c = bar.querySelector('[data-quote-count]');
					if (c) c.textContent = l.length + (l.length === 1 ? ' item' : ' items') + ' in your quote list';
					document.querySelectorAll('[data-quote-add]').forEach(function (b) {
						var on = l.some(function (x) { return x.id === b.dataset.id; });
						b.setAttribute('aria-pressed', String(on));
						b.textContent = on ? 'Added' : 'Add to quote';
					});
				}
				document.addEventListener('click', function (e) {
					var add = e.target.closest('[data-quote-add]');
					if (add) {
						e.preventDefault();
						var l = load(), i = l.findIndex(function (x) { return x.id === add.dataset.id; });
						if (i >= 0) l.splice(i, 1); else l.push({ id: add.dataset.id, title: add.dataset.title, price: add.dataset.price });
						save(l);
					}
					if (e.target.closest('[data-quote-clear]')) save([]);
					var send = e.target.closest('[data-quote-send]');
					if (send) {
						e.preventDefault();
						var lines = load().map(function (x, n) { return (n + 1) + '. ' + x.title + (x.price ? ' (listed R ' + x.price + ')' : ''); });
						var msg = 'Hi ' + send.dataset.store + ', please quote me for:\n' + lines.join('\n') + '\n\nQuantities: ';
						window.open('https://wa.me/' + send.dataset.wa + '?text=' + encodeURIComponent(msg), '_blank', 'noopener');
					}
				});
				document.addEventListener('htmx:afterSettle', render);
				render();
			})();
		</script>
	}
}

func openColour(open bool) string {
	if open {
		return "color:var(--brand-ink);font-weight:600;"
	}
	return ""
}

// StoreCatalogGridComponent is the store's product grid (also the HTMX
// response when searching or filtering within the store).
templ StoreCatalogGridComponent(data StorefrontViewData) {
	<p class="muted" style="font-size:14px;margin:0 0 12px;">
		{ fmt.Sprintf("%d of %d products", len(data.Store.Catalog), data.TotalCount) }
	</p>
	if len(data.Store.Catalog) == 0 {
		@EmptyState("No matching products", "Try another word or category, or message the store to ask.", "/m/"+data.Store.ID, "Show all products")
	} else {
		<div class="tiles">
			for _, item := range data.Store.Catalog {
				@ProductCardComponent(item, data.Store)
			}
		</div>
	}
}

// ProductCardComponent is a product tile with an "Add to quote" toggle.
templ ProductCardComponent(item models.SearchItem, store models.MerchantStorefront) {
	<div style="display:grid;gap:6px;align-content:start;">
		@ProductTile(item)
		if store.WhatsApp != "" {
			<button type="button" class="chip" style="justify-content:center;" data-quote-add data-id={ item.ID } data-title={ item.Title } data-price={ FormatZAR(item.PriceZar) } aria-pressed="false">Add to quote</button>
		}
	</div>
}

// ReviewCard shows one review; fresh marks one the visitor just posted.
templ ReviewCard(t models.StoreTestimonial, fresh bool) {
	<article class="box" style="padding:14px 16px;">
		<div style="display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;">
			<span style="color:#e37400;letter-spacing:1px;" aria-label={ fmt.Sprintf("%d out of 5", t.Rating) }>{ stars(t.Rating) }</span>
			<b>{ t.AuthorName }</b>
			if t.Company != "" {
				<span class="muted">· { t.Company }</span>
			}
			<span class="faint" style="margin-left:auto;font-size:13px;">
				if fresh {
					Just posted
				} else {
					{ t.DateStr }
				}
			</span>
		</div>
		<p style="margin:6px 0 0;">{ t.Text }</p>
	</article>
}

// openLabel states opening status only when the store has hours on record.
func openLabel(s models.MerchantStorefront) string {
	if s.HoursStatus == "" && !s.IsOpenNow {
		return ""
	}
	state := "Closed now"
	if s.IsOpenNow {
		state = "Open now"
	}
	return joinDot(state, s.HoursStatus)
}
