package templates

import (
	"fmt"
	"net/url"

	"github.com/shoppage/consumer-web/internal/models"
	"github.com/shoppage/consumer-web/internal/site"
)

const fontsHref = "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Outfit:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"

func hasRail(trends []models.TradeTrend, drops []models.RetailerDeal, guilds []models.CommunityGuild) bool {
	return len(trends)+len(drops)+len(guilds) > 0
}

func isHome(tab string) bool { return tab == "" || tab == "foryou" }

func current(on bool) templ.Attributes {
	if on {
		return templ.Attributes{"aria-current": "page"}
	}
	return templ.Attributes{}
}

// Layout is the site shell: X-style left navigation, a sticky top bar with a
// Google-style search box, the page, and (when there is something to show) a
// right rail. Phones get a bottom tab bar instead of the left navigation.
templ Layout(title, description, currentTab string, trends []models.TradeTrend, topDrops []models.RetailerDeal, guilds []models.CommunityGuild) {
	<!DOCTYPE html>
	<html lang="en-ZA">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{ title } · Shoppage</title>
			<meta name="description" content={ description }/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:site_name" content="Shoppage"/>
			<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)"/>
			<link rel="manifest" href="/manifest.json"/>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="apple-touch-icon" href="/favicon.svg"/>
			<link rel="search" type="application/opensearchdescription+xml" title="Shoppage" href="/opensearch.xml"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href={ fontsHref } media="print" onload="this.media='all'"/>
			<noscript><link rel="stylesheet" href={ fontsHref }/></noscript>
			<link rel="stylesheet" href="/static/css/tailwind.min.css?v=20260925"/>
			<link rel="stylesheet" href="/static/css/site.css?v=20260925"/>
			<script>
				try { var t = localStorage.getItem('shoppage_theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
			</script>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/site.js?v=20260925" defer></script>
		</head>
		<body class="site" hx-boost="true">
			<a class="skip" href="#content">Skip to content</a>
			if Stats().SampleData {
				<div class="demo-bar" role="note"><b>Demo data</b><span>{ Stats().DataNotice }</span></div>
			}
			<div class={ "shell", templ.KV("with-rail", hasRail(trends, topDrops, guilds)) }>
				@LeftRail(currentTab)
				<div class="main">
					<header class="topbar">
						<a href="/" class="logo-sm" aria-label="Shoppage home">
							@Logo(30)
						</a>
						if !isHome(currentTab) {
							@SearchBox("", false)
						}
						<button type="button" class="loc" hx-get="/location-modal" hx-target="#modal-container" aria-label="Choose your location">
							@Ico("pin", 18)
							<span class="label" data-location-label>Set location</span>
						</button>
						<div class="actions">
							<a class="btn btn-outline btn-sm hide-sm" href="/sell">Sell on Shoppage</a>
						</div>
					</header>
					<div id="content">
						{ children... }
					</div>
				</div>
				if hasRail(trends, topDrops, guilds) {
					@CommerceRail(trends, topDrops, guilds)
				}
			</div>
			@CorporateFooter()
			@BottomBar(currentTab)
			<div id="modal-container"></div>
			<div id="buybox-drawer"></div>
			@AskWidget()
		</body>
	</html>
}

// SearchBox is the Google-style pill search with live suggestions.
templ SearchBox(q string, autofocus bool) {
	<div class="searchbox" data-searchbox>
		<form action="/search" method="get" role="search">
			<span class="faint" aria-hidden="true">
				@Ico("search", 20)
			</span>
			<label class="sr" for={ "q-" + fmt.Sprint(autofocus) }>Search Shoppage</label>
			<input
				id={ "q-" + fmt.Sprint(autofocus) }
				type="search"
				name="q"
				value={ q }
				placeholder="Search products, brands and stores"
				autocomplete="off"
				enterkeyhint="search"
				aria-autocomplete="list"
				aria-controls={ "sug-" + fmt.Sprint(autofocus) }
				if autofocus {
					autofocus
				}
			/>
			<button type="button" class="clear" aria-label="Clear search" data-clear>
				@Ico("x", 18)
			</button>
			<button type="submit" class="go" aria-label="Search">
				@Ico("search", 18)
			</button>
		</form>
		<div class="suggest" id={ "sug-" + fmt.Sprint(autofocus) } role="listbox"></div>
	</div>
}

templ LeftRail(currentTab string) {
	<nav class="nav" aria-label="Main">
		<a href="/" class="logo" aria-label="Shoppage home">
			@Logo(34)
			<b>Shoppage</b>
		</a>
		<a class="navlink" href="/" { current(isHome(currentTab))... }>
			@Ico("home", 24)
			<span class="label">Home</span>
		</a>
		<a class="navlink" href="/?tab=deals" { current(currentTab == "deals")... }>
			@Ico("tag", 24)
			<span class="label">Deals</span>
		</a>
		<a class="navlink" href="/?tab=products" { current(currentTab == "products" || currentTab == "all")... }>
			@Ico("bag", 24)
			<span class="label">Products</span>
			if Stats().Products > 0 {
				<span class="pill-count label">{ FormatCount(Stats().Products) }</span>
			}
		</a>
		<a class="navlink" href="/malls" { current(currentTab == "malls")... }>
			@Ico("store", 24)
			<span class="label">Stores &amp; markets</span>
		</a>
		<a class="navlink" href="/?tab=tradewire" { current(currentTab == "tradewire")... }>
			@Ico("feed", 24)
			<span class="label">Trade Wire</span>
		</a>
		<a class="navlink" href="/shorts" { current(currentTab == "shorts")... }>
			@Ico("play", 24)
			<span class="label">Shorts</span>
		</a>
		<a class="navlink" href="/chat" { current(currentTab == "chat")... }>
			@Ico("chat", 24)
			<span class="label">Messages</span>
		</a>
		<a class="navlink" href="/track" { current(currentTab == "track")... }>
			@Ico("box", 24)
			<span class="label">Orders</span>
		</a>
		<a class="btn btn-brand btn-lg cta" href="/?tab=tradewire#compose" aria-label="Post a request">
			@Ico("plus", 22)
			<span class="label">Post a request</span>
		</a>
		<div class="foot">
			<a class="navlink" href="/sell" { current(currentTab == "sell")... }>
				@Ico("sell", 24)
				<span class="label">Sell on Shoppage</span>
			</a>
			<a class="navlink" href="/desk" target="_blank" rel="noopener">
				@Ico("desk", 24)
				<span class="label">Merchant desk</span>
			</a>
			<button type="button" class="navlink" data-theme-toggle aria-label="Change theme" style="border:0;background:none;cursor:pointer;font:inherit;">
				@Ico("moon", 24)
				<span class="label" data-theme-label>Theme: system</span>
			</button>
		</div>
	</nav>
}

// CommerceRail is the right column ("what's happening"): price drops,
// trending searches and markets. Only real catalogue data is shown.
templ CommerceRail(trends []models.TradeTrend, topDrops []models.RetailerDeal, guilds []models.CommunityGuild) {
	<aside class="rail" aria-label="Highlights">
		if Stats().Products > 0 || Stats().Merchants > 0 {
			<p class="muted" style="font-size:14px;margin:6px 4px 0;">
				{ fmt.Sprintf("Comparing %s products from %s stores", FormatCount(Stats().Products), FormatCount(Stats().Merchants)) }
			</p>
		}
		if len(topDrops) > 0 {
			<section class="box">
				<h2>Price drops</h2>
				for _, d := range topDrops {
					<a class="row" href={ templ.SafeURL("/buybox/" + d.ID) } hx-get={ "/buybox/" + d.ID } hx-target="#buybox-drawer" hx-push-url="false">
						<img src={ d.ImageURL } alt="" loading="lazy" width="48" height="48"/>
						<div class="txt">
							<small>{ d.MerchantName }</small>
							<b>{ d.Title }</b>
							<span>
								<strong style="color:var(--ink)">R { FormatZAR(d.PriceZar) }</strong>
								if d.DiscountPct > 0 {
									<span style="color:var(--sale);display:inline"> { fmt.Sprintf("−%d%%", d.DiscountPct) }</span>
								}
							</span>
						</div>
					</a>
				}
				<a class="foot" href="/?tab=deals">Show more</a>
			</section>
		}
		if len(trends) > 0 {
			<section class="box">
				<h2>Trending searches</h2>
				for _, tr := range trends {
					<a class="row" href={ templ.SafeURL("/search?q=" + url.QueryEscape(SplitTag(tr.Tag))) }>
						<div class="txt">
							<small>{ tr.Category }</small>
							<b>{ SplitTag(tr.Tag) }</b>
						</div>
					</a>
				}
			</section>
		}
		if len(guilds) > 0 {
			<section class="box">
				<h2>Markets to follow</h2>
				for _, g := range guilds {
					<a class="row" href={ templ.SafeURL("/search?q=" + url.QueryEscape(guildQuery(g))) }>
						<span class="avatar" aria-hidden="true">{ g.Initials }</span>
						<div class="txt">
							<b>{ g.Name }</b>
							<small>{ g.Location }</small>
						</div>
					</a>
				}
			</section>
		}
		<nav class="legal" aria-label="Legal">
			<a href="/sell">Sell</a>
			<a href="/track">Track an order</a>
			<a href="/buyer-protection">Buyer protection</a>
			<a href="/desk">Merchant desk</a>
			<span>© 2026 Shoppage</span>
		</nav>
	</aside>
}

func trimHash(s string) string {
	if len(s) > 0 && s[0] == '#' {
		return s[1:]
	}
	return s
}

func guildQuery(g models.CommunityGuild) string {
	if g.Query != "" {
		return g.Query
	}
	return g.Name
}

templ BottomBar(currentTab string) {
	<nav class="bottombar" aria-label="Quick navigation">
		<a href="/" { current(isHome(currentTab))... }>
			@Ico("home", 24)
			Home
		</a>
		<a href="/?tab=deals" { current(currentTab == "deals")... }>
			@Ico("tag", 24)
			Deals
		</a>
		<a href="/search" { current(currentTab == "all")... }>
			@Ico("search", 24)
			Search
		</a>
		<a href="/chat" { current(currentTab == "chat")... }>
			@Ico("chat", 24)
			Messages
		</a>
		<a href="/track" { current(currentTab == "track")... }>
			@Ico("box", 24)
			Orders
		</a>
	</nav>
}

templ CorporateFooter() {
	<footer class="site-foot">
		<div class="in">
			<span>South Africa</span>
			if site.CompanyLegalName() != "" {
				<span>{ site.CompanyLegalName() }</span>
				if site.CompanyCIPC() != "" {
					<span>Reg. { site.CompanyCIPC() }</span>
				}
			}
			<span class="sep"></span>
			<a href="/sell">Sell on Shoppage</a>
			<a href="/track">Track an order</a>
			<a href="/buyer-protection">Buyer protection</a>
			<a href="/desk">Merchant desk</a>
		</div>
	</footer>
}

// AskWidget is the floating shopping assistant. It says plainly whether an AI
// model is connected.
templ AskWidget() {
	<div class="ask" data-ask>
		<div class="ask-panel" id="ask-panel" role="dialog" aria-label="Shopping assistant">
			<header>
				<span class="avatar" aria-hidden="true" style="background:var(--brand-soft);color:var(--brand-ink);">
					@Ico("spark", 20)
				</span>
				<div style="flex:1;min-width:0;">
					<b>Ask Shoppage</b>
					if site.GeminiConfigured() {
						<small>Answers from the live catalogue · { site.GeminiModel() }</small>
					} else {
						<small>Catalogue search only · no AI model connected</small>
					}
				</div>
				<button type="button" class="icon-btn" data-ask-close aria-label="Close">
					@Ico("x", 20)
				</button>
			</header>
			<div class="ask-sugs">
				<button type="button" class="chip" data-ask-q="5kW hybrid inverter under R20 000">5kW inverter under R20 000</button>
				<button type="button" class="chip" data-ask-q="How long does a 5.12kWh battery last at 450W?">Battery runtime</button>
				<button type="button" class="chip" data-ask-q="Cheapest cement near me">Cheapest cement</button>
			</div>
			<div class="ask-msgs" id="ask-msgs" aria-live="polite">
				<div class="bubble it">Tell me what you're looking for and I'll find it across South African stores.</div>
			</div>
			<form data-ask-form>
				<label class="sr" for="ask-input">Message</label>
				<input id="ask-input" type="text" placeholder="Ask about a product…" autocomplete="off"/>
				<button type="submit" class="btn btn-brand btn-sm">Ask</button>
			</form>
		</div>
		<button type="button" class="ask-btn" data-ask-open aria-controls="ask-panel" aria-expanded="false">
			<span class="spark">
				@Ico("spark", 20)
			</span>
			<span class="label">Ask Shoppage</span>
		</button>
	</div>
}

templ Logo(size int) {
	<svg viewBox="0 0 32 32" width={ fmt.Sprint(size) } height={ fmt.Sprint(size) } aria-hidden="true">
		<rect width="32" height="32" rx="9" fill="#0b8a5a"></rect>
		<path d="M8.5 12a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2l1 12a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" fill="#fff"></path>
		<path d="M12 10V7.5A3.5 3.5 0 0 1 15.5 4h1A3.5 3.5 0 0 1 20 7.5V10" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"></path>
		<path d="M17 12l-5 6h4l-1 6 5-7h-3.8z" fill="#f59e0b"></path>
	</svg>
}

// Ico renders one icon from a single 2px-stroke set.
templ Ico(name string, size int) {
	<svg width={ fmt.Sprint(size) } height={ fmt.Sprint(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "home":
				<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"></path>
			case "tag":
				<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"></path>
				<circle cx="7.5" cy="7.5" r="1.5"></circle>
			case "bag":
				<path d="M5 7h14l-1 13H6z"></path>
				<path d="M9 7V6a3 3 0 0 1 6 0v1"></path>
			case "store":
				<path d="M4 9 5.5 4h13L20 9"></path>
				<path d="M4 9a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0"></path>
				<path d="M5.5 12v8h13v-8M10 20v-4.5h4V20"></path>
			case "feed":
				<path d="M4 5h16M4 10h16M4 15h10M4 20h7"></path>
			case "play":
				<rect x="3" y="3" width="18" height="18" rx="4"></rect>
				<path d="m10 8.5 5 3.5-5 3.5z"></path>
			case "chat":
				<path d="M21 12a8.5 8.5 0 0 1-12.4 7.6L3 21l1.5-5.2A8.5 8.5 0 1 1 21 12z"></path>
			case "box":
				<path d="M21 8 12 3 3 8v8l9 5 9-5z"></path>
				<path d="M3 8l9 5 9-5M12 13v8"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "sell":
				<path d="M12 2v20M17 6.5C17 4.6 14.8 3.5 12 3.5S7 4.8 7 6.8c0 4.7 10 2.4 10 7.4 0 2-2.2 3.3-5 3.3s-5-1.2-5-3.1"></path>
			case "desk":
				<rect x="3" y="4" width="18" height="12" rx="2"></rect>
				<path d="M8 20h8M12 16v4"></path>
			case "moon":
				<path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
			case "search":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			case "x":
				<path d="M6 6l12 12M18 6 6 18"></path>
			case "pin":
				<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
				<circle cx="12" cy="10" r="3"></circle>
			case "spark":
				<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path>
				<path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z"></path>
			case "truck":
				<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"></path>
				<circle cx="7" cy="18" r="2"></circle>
				<circle cx="17" cy="18" r="2"></circle>
			case "check":
				<path d="m5 12.5 4.5 4.5L19 7.5"></path>
			case "wa":
				<path d="M20.5 12a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.1-4.2A8.5 8.5 0 1 1 20.5 12z"></path>
				<path d="M9 9.5c.3 2.4 2.1 4.2 4.5 4.5l1-1.2 2 .8-.4 1.6c-3.9.2-7.6-3.5-7.4-7.4l1.6-.4.8 2z"></path>
			case "shield":
				<path d="M12 3 4 6v6c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V6z"></path>
				<path d="m8.5 12 2.5 2.5 4.5-5"></path>
			case "chev":
				<path d="m9 6 6 6-6 6"></path>
			case "filter":
				<path d="M4 6h16M7 12h10M10 18h4"></path>
			case "heart":
				<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path>
			case "share":
				<path d="M12 3v12M7 8l5-5 5 5M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"></path>
			default:
				<circle cx="12" cy="12" r="8"></circle>
		}
	</svg>
}
