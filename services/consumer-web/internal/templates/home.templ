package templates

import (
	"fmt"
	"net/url"

	"github.com/shoppage/consumer-web/internal/models"
)

func tabHref(tab string) string {
	switch tab {
	case "foryou":
		return "/"
	case "shorts":
		return "/shorts"
	}
	return "/?tab=" + tab
}

func catHref(tab, cat string) string {
	v := url.Values{}
	if tab != "" && tab != "foryou" {
		v.Set("tab", tab)
	}
	if cat != "" {
		v.Set("category", cat)
	}
	if len(v) == 0 {
		return "/"
	}
	return "/?" + v.Encode()
}

func dealsHref(retailer, category, sort string) string {
	v := url.Values{"tab": {"deals"}}
	if retailer != "" {
		v.Set("retailer", retailer)
	}
	if category != "" {
		v.Set("category", category)
	}
	if sort != "" {
		v.Set("sort", sort)
	}
	return "/?" + v.Encode()
}

func pressed(on bool) string { return fmt.Sprint(on) }

func firstN[T any](xs []T, n int) []T {
	if len(xs) > n {
		return xs[:n]
	}
	return xs
}

// HomeViewComponent is Home: a Google-style search front door, then
// Shopping-style rails, with X-style tabs for Deals, Products, Trade Wire
// and Shorts.
templ HomeViewComponent(data HomeViewData) {
	@Layout(data.Title, data.Description, data.CurrentTab, data.Trends, data.TopDrops, data.Guilds) {
		<nav class="tabs" aria-label="Home sections">
			for _, t := range [][2]string{{"foryou", "For you"}, {"deals", "Deals"}, {"products", "Products"}, {"tradewire", "Trade Wire"}, {"shorts", "Shorts"}} {
				<a href={ templ.SafeURL(tabHref(t[0])) } { current(data.CurrentTab == t[0] || (t[0] == "foryou" && data.CurrentTab == ""))... }>{ t[1] }</a>
			}
		</nav>
		switch data.CurrentTab {
			case "deals":
				@homeDeals(data)
			case "products":
				@homeProducts(data)
			case "tradewire":
				@homeWire(data)
			case "shorts":
				@homeShorts(data)
			default:
				@homeForYou(data)
		}
	}
}

templ homeForYou(data HomeViewData) {
	<section class="hero">
		<div class="mark">Shop<span>page</span></div>
		@SearchBox(data.Query, true)
		if data.ProductsCount > 0 {
			<p class="tag">{ fmt.Sprintf("Compare prices on %s products from %s South African stores", FormatCount(data.ProductsCount), FormatCount(data.MerchantsCount)) }</p>
		} else {
			<p class="tag">Compare prices across South African stores</p>
		}
		if len(data.Trends) > 0 {
			<div class="popular" aria-label="Popular searches">
				for _, tr := range firstN(data.Trends, 6) {
					<a class="chip" href={ templ.SafeURL("/search?q=" + url.QueryEscape(SplitTag(tr.Tag))) }>{ SplitTag(tr.Tag) }</a>
				}
			</div>
		}
	</section>
	if len(data.Categories) > 0 {
		<div class="chips" aria-label="Categories">
			for _, c := range data.Categories {
				<a class="chip" href={ templ.SafeURL("/search?category=" + url.QueryEscape(c)) }>{ Humanize(c) }</a>
			}
		</div>
	}
	if len(data.Deals) > 0 {
		<section class="section">
			<div class="sec-head">
				<div>
					<h2>Price drops</h2>
					if data.AvgSavingsPct > 0 {
						<p>{ fmt.Sprintf("Retailer specials, %d%% off on average", data.AvgSavingsPct) }</p>
					}
				</div>
				<a class="more" href="/?tab=deals">See all deals</a>
			</div>
			<div class="tiles rowscroll">
				for _, d := range firstN(data.Deals, 12) {
					@DealTile(d)
				}
			</div>
		</section>
	}
	if len(data.Products) > 0 {
		<section class="section">
			<div class="sec-head">
				<div>
					<h2>Popular products</h2>
					<p>Prices from stores across South Africa</p>
				</div>
				<a class="more" href="/?tab=products">Browse all</a>
			</div>
			<div class="tiles">
				for _, p := range firstN(data.Products, 18) {
					@ProductTile(p)
				}
			</div>
		</section>
	}
	if len(data.Shorts) > 0 {
		<section class="section">
			<div class="sec-head">
				<div>
					<h2>Shorts</h2>
					<p>Products in action, from the stores that sell them</p>
				</div>
				<a class="more" href="/shorts">Watch</a>
			</div>
			<div class="shorts">
				for _, s := range firstN(data.Shorts, 10) {
					@ShortCard(s)
				}
			</div>
		</section>
	}
	if len(data.Malls) > 0 {
		<section class="section">
			<div class="sec-head">
				<div>
					<h2>Stores &amp; markets</h2>
					<p>Malls, trade districts and wholesale hubs</p>
				</div>
				<a class="more" href="/malls">See all</a>
			</div>
			<div class="box">
				for _, m := range firstN(data.Malls, 5) {
					<a class="row" href={ templ.SafeURL("/malls/" + m.ID) }>
						<span class="avatar" aria-hidden="true">
							@Ico("store", 20)
						</span>
						<div class="txt">
							<b>{ m.Name }</b>
							<small>{ placeLabel(m.Suburb, m.Metro) }{ mallKind(m) }</small>
						</div>
					</a>
				}
			</div>
		</section>
	}
}

func mallKind(m models.Mall) string {
	if m.MarketType == "" {
		return ""
	}
	return " · " + Humanize(m.MarketType)
}

templ homeDeals(data HomeViewData) {
	<div class="chips" aria-label="Retailers">
		<a class="chip" href="/?tab=deals" aria-pressed={ pressed(data.CurrentRetailer == "" || data.CurrentRetailer == "all") }>All retailers</a>
		for _, r := range Stats().Retailers {
			<a class="chip" href={ templ.SafeURL(dealsHref(r.Key, data.CurrentCategory, data.CurrentSort)) } aria-pressed={ pressed(data.CurrentRetailer == r.Key) }>
				{ r.Label }
				<span class="faint num">{ fmt.Sprint(r.Deals) }</span>
			</a>
		}
	</div>
	<div class="chips" aria-label="Sort deals" style="padding-top:0;">
		for _, s := range [][2]string{{"savings", "Biggest saving"}, {"price_asc", "Lowest price"}, {"expiring", "Ending soon"}} {
			<a class="chip" href={ templ.SafeURL(dealsHref(data.CurrentRetailer, data.CurrentCategory, s[0])) } aria-pressed={ pressed(data.CurrentSort == s[0] || (s[0] == "savings" && data.CurrentSort == "")) }>{ s[1] }</a>
		}
	</div>
	<section class="section">
		if len(data.Deals) == 0 {
			@EmptyState("No deals here right now", "Try another retailer, or check back after the next circular.", "/?tab=deals", "All deals")
		} else {
			<p class="muted" style="margin:0 0 14px;font-size:14px;">
				{ fmt.Sprintf("%d specials", len(data.Deals)) }
				if Stats().MaxDiscountPct > 0 {
					{ fmt.Sprintf(" · up to %d%% off", Stats().MaxDiscountPct) }
				}
			</p>
			<div class="tiles">
				for _, d := range data.Deals {
					@DealTile(d)
				}
			</div>
		}
	</section>
}

templ homeProducts(data HomeViewData) {
	if len(data.Categories) > 0 {
		<div class="chips" aria-label="Categories">
			<a class="chip" href="/?tab=products" aria-pressed={ pressed(data.CurrentCategory == "") }>All</a>
			for _, c := range data.Categories {
				<a class="chip" href={ templ.SafeURL(catHref("products", c)) } aria-pressed={ pressed(data.CurrentCategory == c) }>{ Humanize(c) }</a>
			}
		</div>
	}
	<section class="section">
		if len(data.Products) == 0 {
			@EmptyState("No products in this category", "Try another category or search for what you need.", "/?tab=products", "All products")
		} else {
			<div class="tiles">
				for _, p := range data.Products {
					@ProductTile(p)
				}
			</div>
		}
	</section>
}

templ homeWire(data HomeViewData) {
	<form class="composer" id="compose" hx-post="/feed/post" hx-target="#timeline-posts" hx-swap="afterbegin" hx-on::after-request="if(event.detail.successful) this.reset()">
		<span class="avatar" aria-hidden="true">
			@Ico("feed", 20)
		</span>
		<div>
			<label class="sr" for="wire-text">Post a request or offer</label>
			<textarea id="wire-text" name="text" maxlength="280" rows="2" placeholder="What are you looking for? e.g. 200 bags of cement delivered to Midrand"></textarea>
			<details style="margin:6px 0;">
				<summary class="muted" style="cursor:pointer;font-size:14px;">Add a poll</summary>
				<div style="display:grid;gap:6px;margin-top:8px;">
					<input class="chip" style="height:38px;width:100%;" type="text" name="pollOpt1" placeholder="Option 1"/>
					<input class="chip" style="height:38px;width:100%;" type="text" name="pollOpt2" placeholder="Option 2"/>
					<input class="chip" style="height:38px;width:100%;" type="text" name="pollOpt3" placeholder="Option 3 (optional)"/>
				</div>
			</details>
			<div class="bar">
				<span class="muted" style="font-size:13px;">Stores that stock it can reply with a price.</span>
				<button type="submit" class="btn btn-brand btn-sm" style="margin-left:auto;">Post</button>
			</div>
		</div>
	</form>
	<div id="timeline-posts">
		if len(data.Posts) == 0 {
			@EmptyState("Nothing posted yet", "Requests and offers from buyers and stores appear here.", "", "")
		}
		for _, p := range firstN(data.Posts, data.PostLimit) {
			@PostCard(p)
		}
	</div>
	if len(data.Posts) > data.PostLimit {
		<div style="padding:16px 20px;text-align:center;">
			<a class="btn btn-outline" href={ templ.SafeURL(fmt.Sprintf("/?tab=tradewire&n=%d", data.PostLimit+30)) }>Show more</a>
		</div>
	}
}

templ homeShorts(data HomeViewData) {
	if len(data.Shorts) == 0 {
		<section class="section">
			@EmptyState("No shorts yet", "Stores post short videos of their products here.", "", "")
		</section>
	} else {
		<div class="shorts-feed" data-shorts>
			for _, sh := range data.Shorts {
				<article class="reel" id={ sh.ID }>
					<div class="frame">
						if sh.VideoURL != "" {
							<video src={ sh.VideoURL } poster={ sh.Image } muted loop playsinline preload="none" aria-label={ sh.Title }></video>
						} else {
							<img src={ sh.Image } alt="" loading="lazy"/>
						}
						<div class="over">
							<h2>{ sh.Title }</h2>
							<div style="font-size:14px;opacity:.9;">
								{ sh.MerchantName }
								if sh.PriceZar > 0 {
									· R { FormatZARWhole(sh.PriceZar) }
								}
							</div>
							if sh.Summary != "" {
								<p style="margin:6px 0 0;font-size:14px;opacity:.85;">{ sh.Summary }</p>
							}
						</div>
						<div class="side">
							if sh.MerchantWhatsApp != "" {
								<a href={ templ.SafeURL("https://wa.me/" + sh.MerchantWhatsApp + "?text=" + url.QueryEscape("Hi, I saw \""+sh.Title+"\" on Shoppage.")) } target="_blank" rel="noopener" aria-label={ "Message " + sh.MerchantName }>
									@Ico("wa", 24)
								</a>
								<span>Ask</span>
							}
							<a href={ templ.SafeURL("/search?q=" + url.QueryEscape(sh.MerchantName)) } aria-label="See the store's products">
								@Ico("bag", 24)
							</a>
							<span>Shop</span>
							<a href={ templ.SafeURL("#" + sh.ID) } data-share aria-label="Share">
								@Ico("share", 24)
							</a>
							<span>Share</span>
						</div>
					</div>
				</article>
			}
		</div>
		<script>
			(function () {
				var feed = document.querySelector('[data-shorts]');
				if (!feed || !('IntersectionObserver' in window)) return;
				var io = new IntersectionObserver(function (entries) {
					entries.forEach(function (e) {
						var v = e.target.querySelector('video');
						if (!v) return;
						if (e.isIntersecting && e.intersectionRatio > 0.6) { v.play().catch(function () {}); } else { v.pause(); }
					});
				}, { root: feed, threshold: [0, 0.6, 1] });
				feed.querySelectorAll('.reel').forEach(function (r) { io.observe(r); });
				feed.addEventListener('click', function (e) {
					var v = e.target.closest('video');
					if (v) { v.muted = !v.muted; if (v.paused) v.play(); }
					var sh = e.target.closest('[data-share]');
					if (sh) {
						e.preventDefault();
						var url = location.origin + '/shorts' + sh.getAttribute('href');
						if (navigator.share) navigator.share({ url: url }); else navigator.clipboard.writeText(url);
					}
				});
				if (location.hash) { var t = document.getElementById(location.hash.slice(1)); if (t) t.scrollIntoView(); }
			})();
		</script>
	}
}
